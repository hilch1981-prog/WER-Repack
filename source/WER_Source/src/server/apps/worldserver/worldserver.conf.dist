#                    1+ - (지정한 레벨의 캐릭터에만 연결 해제 방식 적용)

CharDelete.MinLevel = 0

#
#    CharDelete.KeepDays
#        설명: 연결 해제된 캐릭터가 데이터베이스에서 제거되기까지의 기간(일)입니다.
#        기본값:     30 - (활성)
#                    0  - (비활성, 캐릭터를 삭제하지 않음)

CharDelete.KeepDays = 30

