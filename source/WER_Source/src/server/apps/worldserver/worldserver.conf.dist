MinCharterName = 2

#
#    StrictCharterNames
#        설명: 길드/투기장 팀 청원서 이름을 언어별 문자 집합으로 제한합니다.
#                     허용되지 않은 문자를 사용하면 청원서를 만들 수 없습니다.
#        기본값:     0 - (비활성, 서버 시간대에 따른 제한적인 클라이언트 검사)
#                     1 - (활성, 기본 라틴 문자만 허용)
#                     2 - (활성, 렐름 지역에 해당하는 문자만 허용, RealmZone 설정 참고,
#        참고:        클라이언트에 해당 문자 집합을 지원하는 글꼴이 설치되어 있어야 합니다.
#                     비공식 현지화의 경우 사용자 글꼴을 clientdir/Fonts에 넣어야 합니다.
#                     3 - (활성, 기본 라틴 문자 + 서버 시간대에 해당하는 문자)

StrictCharterNames = 0

