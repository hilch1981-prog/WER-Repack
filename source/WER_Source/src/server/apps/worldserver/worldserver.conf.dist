#
#    Instance.ResetTimeRelativeTimestamp
#        설명: 게임 내 달력에 올바른 인스턴스 초기화 시각을 표시하는 데 필요합니다.
#                     이 타임스탬프는 3일 및 7일 주기 공격대가 모두 초기화된 과거 날짜(자정)로 설정해야 합니다.
#        기본값:     1135814400 - (Thu, 29 Dec 2005 00:00:00 GMT - 7일 주기 공격대 초기화는 목요일에,
#                                  3일 주기 초기화는 "Thu 29 Dec 2005", "Sun 01 Jan 2006", "Wed 04 Jan 2006" 등에 해당함)

Instance.ResetTimeRelativeTimestamp = 1135814400

#
#    Rate.InstanceResetTime
#        설명: 전체 공격대/영웅 인스턴스 초기화 주기(dbc 값)의 배율입니다. 값이 높을수록 초기화 간격이
#                     길어지고, 낮을수록 짧아집니다. 새 값을 적용하려면 characters DB의 instance_reset을
#                     비워야 합니다.
#        기본값:     1

Rate.InstanceResetTime = 1

#
#    Instance.UnloadDelay
#        설명: 안에 캐릭터가 없을 때 인스턴스 맵을 메모리에서 해제하기까지의 시간(밀리초)입니다.
#        기본값:     1800000 - (활성, 30분)
#                     0       - (비활성, 인스턴스가 초기화될 때까지 인스턴스 맵을 메모리에
#                               유지함)

Instance.UnloadDelay = 1800000

#
#   AccountInstancesPerHour
#        설명: 플레이어가 한 시간 안에 입장할 수 있는 서로 다른 인스턴스의 최대 개수입니다.
#        기본값:     5

AccountInstancesPerHour = 5

#
#    Instance.SharedNormalHeroicId
#        설명: ICC(얼음왕관 성채)와 RS(루비 성소) 일반 및 영웅 난이도가 귀속을 공유하도록 강제합니다.
#                     ToC(십자군의 시험장)는 영향을 받지 않으며 일반과 영웅이 따로 유지됩니다.
#        기본값:     1 - 활성
#                     0 - 비활성

Instance.SharedNormalHeroicId = 1

#
#    DungeonAccessRequirements.PrintMode
#
#        설명: 입장 요구 조건을 충족하지 못해 포털 던전에 들어갈 수 없는 플레이어에게 정보를 표시할 형식을 선택합니다:
#        기본값:     1 - (한 번에 하나의 요구 조건만 표시(BlizzLike, LFG 인터페이스와 동일))
#                     0 - (추가 정보 없이 "Requirements  not met"만 표시)
#                     2 - (모든 요구 조건을 클릭 가능한 링크와 함께 한꺼번에 자세히 표시)

DungeonAccessRequirements.PrintMode = 1

#
#    DungeonAccessRequirements.PortalAvgIlevelCheck
#
#        설명: 던전/공격대 포털 입장 시 평균 아이템 레벨 요구 조건을 활성화합니다
#                     (LFG처럼 평균 아이템 레벨이 너무 낮으면 입장 거부).
#        기본값:     0 - (비활성  -> Blizzlike)
#                     1 - (활성)

DungeonAccessRequirements.PortalAvgIlevelCheck = 0

#
#    DungeonAccessRequirements.OptionalStringID
#
#        설명: 던전 입장 요구 조건을 출력한 후 acore_strings의 추가 메시지를 채팅에 표시합니다.
#                     활성화하려면 acore_strings 테이블에서 원하는 문자열의 ID를 설정하세요.
#        기본값:     0  - (비활성)
#                     1+ - (활성)

DungeonAccessRequirements.OptionalStringID = 0

#
###################################################################################################

###################################################################################################
# 플레이 시간 제한 (CAIS)
#
#    CAIS.Enable
#        설명: 중국 렐름의 연속 플레이 시간 제한을 활성화합니다. 3시간 연속 플레이 후에는 경험치와
#                     획득하는 돈이 절반으로 줄고, 5시간 후에는 캐릭터가 더 이상 경험치를 얻거나 전리품을 획득하거나
#                     퀘스트를 완료할 수 없습니다. 5시간 동안 오프라인 상태를 유지하면 누적 시간이 초기화됩니다.
#                     3시간/5시간 기준은 클라이언트에 하드코딩되어 있습니다.
#        참고:        worldserver를 재시작하면 모든 계정의 누적 시간이 초기화됩니다.
#        기본값:     0 - 비활성
#                     1 - 활성

CAIS.Enable = 0

