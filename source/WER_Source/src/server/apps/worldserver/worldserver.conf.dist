#                    0 - (비활성, 플레이어를 저장할 때마다 저장)

PlayerSave.Stats.SaveOnlyOnLogout = 1

#
#    PlayerSave.AdditionalSaves
#        설명: 중요한 변경이 생겼을 때 다음 주기적 저장(PlayerSaveInterval)을 기다리지 않고
#              몇 초 후 데이터베이스에 저장할 플레이어 데이터의 비트마스크입니다.
#              서버 크래시 시 잃는 진행 상황을 줄여 줍니다.
#              여러 트리거를 켜려면 값을 합산하세요.
#        값:          1 - 가방과 골드(희귀 등급 이상의 아이템을 획득한 후)
#                     2 - 퀘스트 상태(퀘스트 상태가 바뀐 후)
#                     4 - 업적(업적을 달성한 후)
#        기본값:     0 - (비활성)
#                    7 - (위 항목 모두)

PlayerSave.AdditionalSaves = 0

#
#    CleanCharacterDB
#        설명: 더 이상 사용되지 않는 업적, 기술, 주문, 특성을 DB에서 정리합니다.
#        기본값:     0 - (비활성)
#                    1 - (활성)

CleanCharacterDB = 0

#
#    PersistentCharacterCleanFlags
#        설명: 정리 후에도 설정된 상태로 남을 캐릭터 정리 플래그를 결정합니다.
#              비트마스크 값이며, 다음 값 중 하나를 사용할 수 있습니다.
#
#                     CLEANING_FLAG_ACHIEVEMENT_PROGRESS  = 0x1
#                     CLEANING_FLAG_SKILLS                = 0x2
#                     CLEANING_FLAG_SPELLS                = 0x4
#                     CLEANING_FLAG_TALENTS               = 0x8
#                     CLEANING_FLAG_QUESTSTATUS           = 0x10
#        참고:       이 기능을 사용하기 전에 데이터베이스를 백업하세요.
#        예:         14 - (CLEANING_FLAG_SKILLS + CLEANING_FLAG_SPELLS + CLEANING_FLAG_TALENTS
#                          2+4+8 => 14. 기술, 특성, 주문 정리가 다음 정리 이후에도
#                          활성 상태로 유지됨)
#        기본값:     0  - (다음 정리 이후 모든 정리 방식이 비활성화됨)

PersistentCharacterCleanFlags = 0

#
#    ValidateSkillLearnedBySpells
#        설명: 활성화하면 플레이어가 자신의 종족/직업에 맞지 않는 주문을 잃습니다.
#        기본값:     1 - (활성, 유효한 주문만 허용)
#                    0 - (비활성, 유효하지 않은 주문 허용)
#        참고:       이 옵션을 끈 상태에서 캐릭터가 DBC 수정이 필요한 주문을 배우면
#                    캐릭터가 데이터베이스에 저장되지 않을 수 있습니다.
#                    비활성화는 본인 책임하에 하세요.

ValidateSkillLearnedBySpells = 1

#
###################################################################################################

###################################################################################################
# 캐릭터 삭제
#
#    CharDelete.Method
#        설명: 캐릭터 삭제 방식입니다.
