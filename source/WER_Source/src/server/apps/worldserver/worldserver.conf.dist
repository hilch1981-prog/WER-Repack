#
#    Rate.Health
#    Rate.Mana
#    Rate.Rage.Income
#    Rate.Rage.Loss
#    Rate.RunicPower.Income
#    Rate.RunicPower.Loss
#    Rate.Focus
#    Rate.Energy
#        설명: 생명력, 마나, 분노 획득, 분노 감소, 집중력, 기력의 증가 또는 감소를 설정하는
#              배율입니다.
#        기본값:     1 - (Rate.Health)
#                    1 - (Rate.Mana)
#                    1 - (Rate.Rage.Income)
#                    1 - (Rate.Rage.Loss)
#                    1 - (Rate.RunicPower.Income)
#                    1 - (Rate.RunicPower.Loss)
#                    1 - (Rate.Focus)
#                    1 - (Rate.Energy)

Rate.Health            = 1
Rate.Mana              = 1
Rate.Rage.Income       = 1
Rate.Rage.Loss         = 1
Rate.RunicPower.Income = 1
Rate.RunicPower.Loss   = 1
Rate.Focus             = 1
Rate.Energy            = 1

#
#    Rate.Rest.InGame
#    Rate.Rest.Offline.InTavernOrCity
#    Rate.Rest.Offline.InWilderness
#    Rate.Rest.MaxBonus
#        설명: 휴식 경험치가 쌓이는 배율입니다.
#        기본값:     1   - (Rate.Rest.InGame)
#                    1   - (Rate.Rest.Offline.InTavernOrCity)
#                    1   - (Rate.Rest.Offline.InWilderness)
#                    1.5 - (Rate.Rest.MaxBonus)

Rate.Rest.InGame                 = 1
Rate.Rest.Offline.InTavernOrCity = 1
Rate.Rest.Offline.InWilderness   = 1
Rate.Rest.MaxBonus               = 1.5

#
#    Rate.MissChanceMultiplier.Creature
#    Rate.MissChanceMultiplier.Player
#    Rate.MissChanceMultiplier.OnlyAffectsPlayer
#        설명: 대상이 플레이어보다 3레벨 이상 높으면 적중 확률은 다음 공식으로 결정됩니다.
#              94 - (levelDiff - 2) * Rate.MissChanceMultiplier
#              Rate.MissChanceMultiplier 상수가 클수록 빗나갈 확률이 높아집니다.
#        참고:       플레이어와 대상의 레벨 차이가 3 미만일 때는 영향을 주지 않으며, 이 경우에는
#                    적중 확률 계산에 다음 (선형) 공식이 대신 사용됩니다: 96 - levelDiff.
#                    플레이어 시전자의 빗나감 확률에만 적용하고 싶다면
#                    Rate.MissChanceMultiplier.OnlyAffectsPlayer를 1로 설정하세요.
#                    이렇게 하면 생물의 빗나감 확률에는 영향을 주지 않습니다.
#        예:         확률이 계속 선형으로 증가하게 하려면 1을 사용하세요.
#        기본값:     Rate.MissChanceMultiplier.TargetCreature = 11
#                     Rate.MissChanceMultiplier.TargetPlayer = 7
#                     Rate.MissChanceMultiplier.OnlyAffectsPlayer = 0

Rate.MissChanceMultiplier.TargetCreature = 11
Rate.MissChanceMultiplier.TargetPlayer = 7
Rate.MissChanceMultiplier.OnlyAffectsPlayer = 0

