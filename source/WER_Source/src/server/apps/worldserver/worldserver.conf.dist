#    ArenaTeam.CharterCost.3v3
#    ArenaTeam.CharterCost.5v5
#        설명: 청원서 비용(동화 단위).
#        기본값:      800000  - (80 골드)
#                     1200000 - (120 골드)
#                     2000000 - (200 골드)

ArenaTeam.CharterCost.2v2 = 800000
ArenaTeam.CharterCost.3v3 = 1200000
ArenaTeam.CharterCost.5v5 = 2000000

#
#    MaxAllowedMMRDrop
#        설명: 일부 플레이어는 MMR을 낮춰 약한 상대와 싸우기 위해 투기장 경기에서 일부러 계속 패배합니다.
#              이 설정은 달성했던 최고 MMR에서 MMR이 지나치게 떨어지는 것을 막습니다.
#              예: 캐릭터의 최고 MMR이 2400이었다면, 기본 설정(MaxAllowedMMRDrop = 500)에서는 어떤 경우에도 1900 MMR 아래로 떨어지지 않습니다.
#        기본값:      500

MaxAllowedMMRDrop = 500

#
###################################################################################################

###################################################################################################
# 우편
#
#    MailDeliveryDelay
#        설명: 아이템을 보낼 때 우편 배달이 지연되는 시간(초).
#        기본값:      3600 - (1시간)

MailDeliveryDelay = 3600

#
#     LevelReq.Mail
#        설명: 캐릭터가 우편을 보내고 받을 수 있는 레벨 조건.
#        기본값:      1

LevelReq.Mail = 1

#
###################################################################################################

###################################################################################################
# 운송수단
#
#    IsContinentTransport.Enabled
#        설명: 대륙 간 운송 수단(배, 비행선 등)을 제어합니다
#        기본값:      1 - (활성)

IsContinentTransport.Enabled = 1

#
#    IsPreloadedContinentTransport.Enabled
#        설명: 운송 수단을 미리 로드할지 여부
#              (RAM을 100% 더 사용하므로 저사양 서버에서는 권장하지 않으며)
#              반드시 활성화할 필요도 없습니다.
#        기본값:      0 - (비활성)
#

IsPreloadedContinentTransport.Enabled = 0

#
###################################################################################################

###################################################################################################
# 채팅 채널
#
#    StrictChannelNames
#        설명: 채널 이름을 언어별 문자 집합으로 제한합니다.
#              허용되지 않는 문자를 사용하면 청원서 생성을 막습니다.
#        기본값:      0 - (비활성, 서버 시간대에 따른 제한적인 클라이언트 검사)
#                     1 - (활성, 기본 라틴 문자만 허용)
#                     2 - (활성, 렐름 지역별 문자만 허용, RealmZone 설정 참고,
#        참고:        클라이언트에 해당 문자 집합을 지원하는 글꼴이 설치되어 있어야 합니다.
#                     비공식 현지화의 경우 사용자 정의 글꼴을 clientdir/Fonts 에
#                     넣어야 합니다.
#                     3 - (활성, 기본 라틴 문자 + 서버 시간대별 문자)

StrictChannelNames = 0

#
#    AddonChannel
#        설명: 서버를 통한 애드온 채널 사용을 설정합니다(애드온 채널을 비활성화하면
#              일부 클라이언트 애드온이 제대로 작동하지 않을 수 있습니다)
#        기본값:      1 - (활성)
#                     0 - (비활성)

AddonChannel = 1

#
#    ChatFakeMessagePreventing
#        설명: 공백을 이용해 가짜 채팅 메시지를 만드는 것을 추가로 방지합니다.
#              연속된 여러 공백을 하나의 공백으로 합칩니다.
#              애드온 언어에는 적용되지 않지만, 다른 클라이언트로 데이터를 보낼 때
#              "일반" 채팅 메시지를 사용하는 오래된 애드온은 작동하지 않을 수 있습니다.
#        기본값:      1 - (활성, Blizzlike)
#                     0 - (비활성)

ChatFakeMessagePreventing = 1

#
#    ChatStrictLinkChecking.Severity
#        설명: 채팅 메시지에 포함된 주문, 아이템, 퀘스트 등의 게임 내 링크를 검사합니다.
#                     -1 - (링크 데이터의 유효성만 검사하고 사용자 정의 색상은 허용)
#        기본값:       0 - (텍스트는 검사하지 않고 링크 데이터와 색상이 유효한지만 검사)
#                      1 - (링크 텍스트가 제공된 데이터와 일치하는지도 추가로 검사)
#        참고:        '1'로 설정하면 서버에서 사용 중인 모든 클라이언트 로케일의 .dbc 파일을
#                     추가로 제공해야 합니다.
#                     파일이 하나라도 없으면 해당 로케일 클라이언트에서 보낸 링크 포함 메시지가
#                     서버에서 차단될 가능성이 높습니다.

ChatStrictLinkChecking.Severity = 0

#
#    ChatStrictLinkChecking.Kick
#        설명: 잘못된 제어 문자가 포함된 메시지를 받았을 때 어떻게 처리할지 정의합니다.
#        기본값:      0 - (메시지를 조용히 무시)
#                     1 - (메시지를 무시하고 플레이어를 추방)

ChatStrictLinkChecking.Kick = 0

#
#    ChatFlood.MessageCount
#        설명: 채팅 도배 방지 - 플레이어가 채팅 금지되기까지의 메시지 수.
#        기본값:      10 - (활성)
#                     0  - (비활성)

ChatFlood.MessageCount = 10

#
#    ChatFlood.MessageDelay
#        설명: ChatFlood.MessageCount 에 집계되는 메시지 간 시간 간격(초).
#        기본값:      1

ChatFlood.MessageDelay = 1

#
#    ChatFlood.AddonMessageCount
#        설명: 채팅 도배 방지 - 플레이어가 채팅 금지되기까지의 애드온 메시지 수.
#        기본값:      100 - (활성)
#                     0   - (비활성)

ChatFlood.AddonMessageCount = 100

#
#    ChatFlood.AddonMessageDelay
#        설명: ChatFlood.AddonMessageCount 에 집계되는 애드온 메시지 간 시간 간격(초).
#        기본값:      1

ChatFlood.AddonMessageDelay = 1

#
#    ChatFlood.MuteTime
#        설명: ChatFlood.MessageCount / ChatFlood.AddonMessageCount 를 위반한 캐릭터의 채팅 금지 시간(초).
#        기본값:      10

ChatFlood.MuteTime = 10

#
#    Chat.MuteFirstLogin
#        설명: Chat.MuteTimeFirstLogin 분 동안 플레이한 후에 일반 대화가 허용됩니다. 파티 및 길드 채팅은 사용할 수 있습니다.
#        기본값:      0 - (비활성)
#                     1 - (활성)

Chat.MuteFirstLogin = 0

#
#    Chat.MuteTimeFirstLogin
#        설명: 플레이어가 대화할 수 있게 되기까지의 시간.
#        기본값:      120 - (분)

Chat.MuteTimeFirstLogin = 120

#
#    Channel.RestrictedLfg
#        설명: LookupForGroup 채널을 LFG 도구에 등록한 캐릭터로 제한합니다.
#        기본값:      1 - (활성, LFG에 등록한 경우에만 채널 참여 허용)
#                     0 - (비활성, 언제든 채널 참여 허용)

Channel.RestrictedLfg = 1

#
#    Channel.SilentlyGMJoin
#        설명: GM 캐릭터를 알림 없이 채널에 참여시킵니다. 1로 설정하면 GM이 실행한
#              채널 추방 및 차단 명령도 알림으로 표시되지 않습니다.
#        기본값:      0 - (비활성, 알림과 함께 참여)
#                     1 - (활성, 알림 없이 참여)

Channel.SilentlyGMJoin = 0

#
#    ChatLevelReq.Channel
#        설명: 캐릭터가 채팅 채널에 글을 쓸 수 있는 레벨 조건.
#        기본값:      1

ChatLevelReq.Channel = 1

#
#    ChatLevelReq.Whisper
#        설명: 캐릭터가 다른 캐릭터에게 귓속말을 할 수 있는 레벨 조건.
#        기본값:      1

ChatLevelReq.Whisper = 1

#
#    ChatLevelReq.Say
#        설명: 캐릭터가 일반 대화/외치기/감정 표현을 사용할 수 있는 레벨 조건.
#        기본값:      1

ChatLevelReq.Say = 1

#
#    PartyLevelReq
#        설명: 친구 목록에 없는 상대라도 파티에 초대할 수 있는 최소 레벨.
#              (친구 목록에 있는 플레이어는 레벨이 낮아도 언제든 초대할 수
#              있습니다)
#        기본값:      1

PartyLevelReq = 1

#
#    PreserveCustomChannels
#        설명: 암호, 자동 소유권 이양, 차단 목록 등 사용자 정의 채팅 채널 설정을
#              데이터베이스에 저장합니다. 자동 소유권 이양이 비활성화된 사용자 정의
#              공개/거래 등의 채널을 저장하려면 활성화해야 합니다.
#              (.channel set ownership $channel off)
#        기본값:      0 - (비활성, Blizzlike, 마지막 사람이 나가면 채널 설정이 사라짐)
#                     1 - (활성)

PreserveCustomChannels = 0

#
#    PreserveCustomChannelDuration
#        설명: 사용자 정의 채팅 채널이 데이터베이스에서 정리되기까지 지나야 하는 시간(일).
#              소유권 이양이 활성화된 채널(기본 동작)만 정리됩니다.
#        기본값:      14 - (활성, 14일 동안 사용되지 않은 채널 정리)
#                     0  - (비활성, 채널을 무기한 보관)

PreserveCustomChannelDuration = 14

#
#    ChatFilter.Whisper / ChatFilter.Say / ChatFilter.Yell / ChatFilter.Emote
#        설명: `chat_filter` 테이블의 항목 중 하나라도 포함된 채팅 메시지를 차단합니다
#              (부분 문자열 일치, 대소문자 구분 없음).
#              항목 관리: .chatfilter add / .chatfilter remove / .chatfilter list
#              및 .reload chat_filter.
#              Blizzlike: 귓속말 필터링만 활성화됩니다.
#        기본값:      ChatFilter.Whisper = 1 - (활성)
#                     ChatFilter.Say     = 0 - (Disabled)
#                     ChatFilter.Yell    = 0 - (Disabled)
#                     ChatFilter.Emote   = 0 - (Disabled)
#

ChatFilter.Whisper = 1
ChatFilter.Say     = 0
ChatFilter.Yell    = 0
ChatFilter.Emote   = 0

