#                     (이 값을 높이면 평점을 더 많이 얻습니다)
#        기본값:     48

Arena.ArenaWinRatingModifier1 = 48

#
#    Arena.ArenaWinRatingModifier2
#        설명: 승리 팀 평점이 1300 이상일 때 평점 증가량 계수입니다.
