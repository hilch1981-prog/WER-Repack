###################################################################################################

###################################################################################################
# 사용자 정의
#
#    ICC.Buff.Alliance
#    ICC.Buff.Horde
#        설명: 얼음왕관 성채(ICC) 버프를 지정합니다
#        참고:        값을 변경한 후에는 반드시 서버를 재시작해야 합니다!
#        예:          | 주문 ID   | 수치   | 진영     |
#                     |     73762 |     5% | Alliance |
#                     |     73824 |    10% | Alliance |
#                     |     73825 |    15% | Alliance |
#                     |     73826 |    20% | Alliance |
#                     |     73827 |    25% | Alliance |
#                     |     73828 |    30% | Alliance |
#                     |     73816 |     5% |    Horde |
#                     |     73818 |    10% |    Horde |
#                     |     73819 |    15% |    Horde |
#                     |     73820 |    20% |    Horde |
#                     |     73821 |    25% |    Horde |
#                     |     73822 |    30% |    Horde |
#        기본값:      ICC.Buff.Alliance = 73828
#                     ICC.Buff.Horde    = 73822

ICC.Buff.Alliance = 73828
ICC.Buff.Horde    = 73822

#
#    WipeGunshipBlizzlike.Enable
#       설명: 갑판 위에 플레이어가 아무도 없으면 비행선 전투를 전멸 처리합니다.
#       기본값:      1 - (Blizzlike)

WipeGunshipBlizzlike.Enable = 1

#
#    Minigob.Manabonk.Enable
#        설명: 미니고브 마나봉크(Minigob Manabonk) 활성화/비활성화
#        기본값:      1

Minigob.Manabonk.Enable = 1

#
#    Calculate.Creature.Zone.Area.Data
#        설명: 로딩 시 생물의 zoneId / areaId를 계산하여 creature 테이블에 저장합니다
#              경고: 월드 서버 시작이 느려집니다. 디버깅 용도로만 사용하세요.
#        기본값:      0 - (표시하지 않음)

Calculate.Creature.Zone.Area.Data = 0

#
#    Calculate.Gameoject.Zone.Area.Data
#        설명: 로딩 시 게임 오브젝트의 zoneId / areaId를 계산하여 gameobject 테이블에 저장합니다
#              경고: 월드 서버 시작이 느려집니다. 디버깅 용도로만 사용하세요.
#        기본값:      0 - (표시하지 않음)

Calculate.Gameoject.Zone.Area.Data = 0

#
#    DailyRBGArenaPoints.MinLevel
#        설명: 레벨 70에서 첫 무작위 전장(RBG) 승리 시 투기장 점수를 얻을 수 있게 합니다.
#        기본값:      71 - (Blizzlike)

DailyRBGArenaPoints.MinLevel = 71

#
#    MunchingBlizzlike.Enabled
#        설명: 전사의 분쇄(Rend)나 마법사의 점화(Ignite) 등에 적용되는 Blizzlike 방식의 먼칭(munching) 구현을 활성화합니다
#        기본값:      1 - (Blizzlike)

MunchingBlizzlike.Enabled = 1

#
#    Daze.Enabled
#        설명: 몬스터의 근접 공격이 대상을 멍하게(daze) 만들 확률을 활성화하거나 비활성화합니다.
#        기본값:      1 - (Blizzlike)

Daze.Enabled = 1

#
#    InfiniteAmmo.Enabled
#        설명: 원거리 공격과 투척 무기의 탄약 소모를 활성화하거나 비활성화합니다.
#        기본값:      0 - (Blizzlike)

InfiniteAmmo.Enabled = 0

#
###################################################################################################

###################################################################################################
# 디버그
#
#    Debug.Battleground
#        설명: 전장 1v0 모드를 활성화하거나 비활성화합니다. (활성화하면 게임 내 명령어는 비활성화됩니다.)
#        기본값:      0 - (비활성)
#                     1 - (활성)

Debug.Battleground = 0

#
#    Debug.Arena
#        설명: 투기장 1v1 모드를 활성화하거나 비활성화합니다. (활성화하면 게임 내 명령어는 비활성화됩니다.)
#        기본값:      0 - (비활성)
#                     1 - (활성)

Debug.Arena = 0

#
#    Debug.LFG
#        설명: LFG 1인 대기열 모드를 활성화하거나 비활성화합니다. (활성화하면 게임 내 명령어는 비활성화됩니다.)
#        기본값:      0 - (비활성)
#                     1 - (활성)

Debug.LFG = 0

#
###################################################################################################

###################################################################################################
# 동적 재생성 설정
#
#
#    Respawn.DynamicRateCreature
#        설명: 지역 내 플레이어 수에 따라 생물의 재생성 시간을 조정하는 방식을 제어합니다.
#              플레이어 수가 설정한 값 이하이면 재생성 시간은 변하지 않습니다.
#              플레이어 수가 이 값을 넘으면 재생성 시간이 비례하여 줄어듭니다
#              (예: 플레이어 수가 두 배면 재생성 시간이 절반이 되고, 세 배면 재생성이 세 배 빨라집니다).
#              인스턴스 생물, 보스, 퀘스트 제공자에는 영향을 주지 않습니다.
#        공식:        adjustFactor = rate / playerCount
#                     RespawnTime = RespawnTime * adjustFactor
#        기본값:     1 (비활성화)

Respawn.DynamicRateCreature = 1

#
#    Respawn.DynamicMinimumCreature
#        설명: 동적 조정 시 생물의 최소 재생성 시간.
#        기본값:      10 - (10초)

Respawn.DynamicMinimumCreature = 10

#
#    Respawn.DynamicRateGameObject
#        설명: 지역 내 플레이어 수에 따라 게임 오브젝트의 재생성 시간을 조정하는 방식을 제어합니다.
#              플레이어 수가 설정한 값 이하이면 재생성 시간은 변하지 않습니다.
#              플레이어 수가 이 값을 넘으면 재생성 시간이 비례하여 줄어듭니다
#              (예: 플레이어 수가 두 배면 재생성 시간이 절반이 되고, 세 배면 재생성이 세 배 빨라집니다).
#              인스턴스 오브젝트나 퀘스트 제공자에는 영향을 주지 않습니다.
#        공식:        adjustFactor = rate / playerCount
#                     RespawnTime = RespawnTime * adjustFactor
#        기본값:     1 (비활성화)

Respawn.DynamicRateGameObject = 1

#
#    Respawn.DynamicMinimumGameObject
#        설명: 동적 조정 시 게임 오브젝트의 최소 재생성 시간.
#        기본값:      10 - (10초)

Respawn.DynamicMinimumGameObject = 10

#
#    Respawn.DynamicEscortNPC
#        설명: 호위 퀘스트 NPC에 동적 재생성 동작을 적용합니다.
#              활성화하면 ESCORTQUESTNPC 플래그가 지정된 생성 그룹의 호위 NPC는
#              특수한 재생성 처리를 사용합니다.
#        기본값:      0 - (비활성)

Respawn.DynamicEscortNPC = 0

#
#    Respawn.ForceCompatibilityMode
#        설명: 생성 그룹 플래그와 관계없이 모든 생성 대상이 기존(호환 모드) 재생성 동작을
#              사용하도록 강제합니다. 활성화하면 생물과 게임 오브젝트가 WER에서
#              늘 그래왔듯이 제자리에서 재생성됩니다.
#              모든 생성 대상에 기존 동작을 강제하려면 1로 설정하세요.
#        기본값:      0 - (비활성, 생성 그룹이 재생성 방식을 결정)

Respawn.ForceCompatibilityMode = 0

#
###################################################################################################

###################################################################################################
