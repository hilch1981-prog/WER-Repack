#                     우편으로 보냅니다.
#        기본값:     0 - 비활성
#                     1 - LFG/RDF 파티에서만
#                     2 - 모든 파티 유형에서

LFG.MailItemOnFullInventory = 0

#
#    DungeonFinder.OptionsMask
