#        기본값:     0 - (비활성, 퀘스트의 자동 수락 여부는 DB 값에 따름)
#                     1 - (활성, 클라이언트에 어떤 퀘스트도 자동 수락하라고 알리지 않음)

Quests.IgnoreAutoAccept = 0

