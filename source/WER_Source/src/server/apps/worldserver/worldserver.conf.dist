################################################
# WER 월드 서버 설정 파일 #
################################################
[worldserver]

###################################################################################################
# 섹션 목차
#
#  서버 시스템 설정
#    데이터베이스 및 연결
#    디렉터리
#    콘솔
#    자동 업데이트
#    네트워크
#    원격 접속
#    암호화
#    성능
#    로그
#    메트릭
#    서버
#    패킷 위조 방지 설정
#    워든(Warden)
#    자동 공지
#    가시성 및 거리
#    맵
#    날씨
#    티켓
#    명령어
#
#  게임 설정
#    게임 마스터
#    치트
#    계정
#    캐릭터 데이터베이스
#    캐릭터 삭제
#    캐릭터 생성
#    캐릭터
#    업적
#    기술
#    능력치
#    평판
#    경험치
#    화폐
#    내구도
#    죽음
#    소환수
#    아이템 삭제
#    아이템
#    퀘스트
#    생물
#    상인
#    파티
#    인스턴스
#    던전 및 전장 찾기
#    헌장
#    길드
#    자유 전투 PvP(FFA PvP)
#    야외 PvP
#    겨울손아귀
#    전장
#    투기장
#    우편
#    운송수단
#    채팅 채널
#    진영 상호작용
#    친구 초대
#    달력
#    게임 이벤트
#    경매장
#    플레이어 덤프
#    사용자 정의
#    디버그
#    동적 재생성 설정
#
#  클러스터 설정
#
###################################################################################################

###################################################################################################
#                                                                                                 #
# 서버 시스템 설정 시작                                                                    #
#                                                                                                 #
###################################################################################################

###################################################################################################
# 데이터베이스 및 연결
#
#    RealmID
#        설명:          이 설정을 사용하는 렐름의 ID입니다.
#        중요:          RealmID는 auth 데이터베이스의 realmlist와 일치해야 합니다.
#        기본값:         1

RealmID = 1

#
#    WorldServerPort
#        설명:          월드 서버에 접속할 TCP 포트입니다.
#        기본값:         8085

WorldServerPort = 8085

#
#    BindIP
#        설명:          월드 서버를 바인딩할 IP/호스트 이름입니다.
#        기본값:         "0.0.0.0" - (시스템의 모든 IP에 바인딩)

BindIP = "0.0.0.0"

#
#    LoginDatabaseInfo
#    WorldDatabaseInfo
#    CharacterDatabaseInfo
#        설명:          월드 서버의 데이터베이스 연결 설정입니다.
#        예:           "hostname;port;username;password;database"
#                     ".;somenumber;username;password;database"
#                     (Windows에서 명명된 파이프를 사용하려면 my.ini의 [mysqld] 섹션에 "enable-named-pipe" 추가)
#                     ".;/path/to/unix_socket;username;password;database"
#                     (Unix/Linux에서 Unix 소켓 사용)
#        기본값:         "127.0.0.1;3306;acore;acore;acore_auth"       - (LoginDatabaseInfo)
#                     "127.0.0.1;3306;acore;acore;acore_world"      - (WorldDatabaseInfo)
#                     "127.0.0.1;3306;acore;acore;acore_characters" - (CharacterDatabaseInfo)

LoginDatabaseInfo     = "127.0.0.1;3306;wowlegends;wowlegends;wl_auth"
WorldDatabaseInfo     = "127.0.0.1;3306;wowlegends;wowlegends;wl_world"
CharacterDatabaseInfo = "127.0.0.1;3306;wowlegends;wowlegends;wl_characters"

#
#    LoginDatabase.WorkerThreads
#    WorldDatabase.WorkerThreads
#    CharacterDatabase.WorkerThreads
#        설명:          비동기(지연) MySQL 쿼리를 처리하기 위해 생성할 작업 스레드 수입니다.
#                     각 작업 스레드는 MySQL 서버와의 전용 연결을 가지며, MySQL 서버에서도
#                     각각 별도의 스레드를 사용합니다.
#        기본값:         1 - (LoginDatabase.WorkerThreads)
#                     1 - (WorldDatabase.WorkerThreads)
#                     1 - (CharacterDatabase.WorkerThreads)

LoginDatabase.WorkerThreads     = 1
WorldDatabase.WorkerThreads     = 1
CharacterDatabase.WorkerThreads = 1

#
#    LoginDatabase.SynchThreads
#    WorldDatabase.SynchThreads
#    CharacterDatabase.SynchThreads
#        설명:          처리를 위해 생성할 MySQL 연결 수입니다.
#        기본값:         1 - (LoginDatabase.SynchThreads)
#                     1 - (WorldDatabase.SynchThreads)
#                     1 - (CharacterDatabase.SynchThreads)

LoginDatabase.SynchThreads     = 1
WorldDatabase.SynchThreads     = 1
CharacterDatabase.SynchThreads = 1

#
#    MaxPingTime
#        설명:          데이터베이스 핑 간격(분)입니다.
#        기본값:         30

MaxPingTime = 30

#
#    Database.Reconnect.Seconds
#    Database.Reconnect.Attempts
#        설명:          재연결 시도 간격(초)과 총 시도 횟수입니다.
#        기본값:         15초마다 20회 시도
#

Database.Reconnect.Seconds = 15
Database.Reconnect.Attempts = 20

#
###################################################################################################

###################################################################################################
# 디렉터리
#
#    DataDir
#        설명:          데이터 디렉터리 설정입니다.
#        중요:          경로에 공백이 포함될 수 있으므로 DataDir 값은 따옴표로 감싸야 합니다.
#        예:           "@prefix@\home\youruser\WER\data"
#        기본값:         "."

DataDir = "data"

#
#    LogsDir
#        설명:          로그 디렉터리 설정입니다.
#        중요:          경로에 공백이 포함될 수 있으므로 LogsDir 값은 따옴표로 감싸야 합니다.
#                     로그 디렉터리가 존재해야 하며, 없으면 로그 파일이 생성되지 않습니다.
#        예:           "/home/youruser/WER/logs"
#        기본값:         "" - (로그 파일을 현재 경로에 저장)

LogsDir = ""

#
#    TempDir
#        설명:          임시 디렉터리 설정입니다.
#        중요:          경로에 공백이 포함될 수 있으므로 TempDir 값은 따옴표로 감싸야 합니다.
#                     TempDir 디렉터리가 존재해야 하며, 없으면 서버가 제대로 동작하지 않습니다.
#        예:           "/home/youruser/WER/temp"
#        기본값:         "" - (임시 파일을 현재 경로에 저장)

TempDir = ""

#
#    CMakeCommand
#        설명:          CMake 실행 파일 경로입니다.
#                     비워 두면 내장된 CMAKE_COMMAND를 사용합니다.
#        예:           "C:/Program Files/CMake/bin/cmake.exe"
#                     "/usr/bin/cmake"
#        기본값:         ""

CMakeCommand = ""

#
#    BuildDirectory
#        설명:          빌드 디렉터리 경로입니다.
#                     비워 두면 내장된 CMAKE_BINARY_DIR을 사용합니다.
#        예:           "../WER"
#        기본값:         ""

BuildDirectory = ""

#
#    SourceDirectory
#        설명:          WER 소스 디렉터리 경로입니다.
#                     비워 두면 내장된 CMAKE_SOURCE_DIR을 사용합니다.
#        예:           "../WER-wotlk"
#        기본값:         ""

SourceDirectory = "."

#
#    MySQLExecutable
#        설명:          MySQL CLI 실행 파일 경로입니다.
#                     비워 두면 cmake에 내장된 경로를 사용합니다.
#        예:           "C:/Program Files/MySQL/MySQL Server 8.0/bin/mysql.exe"
#                     "mysql.exe"
#                     "/usr/bin/mysql"
#        기본값:         ""

MySQLExecutable = "mysql/bin/mysql.exe"

#
#    PidFile
#        설명:          월드 데몬 PID 파일입니다.
#        예:           "./world.pid" - (활성)
#        기본값:         ""            - (비활성)

PidFile = ""

#
###################################################################################################

###################################################################################################
# 콘솔
#
#    Console.Enable
#        설명: 콘솔을 활성화합니다.
#        기본값:     1 - (활성)
#                     0 - (비활성)

Console.Enable = 1

#
#    BeepAtStart
#        설명:          월드 서버 시작이 완료되면 비프음을 냅니다(Unix/Linux 시스템).
#        기본값:         1 - (활성)
#                     0 - (비활성)

BeepAtStart = 1

#
#    FlashAtStart
#        설명:          월드 서버 시작이 완료되면 작업 표시줄에서 깜빡입니다(Windows 전용).
#        기본값:         1 - (활성)
#                     0 - (비활성)

FlashAtStart = 1

#
###################################################################################################

###################################################################################################
# 자동 업데이트
#
#    Updates.EnableDatabases
#        설명:          업데이트할 데이터베이스를 지정하는 마스크입니다.
#        참고:          사용 가능한 플래그는 다음과 같습니다.
#                     DATABASE_LOGIN     = 1, Auth database
#                     DATABASE_CHARACTER = 2, Character database
#                     DATABASE_WORLD     = 4, World database
#        기본값:         7 - (모두 활성)
#                     4 - (world만 활성)
#                     0 - (모두 비활성)

Updates.EnableDatabases = 0

#
#    Updates.AutoSetup
#        설명:          비어 있는 데이터베이스를 자동으로 채웁니다.
#        기본값:         1 - (활성)
#                     0 - (비활성)

Updates.AutoSetup   = 1

#
#    Updates.Redundancy
#        설명:          해시로 데이터 중복 검사를 수행하여 SQL 업데이트의 변경을 감지하고
#                     다시 적용합니다.
#        기본값:         1 - (활성)
#                     0 - (비활성)

Updates.Redundancy  = 1

#
#    Updates.ArchivedRedundancy
#        설명:          보관(archived)된 업데이트의 해시도 검사합니다(시작 속도가 느려짐).
#        기본값:         0 - (비활성)
#                     1 - (활성)

Updates.ArchivedRedundancy = 0

#
#    Updates.AllowRehash
#        설명:          데이터베이스의 해시가 비어 있으면 현재 파일 해시를 기록합니다.
#                     해시를 모르는 파일을 적용된 것으로 표시하고 싶을 때 유용합니다.
#        기본값:         1 - (활성)
#                     0 - (비활성)

Updates.AllowRehash = 1

#
#    Updates.CleanDeadRefMaxCount
#        설명:          업데이트를 한 번에 삭제하거나 이름 변경 후 수정했을 때 생기는 끊어진/고아 참조를 정리합니다.
#                     누락된 업데이트 수가 Updates.CleanDeadRefMaxCount 값 이하일 때만 정리를 시작합니다.
#                     이렇게 하면 소스 디렉터리 상태가 잘못되었을 때(잘못된 브랜치나 리비전 등) 업데이트 기록이 지워지는 것을 막습니다.
#                     데이터베이스가 "더러운 상태"일 가능성을 확인하고 싶다면 비활성화하세요.
#        기본값:         3 - (활성)
#                     0 - (비활성)
#                    -1 - (활성 - 무제한)

Updates.CleanDeadRefMaxCount = 3

#
#    Updates.ExceptionShutdownDelay
#        설명:          치명적인 예외(예: SQL 업데이트 실패) 발생 후 종료하기 전에 대기할 시간(밀리초)입니다.
#        기본값:         10000 - 10초
#                     0     - 비활성(즉시 종료)

Updates.ExceptionShutdownDelay = 10000

#
###################################################################################################

###################################################################################################
# 네트워크
#
#    Network.Threads
#        설명: 네트워크에 사용할 스레드 수.
#         기본값:    1 - (연결 1000개당 스레드 1개 권장)

Network.Threads = 1

#
#    Network.OutKBuff
#        설명:          커널 출력 버퍼에 사용할 메모리 양(바이트)입니다(SO_SNDBUF 소켓 옵션,
#                     TCP 매뉴얼 참고).
#        기본값:         -1 - (시스템 기본 설정 사용)

Network.OutKBuff = -1

#
#    Network.OutUBuff
#        설명:          출력 버퍼링을 위해 연결마다 사용자 공간에 처음 예약하는 메모리 양(바이트)입니다.
#         기본값:     4096

Network.OutUBuff = 4096

#
#    Network.TcpNoDelay:
#        설명:          TCP Nagle 알고리즘 설정입니다.
#         기본값:     0 - (활성, 트래픽 적음, 지연 시간 증가)
#                     1 - (비활성, 트래픽 많음, 지연 시간 감소, TCP_NO_DELAY)

Network.TcpNodelay = 1

#
#    Network.EnableProxyProtocol
#        설명:          Proxy Protocol v2를 활성화합니다. 서버가 프록시, 로드 밸런서 등의 뒤에 있을 때
#                     플레이어의 실제 IP 주소를 추적하려면 이 서버와 프록시/로드 밸런서 양쪽 모두에서
#                     Proxy Protocol v2를 활성화해야 합니다.
#        예:           1 - (활성)
#        기본값:         0 - (비활성)

Network.EnableProxyProtocol = 0

#
#    Network.UseSocketActivation
#        설명:          [LINUX 전용 기능] worldserver의 systemd 소켓 활성화 지원을 켭니다.
#                     활성화한 상태에서 프로세스가 systemd 소켓 활성화로 시작되면, 서버는 직접
#                     수신 소켓을 만들고 바인딩하는 대신 systemd가 넘겨준 소켓을 사용합니다. 기본값은 비활성입니다.
#                     활성화하면 종료 시 렐름이 자동으로 오프라인으로 설정되지 않습니다.
#        예:           1 - (활성)
#        기본값:         0 - (비활성)

Network.UseSocketActivation = 0

#
###################################################################################################

###################################################################################################
# 원격 접속
#
#    Ra.Enable
#        설명:          원격 콘솔(telnet)을 활성화합니다.
#        기본값:         0 - (비활성)
#                     1 - (활성)

Ra.Enable = 0

#
#    Ra.IP
#        설명:          원격 접속을 바인딩할 IP/호스트 이름입니다.
#        기본값:         "0.0.0.0" - (시스템의 모든 IP에 바인딩)

Ra.IP = "0.0.0.0"

#
#    Ra.Port
#        설명:          원격 콘솔에 접속할 TCP 포트입니다.
#        기본값:         3443

Ra.Port = 3443

#
#    Ra.MinLevel
#        설명:          원격 콘솔 사용에 필요한 보안 등급입니다.
#        기본값:         3

Ra.MinLevel = 3

#
#    SOAP.Enable
#        설명:          SOAP 서비스를 활성화합니다.
#        기본값:         0 - (비활성)
#                     1 - (활성)

SOAP.Enabled = 0

#
#    SOAP.IP
#        설명:          SOAP 서비스를 바인딩할 IP/호스트 이름입니다.
#        기본값:         "127.0.0.1" - (localhost에 바인딩)

SOAP.IP = "127.0.0.1"

#
#    SOAP.Port
#        설명:          SOAP 서비스에 접속할 TCP 포트입니다.
#        기본값:         7878

SOAP.Port = 7878

#
###################################################################################################

###################################################################################################
# 암호화
#
#    TOTPMasterSecret
#        설명:          authserver가 데이터베이스에 저장된 TOTP 비밀 키를 복호화할 때 쓰는 키입니다.
#                     게임 내 2FA 관리 명령어(.account 2fa)를 사용하려는 경우에만 여기에 설정하면 되며,
#                     그렇지 않으면 비워 두어도 됩니다.
#                     이 값이 authserver 설정과 일치하지 않으면 서버가 자동으로 감지하며,
#                     이 경우 비밀 키에 의존하는 명령어는 비활성화됩니다.
#        기본값:         <비워 둠>
#

TOTPMasterSecret =

#
###################################################################################################

###################################################################################################
# 성능
#
#    ThreadPool
#        설명:          전역 스레드 풀에서 사용할 스레드 수입니다.
#                     스레드 풀은 현재 다음 작업에 사용됩니다:
#                     - 시그널 처리
#                     - 원격 접속
#                     - 데이터베이스 keep-alive 핑
#                     - 코어 멈춤(freeze) 검사
#                     - 월드 소켓 네트워킹
#        기본값:         2

ThreadPool = 2

#
#    UseProcessors
#        설명:          Windows 및 Linux 기반 멀티 프로세서 시스템용 프로세서 마스크입니다.
#        예:           CPU가 3개인 컴퓨터의 경우:
#                     1  - 첫 번째 CPU만
#                     2  - 두 번째 CPU만
#                     4  - 세 번째 CPU만
#                     6  - 두 번째 + 세 번째 CPU ("2 | 4" -> 6)
#        기본값:         0  - (OS가 선택)
#                     1+ - (선택한 프로세서의 비트 마스크 값)

UseProcessors = 0

#
#    ProcessPriority
#        설명:          Windows 기반 시스템의 프로세스 우선순위 설정입니다.
#        기본값:         1 - (높음)
#                     0 - (보통)

ProcessPriority = 1

#
#    Compression
#        설명:          클라이언트 업데이트 패키지의 압축 수준입니다.
#        범위:          1-9
#        기본값:         1 - (속도 우선)
#                     9 - (최고 압축)

Compression = 1

#
###################################################################################################

###################################################################################################
# 로그
#
#    PacketLogFile
#        설명:          월드 서버의 바이너리 패킷 로그 파일입니다.
#                     WowPacketParser로 분석하려면 파일 확장자가 .pkt여야 합니다.
#        예:           "World.pkt" - (활성)
#        기본값:         ""          - (비활성)

PacketLogFile = ""

#
#    LogDB.Opt.ClearInterval
#        설명:          `logs` 테이블의 오래된 항목을 지우는 WUPDATE_CLEANDB 타이머 주기(분)입니다.
#        기본값:         10 - (10분)
#                     1+

LogDB.Opt.ClearInterval = 10

#
#    LogDB.Opt.ClearTime
#        설명:          `logs` 테이블의 오래된 항목을 보관할 시간(초)입니다.
#        기본값:         1209600 - (활성, 14일)
#                     0       - (비활성, 항목을 지우지 않음)

LogDB.Opt.ClearTime = 1209600

#
#    RecordUpdateTimeDiffInterval
#        설명:          업데이트 시간 차이(diff)를 로그 파일에 기록하는 주기(밀리초)입니다.
#                     업데이트 diff는 성능 지표로 사용할 수 있습니다. Diff < 300: 좋은 성능.
#                     Diff > 600: 나쁜 성능이며, 높은 CPU 사용률이 원인일 수 있습니다.
#        기본값:         300000 - (활성, 5분)
#                     0      - (비활성)

RecordUpdateTimeDiffInterval = 300000

#
#     MinRecordUpdateTimeDiff
#        설명:          이 값보다 큰 업데이트 시간 차이(diff)만 기록합니다.
#        기본값:         100

MinRecordUpdateTimeDiff = 100

#
#    IPLocationFile
#        설명:          IP2Location 데이터베이스 CSV 파일 경로입니다.
#        예:           "C:/acore/IP2LOCATION-LITE-DB1.CSV"
#                     "/home/acore/IP2LOCATION-LITE-DB1.CSV"
#        기본값:         "" - (비활성)

IPLocationFile = ""

#
#    AllowLoggingIPAddressesInDatabase
#        설명:          IP 주소를 데이터베이스에 기록할 수 있는지 지정합니다.
#        기본값:         1 - (활성)
#                     0 - (비활성)

AllowLoggingIPAddressesInDatabase = 1

#
#    Allow.IP.Based.Action.Logging
#        설명:          현재 세션의 IP를 기준으로 계정 로그인/로그아웃 등의 행동을 기록합니다.
#        기본값:         0 - (비활성)
#                     1 - (활성)

Allow.IP.Based.Action.Logging = 0

#
#    LogSpamReports
#        설명:          채팅, 우편, 달력에서 플레이어가 보낸 스팸 신고를 데이터베이스에 기록할 수 있게 합니다.
#        기본값:         1 - (활성)
#                     0 - (비활성)

LogSpamReports = 1

#
#    ChatLog.Enable
#        설명: 채팅 로그 기록(chat_log.cpp)을 활성화하거나 비활성화합니다.
#        기본값:     0 - (비활성)
#                     1 - (활성)

ChatLog.Enable = 0

#
#    어펜더(Appender) 설정 값: 어펜더 이름이 "name"일 때
#    Appender.name
#        설명:          '어디에 로그를 남길지' 정의합니다.
#        형식:          Type,LogLevel,Flags,optional1,optional2,optional3
#        Type:        0  - (없음)
#                     1  - (콘솔)
#                     2  - (파일)
#                     3  - (DB)
#        LogLevel:    0  - (비활성)
#                     1  - (Fatal, 치명적)
#                     2  - (Error, 오류)
#                     3  - (Warning, 경고)
#                     4  - (Info, 정보)
#                     5  - (Debug, 디버그)
#                     6  - (Trace, 추적)
#        Flags:       0  - 없음
#                     1  - 텍스트 앞에 타임스탬프 추가
#                     2  - 텍스트 앞에 로그 레벨 추가
#                     4  - 텍스트 앞에 로그 필터 유형 추가
#                     8  - 로그 파일 이름 뒤에 타임스탬프 추가. 형식: YYYY-MM-DD_HH-MM-SS
#                          (Type = 2일 때만 사용)
#                     16 - 덮어쓰기 전에 기존 파일 백업
#                          (Mode = w일 때만 사용)
#        색상:        (Type = Console이면 optional1로 읽음)
#        형식:          "fatal error warn info debug trace"
#                     0  - BLACK
#                     1  - RED
#                     2  - GREEN
#                     3  - BROWN
#                     4  - BLUE
#                     5  - MAGENTA
#                     6  - CYAN
#                     7  - GREY
#                     8  - YELLOW
#                     9  - LRED
#                     10 - LGREEN
#                     11 - LBLUE
#                     12 - LMAGENTA
#                     13 - LCYAN
#                     14 - WHITE
#        예:           "1 9 3 6 5 8"
#        File:        파일 이름(Type = File이면 optional1로 읽음)
#                     "%s"를 하나 사용하여 동적 파일을 만들 수 있습니다.
#        Mode:        파일을 여는 모드(Type = File이면 optional2로 읽음)
#                     a - (이어 쓰기)
#                     w - (덮어쓰기)
#        MaxFileSize: 새 로그 파일을 만들기 전 로그 파일의 최대 크기
#                     (Type = File이면 optional3으로 읽음)
#                     크기는 64비트 부호 없는 정수로 표현한 바이트 단위입니다.
#                     최댓값은 4294967295(4 GB)입니다. 제한을 두지 않으려면 비워 두세요.
#        참고:          동적 파일 이름에서는 동작하지 않습니다.
#        예:           536870912 (512 MB)

Appender.Console=1,4,0,"1 9 3 6 5 8"
Appender.Server=2,5,0,Server.log,w
Appender.Playerbots=2,5,0,Playerbots.log,w
# Appender.GM=2,5,15,gm_%s.log
Appender.Errors=2,2,0,Errors.log,w
# WL 커스텀 개발 로그: WER 코드(mod-WER + WL 크래시 수정) 전용 WLDebug.log입니다.
Appender.WLDebug=2,5,0,WLDebug.log,w
# Appender.DB=3,5,0
# Appender.Dev=2,5,0,Dev.log,a

#    로거(Logger) 설정 값: 로거 이름이 "name"일 때
#    Logger.name
#        설명:         '무엇을 로그로 남길지' 정의합니다.
#        형식:         LogLevel,AppenderList
#        LogLevel:     0 - (비활성)
#                      1 - (Fatal, 치명적)
#                      2 - (Error, 오류)
#                      3 - (Warning, 경고)
#                      4 - (Info, 정보)
#                      5 - (Debug, 디버그)
#                      6 - (Trace, 추적)
#        AppenderList: 로거에 연결할 어펜더 목록
#                      (공백으로 구분).
#

Logger.root=2,Console Server
# Logger.metric=2,Console Server
# Logger.commands.gm=4,Console GM
Logger.diff=3,Console Server
Logger.mmaps=4,Server
Logger.scripts.hotswap=4,Console Server
Logger.server=4,Console Server
Logger.sql.sql=2,Console Errors
Logger.sql.updates=4,Console Server Errors
Logger.sql=4,Console Server
Logger.time.update=4,Console Server
Logger.module=4,Console Server
Logger.spells.scripts=2,Console Errors
Logger.playerbots=5,Console Playerbots
