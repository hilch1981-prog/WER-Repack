#    AllowTwoSide.Interaction.Chat
#        설명: 진영 간 일반 대화를 허용합니다.
#        기본값:      0 - (비활성)
#                     1 - (활성)

AllowTwoSide.Interaction.Chat = 0

#
#    AllowTwoSide.Interaction.Channel
#        설명: 진영 간 채널 채팅을 허용합니다.
#        기본값:      0 - (비활성)
#                     1 - (활성)

AllowTwoSide.Interaction.Channel = 0

#
#    AllowTwoSide.Interaction.Group
#        설명: 진영 간 파티 참여를 허용합니다.
#        기본값:      0 - (비활성)
#                     1 - (활성)

AllowTwoSide.Interaction.Group = 0

#
#    AllowTwoSide.Interaction.Guild
#        설명: 진영 간 길드 가입을 허용합니다.
#        기본값:      0 - (비활성)
#                     1 - (활성)

AllowTwoSide.Interaction.Guild = 0

#
#    AllowTwoSide.Interaction.Arena
#        설명: 진영 간 투기장 팀 가입을 허용합니다.
#        기본값:      0 - (비활성)
#                     1 - (활성)

AllowTwoSide.Interaction.Arena = 0

#
#    AllowTwoSide.Interaction.Auction
#        설명: 진영 간 경매를 허용합니다. 모든 경매장이 중립으로 설정되며,
#              경매 수수료도 중립 경매장 기준으로 떼어 갑니다.
#        기본값:      0 - (비활성)
#                     1 - (활성)

AllowTwoSide.Interaction.Auction = 0

#
#    TalentsInspecting
#        설명: 상대 진영 캐릭터를 살펴볼 수 있게 합니다.
#              GM 모드인 캐릭터에는 영향을 주지 않습니다.
#        기본값:      1 - (활성)
#                     0 - (비활성)

TalentsInspecting = 1

#
#    ChangeFaction.MaxMoney
#        설명: 진영 변경을 하기 위해 캐릭터가 소지할 수 있는 최대 골드.
#        기본값:       0 - 비활성
#                     >0 - 활성 (동화 단위 금액)
#        예:          10000으로 설정하면 캐릭터가 소지할 수 있는 최대 금액은 1 골드가 됩니다.

ChangeFaction.MaxMoney = 0

