#                     퀘스트 제공자 위의 느낌표(!)로 표시하지 않습니다.
#                     givers.
#        기본값:     7  - (활성, 캐릭터보다 7레벨을 초과해 높은 퀘스트를 숨김)

Quests.HighLevelHideDiff = 7

