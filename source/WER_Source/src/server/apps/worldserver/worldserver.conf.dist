Arena.MaxRatingDifference = 150

#
#    Arena.RatingDiscardTimer
#        설명: 경기 매칭 시 평점 차이를 무시하기 시작하는 시간(밀리초)입니다.
#        기본값:     600000 - (활성, 10분)
#                     0      - (비활성)

Arena.RatingDiscardTimer = 600000

#
#    Arena.PreviousOpponentsDiscardTimer
#        설명: 이전 상대를 무시하게 되는 시간(밀리초)입니다.
#        기본값:     120000 - (활성, 2분 - Blizzlike)
#                     0      - (비활성)

Arena.PreviousOpponentsDiscardTimer = 120000

#
#    Arena.AutoDistributePoints
#        설명: 투기장 점수를 자동으로 지급합니다.
#        기본값:     0 - (비활성)
#                     1 - (활성)

Arena.AutoDistributePoints = 1

#
#    Arena.AutoDistributeInterval
#        설명: 자동 지급이 활성화된 경우 투기장 점수를 지급하는 주기(일)입니다.
#        기본값:     7 - (매주)

Arena.AutoDistributeInterval = 7

#
#    Arena.GamesRequired
#        설명: 투기장 점수를 지급받으려면 팀이 참여해야 하는 투기장 경기 수입니다.
#        기본값:     10

Arena.GamesRequired = 10

#
#    Arena.QueueAnnouncer.Enable
#        설명: 투기장 대기열 상태를 채팅으로 알립니다.
#        기본값:     0 - (비활성)
#                     1 - (활성)

Arena.QueueAnnouncer.Enable = 0

#
#    Arena.QueueAnnouncer.PlayerOnly
#        설명: 투기장 대기열 알림 방식입니다.
#        기본값:     0 - (시스템 메시지, 누구나 볼 수 있음)
#                     1 - (개인 메시지, 대기열에 등록한 플레이어만 볼 수 있음)

Arena.QueueAnnouncer.PlayerOnly = 0

#
#    Arena.QueueAnnouncer.Detail
#        설명: 투기장 대기열에 등록한 팀에 대해 알릴 정보의 상세 수준입니다.
#        기본값:     3 - (팀 이름과 평점을 알림)
#                     2 - (팀 이름만 알림)
#                     1 - (팀 평점만 알림)
#                     0 - (팀 정보를 알리지 않음)

Arena.QueueAnnouncer.Detail = 3

#
#    Arena.ArenaStartRating
#        설명: 새 투기장 팀의 시작 평점입니다. (시즌 6 이상에 적용)
#        기본값:     0

Arena.ArenaStartRating = 0

#
#    Arena.LegacyArenaStartRating
#        설명: 새 투기장 팀의 시작 평점입니다. (시즌 1 - 5에만 적용)
#        기본값:     1500

Arena.LegacyArenaStartRating = 1500

#
#    Arena.ArenaStartPersonalRating
#        설명: 팀에 가입할 때의 시작 개인 평점입니다.
#        기본값:     0

Arena.ArenaStartPersonalRating = 0

