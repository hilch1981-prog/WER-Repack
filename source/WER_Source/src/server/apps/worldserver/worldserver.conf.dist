#                     LFG_OPTION_ENABLE_DUNGEON_FINDER  = 1, 던전 찾기 창 활성화
#                     LFG_OPTION_ENABLE_RAID_BROWSER    = 2, 공격대 찾기 창 활성화
#                     LFG_OPTION_ENABLE_SEASONAL_BOSSES = 4, 계절 이벤트 보스 활성화
#        기본값:     5

DungeonFinder.OptionsMask = 5

