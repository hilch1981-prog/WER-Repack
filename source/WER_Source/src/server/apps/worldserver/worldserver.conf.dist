#        기본값:     0 - (비활성)
#                     1 - (활성)

DungeonAccessRequirements.LFGLevelDBCOverride = 0

#
#    DungeonFinder.CastDeserter
#
#        설명: 던전을 중간에 떠난 플레이어에게 탈영병(Deserter) 효과를 겁니다.
#        기본값:     1 - (활성, Blizzlike)
#                     0 - (비활성)

DungeonFinder.CastDeserter = 1

#
#    DungeonFinder.AllowCompleted
#
#        설명: 완료한 영웅 던전을 LFG 대기열에서 제외할지 설정합니다.
#                     0 - (클래식 WLK 방식: 오늘 파티원 중 누구라도 완료한 던전은 제외됨(일일 귀속 적용))
#        기본값:     1 - (Blizzlike: 이미 완료했더라도 모든 던전을 대기열에 등록 가능)

DungeonFinder.AllowCompleted = 1

