#
#        설명: 다른 곳에서 LFG를 검색하도록 보조(satellite) 기능을 포함합니다.
#        기본값:     0 - 비활성
#                     1 - 활성

LFG.Location.All = 0

#
#    LFG.MaxKickCount
#        설명: LFG 파티에서 허용되는 최대 추방 횟수를 지정합니다(최대 3회).
#        기본값:     2
#                     0 - 비활성(추방 불가)

LFG.MaxKickCount = 2

#
#    LFG.KickPreventionTimer
#        설명: LFG 파티에 막 참여한 플레이어가 추방되지 않도록 보호하는 시간을 지정합니다.
#        기본값:     900 secs (15분)
#                     0 - 비활성

LFG.KickPreventionTimer = 900

#
#    DungeonAccessRequirements.LFGLevelDBCOverride
#
#        설명: 활성화하면 `dungeon_access_requirements` 테이블의 `min_level` 및 `max_level` 값을 사용해
