#                    32   - (비활성, 타우렌)
#                    64   - (비활성, 노움)
#                    128  - (비활성, 트롤)
#                    512  - (비활성, 블러드 엘프)
#                    1024 - (비활성, 드레나이)

CharacterCreating.Disabled.RaceMask = 0

