# 게임 설정 END                                                                               #
#                                                                                                 #
###################################################################################################

###################################################################################################
#                                                                                                 #
# 클러스터 설정 시작                                                                            #
#                                                                                                 #
###################################################################################################

###################################################################################################
# 클러스터 설정
#
# 이 기능은 실험적이며 아직 개발 중입니다. 클러스터 모드를 활성화하면 하나의 렐름에서 여러
# worldserver를 실행하여 부하를 분산할 수 있습니다. 정상적으로 작동하려면 worldserver 외에도
# 추가 서비스가 필요합니다. 문제가 발생하면 ToCloud9 프로젝트에 보고해 주세요:
# https://github.com/walkline/ToCloud9.
#
#    Cluster.Enabled
#        설명: 클러스터 모드를 활성화/비활성화합니다.
#              보안: 클러스터 모드에서는 ToCloud9 게이트웨이가 신뢰할 수 있는 인증 경계가 됩니다.
#              이 경우 worldserver는 세션 키 다이제스트 검증, 패킷 암호화, warden,
#              IP/국가 잠금, 차단 및 최소 보안 등급 적용, 로그인 시 캐릭터 소유권 검사를
#              건너뜁니다. worldserver 포트는 게이트웨이에서만 접근할 수 있어야 하며,
#              플레이어가 직접 접근할 수 있어서는 안 됩니다.
#        기본값: 0 - (비활성)
#                1 - (활성)

Cluster.Enabled=0

#
#    Cluster.AvailableMaps
#        설명:          이 서버에서 사용 가능한 맵 id 목록입니다.
#        예:           "" - (모든 맵 처리 가능)
#                     "0,1,573"

Cluster.AvailableMaps=""

#
#    Cluster.IsCrossrealm
#        설명:          크로스 렐름 구성을 위한 크로스 렐름 기능을 활성화합니다.
#                     활성화하면 MySQL 크로스 렐름 리버스 프록시에 연결되어 있어야 합니다.
#        기본값: 0 - (비활성)
#                 1 - (활성)

Cluster.IsCrossrealm=0

#
###################################################################################################

###################################################################################################
#                                                                                                 #
# 클러스터 설정 끝                                                                               #
#                                                                                                 #
###################################################################################################
