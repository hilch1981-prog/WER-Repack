#
#    Log.Async.Enable
#        설명:          비동기 메시지 로깅을 활성화합니다.
#        기본값:         0 - (비활성)
#                     1 - (활성)

Log.Async.Enable = 0

#
###################################################################################################

###################################################################################################
# 메트릭
#
# 이 설정들은 메트릭 데이터베이스(현재 InfluxDB)로 전송되는 통계를 제어합니다.
#
#    Metric.Enable
#        설명:          메트릭 데이터베이스로 통계 전송을 활성화합니다.
#        기본값:         0 - (비활성)
#                     1 - (활성)
#

Metric.Enable = 0

#
#    Metric.InfluxDB
#        설명:            InfluxDB 연결 설정입니다.
#        InfluxDB v1의 경우: Metric.InfluxDB.Connection만 입력하세요.
#        예:              Metric.InfluxDB.Connection = "hostname;port;database"
#        InfluxDB v2의 경우: 모든 항목을 입력하세요.
#        참고:            현재 제공되는 json 파일로는 Grafana에서 InfluxDB v2의 데이터를
#                         시각화할 수 없습니다.
#        예:              Metric.InfluxDB.Connection = "hostname;port"
#                         Metric.InfluxDB.v2 =         0 - (Disabled)
#                                                      1 - (활성)
#                         Metric.InfluxDB.Org =        "my-org"
#                         Metric.InfluxDB.Bucket =     "my-bucket"
#                         Metric.InfluxDB.Token =      "my-token"
#

Metric.InfluxDB.Connection = "127.0.0.1;8086;worldserver"
Metric.InfluxDB.v2 = 0
Metric.InfluxDB.Org = ""
Metric.InfluxDB.Bucket = ""
Metric.InfluxDB.Token = ""

#
#    Metric.Interval
#        설명:          각 데이터 묶음(batch)을 전송하는 간격(초)입니다.
#                     간격이 길수록 한 번에 보내는 데이터가 커집니다. 묶음이 너무 크면
#                     거부될 수 있습니다.
#        기본값:         1초

Metric.Interval = 1

#
#    Metric.OverallStatusInterval
#        설명:          worldserver 전체 상태 데이터를 수집하는 간격(초)입니다.
#        기본값:         1초

Metric.OverallStatusInterval = 1

#
#    메트릭 임계값 설정 값: 메트릭 이름이 "name"일 때
#    Metric.Threshold.name
#        설명:          값이 설정값보다 낮은 통계는 전송하지 않습니다.
#                     임계값을 주석 처리하면 해당 메트릭은 무시됩니다.
#                     소스에서 METRIC_DETAILED_TIMER로 기록되는 메트릭에만 적용됩니다.
#                     기본값은 비활성입니다. WITH_DETAILED_METRICS CMake 플래그가 필요합니다.
#
#        형식:          정수 값
#

#Metric.Threshold.world_update_sessions_time = 100
#Metric.Threshold.worldsession_update_opcode_time = 50

#
###################################################################################################

###################################################################################################
# 서버
#
#    BirthdayTime
#        설명:          프로젝트 탄생일을 UNIX 시간으로 설정합니다. 기본값은 2008년 10월 2일(목)입니다.
#        기본값:         1222964635

BirthdayTime = 1222964635

#
#    PlayerLimit
#        설명:          월드의 최대 플레이어 수입니다. 운영자(Mod), GM, 관리자(Admin)는 제외됩니다.
#        중요:          일반 플레이어를 막고 운영자, GM, 관리자만 서버에 접속하게 하려면
#                     DB 필드 "auth.realmlist.allowedSecurityLevel"을 사용하세요.
#        기본값:         1000 - (활성)
#                     1+   - (활성)
#                     0    - (비활성, 제한 없음)

PlayerLimit = 1000

#
#    World.RealmAvailability
#        설명:          활성화하면 플레이어가 정상적으로 렐름에 입장합니다.
#                     렐름이 비활성화되어 있어도 캐릭터 생성은 가능합니다.
#        기본값:         1 - (활성)
#                     0 - (비활성)

World.RealmAvailability = 1

#
#    GameType
#        설명:          서버 렐름 유형입니다.
#        기본값:         0  - (NORMAL)
#                     1  - (PVP)
#                     4  - (NORMAL)
#                     6  - (RP)
#                     8  - (RPPVP)
#                     16 - (FFA_PVP, 휴식 지역과 성역을 제외한 모든 지역에서 투기장처럼
#                          모두가 적인 PvP 모드)

GameType = 1

#
#    RealmZone
#        설명:          서버 렐름 지역입니다. 캐릭터 이름 등에 허용되는 문자 체계를 설정합니다.
#        기본값:         1  - (Development   - 모든 언어)
#                     2  - (United States - 확장 라틴 문자)
#                     3  - (Oceanic       - 확장 라틴 문자)
#                     4  - (Latin America - 확장 라틴 문자)
#                     5  - (Tournament    - 생성 시 기본 라틴 문자, 로그인 시 모두 허용)
#                     6  - (Korea         - 동아시아 문자)
#                     7  - (Tournament    - 생성 시 기본 라틴 문자, 로그인 시 모두 허용)
#                     8  - (English       - 확장 라틴 문자)
#                     9  - (German        - 확장 라틴 문자)
#                     10 - (French        - 확장 라틴 문자)
#                     11 - (Spanish       - 확장 라틴 문자)
#                     12 - (Russian       - 키릴 문자)
#                     13 - (Tournament    - 생성 시 기본 라틴 문자, 로그인 시 모두 허용)
#                     14 - (Taiwan        - 동아시아 문자)
#                     15 - (Tournament    - 생성 시 기본 라틴 문자, 로그인 시 모두 허용)
#                     16 - (China         - 동아시아 문자)
#                     17 - (CN1           - 생성 시 기본 라틴 문자, 로그인 시 모두 허용)
#                     18 - (CN2           - 생성 시 기본 라틴 문자, 로그인 시 모두 허용)
#                     19 - (CN3           - 생성 시 기본 라틴 문자, 로그인 시 모두 허용)
#                     20 - (CN4           - 생성 시 기본 라틴 문자, 로그인 시 모두 허용)
#                     21 - (CN5           - 생성 시 기본 라틴 문자, 로그인 시 모두 허용)
#                     22 - (CN6           - 생성 시 기본 라틴 문자, 로그인 시 모두 허용)
#                     23 - (CN7           - 생성 시 기본 라틴 문자, 로그인 시 모두 허용)
#                     24 - (CN8           - 생성 시 기본 라틴 문자, 로그인 시 모두 허용)
#                     25 - (Tournament    - 생성 시 기본 라틴 문자, 로그인 시 모두 허용)
#                     26 - (Test Server   - 모든 언어)
#                     27 - (Tournament    - 생성 시 기본 라틴 문자, 로그인 시 모두 허용)
#                     28 - (QA Server     - 모든 언어)
#                     29 - (CN9           - 생성 시 기본 라틴 문자, 로그인 시 모두 허용)

RealmZone = 6

#
#    DBC.Locale
#        설명:          DBC 언어 설정입니다.
#        기본값:         255 - (자동 감지)
#                     0   - (영어)
#                     1   - (한국어)
#                     2   - (프랑스어)
#                     3   - (독일어)
#                     4   - (중국어)
#                     5   - (대만어)
#                     6   - (스페인어)
#                     7   - (스페인어 - 멕시코)
#                     8   - (러시아어)

DBC.Locale = 1

#
#    Expansion
#        설명:          서버가 확장팩 콘텐츠를 사용할 수 있게 합니다. 확장팩 관련 맵 파일,
#                     클라이언트 호환성, 직업/종족 캐릭터 생성을 검사합니다.
#        기본값:         2 - (확장팩 2)
#                     1 - (확장팩 1)
#                     0 - (비활성, 확장팩 콘텐츠(맵, 종족, 직업)를 무시하고 비활성화)

Expansion = 2

#
#    ClientCacheVersion
#        설명:          클라이언트 캐시 데이터 초기화를 위한 클라이언트 캐시 버전입니다. 클라이언트 측
#                     캐시 초기화를 일으키려면 DB 값과 다르고 최근에 사용하지 않은 값을 사용하세요.
#        기본값:         0 - (world DB의 version.cache_id 필드 값 사용)

ClientCacheVersion = 0

#
#    SocketTimeOutTime
#        설명:          캐릭터 선택 화면에서 유휴 상태인 연결을 끊기까지의 시간(밀리초)입니다.
#        기본값:         900000 - (15분)

SocketTimeOutTime = 900000

#
#    SocketTimeOutTimeActive
#        설명:          월드에 접속한 상태에서 유휴 연결을 끊기까지의 시간(밀리초)입니다.
#                     클라이언트는 30초마다 keepalive 패킷을 보냅니다. 30초 이하의 값은 권장하지 않습니다.
#        기본값:         60000 - (1분)

SocketTimeOutTimeActive = 60000

#
#    MaxOverspeedPings
#        설명:          캐릭터 연결을 끊기 전까지 허용하는 과속(overspeed) 핑 횟수의 최댓값입니다.
#        기본값:         2  - (활성, 최솟값)
#                     3+ - (활성, 추방 전 더 많이 검사)
#                     0  - (비활성)

MaxOverspeedPings = 2

#
#    DisconnectToleranceInterval
#        설명:          연결이 끊긴 뒤 지정한 시간(초) 이내에 다시 접속하면 대기열을 건너뛸 수 있게 합니다.
#        기본값:         0

DisconnectToleranceInterval = 0

#
#    EnableLoginAfterDC
#        설명:          정상적으로 로그아웃하지 않으면(로그아웃을 누르고 20초 대기), 클라이언트 연결이
#                     끊겨도 캐릭터가 1분 동안 게임 월드에 남아 있습니다.
#                     이는 예를 들어 alt+f4로 보스 전투의 핵심 기술을 건너뛰거나, PvP에서 상대를
#                     피해 도망치는 악용을 막아 줍니다.
#                     이 설정은 월드에 남아 있는 캐릭터로 플레이어가 다시 로그인할 수 있는지를 정합니다.
#        기본값:         1 - ("월드 입장"을 누르면 이미 월드에 있는 캐릭터로 다시 로그인)
#                     0 - ("월드 입장"을 누르면 월드에 남아 있는 캐릭터에 로그인할 때 오류 메시지가 표시되며,
#                         캐릭터가 월드에서 제거될 때까지 1분을 기다려야 함)

EnableLoginAfterDC = 1

#
#    MinWorldUpdateTime
#        설명:          월드 업데이트 틱 사이의 최소 시간(밀리초)입니다(대부분 유휴 상태인 서버용).
#        기본값:         1 - (0.001초)

MinWorldUpdateTime = 1

#
#    UpdateUptimeInterval
#        설명:          렐름 가동 시간(uptime)을 갱신하는 주기(분)입니다.
#        기본값:         10 - (10분)
#                     1+

UpdateUptimeInterval = 10

#
#    MaxCoreStuckTime
#        설명:          서버가 멈췄을 때 강제로 크래시시키기까지의 시간(초)입니다.
#                     FreezeDetector
#        기본값:         0   - (비활성)
#                     10+ - (활성, 30+ 권장)
#        참고:          활성화한 상태에서 값이 너무 낮으면 예기치 않은 크래시가 발생할 수 있습니다.

MaxCoreStuckTime = 0

#    WER.CrashGuard.Enable
#        설명:          WL 크래시 가드(Windows 전용). 플레이어 업데이트 스크립트 틱 안에서 발생한
#                     하드웨어 예외(playerbot AI 엔진에는 업스트림에서 알려진 use-after-free 버그가 있음)가
#                     worldserver 전체를 죽이지 않도록 잡아냅니다. 문제가 된 틱은 건너뛰고,
#                     3회 연속으로 오류가 나면 해당 세션을 추방합니다. 잡아낸 모든 예외는
#                     "WER" 채널(WLDebug.log + Errors.log)에 눈에 띄게 기록됩니다. 이는
#                     피해를 막는 조치일 뿐이며, 근본 버그는 여전히 업스트림에서 수정해야 합니다.
#                     시작 시 한 번만 읽습니다(변경하려면 재시작).
#        기본값:         1 - (활성)
WowLegends.CrashGuard.Enable = 1

#
#    SaveRespawnTimeImmediately
#        설명:          생물이 죽을 때와 게임 오브젝트를 사용/열 때 리스폰 시간을 저장합니다.
#        기본값:         1 - (활성, 리스폰 시간을 즉시 저장)
#                     0 - (비활성, 그리드 언로드 시 리스폰 시간 저장)

SaveRespawnTimeImmediately = 1

#
#    Server.LoginInfo
#        설명:          로그인 시 코어 버전(.server info)을 표시합니다.
#        기본값:         0 - (비활성)
#                     1 - (활성)

Server.LoginInfo = 0

#
#    ShowKickInWorld
#        설명:          플레이어가 추방될 때 서버 전체에 메시지를 알릴지 정합니다.
#        기본값:         0 - (비활성)
#                     1 - (활성)

ShowKickInWorld = 0

#
#    ShowMuteInWorld
#        설명:          플레이어가 채팅 금지될 때 서버 전체에 메시지를 알릴지 정합니다.
#        기본값:         0 - (비활성)
#                     1 - (활성)

ShowMuteInWorld = 0

#
#    ShowBanInWorld
#        설명:          플레이어가 차단(ban)될 때 서버 전체에 메시지를 알릴지 정합니다.
#        기본값:         0 - (비활성)
#                     1 - (활성)

ShowBanInWorld = 0

#
#    MaxWhoListReturns
#        설명:          /who 목록과 인터페이스에 표시할 최대 플레이어 수를 설정합니다.
#        기본값:         49 - (안정적)

MaxWhoListReturns = 49

#
#    PreventAFKLogout
#        설명:          자리 비움(AFK) 상태의 플레이어가 로그아웃되지 않게 합니다.
#        기본값:         0 - (비활성)
#                     1 - (활성, 성역 지역에서 AFK 플레이어가 로그아웃되지 않음)
#                     2 - (활성, 모든 지역에서 AFK 플레이어가 로그아웃되지 않음)

PreventAFKLogout = 0

#
###################################################################################################

###################################################################################################
# 패킷 위조 방지 설정
#
#    PacketSpoof.BanMode
#        설명:          PacketSpoof.Policy가 2이면 차단 방식을 결정합니다.
#        값:           0 - 계정 차단
#                     1 - IP 차단
#        참고:          논리적인 이유로 캐릭터 단위 차단은 지원하지 않습니다.
#

PacketSpoof.BanMode = 0

#
#    PacketSpoof.BanDuration
#        설명:          차단 기간(초)입니다. PacketSpoof.Policy가 2일 때만 유효합니다.
#                     0으로 설정하면 영구 차단입니다.
#        기본값:         86400초(1일)
#

PacketSpoof.BanDuration = 86400

#
###################################################################################################

###################################################################################################
# WARDEN 설정
#
#    Warden.Enabled
#        설명:          Warden 핵 방지 시스템을 활성화합니다.
#        기본값:         1 - (활성)
#                     0 - (비활성)

Warden.Enabled = 1

#
#    Warden.NumMemChecks
#        설명:          주기마다 클라이언트로 보내는 Warden 메모리 검사 수입니다.
#        기본값:         3 - (활성)
#                     0 - (비활성)

Warden.NumMemChecks = 3

#
#    Warden.NumLuaChecks
#        설명:          주기마다 클라이언트로 보내는 Warden LUA 검사 수입니다.
#        기본값:         1 - (활성)
#                     0 - (비활성)

Warden.NumLuaChecks = 1

#
#    Warden.NumOtherChecks
#        설명:          검사 주기마다 요청에 추가하는, 메모리 검사 이외의 Warden 검사 수입니다.
#        기본값:         7 - (활성)
#                     0 - (비활성)

Warden.NumOtherChecks = 7

#
#    Warden.ClientResponseDelay
#        설명:          클라이언트가 응답하지 않을 때 연결을 끊기까지의 시간(초)입니다.
#        기본값:         600 - (10분)
#                     0 - (비활성, 클라이언트를 추방하지 않음)

Warden.ClientResponseDelay = 600

#
#    Warden.ClientCheckHoldOff
#        설명:          클라이언트에 다음 검사 요청을 보내기 전 대기 시간(초)입니다.
#                     값이 낮으면 클라이언트와 서버 양쪽의 트래픽과 부하가 늘어납니다.
#        기본값:         30 - (30초)
#                     0  - (가능한 한 빨리 검사 전송)

Warden.ClientCheckHoldOff = 30

#
#    Warden.ClientCheckFailAction
#        설명:          클라이언트 검사에 실패했을 때 수행할 기본 조치입니다. characters 데이터베이스의
#                     warden_action 테이블에서 검사별로 조치를 덮어쓸 수 있습니다.
#                     database.
#        기본값:         0 - (비활성, 기록만 함)
#                     1 - (추방)
#                     2 - (차단)

Warden.ClientCheckFailAction = 0

#
#    Warden.BanDuration
#        설명:          ClientCheckFailAction이 차단으로 설정된 경우 계정을 차단할 시간(초)입니다.
#        기본값:         86400 - (24시간)
#                     0     - (영구 차단)

Warden.BanDuration = 86400

#
###################################################################################################

###################################################################################################
# 자동 방송
#
#    AutoBroadcast.On
#        설명:          자동 공지를 활성화합니다.
#        기본값:         0 - (비활성)
#                     1 - (활성)

AutoBroadcast.On = 0

#
#    AutoBroadcast.Center
#        설명:          자동 공지 표시 방식입니다.
#        기본값:         0 - (Announce, 채팅 공지)
#                     1 - (Notify, 화면 알림)
#                     2 - (Both, 둘 다)

AutoBroadcast.Center = 0

#
#    AutoBroadcast.Timer
#        설명:          자동 공지 타이머(밀리초)입니다.
#        기본값:         60000 - (60초)

AutoBroadcast.Timer = 60000

#
#    AutoBroadcast.MinDisableLevel
#        설명:          EnablePlayerSettings 옵션이 활성화된 경우, 자동 공지를 끌 수 있는 최소 레벨입니다.
#        기본값:         0 - (끌 수 없음)

AutoBroadcast.MinDisableLevel = 0

#
###################################################################################################

###################################################################################################
# 표시 및 거리
#
#    Visibility.GroupMode
#        설명:          파티 가시성 모드입니다. 같은 공격대, 파티, 진영의 투명 상태 캐릭터를
#                     항상 감지할 수 있는 그룹을 정의합니다.
#        기본값:         1 - (공격대)
#                     0 - (파티)
#                     2 - (진영)

Visibility.GroupMode = 1

#
#    Visibility.Distance.Continents
#    Visibility.Distance.Instances
#    Visibility.Distance.BGArenas
#        설명:          다른 플레이어나 게임 오브젝트를 볼 수 있는 가시 거리입니다.
#                     정식 서버 기준 대륙에서는 약 100야드, 전장/투기장에서는 약 250입니다.
#                     인스턴스의 기본값은 약 170입니다.
#                     최대: 250
#                     최소 한계는 최대 어그로 반경(45) * Rate.Creature.Aggro 입니다.
#        기본값:         100 - (Visibility.Distance.Continents)
#                     170 - (Visibility.Distance.Instances)
#                     250 - (Visibility.Distance.BGArenas)

Visibility.Distance.Continents = 100
Visibility.Distance.Instances = 170
Visibility.Distance.BGArenas = 250

#
#    Visibility.ObjectSparkles
#        설명:          진행 중인 퀘스트와 관련된 게임 오브젝트에 반짝임 효과를 표시할지 정합니다.
#        기본값:         1 - (반짝임 표시)
#                     0 - (반짝임 숨김)

Visibility.ObjectSparkles = 1

#
#    Visibility.ObjectQuestMarkers
#        설명:          생물 퀘스트 제공자처럼 게임 오브젝트 위에도 퀘스트 아이콘을 표시합니다.
#        기본값:         1 - (퀘스트 표시 보이기, 2.3 패치 이후 방식)
#                     0 - (퀘스트 표시 숨기기, 2.3 패치 이전 방식)

Visibility.ObjectQuestMarkers = 1

#
###################################################################################################

###################################################################################################
# 맵
#
#    MapUpdateInterval
#        설명: 맵 업데이트 간격 시간(밀리초).
#        기본값:     10 - (0.01초)

MapUpdateInterval = 10

#
#    MapUpdate.Threads
#        설명: 맵을 업데이트할 스레드 수.
#        기본값:     1

MapUpdate.Threads = 1

#
#    MoveMaps.Enable
#        설명:          mmaps를 이용한 경로 탐색을 활성화/비활성화합니다 - 권장.
#        기본값:         0 - (비활성)
#                     1 - (활성)

MoveMaps.Enable = 1

#
#    vmap.enableLOS
#    vmap.enableHeight
#        설명:          시야 판정(LOS)과 높이 계산을 위한 VMmap 지원입니다.
#        기본값:         1 - (활성, vmap.enableLOS)
#                     1 - (활성, vmap.enableHeight)
#                     0 - (비활성)

vmap.enableLOS    = 1
vmap.enableHeight = 1

#
#    vmap.petLOS
#        설명:          소환수가 벽 너머로 공격하지 않도록 소환수의 시야를 검사합니다.
#        기본값:         1 - (활성, 소환수의 모든 공격마다 시야 검사)
#                     0 - (비활성, CPU 사용량이 약간 줄어듦)

vmap.petLOS = 1

#    vmap.BlizzlikePvPLOS
#        설명: 전장과 투기장의 게임 오브젝트 및 기타 장식물(예: 전쟁노래 협곡의 나무 그루터기)에 대해
#              시야를 검사합니다.
#        기본값:     1 - (활성, 플레이어가 나무 그루터기 등 오브젝트 너머로 주문을 시전할 수 있음)
#                    0 - (비활성, 플레이어가 나무 그루터기 등 오브젝트 너머로 주문을 시전할 수 없음)

vmap.BlizzlikePvPLOS = 1

#
#   vmap.BlizzlikeLOSInOpenWorld
#       설명: 열린 세계에서 게임 오브젝트에 대한 시야를 검사합니다.
#       기본값:     1 (활성, 열린 세계에서 플레이어가 나무 그루터기 등 오브젝트 너머로 주문을 시전할 수 있음)
#                   0 (비활성, 열린 세계에서 플레이어가 나무 그루터기 등 오브젝트 너머로 주문을 시전할 수 없음)

vmap.BlizzlikeLOSInOpenWorld = 1

#
#    vmap.enableIndoorCheck
#        설명: VMap 기반 실내 검사로 야외 전용 효과(탈것 등)를 제거합니다.
#        기본값:     1 - (활성)
#                    0 - (비활성, CPU 사용량이 약간 줄어듦)

vmap.enableIndoorCheck = 1

#
#    DetectPosCollision
#        설명: 최종 이동 위치, 소환 위치 등이 다른 오브젝트나 벽과 눈에 보이게 충돌하는지
#              검사합니다(벽은 vmaps가 활성일 때만).
#        기본값:     1 - (활성)
#                    0 - (비활성, 위치 정밀도는 낮아지지만 CPU 사용량이 줄어듦)

DetectPosCollision = 1

#
#    CheckGameObjectLoS
#        설명: 시야 검사에 동적 게임 오브젝트(문, 상자 등)를 포함합니다.
#              CPU 사용량이 다소 증가합니다.
#        기본값:     1 - (활성)
#                    0 - (비활성, 일부 우두머리 전투가 제대로 동작하지 않을 수 있음)

CheckGameObjectLoS = 1

#
#    PreloadAllNonInstancedMapGrids
#        설명: 인스턴스가 아닌 모든 맵의 그리드를 미리 불러옵니다. 추가 RAM이 매우 많이
#              필요하고(약 9 GB) 서버 시작 시간이 길어지지만, 플레이어가 많은 서버에서는
#              성능을 높일 수 있습니다.
#              또한 서버 시작 시 활성으로 설정된 모든 생물(예: 지옥불 반도의 지옥 절단기)을
#              활성화합니다.
#        기본값:     0 - (비활성)
#                    1 - (활성)

# ⭐ WL 안정성 권장 사항: 머신의 RAM이 16 GB 이상이면 이 옵션을 켜세요(=1). 시작할 때 모든 대륙
# 그리드를 미리 불러오면 실행 중에 그리드가 새로 생성되는 일이 전혀 없으므로, 이 코어의
# MapGridManager에 있는 스레드 간 그리드 생성 경쟁 상태가 사라집니다(인스턴스 맵이 다른 작업
# 스레드에서 상위 대륙 맵의 그리드를 생성하는 동안 읽는 쪽은 잠금이 풀려 있음. 실제로 드물게
# worldserver 크래시로 관찰됨). RAM이 약 6-9 GB 더 들고 첫 부팅이 느려지지만, 수백 개의 봇이
# 돌아다니면 어차피 대부분의 그리드가 로드되며, 로딩 끊김도 사라집니다.
PreloadAllNonInstancedMapGrids = 0

#
#     DontCacheRandomMovementPaths
#        설명: 랜덤 이동 경로(MoveMaps로 계산)를 캐시하여 CPU 시간을 절약할 수 있지만,
#              메모리를 상당히 많이 사용할 수 있으며 이 옵션을 1로 설정하면 캐시하지 않습니다.
#              사람이 많은 서버에서는 RAM을 충분히 확보하고 0으로 설정하는 것을 권장합니다.
#        기본값:     0 - (경로를 캐시함, 메모리를 더 사용)
#                    1 - (캐시하지 않음, CPU를 더 사용)

DontCacheRandomMovementPaths = 0

