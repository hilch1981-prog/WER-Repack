[worldserver]

########################################
# mod-dungeon-clear 설정
########################################
#
# 공략은 실행 중 `.dc on|off|skip|status|bosses` 명령이나 파티 채팅 키워드
# (`dc on`, `dungeon clear on`, …)로 제어하며 별도 설정이 필요하지 않습니다.
# 아래 설정은 동작, 디버깅, 경로 탐색을 조정합니다.
#
# 다시 빌드하지 않고 모듈 전체를 끄려면 DungeonClear.Enable = 0 으로 설정하고
# (모듈 마스터 스위치, 아래 첫 번째 섹션) worldserver를 재시작하세요.
#
# 플레이어별 재정의: 아래 일반 설정(GENERAL SETTINGS)은 서버 전체의 기본값입니다.
# DungeonClear 연동 애드온을 사용하는 플레이어는 자신의 던전 공략 동안 이 설정들을 재정의할 수
# 있습니다(재정의는 해당 파티의 리더 탱커 봇에 연결되며, 그 공략이 끝나면 폐기됩니다). 애드온은
# "DC" 애드온 채널에서 `set <key> <value>` / `reset [<key>]`로 재정의 값을 보내고,
# `sync`로 현재 적용 중인 값과 스키마를 읽어옵니다. 서버는 모든 재정의를 검증하고
# 레지스트리 범위 안으로 제한합니다(DcSettingsRegistry.h 참고). 여기에 적힌 값은 재정의가 없는
# 모든 사용자의 대체값으로 유지됩니다. 디버깅(DEBUGGING)과 고급 경로 탐색(ADVANCED PATHING)
# 설정은 서버 전용이며 재정의할 수 없습니다.
#
# 영웅 난이도: 영웅 난이도 던전 안에서 공략 중일 때는 몇몇 설정이 다른 내장 기본값을 사용합니다.
# 영웅 던전의 일반 몹은 성격이 다른 문제이기 때문입니다(모든 몹이 정예이고, 한 번 잘못된 규모로
# 끌면 공략이 끝납니다). 어떤 설정이든 키 뒤에 ".Heroic"을 붙이면 별도의 영웅 난이도 값을 줄 수
# 있습니다:
#
#     DungeonClear.PullDynamicMaxLeeroyMobs = 5          # normal difficulty
#     DungeonClear.PullDynamicMaxLeeroyMobs.Heroic = 2   # heroic difficulty
#
# 전체 적용 순서: 플레이어별 재정의 -> "<key>.Heroic"(영웅 공략에서만) -> 내장 영웅 기본값
# -> "<key>" -> 내장 기본값. 플레이어 재정의는 난이도를 구분하지 않고 두 영웅 계층보다 우선하므로,
# 누군가 자신의 공략에 설정한 값이 영웅 기본값에 의해 무시되는 일은 없습니다. 영웅 기본값이 내장된
# 모든 키는 일반 설정 끝의 HEROIC DEFAULTS 섹션에 나열되어 있으며, "<key>.Heroic" 줄을 적으면
# 그 값을 대체합니다.
#
# 공격대 맵: 같은 방식이 공격대 공략용으로 한 계층 위에도 있습니다. 키 뒤에 ".Raid"를 붙이면
# 공격대 값을 줄 수 있으며, 모든 공격대 맵(난이도 무관)에 적용되고 영웅 계층보다 우선합니다.
# 내장 공격대 기본값은 영웅 섹션 다음의 RAID DEFAULTS 섹션에 나열되어 있습니다. 전체 순서:
# 플레이어별 재정의 -> "<key>.Raid"(공격대 맵) -> 내장 공격대 기본값 -> "<key>.Heroic"(영웅급 맵)
# -> 내장 영웅 기본값 -> "<key>" -> 내장 기본값.

########################################
# 모듈 마스터 스위치
########################################

#
#    DungeonClear.Enable
#        1 (기본값): mod-dungeon-clear가 동작합니다.
#        0: 모듈은 컴파일·링크된 상태로 남지만 완전히 아무 일도 하지 않습니다.
#        mod-playerbots에 전략, 액션, 트리거, 값을 전혀 등록하지 않으므로 어떤 봇의 AI 엔진도
#        이를 참조할 수조차 없습니다. 어떤 봇에게도 "dungeon clear" / "dungeon clear combat"
#        전략이 부여되지 않고, 모든 `.dc` 명령어와 연동 애드온 버튼은 동작하는 대신
#        "module is disabled"라고 응답합니다. 또한 모듈이 가진 모든 훅(풀링 브레이크, 관전 카메라,
#        틱마다 도는 정리기, `.dc test` 테스트 하네스, 코어 버그 우회 스크립트 2개,
#        봇 자신 모드 전리품 주사위 재정의)이 아무것도 하지 않습니다.
#        봇은 모듈이 없을 때와 완전히 똑같이 행동합니다.
#
#        코드는 남겨 두어 다시 빌드하지 않고 켤 수 있게 하되, 동작은 끄고 싶을 때 사용하세요.
#
#        시작 시 한 번만 읽습니다. mod-playerbots 공유 컨텍스트에 대한 등록은 이미 생성된 봇이
#        참조로 보유하는 단방향 추가 작업이므로, 실행 중에 취소(또는 추가)할 수 없습니다.
#        이 값을 바꾸고 `.reload config`를 실행하면 경고가 기록될 뿐 아무것도 바뀌지 않습니다.
#        새 값을 적용하려면 worldserver를 재시작하세요. 이 파일의 다른 모든 설정은
#        `.reload config` 시 실행 중에도 반영됩니다.
#
#        기본값: 1
#

DungeonClear.Enable = 1

########################################
#        일반 설정(플레이어별 재정의 가능, 위 안내 참조)
########################################

#
#    DungeonClear.PreventBotRelease
#        1 (기본값): 던전 또는 공격대 맵에서 죽은 봇은 묘지로 자동 영혼 해방하지 않고
#        부활(부활 주문, 영혼석, 소환 후 부활)될 때까지 시체 상태로 남습니다. 따라서 전멸하더라도
#        시체 달리기나 부활로 복구할 수 있습니다. 인스턴스 안의 모든 봇에 적용됩니다(공략은 누군가
#        죽으면 자동으로 비활성화되므로 진행 중인 공략에만 묶을 수 없습니다). 야외 필드에서 죽은 봇은
#        항상 기본 자동 영혼 해방을 사용합니다. 0이면 모든 곳에서 기본 자동 영혼 해방으로 되돌립니다.
#        `.reload config` 시 실행 중에도 반영됩니다. 끼임 방지용 강제 부활 안전장치(지형에 끼었거나
#        월드 밖으로 나간 죽은 봇)는 어느 쪽이든 계속 동작합니다.
#
#        기본값: 1
#

DungeonClear.PreventBotRelease = 1

#
#    DungeonClear.RecordDecisions
#        진단용. 0 (기본값): 끔. 1: 보스 접근 판단(순수 DecideApproach 관찰값 + 탱커가 실제로
#        따른 판정)을 매번 JSON 한 줄로 캡처 파일에 추가합니다. 실제 서버에서 발생한 멈춤/끊김을
#        영구적인 오프라인 회귀 테스트 자료로 만들 때 사용합니다: 이 설정을 켜고 문제를 재현한 뒤,
#        캡처된 줄을 리플레이 하네스에 넣으세요(t/replay_decisions.cpp가 모든 줄에 대해
#        DecideApproach(obs) == verdict 인지 확인합니다). 캡처는 이미 수집된 구조체를 추가 기록만
#        하므로 부담은 무시할 만하지만, 일반 플레이에서는 꺼 두세요.
#        경로: worldserver 작업 디렉터리의 dungeonclear_decisions.jsonl이며,
#        DUNGEONCLEAR_DECISIONS_FILE 환경 변수로 바꿀 수 있습니다.
#
#        기본값: 0
#

DungeonClear.RecordDecisions = 0

#
#    DungeonClear.LootMinQuality
#        획득할 가치가 있는 최소 아이템 등급입니다. 이 기준 미만의 아이템만 있는
#        시체는 우회하지 않고 건너뜁니다. 퀘스트 아이템은 항상 획득 대상입니다.
#        기준이 0보다 크면 돈만 있는 시체도 건너뛰어, 자잘한 골드를 포기하는 대신
#        더 빠르게 공략합니다.
#            0 = 하급(회색) (잡템 동전까지 모두 획득 — 기존 동작)
#            1 = 일반(흰색)   2 = 고급(녹색)
#            3 = 희귀(파란색)   4 = 영웅(보라색)
#
#        기본값: 0
#

DungeonClear.LootMinQuality = 0

#
#    DungeonClear.BetterLootRolling
#        mod-playerbots의 파티 전리품 자동 주사위 처리에 대한 여러 개선 사항을
#        한꺼번에 켜고 끄는 주 스위치입니다. 기본값은 꺼짐(기존 주사위 처리)입니다.
#
#        첫 번째 개선: "bot self" 모드(내 캐릭터가 자동 조종으로 움직이는 모드)로 플레이할 때,
#        봇이 파티 전리품에 자동으로 입찰/차비 주사위를 굴리지 않습니다. 봇과 내가 캐릭터 GUID
#        하나를 공유하기 때문에, 그렇지 않으면 봇의 자동 주사위가 내 것으로 집계되어 내 주사위 창이
#        무의미해지고 주사위가 두 번 굴려집니다. 이 설정을 켜면 bot-self 모드에서는 나만 전리품
#        주사위를 굴립니다. 별도의 사람 주인이 있는 봇은 영향을 받지 않고 이전처럼 주사위를 굴립니다.
#
#        두 번째 개선: 봇이 앞으로 착용하게 될 장비에도 주사위를 굴립니다. 기본 동작에서는 요구 레벨이
#        봇의 현재 레벨보다 높은 무기/방어구에는, 그 봇의 미래 업그레이드라 해도 차비를 굴리거나
#        포기합니다. 이 설정을 켜면 레벨 요구 사항 때문에만 막힌 아이템은 봇이 이미 그 레벨인 것처럼
#        판단합니다: 그때까지 봇이 해당 숙련을 갖게 되고(40레벨에 풀리는 사슬/판금도 고려함) 능력치가
#        전문화에 맞으면 입찰, 그렇지 않으면 차비를 선택합니다. 서버의 LootNeedRollLevel /
#        LootGreedRollLevel 정책과 고유 착용 확인은 평소대로 적용됩니다.
#
#        세 번째 개선: 봇이 즉시 주사위를 굴립니다. 기본 playerbots는 대기 중인 주사위를 무작위
#        타이머로 확인하므로(AiPlayerbot.RepeatDelay마다 3분의 1 확률로 확인), 봇이 열린 주사위 창을
#        몇 초씩 바라보다가 투표하는 경우가 많습니다. 이 설정을 켜면 봇은 창이 열린 직후의 다음 AI
#        틱에 입찰/차비/포기를 선택합니다.
#            0 = 기존 playerbots 주사위 방식 (기본값)
#            1 = 위에서 설명한 개선된 주사위 방식
#
#        기본값: 0
#

DungeonClear.BetterLootRolling = 0

#
#    DungeonClear.IgnoreChests
#        활성화하면 탱커가 공략 중 보물 상자(및 바닥의 다른 모든 월드 오브젝트)를
#        무시하고 생물의 시체에만 멈춥니다. 파티에 필요 없는 상자로 우회하거나
#        상자 주변에서 길을 찾다가 끼이는 것을 막습니다. 끄면 경로상 도달 가능한
#        상자도 획득하던 이전 동작으로 돌아갑니다.
#            0 = 상자도 획득      1 = 상자 무시 (시체만)
#
#        기본값: 1 (상자 무시)
#

DungeonClear.IgnoreChests = 1

#
#    DungeonClear.DoorBlockedTimeout
#        탱커가 닫힌 문 하나를 상대로(클릭하거나 옆에서 대기하며) "Blocked by a door" 상태에 머물 수
#        있는 시간(초)입니다. 이 시간이 지나면 포기하고 공략을 자동 일시정지하며, 열 수 없다고 알고 있는
#        문과 같게 처리합니다. 잠금 템플릿 검사가 잘못 판단하는 문을 잡아냅니다 — 평범한 클릭형 문처럼
#        보이는 이벤트 관문(그림자송곳니 성채의 관문 3개가 알려진 사례이며 이제 엔트리 기준 차단 목록에
#        들어 있지만, 다음 던전의 관문은 그렇지 않을 것입니다), 그리고 클릭 가능한 기준점이 경로 끝에서
#        닿지 않는 곳에 있는 넓은 관문 등입니다.
#        일시정지는 해당 문을 기억하므로, 문이 실제로 열리는 순간(이벤트가 완료되거나 플레이어가
#        열었을 때) 공략이 자동으로 재개됩니다.
#
#        기본값: 5
#

DungeonClear.DoorBlockedTimeout = 5

#
#    DungeonClear.RestHealthPct
#        던전 정리 중 전투 사이에 파티가 채우는 생명력 %로, 공략 동안 mod-playerbots의
#        AiPlayerbot.AlmostFullHealth를 대체합니다. 봇은 이 값까지 음식을 먹고, 탱커는 모두가 이 값에
#        도달할 때까지 전진을 멈춥니다. 그래서 파티가 볼 수 없는 playerbots 설정을 건드리지 않고도
#        서버 전체 기본값보다 더 충분히 쉬거나(또는 더 빠르게 몰이) 할 수 있습니다.
#            0 = AiPlayerbot.AlmostFullHealth 값을 따름 (재정의 안 함)
#            1-100 = 생명력이 이 %가 될 때까지 음식 섭취/대기
#
#        기본값: 0 (상속)
#

DungeonClear.RestHealthPct = 0

#
#    DungeonClear.RestManaPct
#        던전 정리 중 전투 사이에 파티가 채우는 마나 %로, 공략 동안 mod-playerbots의
#        AiPlayerbot.HighMana를 대체합니다. 봇은 이 값까지 물을 마시고, 탱커는 마나를 쓰는 모든
#        구성원이 이 값에 도달할 때까지 전진을 멈춥니다.
#            0 = AiPlayerbot.HighMana 값을 따름 (재정의 안 함)
#            1-100 = 마나가 이 %가 될 때까지 음료 섭취/대기
#
#        기본값: 0 (상속)
#

DungeonClear.RestManaPct = 0

#
#    DungeonClear.SmartRest
#        히스테리시스 휴식 주기. 켜면 파티는 누군가(아무나)가 역할별 기준치
#        (SmartRestHealthPct / SmartRestDpsManaPct / SmartRestHealerManaPct) 아래로 떨어질 때까지
#        먹거나 마시지 않고 계속 전진합니다 — 그러면 파티 전체가 멈추고 생명력과 마나를 가득 채운 뒤에
#        다시 전진합니다. 잦은 짧은 휴식 대신 적지만 긴 휴식을 합니다.
#        보스 풀링은 예외로 처리합니다: 보스 앞에서는 기준치와 관계없이 항상 마나를 ~90%까지 채운 뒤
#        풀링하므로, 어려운 보스를 일반 몹 기준치를 겨우 넘긴 파티로 시작하는 일은 없습니다.
#        켜져 있는 동안에는 기존 RestHealthPct/RestManaPct 목표값은 무시됩니다.
#        연동 애드온에서 공략별로 재정의할 수 있습니다.
#            0 = 끔 (기존 휴식 동작)
#            1 = on
#
#        기본값: 0
#

DungeonClear.SmartRest = 0

#
#    DungeonClear.SmartRestHealthPct
#        Smart Rest 전용. 어떤 파티원이든(역할 무관) 생명력이 이 % 아래로 떨어지면
#        완전 휴식 정지가 발생합니다.
#            0 = 생명력 조건 비활성
#
#        기본값: 50
#

DungeonClear.SmartRestHealthPct = 50

#
#    DungeonClear.SmartRestDpsManaPct
#        Smart Rest 전용. 마나를 쓰는 DPS 또는 탱커의 마나가 이 % 아래로 떨어지면 완전 휴식 정지가
#        발생합니다. 탱커도 이 기준을 함께 씁니다: 보호 성기사는 전투 중에 마나를 회복하며, 어차피
#        치유사가 유발한 휴식마다 마나를 채웁니다.
#            0 = DPS/탱커 마나 조건 비활성
#
#        기본값: 10
#

DungeonClear.SmartRestDpsManaPct = 10

#
#    DungeonClear.SmartRestHealerManaPct
#        Smart Rest 전용. 치유사의 마나가 이 % 아래로 떨어지면 완전 휴식 정지가 발생합니다.
#        DPS 기준보다 높습니다 — 치유사의 마나량이 곧 파티의 안전 여유이기 때문입니다.
#            0 = 치유사 마나 조건 비활성
#
#        기본값: 40
#

DungeonClear.SmartRestHealerManaPct = 40

#
#    DungeonClear.PostCombatRez
#        사망 시 공략을 끝내지 않고 복구합니다. 켜면 파티원이 죽어도 전투가 끝나는 순간 던전 정리가
#        비활성화되지 않습니다: 살아 있는 구성원 중 부활 가능한 직업(사제, 성기사, 주술사, 드루이드)이
#        있으면 공략은 제자리에서 대기하고, 부활 담당 봇이 시체로 걸어가 부활을 시전합니다(죽은 봇은
#        자동 수락, 죽은 플레이어에게는 일반 수락 창이 뜹니다). 아무도 죽어 있지 않게 되면 공략이
#        재개되며, 막 부활한 구성원의 낮은 생명력/마나 때문에 탱커는 회복될 때까지 평소의 전투 간 휴식
#        기준에서 대기합니다. 부활할 수 있는 사람이 나뿐이라면 파티는 대기하며 나에게 부활을 요청합니다.
#        전멸했을 때, 살아 있는 구성원 중 부활 가능한 사람이 없을 때, 또는 복구가 아래 제한 시간을
#        넘겼을 때는 여전히 공략이 비활성화됩니다.
#        연동 애드온에서 공략별로 재정의할 수 있습니다.
#            0 = 끔 (예전처럼 누구든 죽으면 즉시 공략이 비활성화됨)
#            1 = on
#
#        기본값: 1
#

DungeonClear.PostCombatRez = 1

#
#    DungeonClear.PostCombatRezTimeoutSecs
#        전투 후 부활 전용. 공략이 포기하고 비활성화되기 전까지 복구에 쓸 수 있는 비전투 시간(초)입니다
#        (전투 중에는 시계가 멈추므로, 복구 도중 추가 몹이 끌려와도 시간이 소모되지 않습니다).
#        기본값이 넉넉한 이유: 부활 담당자가 시전에 필요한 마나를 다시 마시는 시간과, 요청을 받은
#        사람이 시체를 찾아가는 시간까지 포함해야 하기 때문입니다.
#
#        기본값: 90
#

DungeonClear.PostCombatRezTimeoutSecs = 90

#
#    DungeonClear.StrandedRecovery
#        고립된 파티원 복구 안전장치. 현재 공략이 멈추는 가장 흔한 원인은 파티원이 월드 지형을 뚫고
#        떨어지는 경우(또는 내비메시가 복구할 수 없는 곳에 끼는 경우)입니다: 그 구성원이 범위를 벗어나고,
#        전투 간 산개 확인이 따라올 때까지 탱커를 계속 붙잡아 공략 전체가 멈춥니다. 켜면, 진행이 전혀
#        없는 상태 — 완료된 보스/목표가 없고 탱커가 다음 기준점에 가까워지지도 않는 상태 — 가
#        StrandedRecoveryNoProgressSecs 동안 이어지고 봇 구성원이 탱커로부터 PartyMaxSpread보다 먼 곳에
#        끼어 있으면, 그 구성원을 탱커에게 순간이동시킵니다(봇만 해당, 사람은 절대 옮기지 않습니다).
#        전투가 시계를 초기화하므로(전투도 진행으로 간주) 긴 보스전에서는 발동하지 않습니다.
#            0 = 끔 (끼인 구성원이 있으면 직접 개입할 때까지 공략이 멈춤)
#            1 = on
#
#        기본값: 1
#

DungeonClear.StrandedRecovery = 1

#
#    DungeonClear.StrandedRecoveryNoProgressSecs
#        고립 복구 전용. 안전장치가 범위 밖에 끼인 구성원을 탱커에게 순간이동시키기 전에, 공략이 진행 없이
#        지속되어야 하는 시간(초)입니다. 일부러 길게 잡았습니다: 정상적으로 느린 풀링, 전투 간 휴식,
#        오래 걸리는 전투 중에는 절대 발동하면 안 되고 진짜 멈춤에서만 발동해야 합니다. 시계는 살아 있다는
#        신호(보스/목표 완료, 탱커가 다음 기준점에 가까워짐, 또는 어떤 전투든)가 있으면 초기화되므로,
#        실제로 끼어 버린 공략만 시간이 다 됩니다.
#
#        기본값: 60 (1분)
#

DungeonClear.StrandedRecoveryNoProgressSecs = 60

#
#    DungeonClear.UnreachableCombatPurgeSecs
#        "공략이 멈춤"의 나머지 절반. 범위 밖에 고립된 파티원이 아니라, 파티를 전투 상태로 잡고 있으면서
#        죽일 수도, 닿을 수도, 귀환(evade)하지도 않는, 도달 불가 위치에 고립된 몹의 경우입니다 —
#        군드랔의 드라카리 약탈자가 이 기능이 존재하는 이유입니다: SmartAI가 그중 셋을 돌진 도중
#        16야드 낭떠러지 아래 물속으로 튕겨 내고, 떨어진 곳을 귀환 위치로 설정합니다. 인스턴스 생물은
#        추적 거리 제한이 없고 귀환 위치가 바뀐 몹은 돌아갈 곳이 없으므로, 코어의 어떤 것도 그 전투를
#        끝내지 못합니다: 파티는 전투 상태로 남고, 풀링 FSM은 단계를 종료하지 못하며, 아무도 먹거나
#        마실 수 없고, 정리는 그 자리에서 멈춥니다.
#
#        그런 몹의 전투와 위협 수준을 제거하기 전에, 공략이 진행 없이 지속되어야 하는 시간(초)입니다.
#        제거된 몹의 엔트리는 같은 시간 동안 대상 선택에서 제외됩니다. 이 시계는 위의 고립 복구 시계와
#        달리 전투 여부를 무시합니다 — 끝나지 않는 전투 자체를 감지하는 것이므로, 전투로 초기화되는
#        시계라면 결코 발동할 수 없기 때문입니다.
#
#        DcCombatPurgeRegistry에 직접 등록된 생물만 제거될 수 있으므로(현재 한 줄: 군드랔의 드라카리
#        약탈자), 이 시간은 무엇을 제거할지가 아니라 교착 상태가 얼마나 지속된 뒤에 안전장치가
#        대응할지만 결정합니다.
#            0 = 끔 (도달할 수 없는 보유자가 있으면 직접 개입할 때까지 공략이 멈춤)
#
#        기본값: 60 (1분)
#

DungeonClear.UnreachableCombatPurgeSecs = 60

#
#    DungeonClear.WaitAtBoss
#        매 보스 풀링 직전에 공략을 자동 일시정지하고, 사용자가 재개할 때까지(애드온의 Pause/Resume
#        버튼 또는 `dc pause`) 기다립니다. 일시정지는 다른 준비가 모두 끝난 뒤에 걸립니다 — 방 사전 정리,
#        전리품 획득, Smart Rest 채우기 완료 — 따라서 재개하면 바로 풀링합니다.
#        보스마다 공략당 한 번만 대기합니다. 재개하거나, `dc go`를 쓰거나, 대기 후 다시 접근해도 같은
#        보스에서 다시 일시정지하지 않습니다. 연동 애드온에서 공략별로 재정의할 수 있습니다.
#            0 = 끔 (탱커가 신호 없이 보스를 끌어옴)
#            1 = on
#
#        기본값: 0
#

DungeonClear.WaitAtBoss = 0

#
#    DungeonClear.PartyMaxSpread
#        공략 중 탱커가 파티원보다 앞설 수 있는 최대 거리(야드)입니다. 이를 넘으면
#        전진을 멈추고 모두가 따라올 때까지 기다립니다. 낮으면 탱커가 더 자주 멈추는
#        대신 파티가 더 밀집되고(안전한 풀링, 낙오 감소), 높으면 탱커가 더 멀리
#        앞서 나갈 수 있습니다.
#
#        기본값: 25.0
#

DungeonClear.PartyMaxSpread = 25.0

#
#    DungeonClear.CombatRegroup
#        1 (기본값): 전투 중, 추종자가 현재 위치에서 정말로 기여할 수 없을 때만 전투에 다시 합류시킵니다 —
#        보이는 대상이 없는 DPS(적 무리가 모퉁이 너머/시야 밖에 있음)나, 피해가 들어오는 순간 탱커를
#        치유할 수 없는 곳에 서 있는 치유사가 해당합니다. 그러면 탱커 위가 아니라, 전투에 대한 시야가
#        확보된 역할별 적정 거리 지점(원거리 DPS는 주문 사거리 원 위의 지점, 치유사는 탱커 근처의 치유
#        사거리 지점)으로 걸어갑니다. 추종자 자신의 전투 로테이션이 이미 할 수 있는 행동이 그 틱에서
#        우선합니다 — 이것은 목줄이 아니라 보조 재합류 기능이므로, 더 이상 근접 캐릭터를 처치 중에
#        끌어내거나 원거리 시전자를 방해하지 않습니다. 고급 풀링 캠프에서 파티가 대기(passive) 상태일
#        때는 동작하지 않습니다(그곳의 위치는 캠프 액션이 담당합니다). 0이면 끄고 기본 전투 이동을 씁니다.
#
#        기본값: 1
#

DungeonClear.CombatRegroup = 1

#
#    DungeonClear.CombatRegroupDistance
#        강제 외곽 제한 거리(야드): 추종자가 리더 탱커로부터 이만큼 멀어지면 위의
#        기여 가능 여부 판정과 관계없이 다시 합류합니다. 엉뚱한 곳으로 이탈하거나
#        너무 뒤처졌을 때의 안전장치입니다(반복 발동 억제와 재사용 대기시간 무시).
#        낮으면 떠도는 추종자를 더 빨리 복귀시키고, 높으면 근접 공격자가 도망가는
#        몬스터를 더 멀리 추격한 뒤 복귀합니다. 다음 경우에는 효과가 없습니다:
#        CombatRegroup = 0.
#
#        기본값: 40.0
#

DungeonClear.CombatRegroupDistance = 40.0

#
#    DungeonClear.CombatRegroupSlack
#        사전 위치 판정에서 치유 담당의 치유 사거리에서 빼는 거리(야드)입니다. 치유
#        담당은 탱커와의 거리가 (치유 사거리 - 여유 거리)보다 멀면 다시 합류하므로,
#        탱커가 조금 움직였다고 곧바로 사거리 밖으로 벗어나지 않습니다. 높으면
#        치유 담당이 탱커에 더 가깝게 붙습니다. 다음 경우에는 효과가 없습니다:
#        CombatRegroup = 0.
#
#        기본값: 8.0
#

DungeonClear.CombatRegroupSlack = 8.0

#
#    DungeonClear.CombatRegroupCooldown
#        전투 재집결이 재합류를 마친 뒤 다시 발동 가능해지기까지 기다리는 시간(초)으로,
#        잠깐 시야가 끊겼다고 추종자가 반복해서 오가지 않게 합니다.
#        강제 외곽 제한(CombatRegroupDistance)은 이 대기시간을 무시합니다. 0이면
#        즉시 다시 발동 가능합니다. CombatRegroup = 0이면 효과가 없습니다.
#
#        기본값: 5.0
#

DungeonClear.CombatRegroupCooldown = 5.0

#
#    DungeonClear.HealReposition
#        치유 담당 시야 재배치 수정의 주 스위치입니다. 기존 봇은 시야 밖 파티원을
#        치유 대상 목록에서 완전히 제외하므로, 탱커가 시야 밖으로 끌려가면 치유 담당은
#        치유를 멈출 뿐 아니라 시야 안으로 돌아오지도 않습니다. 켜면 가장 많이 다친
#        치유 대상의 생명력이 HealRepositionHpFloor보다 낮은데 현재 위치에서 치유할 수
#        없을 때(시야 밖 또는 치유 사거리 밖), 치유 담당이 시야와 치유 사거리가
#        확보되는 지점으로 이동한 뒤 자동으로 치유를 재개합니다.
#        1 = on, 0 = off.
#
#        기본값: 1
#

DungeonClear.HealReposition = 1

#
#    DungeonClear.HealRepositionHpFloor
#        치유 대상의 생명력이 이 백분율보다 낮을 때만 위치 이동이 발동합니다
#        ("실제로 치유가 필요함" 조건). 높을수록 더 적극적으로 위치를 옮깁니다.
#
#        기본값: 90.0
#

DungeonClear.HealRepositionHpFloor = 90.0

#
#    DungeonClear.HealRepositionTankBias
#        치유 담당이 따라갈 대상을 고를 때 선출된 리더 탱커에게 주는 생명력 백분율
#        가산치입니다. 보통 시야 밖으로 끌려 나가는 파티원이 탱커이기 때문입니다.
#        0이면 가산하지 않습니다(순수하게 생명력이 가장 낮은 대상).
#
#        기본값: 15.0
#

DungeonClear.HealRepositionTankBias = 15.0

#
#    DungeonClear.HealRepositionMaxRange
#        치유 대상과의 거리가 이 값(야드)을 넘으면 치유 담당은 위치를 옮기지 않습니다.
#        그만큼 먼 경우는 위치 이동이 아닌 전멸/건너뛰기 상황으로 취급합니다.
#
#        기본값: 60.0
#

DungeonClear.HealRepositionMaxRange = 60.0

#
#    DungeonClear.DynamicAggroRange
#        1 (기본값): "막고 있는 일반 몹" 검색 범위와 보스 교전 인계 거리를 하나의 고정 거리 대신 각
#        생물의 실제 어그로 범위(코어 자체의 레벨 보정 감지 반경)로 정합니다.
#            - 일반 몹: 어그로 반경이 큰 거대 정예 몹이 경로선에서 몇 야드 떨어져 있어도 잡아내고,
#              경로선 바로 옆의 어그로 범위가 작은 주변 몹은 더 이상 끌지 않습니다.
#            - 보스: 어그로 범위가 작은 보스는 인계 거리가 짧아져, 풀링 전까지 부드러운 접근 이동으로
#              탱커가 대부분의 거리를 다가갑니다 — 그런 보스에게 느리게 끊기며 다가가던 문제를 고칩니다.
#        0: 모든 경우에 고정된 기존 범위(일반 몹 18yd, 보스 22yd)를 사용합니다.
#
#        기본값: 1
#

DungeonClear.DynamicAggroRange = 1

#
#    DungeonClear.AggroRangeMargin
#        전투 개시 전환 거리를 계산할 때 우두머리의 어그로 범위에 더하는 거리(야드)로,
#        우두머리가 스스로 전투를 시작하기 직전에 전투 개시 조건이 발동하도록 합니다.
#        DynamicAggroRange = 1일 때만 사용합니다.
#
#        기본값: 2.0
#

DungeonClear.AggroRangeMargin = 2.0

#
#    DungeonClear.ClearRoomBeforeBoss
#        1 (기본값): 교전하는 순간 방 전체를 전투에 끌어들이는 몇몇 보스(스크립트된 CallForHelp /
#        그리드 풀링 — 예: 붉은십자군 수도원 대성당의 모그레인, 어둠의 미궁의 검은마음,
#        마나 무덤의 판데모니우스, 검은바위 나락의 황제 다그란)의 경우, 풀링 시 전체 무리를 한꺼번에
#        받는 대신 탱커가 보스를 풀링하기 전에 그 방을 먼저 정리합니다. 방의 범위는 살아 있는 보스를
#        중심으로 한 스크립트 자체의 반경 구체입니다. 보스에 너무 붙어 있어 떼어낼 수 없는 몹은 보스와
#        함께 오도록 둡니다. 정리는 선택한 풀링 방식을 따릅니다(Off/Leeroy는 걸어 들어가 무리마다 탱킹,
#        Advanced/Dynamic은 보스에서 떨어진 안전한 캠프로 끌어옵니다). 0이면 끕니다 — 이 기능 이전처럼
#        방의 몹이 살아 있는 채로 보스를 풀링합니다.
#
#        기본값: 1
#

DungeonClear.ClearRoomBeforeBoss = 1

#
#    DungeonClear.RoomClearTimeout
#        방을 정리하기 위해(ClearRoomBeforeBoss 참고) 탱커가 우두머리 풀링을 미룬 채
#        남은 적 수가 줄지 않는 상태로 기다리는 시간(초)입니다. 이 시간이 지나면
#        포기하고(채팅으로 알림) 우두머리를 풀링합니다. 도달할 수 없는 낙오 몬스터나
#        재생성 때문에 수가 줄지 않아 무한 정체되는 것을 막습니다. 실제로 진척이
#        있으면 타이머가 다시 시작됩니다.
#            0 = 절대 포기하지 않음 (권장하지 않음 — 무한 정체될 수 있음)
#
#        기본값: 원본(upstream)은 30. WER는 180 유지(WL 1.5.3 값: 느린 무리와 전투 간
#        물 마시기/휴식까지 견뎌야 함. 기존 30초는 탱커가 방에 도착하기도 전에 발동했음).
#        upstream 29c53fd에 병합, 2026-09-16.
#

DungeonClear.RoomClearTimeout = 180

#
#    DungeonClear.RoomAggroPathPadding
#        방 어그로 보스의 회피 구체에 더하는 추가 거리(야드)로, 사전 정리 중 탱커가 일반 몹 무리에
#        가기 위해 보스를 돌아갈 때 적용됩니다. 방 일반 몹 제외 구체는 보스의 정확한 어그로 범위 +
#        접촉 거리 + AggroRangeMargin 입니다. 돌아가는 접근 경로는 여기에 이 여유를 더해, 탱커가 어그로
#        경계를 스치며 보스를 깨우는 대신(붉은십자군 수도원 대성당 / 모그레인 실패 사례) 어그로 범위
#        밖으로 넉넉하게 돌아가게 합니다. 탱커가 여전히 보스를 건드리면 올리고, 구체에 더 바짝 붙게
#        하려면 낮추세요.
#
#        기본값: 3.0
#

DungeonClear.RoomAggroPathPadding = 3.0

#
#    DungeonClear.RoomAggroPartyMargin
#        방 어그로 보스의 어그로 구체를 돌아서 방 일반 몹에게 갈 때, 탱커가 그 구체 밖으로 얼마나 멀리
#        호를 그리며 도는지(야드)입니다. 탱커 자신은 어그로 범위만 벗어나면 되지만, 파티는 불완전하게
#        따라오며 모서리를 가로지르므로 어그로 경계에 바짝 붙어 돌면 결국 보스가 끌려옵니다. 이 여유
#        거리는 탱커가 "비스듬히 뒤로 달려" 더 넓은 대기 거리로 가게 해서 뒤따르는 추종자들이 범위를
#        벗어나 있게 하고, 그 지점에서 보스 반대편 무리에게 곧장 가는 길이 열립니다. 추종자가 여전히
#        보스를 건드리면 올리고, 넓은 호가 시간을 낭비하거나 벽으로 밀고 들어가면 낮추세요.
#
#        기본값: 10.0
#

DungeonClear.RoomAggroPartyMargin = 10.0

#
#    DungeonClear.ObjectiveArriveRadius
#        비전투 이동 목표(BossRosterRegistry 기준점, 예: 가라앉은 사원 이벤트 경유지)에 도달한 것으로
#        판정하고 정리를 진행하는 기본 도착 반경(야드)입니다. 로스터 행에서 기준점별로 재정의할 수
#        있으며, 재정의하지 않으면 이 값을 사용합니다.
#
#        기본값: 8.0
#

DungeonClear.ObjectiveArriveRadius = 8.0

#
#    DungeonClear.EventStepTimeout
#        선언형 던전 이벤트 실행기(DungeonEventRegistry / DungeonEventExecutor)의 단계별 제한 시간(초)입니다.
#        한 단계가 이 시간 동안 계속 Running을 반환하면 실패로 처리합니다: 필수(REQUIRED) 이벤트는
#        사람이 처리할 때까지 멈추고, 선택(OPTIONAL) 이벤트는 건너뛰고 정리를 진행합니다.
#        단계에 자체 제한 시간이 없을 때만 사용됩니다. 느린 접근과 스크립트 진행이 중간에 끊기지 않도록
#        넉넉하게 잡았습니다.
#
#        기본값: 30
#

DungeonClear.EventStepTimeout = 30

#
#    DungeonClear.BossEngageRangeFloor / DungeonClear.BossEngageRangeCap
#        동적 보스 교전 인계 거리를 [floor, cap] 야드 범위로 제한합니다.
#        floor(하한)는 어그로 범위가 아주 작은 보스에게 탱커가 바로 코앞 근접 거리까지 가야 하는 일을
#        막고, cap(상한)은 레벨 차이로 커진 거대한 어그로 반경 때문에 터무니없이 먼 곳에서 풀링을
#        시작하는 일을 막습니다. 다음 경우에만 사용됩니다:
#        DynamicAggroRange = 1.
#
#        기본값: 12.0 / 30.0
#

DungeonClear.BossEngageRangeFloor = 12.0
DungeonClear.BossEngageRangeCap = 30.0

#
#    DungeonClear.TrashWidthFloor / DungeonClear.TrashWidthCap
#        각 일반 몹 후보의 동적 통로 폭을 [floor, cap] 야드로 제한합니다. floor(하한)는 경로선 바로 위에
#        있는 몹을 항상 막고 있는 것으로 치게 하고, cap(상한)은 어그로 범위가 큰 정예 몹을 경로선에서
#        얼마나 멀리까지 끌 수 있는지 제한합니다(광역 단계 제외 박스의 여유도 정합니다).
#        DynamicAggroRange = 1일 때만 사용됩니다. 폭은 통합 어그로 도달 거리(몹의 감지 거리 + 양쪽 전투
#        접촉 거리 + AggroRangeMargin)이며, 이동 중 회피 구체와 같은 크기 계산을 사용하므로 감지와 회피가
#        "어그로 범위 안"의 의미를 두고 서로 어긋날 수 없습니다.
#
#        기본값: 8.0 / 30.0 (영웅 난이도에서는 상한 42.0 — 아래 HEROIC DEFAULTS 참고)
#

DungeonClear.TrashWidthFloor = 8.0
DungeonClear.TrashWidthCap = 30.0

########################################
#        디버깅 설정
########################################
#
# 이 키들은 전용 DungeonClear 채널(playerbots.dungeonclear)을 위해
# AzerothCore의 전역 로깅 설정에 병합됩니다.

#
#    Appender.DungeonClear
#        채널을 별도 파일에 기록합니다. 형식: Type,LogLevel,Flags,File
#        Type 2 = 파일. LogLevel 4 = Info, 5 = Debug, 6 = Trace.
#

Appender.DungeonClear=2,4,0,DungeonClear.log

#
#    Logger.playerbots.dungeonclear
#        채널의 출력 대상을 지정합니다. 형식: LogLevel,AppenderList
#        4 (Info, 기본값): 주요 단계만 기록. 경로 탐색/멈춤 문제를 진단하려면 5 (Debug) 또는
#        6 (Trace)으로 올리세요.
#
#        어펜더 목록은 DungeonClear 전용으로, worldserver 콘솔이 아니라 파일에만 기록합니다. 정리 중에는
#        봇마다 무리당 몇 줄의 Info가 기록되는데(첫 접촉, 캠프 지정, 파티 해제), 나중에 grep으로 찾아볼
#        로그에는 딱 필요한 내용이지만 실제 서버 콘솔에 스크롤되는 것은 전혀 원치 않는 내용입니다.
#        공략을 실시간으로 지켜보는 중이라면 아래 목록에 `Console`을 추가하세요. 실제 오류는 영향을 받지
#        않습니다: 모듈의 오류 경로는 자체 출력 설정을 가진 `playerbots`에 기록됩니다.
#

Logger.playerbots.dungeonclear=4,DungeonClear

#
#    고급 풀링 하위 채널 (playerbots.dungeonclear.pull).
#
#        고급 풀링(시야 차단 캠프 풀링)은 자체 하위 카테고리에 기록되므로, 훨씬 더 분주한 기본
#        DungeonClear 채널과 별개로 디버깅할 수 있습니다 — 경로/멈춤 로그에 파묻히지 않고 풀링 추적을
#        최대로 올리거나, 풀링 모드가 안정될 때까지 완전히 끌 수 있습니다. playerbots.dungeonclear의
#        하위 항목이므로, 아래 두 키를 주석 처리된 상태로 두면 풀링 로그는 위의 상위 채널/레벨을 그대로
#        물려받습니다.
#
#        풀링 로그를 Debug 레벨의 별도 파일로 분리하려면 주석을 해제하세요. 레벨:
#        4 = Info (캠프 표시, 어그로 확인, 파티 해제, 중단),
#        5 = Debug (진행 조건 판단, 거리, 단계 계산),
#        6 = Trace (틱마다의 돌입 / 복귀 / 캠프 대기 이동).
#
#    Appender.DungeonClearPull=2,5,0,DungeonClearPull.log
#    Logger.playerbots.dungeonclear.pull=5,DungeonClearPull

########################################
#        고급 경로 탐색 설정
########################################
#
# 경고: 이 값을 바꾸면 길 찾기가 망가질 수 있습니다. 대부분 테스트용이므로
# 무엇을 하는지 정확히 알지 못한다면 기본값으로 두세요.

#
#    DungeonClear.AsyncPathfinding
#        1 (기본값): 무거운 던전 전체 내비메시 경로 생성을 백그라운드 작업 스레드에서 실행하여, 캐시 미스가
#        서버 틱을 미세하게 끊기게 하지 않도록 합니다. 생성이 진행되는 동안 탱커는 현재 경로를 계속
#        걷습니다(보스가 바뀌면 새 경로가 준비될 때까지 잠깐 멈춥니다). 경로 결과는 동기 모드와
#        동일합니다. 0이면 맵 스레드에서 바로 생성합니다(원래 동작) — 작업 스레드가 의심될 때 검증된
#        대안으로 설정하세요. `.reload config` 시 실행 중에도 반영됩니다(다음 경로 재생성부터 적용).
#
#        기본값: 1
#

DungeonClear.AsyncPathfinding = 1

#
#    DungeonClear.PathCenterEnable
#        1(기본값): Detour의 벽에 붙는 경로 대신 통로 중앙 쪽으로 경로를 옮겨
#        봇이 벽과 낭떠러지 가장자리에 붙지 않게 합니다. 옮긴 지점은 메시 위에
#        있는지 재검증하고 시야도 검사합니다. 0이면 벽에 붙는 경로로 돌아갑니다.
#        `.reload config` 시 즉시 반영됩니다.
#
#        기본값: 1
#

DungeonClear.PathCenterEnable = 1

#
#    DungeonClear.PathWallClearance
#        경로 중앙 정렬 시 경로 지점을 가장 가까운 벽에서 떨어뜨려 두는 목표 거리(야드)입니다.
#        이 값의 두 배보다 좁은 통로에서는 정확히 가운데에 위치합니다. 값이 클수록 벽에 덜 붙지만,
#        좁은 공간에서 시야(LOS) 잘림이 더 많이 발생합니다.
#
#        기본값: 3.0
#

DungeonClear.PathWallClearance = 3.0

#
#    DungeonClear.PathCenterMaxPush
#        중앙 정렬로 한 지점을 옮길 수 있는 최대 거리(야드)의 상한으로,
#        잘못된 벽 법선 때문에 지점이 얇은 벽을 뚫고 넘어가지 않도록 합니다.
#
#        기본값: 5.0
#

DungeonClear.PathCenterMaxPush = 5.0

#
#    DungeonClear.PathCenterSmoothIters
#        톱니 모양 흔들림을 없애기 위해 중앙 정렬 후 적용하는 라플라시안 스무딩 횟수입니다.
#        0이면 끄고, 높으면 더 부드럽지만 급격한 굽이에서 중앙 정렬이 느슨해집니다.
#        끝점은 고정하며 결과가 메시 위에 있는지 재검증합니다.
#
#        기본값: 2
#

DungeonClear.PathCenterSmoothIters = 2

#
#    DungeonClear.WaterPathCost
#        경로 탐색기에서 물 폴리곤에 적용하는 육지 선호 배수입니다. 봇은 여전히
#        헤엄치거나 얕은 물을 걸을 수 있지만(물은 통행 가능), 물을 건너는 경로가
#        실제로 더 짧을 때만 선택됩니다. 물 지름길보다 이 배수만큼 긴 육지 우회로까지는
#        물에 들어가는 대신 육지를 선호합니다. 물 동굴이나 마른 길이 없는 수중 통로처럼
#        반드시 헤엄쳐야 하는 경우에는 영향이 없으며, 육지 대안이 전혀 없으므로 수영합니다.
#        1.0 = 선호 없음 (물과 육지의 비용이 같음).
#
#        기본값: 3.0
#

DungeonClear.WaterPathCost = 3.0

#
#    DungeonClear.MagmaPathCost
#        WaterPathCost와 같지만 마그마/용암 폴리곤용입니다 — 높게 설정하여 경로가 용암을 강하게 피하되,
#        건너갈 다른 방법이 없을 때는 최후의 수단으로 지나갈 수 있게 합니다. (점액은 플레이어 이동에서
#        아예 제외되므로 비용 설정이 없습니다.)
#
#        기본값: 20.0
#

DungeonClear.MagmaPathCost = 20.0

#
#    DungeonClear.SwimEnable
#        물속 수영 구간을 활성화합니다. 내비메시는 깊은 물 위에 평평한 수면 층만 남기므로(액체 아래의
#        바닥은 mmap 생성 시 버려집니다), 물에 잠긴 터널 — 예: 검은심연의 나락에서 여군주 사레베스로 가는
#        통로 — 은 일반 경로 탐색으로 도달할 수 없어 공략이 멈추게 됩니다.
#        이 설정을 켜면 경로가 막다른 곳에 이르고 봇과 목표 사이에 물이 있을 때, 봇이 목표를 향해
#        탐욕적으로 3D 수영을 합니다(VMAP 충돌 기반 이동, 맵별 데이터 불필요). 0이면 끄고 예전의
#        "멈춤" 동작으로 되돌립니다.
#
#        기본값: 1 (활성)
#

DungeonClear.SwimEnable = 1

#
#    DungeonClear.SwimMaxRange
#        수영을 시도할 수 있는 막다른 지점과 목표 사이의 최대 거리(야드)입니다. 탐욕적 탐색 범위를 제한하고,
#        정말로 도달할 수 없는 목표로 헤엄치려는 시도를 막습니다. 알려진 수중 터널을 여유 있게 포함하도록
#        정한 값입니다.
#
#        기본값: 250.0
#

DungeonClear.SwimMaxRange = 250.0

#
#    DungeonClear.PullSafetyHpPct
#        고급 풀링 모드(`dc pull`)의 캠프 안전 밸브입니다. 풀링이 진행되는 동안 DPS와 치유사는 캠프에서
#        대기(passive) 상태로 기다리므로, 순찰 몹이 캠프를 스치거나 풀링이 틀어지면 스스로를 방어할 수
#        없습니다. 대기 중인 파티원이 이 생명력 % 아래로 전투 중이고, 그를 공격하는 대상이 끌려오는 무리가
#        아니라면(끌려오는 무리의 광역 피해는 평범한 끌기이지 풀링 실패가 아닙니다), 파티를 해제하여
#        반격하게 합니다. 진행 중인 끌기는 유지됩니다 — 탱커는 무리를 캠프까지 끌고 오고, 해제된 파티는
#        그곳에서 싸웁니다. 아직 무리에게 걸어가는 중인(아무것도 태그하지 않은) 풀링만 즉시 중단됩니다.
#        0이면 밸브를 끕니다(짧은 풀링 제한 시간에만 의존).
#
#        기본값: 50.0
#

DungeonClear.PullSafetyHpPct = 50.0

#
#    DungeonClear.PullSafetyGrace
#        위의 조건 상태가 밸브가 작동하기 전에 지속되어야 하는 시간(초)입니다.
#        유예 시간 안에 추종자가 버텨 낸 한 번의 우발적 타격으로는 순간적인 변화 때문에 작전을 버리지
#        않고, 지속적인 피해(무언가가 정말로 캠프를 공격 중)일 때 파티를 해제합니다. 0이면 조건을 만족한
#        첫 틱에 작동합니다.
#
#        기본값: 0.0
#

DungeonClear.PullSafetyGrace = 0.0

#
#    DungeonClear.PullSetback
#        고급 풀링(`dc pull`) 캠프 거리입니다. 탱커가 무리를 풀링할 때, 이미 정리된 경로를 따라 이만큼
#        뒤쪽에 집결 "캠프"를 지정하고 끌어온 무리를 그곳으로 데려오며, 파티는 거기서 기다립니다.
#        던전 몹은 추적 거리 제한이 없으므로(인스턴스 전체를 따라옵니다), 이 값은 단순히 다음 무리로부터
#        전투를 얼마나 떨어뜨려 끌어오느냐입니다 — 클수록 공간이 넓고 안전하지만 끄는 거리가 길어집니다.
#        이만큼 뒤의 지점이 여전히 다른 무리로부터 안전하지 않으면(PullCampSafeRadius 참고) 탱커는
#        안전해질 때까지 PullMaxDrag 한도 안에서 계속 뒤로 걸어갑니다.
#
#        기본값: 25.0
#

DungeonClear.PullSetback = 25.0

#
#    DungeonClear.PullCampSafeRadius
#        고급 풀링 거점이 풀링 대상이 아닌 다른 무리와 유지하는 최소 거리(야드)로,
#        거점에서 싸우다가 이웃 무리를 자극하지 않도록 합니다. 거점은 먼저
#        PullSetback야드 뒤에 잡고, 이 반경 안에 다른 무리가 있으면 벗어날 때까지
#        탱커가 더 뒤로(최대 PullMaxDrag까지) 이동합니다.
#
#        기본값: 25.0
#

DungeonClear.PullCampSafeRadius = 25.0

#
#    DungeonClear.PullMaxDrag
#        고급 풀링 캠프를 얼마나 뒤까지 둘 수 있는지에 대한 절대 상한(정리된 경로를 따라 잰 야드)입니다 —
#        즉, 탱커가 PullSetback을 넘어 안전한 지점을 찾아 계속 뒤로 걸어가는 최대 거리입니다. 풀링이
#        인스턴스 전체를 가로질러 무리를 끌고 가지 않도록 하는 최소한의 안전 한도일 뿐이며, 추적 거리
#        제한을 걱정할 필요가 없으므로 크게 잡아도 됩니다.
#
#        기본값: 35.0
#

DungeonClear.PullMaxDrag = 35.0

#
#    DungeonClear.PullRangedLosBreak
#        고급 풀링 전용. 풀링한 무리에 원거리 공격 몹(시전자, 궁수, 마법봉 사용자 등 근접하러 달려오지 않고
#        멀리서 쏘거나 시전하는 몹)이 있으면, 평소 거리에 캠프를 두었을 때 그 몹들이 방 건너편에서
#        파티를 계속 공격합니다. 이 설정을 켜면 무리로의 시야가 없는 지점 — 보통 탱커가 들어온 입구나
#        모퉁이 — 에 이를 때까지 캠프를 정리된 경로를 따라 더 뒤로 옮기므로, 원거리 몹이 캠프에서
#        근접 거리까지 다가올 수밖에 없게 됩니다. 시야는 현재 풀링 대상에 대해서만 검사합니다(같은 무리의
#        몹은 그 주위에 모여 있습니다). PullRangedMaxDrag 안에서 시야 밖 지점에 도달할 수 없으면 캠프는
#        정리된 지점 중 가장 먼 곳으로 대체됩니다(최선의 시도 — 엄폐물이 없는 방에서는 시야를 끊을 수
#        없습니다).
#
#        기본값: 1 (활성)
#

DungeonClear.PullRangedLosBreak = 1

#
#    DungeonClear.PullRangedMaxDrag
#        원거리 시야 차단 풀링에서만 쓰는 캠프 끌기 거리의 절대 상한(정리된 경로를 따라 잰 야드)입니다.
#        시야를 끊는 지점(입구/모퉁이)은 근접 풀링의 일반 캠프 위치보다 훨씬 멀리 있을 수 있어서
#        PullMaxDrag보다 큽니다. PullRangedLosBreak가 꺼져 있거나 무리에 원거리 공격 몹이 없으면
#        무시됩니다(그때는 PullMaxDrag가 적용됩니다).
#
#        기본값: 60.0
#

DungeonClear.PullRangedMaxDrag = 60.0

#
#    DungeonClear.PullRangedSpellRangeFloor
#        감지 조정: 최대 사거리가 이 값(야드)을 넘는 피해 주문을 가진 생물은 시야 차단 판단에서 "원거리에서
#        싸우는" 몹으로 표시됩니다. ~15이면 진짜 시전자(얼음화살/어둠의 화살 ~30yd)는 포함하고, 짧은 사거리
#        투척/도약 기술만 가진 근접 몹은 제외합니다. 서버 전용.
#
#        기본값: 15.0
#

DungeonClear.PullRangedSpellRangeFloor = 15.0

#
#    DungeonClear.PullPlayerReleaseDelay
#        리더 탱커가 전투에 들어간 뒤 DPS 추종자를 전투에 풀어 주기 전까지 붙잡아 두는 시간(초)입니다 —
#        탱커가 무리를 모으고 광역 위협 수준을 쌓아, 교전하자마자 파티가 몹을 빼앗아 가지 않게 하는
#        "위협 선행 시간"입니다. 이 하나의 값이 두 해제 경로를 모두 결정합니다: 고급 풀링 캠프 대기(선행
#        시간이 지날 때까지 파티는 대기)와 지원 경로(Leeroy 진입 / 계획에 없던 어그로 / 일반 전투에서
#        선행 시간 동안 파티를 전투 밖에 붙잡아 둠)입니다. 공략을 끝내거나 일시정지하거나, 캠프 안전
#        밸브(대기 중인 추종자가 큰 피해를 받음)가 작동하면 이와 관계없이 즉시 파티를 해제합니다.
#        탱커가 PullThreatLeadPanicHp 아래로 떨어지면 지원 경로를 일찍 해제합니다. 0이면 즉시 해제합니다
#        (예전 동작). 치유사는 붙잡아 두지 않으며 영향을 받지 않습니다. 아래의 소환수 지연은 이 값에
#        추가로 더해집니다.
#
#        기본값: 1.5
#

DungeonClear.PullPlayerReleaseDelay = 1.5

#
#    DungeonClear.PullPetReleaseDelay
#        고급 풀링 전용. 추종자의 소환수가 주인이 해제된 뒤에도(PullPlayerReleaseDelay에
#        더해) 수동 상태로 남아 있는 시간(초)입니다. 소환수와 주인을 동시에 해제하면
#        탱커가 위협 수준을 확보하기 전에 소환수가 돌진해 어그로를 빼앗아 풀링을 망칩니다.
#        이 지연 동안 나머지 파티가 교전하는 사이 탱커가 먼저 어그로를 확보합니다.
#        0이면 소환수를 주인과 함께 즉시 해제합니다(이전 동작).
#
#        기본값: 2.5
#

DungeonClear.PullPetReleaseDelay = 2.5

#
#    DungeonClear.PullThreatLeadPanicHp
#        지원 경로 위협 선행 시간 우회. 리더가 전투에 들어간 뒤(Leeroy / 걸어 들어가기 / 일반 지원 경로)
#        PullPlayerReleaseDelay 선행 시간 동안 DPS 추종자를 붙잡아 두는 중에, 탱커의 생명력이 이 %
#        아래로 떨어지면 전투에서 지고 있는 것입니다 — 남은 선행 시간과 관계없이 파티를 즉시 풀어
#        합류시킵니다. 0이면 우회를 끄고 항상 선행 시간을 끝까지 지킵니다. 치유사는 붙잡아 두지 않으며
#        이 설정을 무시합니다.
#
#        기본값: 60
#

DungeonClear.PullThreatLeadPanicHp = 60

#
#    DungeonClear.PartyCombatLatch
#        동적 정찰 거리 억제와 전투 지원 활성화를 모두 제어하는, 봇 간 "파티가 전투 중인가?" 판정의
#        히스테리시스(초)입니다. 리더의 전투 상태만 읽는 것은 한 시점의 확인일 뿐이고, 전투는 우리가 제어할
#        수 없는 틱에 시작되거나 끝납니다(돌아다니는 몹이 전투 사이에 탱커를 공격함, 끌어온 무리가 한 틱
#        동안 시야 밖으로 벗어남, 탱커가 태그하고 위치를 옮김) — 즉 TOCTOU 경쟁 조건입니다. 히스테리시스가
#        없으면 잘못된 판독 한 번에 탱커가 낮은 생명력으로 싸우는 중에도 파티 전체가 "모여서 돕기"에서
#        먼 정찰 거리로 튕겨 나가 전투에서 빠졌다가 다시 돌아옵니다. 파티원 중 누구든 전투 중으로
#        확인되면 이 시간(초) 동안 교전 판정을 유지하므로, 오래된 판독 하나로 파티가 지원 모드에서
#        빠지지 않습니다. 0이면 이 래치를 끕니다(순간 확인만 사용 — 권장하지 않음).
#
#        기본값: 3
#

DungeonClear.PartyCombatLatch = 3

#
#    DungeonClear.StuckCombatTimeout
#        유령 전투 탈출 장치(초). 맵 반대편이나 관문 뒤에서 생성된 몹(근접 또는 관문 이벤트 생성)이 파티원을
#        태그하면 그 파티원이 전투 상태로 남을 수 있습니다: 전투를 유지하는 대상에 도달할 수 없어 코어의
#        전투 참조가 해제되지 않고, DC 자체의 "누군가 전투 중" 확인이 끝없이 돌며, 'dc off'/'on'을
#        전환해도 해결되지 않습니다(이 플래그는 DC가 아니라 코어에 있습니다). 구성원이 전투 중이고,
#        아무도 근접 공격하지 않으며, 대상이 없고, 전투를 유지하는 모든 유닛이 경로상 도달 불가이거나
#        귀환 중인 상태가 이 시간(초) 동안 이어질 때에만 DC가 전투와 위협 수준을 강제로 해제합니다
#        (GM '.combatstop'과 같은 효과). 거리가 아니라 도달 가능성을 기준으로 하므로, 파티가 도망치거나
#        카이팅하는 중에는 절대 발동하지 않고(추격자는 항상 경로상 도달 가능), 유닛 참조를 남기지 않는
#        스크립트 강제 전투는 건드리지 않습니다. 또한 공격대 지역에서는 완전히 비활성화되는데, 잘못된
#        전투 해제가 공격대 전체의 보스를 초기화할 수 있기 때문입니다. 일부러 파티를 전투 상태로 붙잡는
#        전투를 멈춘 플래그로 오인하지 않도록 기본값을 길게 잡았습니다. 0이면 모든 곳에서 끕니다.
#
#        기본값: 15
#

DungeonClear.StuckCombatTimeout = 15

#
#    DungeonClear.PullPlantEnable
#        끌고 오는 중 돌아서서 자리 잡기. 사람 탱커는 풀링한 무리를 캠프로 끌고 올 때 돌아오는 구간 전체를
#        등을 보인 채 달리지 않습니다: 무리가 붙어서 따라오기 시작하면 몇 걸음 뒤 멈춰 돌아서서 그 자리에서
#        싸우며, 그 지점이 새 캠프가 됩니다(파티가 그곳으로 모입니다). 이렇게 하면 멍해짐 면역 안전장치가
#        막으려는 등 노출 시간이 줄어듭니다. 모퉁이에 도달하는 것이 목적인 시야 차단(원거리) 풀링에서는
#        적용되지 않으며, 돌아오는 구간의 절반 이상을 이동한 뒤에만 발동합니다. 0이면 항상 지정된 캠프까지
#        끝까지 끌고 옵니다(예전 동작).
#
#        기본값: 1 (활성)
#

DungeonClear.PullPlantEnable = 1

#
#    DungeonClear.PullPlantGlueRadius
#        돌아서서 자리 잡기의 발동 반경(야드)입니다. 탱커를 공격 중인 살아 있는 모든 몹이 이 거리 안에
#        들어왔을 때만 발동합니다 — 무리가 모여 있어 탱커가 멈춘 곳으로 다가올 상태입니다. 작을수록 더
#        촘촘히 뭉칠 때까지 기다리고, 클수록 무리가 더 퍼진 상태에서 일찍 자리를 잡습니다.
#        PullPlantEnable이 켜져 있을 때만 사용됩니다.
#
#        기본값: 6.0
#

DungeonClear.PullPlantGlueRadius = 6.0

#
#    DungeonClear.PullCcAssist
#        고급/동적 풀링 전용. 리더 탱커가 풀링한 무리를 캠프로 끌고 오는 중 군중 제어를 당하면 — 기절, 공포,
#        혼란, 이동 불가, 또는 PullCcSlowFloor 이하로 감속 — 끌기는 실패합니다: 탱커는 후퇴하지 못하고
#        무리에게 맞기만 하며, 파티는 캠프에서 대기 상태로 서 있습니다. 이 설정을 켜면 군중 제어가
#        PullCcAssistGrace 초 동안 지속되는 순간 그 풀링을 중단하고, 파티의 대기 상태를 해제하여 탱커가
#        죽는 것을 지켜보는 대신 무리에게 달려들어 돕게 합니다. 0이면 탱커가 군중 제어를 당해도 파티를
#        대기 상태로 유지합니다(예전 동작 — 풀링은 구간 감시 타이머나 캠프 안전 밸브로만 해제됩니다).
#
#        기본값: 1 (활성)
#

DungeonClear.PullCcAssist = 1

#
#    DungeonClear.PullCcAssistGrace
#        고급/동적 풀링 전용. 리더 탱커에게 걸린 군중 제어가 끌고 오는 도중 이 시간(초)
#        이상 지속되어야 PullCcAssist가 풀링을 중단합니다. 짧은 유예로 0.5초 순간 기절 같은
#        짧은 군중 제어는 무시하여 정상적인 풀링이 순간적인 방해로 취소되지 않게 하고,
#        풀링이 실제로 실패하는 지속적인 군중 제어에는 파티를 해제해 돕게 합니다.
#        0이면 군중 제어를 감지하는 즉시 해제합니다.
#
#        기본값: 1.0
#

DungeonClear.PullCcAssistGrace = 1.0

#
#    DungeonClear.PullCcSlowFloor
#        고급/동적 풀링 전용. 탱커가 PullCcAssist에서 "감속됨"으로 판정되는 이동 속도 비율(기본 달리기
#        속도 기준) 상한입니다. 풀링 중에는 멍해짐에 면역이므로, 이만큼 깊은 감속은 실제 약화 효과
#        (힘줄 절단, 거미줄, 얼음화살 냉기)이며 무리를 끌고 후퇴하는 속도를 기어가는 수준으로 떨어뜨려
#        경쟁에서 지게 됩니다. 1.0이면 어떤 감속이든 군중 제어로 취급하고, 0.1이면 가장 심한 감속만
#        해당합니다. 기절/공포/혼란/이동 불가는 이 값과 관계없이 중단됩니다.
#
#        기본값: 0.6
#

DungeonClear.PullCcSlowFloor = 0.6

#
#    DungeonClear.PullCommitRangeFloor / DungeonClear.PullCommitRangeCap
#        고급 풀링 전용. 탱커가 이동을 멈추고 대기하며, 태그하러 들어가기 전에 파티가 캠프에 자리 잡기를
#        기다리기 시작하는 무리까지의 거리입니다. 실제 값은 무리의 실제 어그로 반경
#        (Creature::GetAggroRange + 접촉 거리 + AggroRangeMargin — 보스 인계에 쓰는 것과 같은 코어 값)에
#        맞춰 정해지므로, 탱커는 이동 도중 무리를 정면으로 끌지 않고 어그로 범위 바로 바깥에서 대형을
#        갖춥니다. 이 두 값이 그 거리를 제한합니다: cap(상한)은 ~35yd 풀링 감지 범위 안에 머물고,
#        floor(하한)는 어그로 범위가 작은 무리에게도 약간의 거리를 유지하게 합니다.
#        DynamicAggroRange = 1일 때만 사용되며, 그렇지 않으면 고정 대체값이 적용됩니다.
#
#        기본값: 16.0 / 34.0
#

DungeonClear.PullCommitRangeFloor = 16.0
DungeonClear.PullCommitRangeCap = 34.0

#
#    DungeonClear.PullDynamicMaxLeeroyMobs
#        동적 풀링(애드온의 "Dynamic" 고급 풀링 상태) 전용. Leeroy와 Advanced 중 무엇을 쓸지 판정하는
#        값입니다. 탱커가 다음 풀링 대상을 살필 때, 모듈은 그냥 달려 들어가 대상 위에서 싸우면 몇 마리가
#        어그로될지 추정합니다: 자신의 어그로 반경(레벨 보정된 실제 게임 값 + PullCombatSpread)이 전투
#        지점에 닿는 모든 몹, 그리고 CallForHelp 지원 한 단계를 더합니다. 추정치가 이 수보다 크면 신중한
#        Advanced 캠프 풀링(한 번에 한 무리씩 떼어냄)을 사용하고, 같거나 작으면 탱커가 Leeroy로
#        진입합니다. 파티가 한 번에 편하게 상대할 수 있는 몹 수로 설정하세요: 예를 들어 서로 가까운
#        2마리 무리 셋은 6으로 추정되므로, 6이면 전부 Leeroy로 처리하고 4면 하나씩 떼어냅니다.
#        낮을수록 Advanced 풀링을 더 자주 사용합니다.
#
#        도달 거리는 각 몹의 실제 어그로 반경에서 계산되므로, 지역과 레벨 구간에 따라
#        자동으로 맞춰집니다. 던전마다 거리를 다시 조정할 필요가 없습니다.
#        (예전의 PullDynamicChainRadius + PullDynamicLargePackThreshold를 대체하며, 둘 다 제거되었습니다.)
#
#        기본값: 5
#

DungeonClear.PullDynamicMaxLeeroyMobs = 5

#
#    DungeonClear.PullForceAdvanced
#        동적 풀링 전용입니다. 1이면 위의 추정치가 아무리 작게 나오더라도 모든 무리를
#        신중한 Advanced 방식(캠프로 끌어오기)으로 풀링합니다. 이 옵션은 "항상 Advanced"를
#        추측이 아니라 조정된 상한값과 비교해 측정할 수 있도록 하기 위한 것이며,
#        영웅 던전 진행을 안전하게 만드는 권장 방법은 아닙니다. Advanced는 몹이 하나뿐인
#        무리에도 대형 갖추기/전진/뒤로 끌어오기 전체 과정을 수행하므로 순전히 진행 시간만
#        늘어나며, Leeroy에는 없는 실패 유형도 있습니다(끌어오기가 흐지부지될 수 있고,
#        캠프 위치가 수직 경계 너머에 잡힐 수 있음).
#
#        영웅 던전 진행에만 강제하려면 전역으로 켜지 말고 난이도 접미사를 사용하세요:
#            DungeonClear.PullForceAdvanced.Heroic = 1
#
#        기본값: 0 (추정치에 맡김)
#

DungeonClear.PullForceAdvanced = 0

#
#    DungeonClear.PullCombatSpread
#        동적 풀링 전용입니다. 위 추정에서 모든 몹의 근접 어그로 도달 거리에 더하는 야드 값으로,
#        전투 중 파티가 측면 공격/카이팅/위치 조정으로 흩어지는 것을 반영합니다. 전투는 한 점이
#        아니라 대상 주변의 원형 영역에서 벌어집니다. 값이 클수록 조금 더 멀리 있는 몹까지
#        어그로가 끌린다고 계산하므로 더 신중해집니다(Advanced 풀링 증가).
#
#        기본값: 6.0
#

DungeonClear.PullCombatSpread = 6.0

# 참고: 위 추정의 지원 전파 범위는 DungeonClear 설정이 아닙니다.
# 엔진 자체의 CreatureFamilyAssistanceRadius(생물의 CallAssistance가 같은 진영의
# 도움을 부를 때 쓰는 반경)를 읽으므로, 렐름에 설정된 지원 동작과 항상 일치하며
# 다시 조정할 필요가 없습니다.

#
#    DungeonClear.PullDynamicPartyLag
#        동적 풀링 전용입니다. 탱커가 다음 무리를 향해 정찰하며 Leeroy와 Advanced 중 무엇을 할지
#        결정하는 동안(탱커는 아직 비전투 상태이며 결정 전) 파티가 탱커 뒤에서 따라오는 거리(야드)입니다.
#        일반 따라가기 거리(~6yd)로는 탱커가 결정을 내리기도 전에 파티가 탱커 바로 뒤까지 붙어
#        무리의 어그로 범위에 들어가 의도치 않게 풀링을 시작하게 됩니다. 이 넓은 간격이 파티를
#        뒤에 붙잡아 두어 탱커가 혼자 어그로 범위 가장자리까지 다가가 결정한 뒤에야 파티가 교전합니다.
#        Advanced 풀링이면 캠프에서 대기하고, 탱커가 Leeroy를 결정하면 따라잡아 돌진합니다.
#        값이 클수록 더 신중합니다(파티가 더 뒤에 위치). 탱커가 전투에 들어가는 즉시 간격은
#        일반 따라가기 거리로 돌아가므로 DPS가 전투에서 뒤처지지 않습니다.
#
#        기본값: 15.0
#

DungeonClear.PullDynamicPartyLag = 15.0

#
#    DungeonClear.PullDynamicRollInLead
#        동적 풀링 전용입니다. 현재 판정이 Leeroy일 때, 파티의 정찰 간격(위 설정)이 탱커의
#        돌입 거리보다 몇 야드 바깥에서 풀리는지를 정합니다. 탱커가 판정된 무리에 대해
#        돌입 거리 + 이 선행 거리까지 접근하면 돌진을 확정한 것이므로, 파티는 간격 지점에서
#        대기를 멈추고 탱커의 마지막 접근 동안 거리를 좁힙니다. 그 결과 전투가 등록된 뒤에야
#        멍하니 서 있다가 15-20yd를 달려가는 대신, 실제 파티처럼 첫 접촉 후 1~2초 안에 도착합니다.
#        0이면 돌입 거리 자체에서만 풀립니다. 값이 클수록 파티가 탱커와 함께 더 일찍 움직입니다.
#        Advanced 판정에는 영향이 없습니다(파티는 이전처럼 캠프에서 대기).
#
#        기본값: 8.0
#

DungeonClear.PullDynamicRollInLead = 8.0

#
#    DungeonClear.PullPatrolWait
#        동적 모드 전용입니다. 사람 탱커는 순찰몹의 움직임에 맞춰 풀링 타이밍을 잡습니다.
#        무리의 어그로 추정치를 Leeroy 상한 위로 밀어 올리는 유일한 요인이 연쇄 범위 안의
#        DB에 정의된 단독 순찰몹이라면(그 순찰몹을 뺀 추정치는 깔끔한 소규모 Leeroy),
#        탱커는 더 무거운 Advanced 풀링을 확정하는 대신 돌입 거리에서 순찰몹이 지나가기를
#        기다렸다가, 순찰몹이 멀어지는 순간 Leeroy로 풀링합니다. 대기 중에는 애드온에
#        "Waiting for patrol"이 표시됩니다. 0이면 비활성(예전 동작처럼 Advanced 판정을 즉시 확정)입니다.
#        대형/연결된 순찰몹은 해당되지 않습니다. 무리의 절반만 기다려 보낼 수는 없기 때문입니다.
#
#        기본값: 1 (활성)
#

DungeonClear.PullPatrolWait = 1

#
#    DungeonClear.PullPatrolWaitSec
#        동적 모드 전용입니다. 탱커가 순찰몹을 기다리는(PullPatrolWait) 최대 시간으로,
#        이 시간이 지나면 포기하고 Advanced 판정을 그대로 확정합니다. 이렇게 해서 고정된
#        경로 지점에 멈춰 있거나 매우 느리게 움직이는 순찰몹 때문에 진행이 무한정 멈추지 않게 합니다.
#        시간은 탱커가 돌입 거리에 도달하고 경합이 확인된 시점부터 계산됩니다.
#
#        기본값: 8.0
#

DungeonClear.PullPatrolWaitSec = 8.0

#
#    DungeonClear.PullChaseLeash
#        풀링/교전 대상이 탱커가 선택했을 때 서 있던 위치에서 몇 야드(yards)까지 벗어나면,
#        탱커가 쫓아가지 않고 걸음을 멈춘 채 대상이 돌아오기를 기다릴지 정합니다.
#        위의 PullPatrolWait는 풀링 중인 무리와 경합하는 순찰몹을 처리하고, 이 설정은 순찰몹
#        자체가 풀링 대상 무리인 경우를 처리합니다. 대상은 GUID로 고정되고 매 틱마다 현재 위치로
#        다시 조준되므로, 걸어 다니는 몹이면 접근이 추격으로 바뀝니다. 그 경로가 다른 무리들 뒤로
#        돌아가면 탱커는 그 모든 무리의 어그로 범위를 지나쳐 방 전체를 끌고 도착하게 됩니다.
#        실행 중인 계획(풀링 규모 추정, 캠프 위치)은 선택 당시 몹이 서 있던 곳을 기준으로
#        측정된 것이므로, 몹이 그 자리를 떠나면 전혀 다른 장소에 대한 계획을 쫓게 됩니다.
#        사람 탱커는 기다립니다. 순찰은 순환 경로이므로 결국 돌아옵니다.
#
#        일반적인 배회/순찰 흔들림보다 크게 잡아서, 생성 지점 주변을 서성이는 무리로는 절대
#        발동하지 않게 합니다. 선택 당시만큼 또는 그보다 더 탱커의 돌입 지점에 가까이 온 대상은
#        대기하지 않습니다. 그것은 다가오는 순찰몹이며, 바로 이 대기가 기다리는 상황입니다.
#            0 = 끔 (항상 추격, 기존 동작)
#
#        기본값: 15.0
#

DungeonClear.PullChaseLeash = 15.0

#
#    DungeonClear.PullChaseWaitSec
#        PullChaseLeash를 넘어 벗어난 대상을 탱커가 서서 기다리는 최대 시간(초)으로,
#        이 시간이 지나면 기준점을 다시 잡고 대상에게 걸어갑니다. 이렇게 해서 정말로 떠나 버린 몹
#        (사라진 순찰 경로, 스크립트에 의한 위치 이동) 때문에 진행이 멈추는 일이 없게 합니다.
#        Advanced 풀링의 태그 단계에서는 태그 단계 감시기(watchdog)와 똑같이, 대신 무리를 일반
#        걸어 들어가기 교전으로 넘깁니다. 단계가 실패하는 이유를 아는 이 제한이 먼저 발동하도록
#        의도적으로 그 10s 감시기보다 짧게 설정되어 있습니다.
#            0 = 대기하지 않음 (처음 멀어지는 틱에 포기)
#
#        기본값: 6.0
#

DungeonClear.PullChaseWaitSec = 6.0

#
#    DungeonClear.PullEnRouteAvoid
#        무리로 걸어가는 경로를 다른 무리들의 어그로 반경을 피해 우회시킵니다. 풀링 규모 산정은
#        "대상 위치에 머무는 전투에 누가 합류하는가"에 답할 뿐, 거기까지 가는 과정은 다루지 않습니다.
#        경로에서 40yd 떨어진 무리는 가만히 있으면 아무것도 끌지 않지만, 탱커가 옆을 뛰어 지나가면
#        전부 끌려옵니다. 이 옵션을 켜면 교전 걸어 들어가기, 풀링의 태그 단계, 방을 가로지르는
#        풀링 접근이 모두 길을 막는 가장 가까운 주변 무리의 구체를 하나씩 피해 돌아가며, 하나를
#        지날 때마다 다시 조준합니다. 이는 선호일 뿐 거부가 아닙니다. 우회 경로를 찾을 수 없으면
#        탱커는 이전처럼 곧장 걸어 들어가므로, 좁은 통로 때문에 진행이 멈추지 않습니다.
#        장거리 글라이드도 이를 따릅니다. 각 Advance 스플라인 구간은 어느 한 구간이라도 처음 침범하는
#        주변 무리 구체에서 잘리므로, 탱커는 위험 요소의 경계까지 미끄러지듯 이동한 뒤 비전투 상태로
#        멈춥니다. 밀집된 방을 관통하던 경로가 이제는 결정 하나씩 단계적으로 진입하게 되며,
#        빈도가 제한된 글라이드 중간 탐지가 순찰몹이 들어온 진행 중 구간을 중단시킵니다.
#        동반 애드온에서 진행별로 재정의할 수 있습니다.
#            0 = 끔 (직선 경로로 걸어감)
#            1 = on
#
#        기본값: 0 (영웅 난이도에서는 1 — 아래 영웅 난이도 기본값 참고)
#

DungeonClear.PullEnRouteAvoid = 0

#
#    DungeonClear.PullEnRouteMargin
#        PullEnRouteAvoid가 우회할 구체 크기를 정할 때, 주변 무리의 실제 어그로 도달 거리(양쪽의
#        전투 도달 거리와 AggroRangeMargin 포함) 위에 더하는 여유 야드 값입니다. 이 여유는 탱커가
#        아니라 파티를 위한 것입니다. 따라오는 파티원은 탱커를 정확히 따르지 않고 모퉁이를 가로지르므로,
#        탱커 기준으로 겨우 무리를 피하는 우회로는 힐러를 무리 한가운데로 지나가게 만듭니다.
#
#        기본값: 4.0
#

DungeonClear.PullEnRouteMargin = 4.0

#
#    DungeonClear.AdvanceWindowYards
#        Advance 글라이드가 발행하는 연속 스플라인 이동 구간 하나의 최대 길이(야드)로, 긴 경로에서
#        모듈의 이동 단위입니다. 구간은 일종의 확약입니다. 글라이드가 정상인 동안 Advance는 경로 평가를
#        전혀 하지 않으므로, 제한 없는 구간(최대 ~400yd까지 관측됨)은 경로상의 모든 무리 어그로 범위를
#        막는 몹 판단이나 풀링 결정 한 번 없이 탱커를 통과시킵니다. 이것이 "풀링 결정이 생기기도 전에
#        탱커가 이미 전투 중"인 과다 풀링입니다. 구간 길이를 제한하면 탱커가 최소한 이 야드마다 한 번은
#        멈춰서 다시 평가합니다. DC_CORRIDOR_LOOKAHEAD (35)에 맞춰져 있어, 두 평가 사이에 탱커가
#        길을 막는 몹 탐지기가 볼 수 있는 거리보다 멀리 이동하지 않습니다. 구간이 짧을수록 더 자주
#        재발행되며, 기본 ReactDelay에서 예상되는 글라이드 가동률 손실은 ~2%입니다.
#        0 = 제한 없음(과거 동작). 동반 애드온에서 진행별로 재정의할 수 있습니다.
#
#        기본값: 0.0 (영웅 난이도에서는 35.0 — 아래 영웅 난이도 기본값 참고)
#

DungeonClear.AdvanceWindowYards = 0.0

#
#    DungeonClear.SpectateEnable
#        관전 카메라의 두 가지 모드 모두에 대한 마스터 스위치입니다:
#            `.dc spectate`              — 자유 비행 카메라(애드온: Spectate 왼쪽 클릭).
#                                          플레이어를 캐릭터에서 분리합니다. 봇이 계속
#                                          캐릭터를 조작하는 동안 플레이어는 인스턴스를
#                                          자유롭게 날아다닙니다.
#            `.dc spectate follow [name]`— 추적 카메라(애드온: Spectate 오른쪽 클릭).
#                                          시점이 봇에 붙어 서버가 봇을 이동시키는 대로
#                                          따라가며, 그 봇이 죽거나 로그아웃하면 다른
#                                          탱커로 넘어갑니다. 이름을 지정하면 바로 그 봇으로
#                                          전환합니다(앞부분만 일치해도 됨).
#            `.dc spectate next` / `prev` — 탱커 여부와 관계없이 인스턴스의 다른 봇으로
#                                          카메라를 옮깁니다(애드온: < 및 > 버튼). 카메라가
#                                          없을 때 쓰면 새로 시작하므로, 단축키 하나로
#                                          시작과 전환을 모두 할 수 있습니다.
#            `.dc spectate list`         — 이곳에서 관전 가능한 봇 목록(현재 시점 표시).
#            `.dc test watch [selector]` — GM 전용: 실행 중인 `.dc test` 인스턴스로
#                                          순간이동하고(진행에 보이지 않도록 GM 모드 켬)
#                                          도착 시 추적 카메라를 시작합니다. `off`로 종료합니다.
#        두 모드 모두 파티가 필요 없습니다. 일부 서버는 카메라 분리를 부정행위로 보므로 여기서
#        끌 수 있습니다. 0이면 관전 시도가 "Spectator mode is disabled on this server." 메시지와 함께
#        거부됩니다(진행 중인 관전은 종료할 수 있음). 서버 전용 설정이며, 플레이어가 애드온에서
#        재정의할 수 없습니다.
#            0 = disabled
#            1 = enabled
#        기본값: 1 (활성)
#

DungeonClear.SpectateEnable = 1

#
#    DungeonClear.SpectateSpeed
#        관전 자유 카메라(`.dc spectate` 또는 애드온의 Spectate 버튼)의 이동 속도 배수로,
#        분리된 카메라가 날아다니는 속도를 일반 달리기 속도의 배수로 지정합니다. 카메라는 빙의된
#        투명 더미이므로 카메라에만 영향을 주고 캐릭터에는 영향이 없습니다(캐릭터는 봇 AI로 자체 속도로
#        계속 달림). 추적 카메라는 이 값을 무시합니다. 날아다니지 않고 봇에 붙어 가므로 속도는 봇의 속도입니다.
#
#        기본값: 2.5
#

DungeonClear.SpectateSpeed = 2.5

###############################################################################
# 영웅 난이도 기본값
#
#   아래의 모든 키는 진행이 영웅 난이도 던전 안에 있을 때 다른 내장 기본값을 사용합니다.
#   각 줄은 주석 처리되어 있으며 모듈이 이미 사용하는 값을 보여 줍니다. 값을 바꾸려는 경우에만
#   주석을 해제하세요. 일반 난이도는 이 섹션의 어떤 설정에도 영향을 받지 않습니다.
#
#   왜 이 항목들만인가: 불타는 성전 영웅 던전에서는 모든 일반몹이 정예이고, 규모를 잘못 잡은
#   풀링은 힘든 전투 정도가 아니라 진행 자체를 끝내 버립니다. 따라서 풀링 안전 설정은 난이도에 따라
#   달라져야 합니다. 그 밖의 모든 것(경로, 문, 전리품 줍기, 이벤트)은 양쪽에서 동일하게 동작합니다.
###############################################################################

#    풀링 상한입니다. 가장 중요한 항목입니다. Leeroy와 Advanced 판정은 추정된 무리를 정예의
#    1/3 단위로 가중치를 매기며(정예 = 3, 일반 = 1), 일반 난이도에서는 약한 일반몹으로 가득한 방 때문에
#    신중한 방식이 강제되는 것을 막아 줍니다. 영웅 던전에서는 모든 몹이 정예이므로 가중치가 단순한
#    머릿수가 되고, 상한 5는 정예 다섯을 정면으로 풀링하게 됩니다. 사람 탱커가 풀링하는 수는 2입니다.
# DungeonClear.PullDynamicMaxLeeroyMobs.Heroic = 2

#    모든 몹의 근접 도달 거리를 더 넓혀서, 전투 근처에 있을 뿐인 이웃 무리가 계산되지 않은 채
#    합류하는 대신 추정에 포함되게 합니다. 72레벨(lvl-72) 정예의 실제 도달 거리는 ~24yd이므로, 20이면
#    풀링 대상에서 ~44yd까지의 이웃이 계산됩니다. 영웅 던전 방의 대부분입니다. 의도적으로 과하게
#    잡았습니다. LEEROY로 분류된 무리는 풀링이 잘못되어도 캠프, 파티 대기, 뒤로 끌어오기가 없으므로,
#    무리를 ADVANCED로 밀어내는 것이 그 장치들을 작동시키는 방법입니다. 전멸 대신 정체가 잦아지면
#    14-16 쪽으로 낮추세요.
# DungeonClear.PullCombatSpread.Heroic = 20.0

#    캠프 배치: 더 멀리 끌어오고 다른 무리와의 간격을 더 요구합니다. MaxDrag는 SafeRadius와 함께
#    늘려야 합니다. 그렇지 않으면 배치기가 더 큰 반경을 만족시키지 못하고 원래 골랐을 지점으로
#    조용히 되돌아갑니다.
# DungeonClear.PullSetback.Heroic = 35.0
# DungeonClear.PullCampSafeRadius.Heroic = 35.0
# DungeonClear.PullMaxDrag.Heroic = 55.0
# DungeonClear.PullRangedMaxDrag.Heroic = 85.0

#    무리에서 더 먼 곳에서 멈춰 대형을 갖춥니다. (돌입 거리 상한(CAP)은 올리지 않습니다. 그 역할은
#    돌입 지점을 ~35yd 풀링 탐지 범위 안에 두는 것이며, 이는 난이도가 아니라 코드의 특성입니다.)
# DungeonClear.PullCommitRangeFloor.Heroic = 20.0

#    정찰하는 탱커 뒤에서 더 멀리 떨어져 따라갑니다. 탱커가 아무것도 결정하기 전에 파티가 무리의
#    어그로 범위로 걸어 들어가는 것이 아무도 의도하지 않은 풀링의 주요 원인입니다.
# DungeonClear.PullDynamicPartyLag.Heroic = 22.0

#    탱커에게 충분한 위협 수준 선점 시간을 주고, 소환수는 그보다 더 오래 붙잡아 둡니다. 긴급 기준도
#    함께 올라갑니다. 파티를 두 배 오래 붙잡아 두는 만큼, 밀리고 있는 탱커는 더 빨리 파티를 불러야 합니다.
# DungeonClear.PullPlayerReleaseDelay.Heroic = 3.0
# DungeonClear.PullPetReleaseDelay.Heroic = 4.5
# DungeonClear.PullThreatLeadPanicHp.Heroic = 70.0

#    대기 중인 수동(passive) 파티원을 아직 버틸 생명력이 있을 때 풀어 줍니다. 단, 위험이
#    PullSafetyGrace초 동안 지속된 뒤에만 풀어 줍니다. 천 방어구 파티원은 영웅 정예의 한 방에도 35%를
#    쉽게 넘기므로, 유예 시간이 없으면 뒤로 끌어오기가 대비하려는 바로 그 상황에서 안전장치가 발동합니다.
#    rescue.
# DungeonClear.PullSafetyHpPct.Heroic = 65.0
# DungeonClear.PullSafetyGrace.Heroic = 1.5

#    순찰몹을 실제로 기다려 보냅니다. 8초로는 실제 순찰 경로 상당수를 기다리지 못하고 포기하며,
#    포기한다는 것은 곧 작아졌을 무리에 뛰어든다는 뜻입니다.
# DungeonClear.PullPatrolWaitSec.Heroic = 18.0

#    경로상 무리 회피로, 영웅 난이도에서는 켜지고 일반 난이도에서는 꺼져 있습니다. 풀링 추정은
#    "대상 위치에 머무는 전투에 누가 합류하는가"에 답합니다. 풀링 규모를 정하는 데는 맞는 질문이지만,
#    거기까지 가는 데는 틀린 질문입니다. 경로에서 40yd 떨어진 무리는 가만히 있으면 아무것도 끌지 않지만,
#    탱커가 옆을 뛰어 지나가면 전부 끌려옵니다. 이 옵션을 켜면 무리로 가는 경로가 다른 모든 무리의
#    어그로 구체를 피해 우회합니다. 선호일 뿐 거부가 아닙니다. 우회로를 잡을 수 없으면 탱커는 이전처럼
#    곧장 걸어 들어가므로, 좁은 통로 때문에 진행이 멈추지 않습니다.
# DungeonClear.PullEnRouteAvoid.Heroic = 1

#    Advance 이동 단위를 길을 막는 몹 탐지 거리(DC_CORRIDOR_LOOKAHEAD = 35)로 제한합니다.
#    두 경로 평가 사이에 탱커가 탐지기가 볼 수 있는 거리보다 멀리 이동할 수 없으므로, 관찰 없이
#    400yd를 한 번에 미끄러지듯 이동하는 대신 결정 하나씩 방에 진입합니다.
# DungeonClear.AdvanceWindowYards.Heroic = 35.0

#    영웅 정예에 대해 길을 막는 몹 탐지 범위의 잘림을 풉니다. 통합된 어그로 도달 거리를 쓰면 일반적인
#    영웅 정예의 범위는 ~32-36yd가 되는데, 상한 30은 이를 조용히 잘라 통합으로 늘어난 바로 그 거리를
#    버립니다. 42로도 70레벨(lvl-70) 정예의 제한된 45yd 인지 거리는 여전히 범위 밖에 둡니다.
# DungeonClear.TrashWidthCap.Heroic = 42.0

#    Smart Rest는 영웅 난이도 프로필에 포함되지 않습니다. 잠시 높은 발동 기준으로 강제로 켰던 적이
#    있었지만, 높은 기준 때문에 거의 모든 무리마다 파티 전체가 멈추고 먹고 마시는 주기가 막아 주는 죽음보다
#    더 많은 진행 시간을 잡아먹어 영웅 던전 진행이 기어가듯 느려졌습니다. 이제는 두 난이도 모두에서
#    선택 사항입니다(위의 DungeonClear.SmartRest 또는 진행별 애드온 설정). 영웅 던전에만 다시 적용하려면
#    다음 줄들의 주석을 해제하세요:
# DungeonClear.SmartRest.Heroic = 1
# DungeonClear.SmartRestHealthPct.Heroic = 70
# DungeonClear.SmartRestDpsManaPct.Heroic = 35
# DungeonClear.SmartRestHealerManaPct.Heroic = 60

###############################################################################
# 공격대 기본값
#
#   아래의 모든 키는 진행이 공격대 지도(모든 공격대 난이도)에 있을 때 다른 내장 기본값을 사용합니다.
#   영웅 난이도 섹션과 같은 방식으로, 각 줄은 주석 처리되어 있으며 모듈이 이미 사용하는 값을 보여 줍니다.
#
#   왜 이 항목들만인가: 공격대 프로필은 10-40명 규모에 맞춰 달라져야 하는 수치만 담습니다.
#   동작(경로, 풀링, 문, 이벤트)은 던전과 공유되며, 보스 전투 자체는 dungeon-clear가 물러난 동안
#   Playerbots 공격대 전략이 담당합니다.
###############################################################################

#    25-40명의 행렬은 5인 대열보다 당연히 깁니다. 25yd 던전 간격을 쓰면 뒤처진 인원 때문에 매번
#    전진이 멈추게 됩니다. (재정의 값의 최대 제한은 120입니다.)
# DungeonClear.PartyMaxSpread.Raid = 40

#    공격대 전용 설정(".Raid" 접미사 없음 — 이 키들은 애초에 공격대 지도에서만 참조됩니다).
#
#    공격대 일반몹 처리 흐름의 준비 정족수: 모든 탱커와 힐러가 준비 기준을 충족하고, 살아 있는 인원 중
#    최소 이 비율(%)이 충족하면 진행이 전진합니다. 보스 풀링은 여전히 전원이 집결한 상태에서 100/100을
#    요구하며, 이 더 엄격한 기준은 아래의 보스 전 집결 설정과 그 제한 시간에서 다룹니다.
# DungeonClear.RaidReadyQuorumPct = 90
#
#    전투를 전멸(WIPE)로 간주하기 위해 사망해야 하는 공격대 인원 비율입니다(아무도 싸우고 있지 않은 상태).
#    (-> 입구에서 부활 후 계속 진행)
# DungeonClear.RaidWipeFractionPct = 90
#
#    보스 전 집결 제한 시간: 공격대가 집결 지점에서 회복하는 데 쓸 수 있는 시간과 ForceRebuff 한 차례가
#    진행될 수 있는 시간이며, 이후 집결은 현재 상태로 진행합니다(부족한 부분을 알리며, 교착 상태에
#    빠지지 않음).
# DungeonClear.RaidMusterRestTimeoutSecs = 35
# DungeonClear.RaidMusterRebuffTimeoutSecs = 25
#
#    보스를 위해 집결이 시작된 틱부터 측정하는 집결 전체의 절대 상한입니다. 만료되면 집결은 어느 단계에
#    있든 풀링을 진행시키고 열려 있는 재버프 시간을 취소하므로, 버프가 걸어 들어가기나 전투까지 이어지지
#    않습니다. 위의 두 제한 시간은 합이 이 값이 되도록 작성되어 있습니다. 사제 한 명이 서른아홉 명에게
#    단일 대상 버프를 거는 문제에 대한 진짜 해답이 이것입니다. 공격대는 버프가 끝날 때까지가 아니라 제한
#    시간이 끝날 때까지 기다립니다. 공격대 보스에서는 집결이 곧 풀링 준비 확인이므로(그곳에서는 풀링 사이의
#    휴식/간격 확인을 대체함), 이 상한은 공격대가 보스 앞에서 아무것도 하지 않고 서 있을 수 있는 최대
#    시간입니다. 그래도 지켜보기에 너무 길면 낮추세요.
# DungeonClear.RaidMusterTotalTimeoutSecs = 60

#    전투가 잘못된 뒤에는 오가야 할 시체와 마나 회복이 훨씬 많습니다. 5인 기준 제한 시간으로는 회복 가능한
#    공격대 복구가 너무 일찍 끝나 버립니다.
# DungeonClear.PostCombatRezTimeoutSecs.Raid = 180

###############################################################################
# `.dc test` — 자동 던전 테스트 진행
#
#   테스트 진행 도구(5봇 파티를 생성해 자율적으로 던전을 공략하고 결과를 dc_testruns.jsonl에 기록하는
#   GM 명령어)를 위한 서버 전용 감시 제한값입니다. 플레이어용 설정이 아니며, 동반 애드온에서
#   재정의할 수 없습니다.
###############################################################################

#
#    DungeonClear.TestRun.PauseGraceS
#        테스트 진행이 일시 정지(문으로 인한 자동 일시 정지 등 평소라면 사람을 기다리는 모든 상황) 상태로
#        머물 수 있는 시간으로, 초과하면 paused_timeout으로 실패 처리됩니다. 문이 다시 열렸을 때 문 막힘
#        자동 재개가 먼저 작동할 수 있을 만큼 충분히 길게 잡습니다.
#
#        기본값: 60
#

DungeonClear.TestRun.PauseGraceS = 60

#
#    DungeonClear.TestRun.StallGraceS
#        진행이 정체 사유("can't reach ...")를 보고한 채로 있을 수 있는 시간으로, 초과하면 stalled_timeout으로
#        실패 처리됩니다. 정체 복구 단계는 먼저 이 시간 동안 스스로 복구를 시도합니다.
#
#        기본값: 120
#

DungeonClear.TestRun.StallGraceS = 120

#
#    DungeonClear.TestRun.NoProgressS
#        조용한 무한 정체(livelock) 방지: 보스 처치나 목표 달성이 전혀 없이 진행이 지속될 수 있는 최대 시간으로,
#        초과하면 no_progress로 실패 처리됩니다.
#
#        기본값: 600
#

DungeonClear.TestRun.NoProgressS = 600

#
#    DungeonClear.TestRun.OverallTimeoutS
#        테스트 진행 한 번의 실제 경과 시간 절대 상한(준비 시간 제외)으로, 초과하면 overall_timeout으로
#        실패 처리됩니다.
#
#        기본값: 7200 (2시간)
#

DungeonClear.TestRun.OverallTimeoutS = 7200

#
#    DungeonClear.TestRun.MaxConcurrent
#        동시에 실행할 수 있는 `.dc test` 진행 수입니다. 각 진행은 자체 5봇 파티(자체 인스턴스, 감시기,
#        대시보드 카드)를 사용하므로, N개의 진행은 AiPlayerbot.MaxAddedBots에 대해 N*5 봇을 차지합니다.
#        그 상한을 넘게 되는 시작은 명시적인 메시지와 함께 즉시 거부됩니다. 이 상한을 넘어 시작하면
#        "max concurrent test runs reached" 메시지와 함께 거부됩니다.
#        0 = 무제한 (MaxAddedBots와 addclass 풀로만 제한됨),
#        이것이 기본값입니다. 머신의 실제 제한이 이미 예산을 초과하는 시작을 이유와 함께 거부하므로,
#        별도의 도구 자체 상한은 서버가 감당할 수 있었던 진행만 거부할 뿐입니다. 상한을 다시 두려면
#        양수를 지정하세요.
#
#        기본값: 0 (무제한)
#

DungeonClear.TestRun.MaxConcurrent = 0

#
#    DungeonClear.TestRun.MaxPlans
#        동시에 실행할 수 있는 `.dc test plan` 캠페인 수입니다. 각 계획은 `total=` 진행이 완료될 때까지
#        자체 `concurrent=` 수만큼의 테스트 진행을 유지하고, 끝나면 dc_testplans.jsonl에 요약 한 줄을
#        기록합니다. 0 = 무제한(기본값). 계획이 시작하는 진행은 여전히 MaxConcurrent와 봇 예산의 제한을 받습니다.
#
#        기본값: 0 (무제한)
#

DungeonClear.TestRun.MaxPlans = 0

#
#    DungeonClear.TestRun.Plan.MaxTotal
#        계획의 `total=` 인수에 대한 안전 상한입니다. 0 = 무제한(기본값). 실수로 total=2000을 입력해
#        서버가 며칠씩 돌아가는 일을 막으려면 양수를 지정하세요.
#
#        기본값: 0 (무제한)
#

DungeonClear.TestRun.Plan.MaxTotal = 0

#
#    DungeonClear.TestRun.Plan.BackoffMs
#        일시적인 시작 거부(전체 진행 상한 도달, MaxAddedBots 예산, addclass 풀 소진, 명령을 내린 GM의
#        일시적 오프라인) 후 계획이 재시도하기 전까지 기다리는 시간입니다.
#
#        기본값: 5000
#

DungeonClear.TestRun.Plan.BackoffMs = 5000

#
#    DungeonClear.TestRun.Plan.DriverWaitMs
#        헤드리스 테스트 드라이버가 로그인을 마치기를 계획이 기다리는 시간으로, 초과하면 포기하고 계획을
#        중단합니다. 명령을 내린 GM이 접속해 있지 않을 때만 적용됩니다(콘솔/대시보드에서 시작했거나 GM이
#        캠페인 도중 로그아웃한 경우). 이 설정이 없으면 드라이버가 끝내 뜨지 않는 계획이 영원히 재시도하게 됩니다.
#
#        기본값: 120000 (2분)
#

DungeonClear.TestRun.Plan.DriverWaitMs = 120000

#
#    DungeonClear.TestRun.DriverCharacter
#        `.dc test ...`가 콘솔이나 대시보드에서 실행될 때(진행을 연결할 게임 내 플레이어가 없음),
#        테스트 도구가 명령을 내린 "GM"으로서 헤드리스 로그인하는 캐릭터 이름입니다. 별도 준비는 필요 없습니다.
#        모듈이 처음 사용할 때 캐릭터를 생성하고(아래 DriverAccount 참고), 로그인시키고, AI의 마스터를
#        자기 자신으로 지정하며(파티가 실제 플레이어 마스터용 빠른 경로를 유지하도록), GM 모드로 대기시킨 뒤 재사용합니다
#        forever.
#
#        이름은 대소문자를 구분하는 정확한 조회로 찾으므로, 올바르게 대문자로 시작하는 캐릭터 이름이어야 합니다
#        ("dcdriver"가 아니라 "Dcdriver"). 그렇지 않은 이름은 생성하지 않고 거부합니다. 생성된 캐릭터를
#        다시는 찾을 수 없기 때문입니다.
#
#        기본값: "Dcdriver"
#

DungeonClear.TestRun.DriverCharacter = "Dcdriver"

#
#    DungeonClear.TestRun.DriverAccount
#        DriverCharacter를 소유하는 계정입니다. 콘솔/대시보드의 `.dc test`가 처음 드라이버를 필요로 할 때,
#        모듈이 계정(기록되지 않는 무작위 비밀번호로 생성 — 로그인이 필요하면 `account set
#        password`를 사용하세요)과 그 계정의 캐릭터를 생성합니다.
#
#        여기에는 GM 레벨이 필요 없습니다. 드라이버가 접속할 때 스스로 세션 권한을 올리므로, 계정은
#        일반 플레이어 계정으로 유지됩니다.
#
#        AiPlayerbot.RandomBotAccounts에 속한 계정이거나 addclass 풀 계정이면 안 됩니다. 봇 순환 기능이
#        그 캐릭터들을 관리하므로 진행 도중 드라이버를 로그아웃시킬 수 있습니다. 랜덤봇 계정은 사용하지 않고
#        거부합니다.
#
#        자동 생성을 끄고 캐릭터를 직접 제공하려면 ""로 설정하세요
#        yourself.
#
#        기본값: "dcdriver"
#

DungeonClear.TestRun.DriverAccount = "dcdriver"

###############################################################################
#
#   던전 찾기(RDF) 즉시 대기열 채우기 (DungeonClear.DungeonQueueFill.*)
#
#   실제 플레이어가 던전 찾기를 사용하면, 파티에 부족한 역할의 봇을 준비해 같은 대기열로 같은 던전에
#   대기시킵니다. 그러면 기본 LFG 매칭이 이들을 짝지어 줍니다. 플레이어는 평소와 같은 "Dungeon Found" 창을
#   받아 직접 수락하고, 기본 MakeNewGroup이 LFG 파티를 구성하고 던전 찾기 버프를 적용한 뒤 모두를
#   순간이동시킵니다. 클라이언트 흐름은 전혀 바뀌지 않습니다. 애드온도 명령어도 필요 없습니다.
#
#   렐름 전체의 동작을 바꾸므로 기본값은 꺼짐입니다.
#
#   DungeonClear.BgQueueFill.* 접두사는 전장용 대응 기능을 위해 예약되어 있으며, 이는 자체 스위치를
#   가진 별도 기능입니다.
#

#
#    DungeonClear.DungeonQueueFill.Enable
#        마스터 스위치입니다. 0 = 던전 찾기가 이 모듈이 없을 때와 똑같이 동작합니다.
#
#        채우기가 진행 중일 때 끄면 해당 채우기를 해제합니다(봇이 대기열에서 나가 로그아웃함).
#        대기 중인 봇이 방치되는 일은 없습니다.
#
#        기본값: 0 (꺼짐)
#

DungeonClear.DungeonQueueFill.Enable = 0

#
#    DungeonClear.DungeonQueueFill.MaxConcurrent
#        동시에 준비 단계에 있을 수 있는 채우기 수입니다. 각 채우기는 PlayerbotFactory를 통해 최대 네 봇을
#        준비하는데, 렐름 전체에서 월드 틱당 한 번씩만 처리되므로(`.dc test` 도구와 공유), 이 설정이
#        기능의 비용을 제한하는 조절 값입니다.
#
#        파티가 구성되기까지의 단계만 계산합니다. 파티가 구성된 채우기는 마지막에 봇을 로그아웃시키기 위해
#        던전이 끝날 때까지 그 파티를 계속 따라가지만, 그동안 비용이 들지 않으므로 여기에 계산되지 않습니다.
#        그렇지 않으면 던전을 공략하는 파티 하나가 거의 한 시간 동안 자리를 차지해, 다음에 파티 찾기를
#        누른 플레이어가 알 수 없는 이유로 채우기를 거부당하게 됩니다.
#
#        따라서 이 값은 동시에 나가 있는 파티 수를 제한하지 않으며, addclass 풀 사용량의 제한도 아닙니다.
#        풀은 MaxConcurrent x 4가 아니라 예상되는 동시 던전 수에 맞춰 채워 두세요. 풀이 비어 있는 채우기는
#        스스로 해제하고 플레이어에게 알립니다.
#
#        0 = 무제한 (권장하지 않음).
#
#        값을 올려도 처리량이 늘지 않습니다. 준비 중인 모든 채우기가 틱당 한 번의 같은 처리를 두고 경쟁하므로,
#        N개가 진행 중이면 각각의 준비 시간이 대략 N배로 늘어납니다. 너무 올리면 채우기가 구성되지 못하고
#        SetupTimeoutSec에 걸리기 시작합니다.
#
#        기본값: 3
#

DungeonClear.DungeonQueueFill.MaxConcurrent = 3

#
#    DungeonClear.DungeonQueueFill.SetupTimeoutSec
#        봇이 대기열에 들어가기까지 모든 과정의 제한 시간입니다. 플레이어 자신의 대기열이 안정되기를 기다리고,
#        풀 캐릭터를 확보하고, 로그인시키고, 준비 및 정리하는 과정이 포함됩니다.
#
#        시간이 초과되면 채우기가 해제되고 플레이어는 실제 대기열의 순서를 유지합니다. 채우기가 불가능하면
#        일반 매칭으로 돌아갈 뿐, 대기열이 깨지는 일은 없습니다.
#
#        기본값: 60
#

DungeonClear.DungeonQueueFill.SetupTimeoutSec = 60

#
#    DungeonClear.DungeonQueueFill.MatchTimeoutSec
#        봇이 대기열에 들어간 뒤 매칭을 기다리는 제한 시간입니다. 기본 호환성 검사는 지도 업데이트마다
#        새 대기열 항목을 하나씩 처리하므로 보통 몇 초 안에 매칭되며, 이 설정은 끝내 매칭되지 않는
#        경우만 잡아냅니다.
#
#        기본값: 120
#

DungeonClear.DungeonQueueFill.MatchTimeoutSec = 120

#
#    DungeonClear.DungeonQueueFill.MinPlayerLevel
#        이 레벨 미만의 플레이어에게는 채우기를 하지 않습니다.
#
#        기본값: 15 (던전 찾기 자체가 열리는 레벨)
#

DungeonClear.DungeonQueueFill.MinPlayerLevel = 15

#
#    DungeonClear.DungeonQueueFill.GearIlvl
#    DungeonClear.DungeonQueueFill.GearQuality
#        채워지는 봇의 장비 상한으로, `.dc test` 진행과 같은 단계 규칙으로 결정됩니다. GearIlvl은 아이템 레벨
#        상한이고, GearQuality는 아이템 품질입니다(2 = 고급, 3 = 희귀, 4 = 영웅).
#
#        어느 쪽이든 0이면 서버 전체 설정인 AiPlayerbot.AutoGearScoreLimit /
#        AiPlayerbot.AutoGearQualityLimit를 따르며, 보통은 이것이 원하는 동작입니다. 채워진 봇이
#        렐름의 다른 봇과 비슷해 보여야 하기 때문입니다.
#
#        기본값: 0 / 0 (상속)
#

DungeonClear.DungeonQueueFill.GearIlvl = 0
DungeonClear.DungeonQueueFill.GearQuality = 0

#
#    DungeonClear.DungeonQueueFill.AutoClear
#        0 = 채워진 봇이 다른 파티 봇과 똑같이 행동합니다:
#        플레이어를 따르며 돕습니다. 플레이어는 던전을 직접 플레이하려고 대기열에 등록했으므로 이것이
#        기본값입니다.
#
#        1 = 파티가 인스턴스에 들어가면 dungeon-clear 드라이버가 넘겨받아
#        인스턴스 공략을 직접 진행하고, 플레이어는 따라가기만 합니다.
#
#        기본값: 0
#

DungeonClear.DungeonQueueFill.AutoClear = 0

#
#    DungeonClear.DungeonQueueFill.LogoutOnRelease
#        1 = 채워진 봇을 로그아웃시킵니다: 채우기가 해제되거나 던전이
#        종료될 때. 0 = 월드에 그대로 남겨 둡니다(채우기를 디버깅할 때 이후 캐릭터를 살펴볼 수 있어 유용함).
#
#        기본값: 1
#

DungeonClear.DungeonQueueFill.LogoutOnRelease = 1
