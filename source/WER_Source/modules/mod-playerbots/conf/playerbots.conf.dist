####################################################################################################

###################################
#                                 #
# 공격대                           #
#                                 #
###################################

####################################################################################################
#
#

# 영웅 난이도를 더 쉽고 가볍게 즐길 수 있도록 ICC에서 버프를 활성화합니다.
# 피해 30% 증가, 받는 피해 40% 감소(탱커 봇), 모든 저항 증가, 탱커가 아닌 봇의 위협 감소,
# 탱커 봇의 위협 증가.
# 버프는 LDW, PP, Sindragosa, Lich King에서 적용됩니다.
# 기본값: 1 (활성)
AiPlayerbot.EnableICCBuffs = 1

#
#
####################################################################################################

###################################
#                                 #
# PLAYERBOTS 시스템 설정      #
#                                 #
###################################

####################################################################################################
# 데이터베이스 및 연결
#
#    PlayerbotsDatabaseInfo
#        설명: playerbots 서버의 데이터베이스 연결 설정.
#        예:          "hostname;port;username;password;database"
#                     ".;somenumber;username;password;database" - (Windows에서 명명된 파이프 사용 시
#                                                                 my.ini의 [mysqld] 섹션에
#                                                                 "enable-named-pipe" 추가)
#                     ".;/path/to/unix_socket;username;password;database" - (Unix/Linux에서
#                                                                           Unix 소켓 사용)
#        기본값:      "127.0.0.1;3306;acore;acore;acore_playerbots"       - (PlayerbotDatabaseInfo)

PlayerbotsDatabaseInfo = "127.0.0.1;3306;wowlegends;wowlegends;wl_playerbots"

#    PlayerbotsDatabase.WorkerThreads
#        설명: 비동기 (지연) MySQL 문을 처리하기 위해 생성할 작업 스레드 수입니다.
#                     각 작업 스레드는 MySQL 서버에 대한 자체 연결과
#                     MySQL 서버 내 자체 스레드에 각각 대응합니다.
#        기본값:     1 - (PlayerbotsDatabase.WorkerThreads)

PlayerbotsDatabase.WorkerThreads     = 1

#    PlayerbotsDatabase.SynchThreads
#        설명: 처리를 위해 생성할 MySQL 연결 수입니다.
#        기본값:     1 - (PlayerbotDatabase.WorkerThreads)

PlayerbotsDatabase.SynchThreads     = 1

#    Playerbot.Updates.EnableDatabases
#        설명: 업데이트 시스템이 Playerbots 데이터베이스에 적용될지 결정합니다.
#
#        기본값:     1  - (활성)
#                     0  - (비활성)

Playerbots.Updates.EnableDatabases = 1

# 명령 서버 포트, 0 - 비활성화
AiPlayerbot.CommandServerPort = 8888

#
#
####################################################################################################

####################################################################################################
# 디버그 전환 설정
#

AiPlayerbot.SpellDump = 0
AiPlayerbot.LogInGroupOnly = 1
AiPlayerbot.LogValuesPerTick = 0
AiPlayerbot.RandomChangeMultiplier = 1

# 회피 중인 주문을 알림 (실험적 기능)
# 기본값: 0 (비활성)
AiPlayerbot.TellWhenAvoidAoe = 0

# 성능 모니터 활성화/비활성화
AiPlayerbot.PerfMonEnabled = 0

#
#
####################################################################################################

####################################################################################################
# 채팅 설정
#

# 봇 채팅 명령의 접두사. WER: "$"로 설정하여 일반 귓속말은 AI CHAT으로 가고
# $ 접두사가 붙은 귓속말만 명령으로 처리됩니다 (예: $follow, $stay, $go x,y).
# ⚠️ 여기에 "!"나 "."를 사용하지 마세요 — AzerothCore 코어가 둘 다 GM 명령 접두사로 예약하고 있어
# (Chat.cpp ParseCommands), "!stay"는 봇에 전달되지 않고 코어 명령 파서가 가로채서 GM에게는
# "Command 'stay' does not exist"를 표시합니다(GM이 아니면 아무 표시 없이 무시됨).
# "$"는 코어가 무시하므로 GM과 일반 플레이어 모두 명령이 작동합니다.
# 빈 값 = 모든 귓속말을 명령으로 해석하므로, 채팅 단어가 명령과 일치하면 명령 도움말이 도배됩니다.
AiPlayerbot.CommandPrefix = "$"

# 봇 채팅 명령의 구분자
AiPlayerbot.CommandSeparator = "\\\\"

# 채팅 메시지에 아이템 관련 키워드가 있으면 아이템 개수 확인/거래를
# 자동 실행합니다. 활성화 (1)하면 채팅에서 아이템을 언급할 때
# (예: "food", "potion", "ammo") 자동으로 소지품을 표시하고
# 봇과의 거래 창을 엽니다. 명시적인 "c" 및 "t" 명령은
# 이 설정과 관계없이 계속 작동합니다.
# 기본값: 1 (활성)
AiPlayerbot.EnableAutoTradeOnItemMention = 1

# 봇 대화 활성화 (일반 대화 / 외침 / 일반 채팅 / 파티 찾기)
AiPlayerbot.RandomBotTalk = 1
# 봇 감정 표현 활성화
AiPlayerbot.RandomBotEmote = 0
# 무작위 봇이 채팅에서 던전을 제안하도록 활성화
AiPlayerbot.RandomBotSuggestDungeons = 1
# 봇이 초대받으면 플레이어에게 인사
AiPlayerbot.EnableGreet = 1
# 실제 근접 인사 확률(0-100). 실패한 대상은 반복 시도하지 않습니다.
AiPlayerbot.GreetChance = 3
# 공격적인 링크에 공격적인 링크로 답할 확률 (0-100)
AiPlayerbot.ToxicLinksRepliesChance = 30
# 우레폭풍에 우레폭풍으로 답할 확률 (0-100)
AiPlayerbot.ThunderfuryRepliesChance = 40
# 특정 사건에 대해 봇이 길드 채팅을 하도록 활성화
AIPlayerbot.GuildFeedback = 1
# 특정 사건에 대해 봇이 길드에서 대화할 확률 (정수) (0-100)
AiPlayerbot.GuildRepliesRate = 100
# 주인이 없는 봇도 대사 출력
AiPlayerbot.RandomBotSayWithoutMaster = 0

#
#
####################################################################################################

####################################################################################################
# 알림 전송 확률
#

# 전체 알림 전송 활성화/비활성화
# 기본값: 1 (활성)
AiPlayerbot.EnableBroadcasts = 1

# 모든 알림 확률은 0-30000 범위여야 합니다
# 0이면 해당 알림이 비활성화됩니다
# 내부적인 무작위 요소도 있으므로 30000으로 설정해도 알림이 보장되지는 않습니다
# 채널 알림 확률을 0으로 설정하면 대부분의 알림이 사용 가능한 다른 채널로 전환됩니다
# 모든 채널 알림을 0으로 설정하면 대부분의 알림이 비활성화됩니다
AiPlayerbot.BroadcastToGuildGlobalChance = 30000
AiPlayerbot.BroadcastToWorldGlobalChance = 30000
AiPlayerbot.BroadcastToGeneralGlobalChance = 30000
AiPlayerbot.BroadcastToTradeGlobalChance = 30000
AiPlayerbot.BroadcastToLFGGlobalChance = 30000
AiPlayerbot.BroadcastToLocalDefenseGlobalChance = 30000
AiPlayerbot.BroadcastToWorldDefenseGlobalChance = 30000
AiPlayerbot.BroadcastToGuildRecruitmentGlobalChance = 30000

