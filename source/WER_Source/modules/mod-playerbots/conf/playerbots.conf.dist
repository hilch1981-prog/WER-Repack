AiPlayerbot.AttunementQuests = 10279,10277,10282,10283,10284,10285,10296,10297,10298,11481,11482,11488,11490,11492,10901,10888,10445,10985

#
#
####################################################################################################

####################################################################################################
# 비행 경로
#

# 1번째 추종 봇이 비행 조련사를 클릭하기 전의 최소 무작위 지연 (ms)
AiPlayerbot.BotTaxiDelayMinMs = 350

# 전체 비행 지연 구간의 상한 (ms). 값이 클수록 대규모 공격대의 출발 시점이 더 분산됩니다.
AiPlayerbot.BotTaxiDelayMaxMs = 5000

# 봇이 동시에 출발하지 않도록 파티 슬롯마다 추가하는 고정 간격 (ms)
AiPlayerbot.BotTaxiGapMs = 200

# 출발이 기계적으로 보이지 않도록 각 간격에 추가하는 작은 무작위 지연 (ms)
AiPlayerbot.BotTaxiGapJitterMs = 100

#
#
####################################################################################################

####################################################################################################
# 전문기술
#

# 각 직업 그룹의 랜덤봇 중 해당 직업에 맞는 가중치 기반
# 전문 기술 조합을 받는 비율입니다. 나머지 랜덤봇은 가중치가 적용된
# 합리적인 무작위 전문 기술 쌍 풀을 사용합니다.
# 기본값: 30
AiPlayerbot.ClassMatchingProfessionChance = 30

# 봇의 주인이 낚시할 때 낚시 기술이 있는 봇에 'master fishing' 전략을 자동 추가합니다.
# 기본값: 1 (활성)
AiPlayerbot.EnableFishingWithMaster = 1

# 주인이 있는 봇이 낚시할 물을 찾는 자기 주변 탐색 거리 (야드)
AiPlayerbot.FishingDistanceFromMaster = 10.0

# 주인이 없는 봇이 낚시할 물을 찾는 자기 주변 탐색 거리 (야드)
# 현재 주인이 없는 봇은 낚시하지 않으므로 이 설정은 영향을 주지 않습니다.
AiPlayerbot.FishingDistance = 40.0

# 봇이 물에서 이 거리 (야드)보다 멀어지면 'master fishing' 전략을 제거합니다.
AiPlayerbot.EndFishingWithMaster = 30.0

#
#
####################################################################################################

#######################################
#                                     #
# 랜덤봇 전용 설정                   #
#                                     #
#######################################

####################################################################################################
# 일반
#

# 무작위 봇 계정의 무작위 비밀번호 생성 활성화/비활성화
AiPlayerbot.RandomBotRandomPassword = 0

# 무작위 봇의 최소 및 최대 레벨
AiPlayerbot.RandomBotMinLevel = 1
AiPlayerbot.RandomBotMaxLevel = 80

# 랜덤봇의 최대 레벨을 접속 중인 플레이어의 최대 레벨에 동기화
# 기본값: 0 (비활성)
AiPlayerbot.SyncLevelWithPlayers = 0

# 랜덤봇의 순간이동을 실제(GM이 아닌) 플레이어가 있는 레벨에 맞는 야외 지역으로 집중시킵니다.
# 플레이어가 있는 지역 중 일치하는 곳이 없으면 일반 순간이동 방식으로 돌아갑니다.
# AiPlayerbot.SyncLevelWithPlayers와 함께 사용하는 것이 가장 좋습니다.
# 기본값: 0 (비활성)
AiPlayerbot.RandomBotConcentrateInPlayerZone = 0

# 봇 레벨 이하인 여러 퀘스트를 완료 처리 (봇 생성 속도가 느려짐)
# 기본값: 0 (비활성)
AiPlayerbot.PreQuests = 0

# 랜덤봇의 던전 찾기 (LFG) 활성화
# 기본값: 1 (활성)
AiPlayerbot.RandomBotJoinLfg = 1

# 모든 플레이어가 동시에 접속하지 않는 실제 상황을 모방하도록 랜덤봇의 주기적인 접속/접속 종료 활성화/비활성화
# 활성화하면 더 큰 봇 집합에서 무작위로 봇을 선택하여 주기적으로 접속하거나 접속을 종료합니다.
# 기본값: 0 (비활성, 접속 중인 봇의 구성이 고정됨)
AiPlayerbot.EnablePeriodicOnlineOffline = 0

# 전체 랜덤봇 수 (오프라인 포함)와 현재 접속 중인 랜덤봇 수 (MaxRandomBots) 사이의 비율
# 이 값은 1.0보다 커야 하며 EnablePeriodicOnlineOffline이 활성화된 경우에만 적용됩니다.
# 기본값: 2.0 (전체 봇 수가 MaxRandomBots의 두 배)
AiPlayerbot.PeriodicOnlineOfflineRatio = 2.0

# 얼라이언스 및 호드 무작위 봇의 백분율 비율
AiPlayerbot.RandomBotAllianceRatio = 50
AiPlayerbot.RandomBotHordeRatio = 50

# 죽음의 기사 봇 로그인 비활성화
AiPlayerbot.DisableDeathKnightLogin = 0

# 특성과 문양에 확장팩 제한을 모의 적용
# 활성화하면 61레벨 미만 봇은 특성 트리가 6줄과 7번째 줄 가운데 특성까지로,
# 61레벨부터 71레벨 미만 봇은 8줄과 9번째 줄 가운데 특성까지로 제한됩니다
# 기본값: 0 (비활성)
AiPlayerbot.LimitTalentsExpansion = 0

# 랜덤봇 거래 설정 (0: 비활성화, 1: 활성화, 2: 구매만, 3: 판매만)
# 기본값: 1 (활성)
AiPlayerbot.EnableRandomBotTrading = 1

# 거래 창을 여는 거래 행동의 메시지 분석에서 제외할 메시지 접두사 설정
AiPlayerbot.TradeActionExcludedPrefixes = "RPLL_H_,DBMv4,{звезда} Questie,{rt1} Questie"

# 봇의 우편 발송을 허용합니다. 비활성이면 봇이 채팅 명령("send mail")에 응답하여
# 아이템이나 돈을 우편으로 보내지 않습니다.
# 기본값: 1 (활성)
AiPlayerbot.BotSendMailEnabled = 1

#
#
####################################################################################################

####################################################################################################
# 레벨
#

# 랜덤봇을 무작위 레벨로 생성하는 기능 비활성화
# 무작위 레벨 생성을 비활성화하면 모든 랜덤봇이 지정된 레벨로 시작합니다 (몬스터 처치와 퀘스트로 레벨 상승은 가능).
AiPlayerbot.DisableRandomLevels = 0

# "AiPlayerbot.DisableRandomLevels"가 활성일 때 랜덤봇의 시작 레벨을 여기서 설정합니다
AiPlayerbot.RandombotStartingLevel = 1

# 랜덤봇이 최초 무작위 초기화 시 최소 레벨일 확률
# 기본값: 0.1 (10%) - 시작 지역에 저레벨 봇이 계속 있도록 상향
AiPlayerbot.RandomBotMinLevelChance = 0.25

# 랜덤봇이 최초 무작위 초기화 시 최대 레벨일 확률
# 기본값 0.1 (10%)
AiPlayerbot.RandomBotMaxLevelChance = 0.1

# 랜덤봇의 레벨 고정 (레벨이 오르지 않음)
# 기본값: 0 (비활성)
AiPlayerbot.RandomBotFixedLevel = 0

# RandomBotMaxLevel 레벨의 봇을 RandomBotMinLevel로 설정
# 기본값: 0 (비활성)
AiPlayerbot.DowngradeMaxLevelBot = 0

# 랜덤봇의 경험치 배율 설정 (기본값: 1.0)
# 서버 경험치 배율 * AiPlayerbot.RandomBotXPRate
AiPlayerbot.RandomBotXPRate = 1.0

#
#
####################################################################################################

####################################################################################################
# 랜덤봇 레벨 관리 (레벨 구간 + 레벨 초기화)
#
# 시간에 따라 랜덤봇 레벨을 관리하는, 서로 독립적이고 선택적으로 켜는 두 하위 기능입니다. 둘 다
# 표준 ".reload config" GM 명령으로 변경된 값을 반영합니다.
#
#   - 레벨 구간(Level Brackets): 진영별로 설정 가능한 레벨 구간에 랜덤봇을 주기적으로 재분배하며,
#     선택적으로 실제(봇이 아닌) 플레이어가 있는 구간에 가중치를 둘 수 있습니다.
#     AiPlayerbot.DowngradeMaxLevelBot 방식의 동작을 보완합니다: 한 번 하향하는 대신
#     전체 랜덤봇 인구를 시간에 걸쳐 구간별로 계속 재조정합니다.
#
#   - 레벨 초기화(Level Reset): 랜덤봇이 설정된 최대 레벨에 도달하면 PlayerbotFactory 전체 무작위화로
#     더 낮은 레벨로 되돌립니다. 선택적 확률(레벨에 따라 조정 가능), 선택적 최소 플레이 시간 제한,
#     그리고 봇이 설정된 트리거 레벨에 도달하는 즉시 다른 레벨로 보내는 선택적 "건너뛰기"를 지원합니다.
#
# 참고: 레벨 초기화는 AiPlayerbot.DowngradeMaxLevelBot와 기능이 겹칩니다. 이 옵션은 이미
#       RandomBotMaxLevel에 도달한 봇을 다음 주기적 재무작위화 때 RandomBotMinLevel로 낮춥니다.
#       반면 레벨 초기화는 봇이 설정된 레벨에 도달하는 즉시(또는 플레이 시간 타이머에 따라) 동작하며,
#       자체 확률/플레이 시간 설정을 가집니다. 일반적으로 AiPlayerbot.DowngradeMaxLevelBot와
#       AiPlayerbot.ResetBotLevel.Enabled를 동시에 활성화하지 마세요.
#

##############################################
# 레벨 구간
##############################################

# 레벨 구간 기능을 활성화합니다.
# 기본값: 0 (비활성)
AiPlayerbot.LevelBrackets.Enabled = 0

# 봇 레벨 분포 검사를 수행하는 주기(초).
# 기본값: 300
AiPlayerbot.LevelBrackets.CheckFrequency = 300

# 안전한 봇, 그리고 처음에 안전 검사를 통과하지 못해 표시된 봇의 대기 중인 레벨 초기화를
# 처리하는 주기(초).
# 기본값: 15
AiPlayerbot.LevelBrackets.CheckFlaggedFrequency = 15

# 대기 중인 레벨 변경 단계마다 처리할 표시된 봇의 최대 수.
# 0 = 무제한 (단계마다 표시된 봇을 모두 처리)
# 기본값: 5
AiPlayerbot.LevelBrackets.FlaggedProcessLimit = 5

# 활성이면 실제(봇이 아닌) 플레이어가 길드장인 길드에 속한 봇은 봇 구간 계산에서 제외되며
# 레벨 변경이나 표시 대상이 되지 않습니다. 공유 PlayerbotGuildMgr 길드 캐시(시작 시 검증되고
# 매시간 갱신)를 사용하며 오프라인 플레이어도 포함합니다. 길드장이 랜덤봇 계정이 아니면
# 실제 길드로 간주합니다.
# 기본값: 1 (활성)
AiPlayerbot.LevelBrackets.IgnoreGuildBotsWithRealPlayers = 1

# 활성이면 투기장 팀에 속한 봇은 봇 구간 계산에서 제외되며 레벨 변경이나 표시 대상이 되지
# 않습니다. 투기장 팀에 속한 봇이 변경되어 팀 구성이 깨지는 것을 방지합니다.
# 기본값: 1 (활성)
AiPlayerbot.LevelBrackets.IgnoreArenaTeamBots = 1

# 실제 플레이어의 친구 목록에 있는 봇을 모든 구간에서 무시합니다.
# 기본값: 1 (활성)
AiPlayerbot.LevelBrackets.IgnoreFriendListed = 1

# 모든 구간 검사에서 제외할 봇 이름 목록(쉼표로 구분). 이름은 캐릭터 이름과 정확히 일치해야
# 합니다(캐릭터 이름은 첫 글자가 대문자로 저장됨, 예: "Thrall").
# 기본값: ""
AiPlayerbot.LevelBrackets.ExcludeNames =

# 봇 분배에 사용하는 레벨 구간 수. 얼라이언스와 호드 모두 아래에 같은 수의 구간이
# 정의되어 있어야 합니다.
# 기본값: 9
#
# 중요: 구간 수를 9개보다 늘리면, 추가 구간에 대한 설정 줄(예: Range10, Range11 등)을
#       playerbots.conf와 이 playerbots.conf.dist 양쪽에 추가해야 합니다. 각 진영의
#       Pct 값 합계가 100이 되도록 유지하세요.
AiPlayerbot.LevelBrackets.NumRanges = 9

# 각 레벨 구간에 있는 봇이 아닌 플레이어 수를 바탕으로 봇 분배 비율을 동적으로 다시 계산합니다.
# 이 설정은 conf의 사용자 지정 구간을 덮어씁니다.
# 기본값: 0 (비활성)
AiPlayerbot.LevelBrackets.Dynamic.UseDynamicDistribution = 0

# 동적 분배가 활성일 때, 실제(봇이 아닌) 플레이어가 있는 구간(레벨 범위)에 주는 추가 가중치를
# 조절합니다. 값이 클수록 실제 플레이어가 있는 레벨 구간으로 더 많은 봇이 이동하지만, 효과는
# 극단적이지 않고 완만합니다. 0.0이면 플레이어 위치와 관계없이 봇이 모든 구간에 고르게 분배됩니다.
# 기본값 1.0은 온건하고 균형 잡힌 효과를 줍니다. 3.0, 5.0 이상으로 올리면 실제 플레이어가 있는
# 구간에 봇이 더 몰립니다. 이 값은 배수(퍼센트 아님)입니다:
# 0.0 = 추가 효과 없음, 1.0 = 최소, 3.0 = 더 강함, 5.0 = 강하지만 극단적이지 않음. 실험을 통해
# 전체 봇 수와 실제 플레이어 수를 바탕으로 서버에 맞는 값을 찾으세요. 솔로 플레이를 위해
# 자신의 레벨 구간에 봇이 많이 몰리기를 원한다면 10-15를 권장합니다.
# 예상 결과:
#   - 1.0(기본값): 실제 플레이어 10명 중 6명이 한 구간에 있으면 그 구간은 봇의 약 12.77%를
#     받습니다. 플레이어가 없는 구간은 각각 약 10.69%.
#   - 3.0: 같은 상황에서 그 구간은 봇의 약 15.73%. 플레이어가 없는 구간: 각각 9.93%.
#   - 5.0: 실제 플레이어 6/10이 있는 구간은 18.31%. 플레이어가 없는 구간: 각각 9.28%.
#   - 모든 실제 플레이어가 한 구간에 있고 가중치가 5.0이면 그 구간은 봇의 약 21.56%를
#     받습니다(나머지: 각각 9.80%).
#   - 0.0: 모든 구간이 항상 같은 수의 봇을 받습니다(예: 구간이 9개면 각각 11.11%).
# 공식 (구간별):
#   bracket_weight = 1.0 + (RealPlayerWeight x (1 / TotalRealPlayers) x log(1 + RealPlayersInBracket))
#   모든 구간 가중치는 합계 100%로 정규화됩니다.
# 기본값: 1.0
AiPlayerbot.LevelBrackets.Dynamic.RealPlayerWeight = 1.0

# 활성이면 얼라이언스와 호드의 구간 정의가 동일해야 합니다(같은 개수, 같은 레벨 경계).
# 모든 실제 플레이어(진영 무관)가 두 진영의 동적 분배에 영향을 줍니다.
# 기본값: 0 (비활성)
# 참고: 활성 상태에서 구간이 일치하지 않으면 해당 세션에서 SyncFactions가 강제로 비활성화되고
#       오류가 기록됩니다. 이 때문에 서버 시작이 실패하지는 않습니다.
AiPlayerbot.LevelBrackets.Dynamic.SyncFactions = 0

##############################################
# 얼라이언스 레벨 구간 설정
##############################################
# 다음 설정은 얼라이언스 봇의 레벨 구간을 정의합니다. 각 구간마다 다음을 지정하세요:
#
#    AiPlayerbot.LevelBrackets.Alliance.RangeX.Lower
#        설명: X번 구간의 하한(포함).
#
#    AiPlayerbot.LevelBrackets.Alliance.RangeX.Upper
#        설명: X번 구간의 상한(포함).
#
#    AiPlayerbot.LevelBrackets.Alliance.RangeX.Pct
#        설명: X번 구간에 속해야 할 얼라이언스 봇의 목표 비율(%).
#
# 예:
#   아래 기본 설정은 9개 구간을 정의합니다: Range1은 1-9레벨, Range2는 10-19레벨,
#   Range3은 20-29레벨 등을 포함합니다.
#
#   구간을 조정하거나 새 구간을 추가하려면 (예: 60레벨만 별도 구간으로 분리):
#       - Range7.Lower = 60, Range7.Upper = 60으로 설정한 뒤 Range6과 Range8의
#         Pct 값을 그에 맞게 조정하세요.
#
#   기본 9개 외에 구간을 추가하려면:
#       1. AiPlayerbot.LevelBrackets.NumRanges를 원하는 수로 늘립니다.
#       2. 새 RangeX.Lower, RangeX.Upper, RangeX.Pct 설정 줄을 추가합니다.
#
# 참고: 얼라이언스 구간의 모든 Pct 값 합계는 100이어야 합니다.
#
AiPlayerbot.LevelBrackets.Alliance.Range1.Lower = 1
AiPlayerbot.LevelBrackets.Alliance.Range1.Upper = 9
AiPlayerbot.LevelBrackets.Alliance.Range1.Pct   = 12

