# 랜덤봇 순간이동 시 ZoneBracket.<지역ID>에 정의된 레벨 범위를 적용합니다.
# 활성화하면 저레벨 지역으로 만렙 봇이 순간이동하는 것을 막습니다. ZoneBracket에 없는
# 지역은 기존 규칙을 유지합니다.
# 기본값: 1 (활성)

# 봇이 지역 내 최저 레벨 생물보다 몇 레벨 낮을 수 있는지 설정
# AiPlayerbot.EnableNewRpgStrategy가 활성화되어 있으면 효과가 없습니다.
# 기본값: 1 (랜덤봇이 1레벨 넘게 낮으면 떠남)
AiPlayerbot.RandomBotTeleLowerLevel = 1

# 봇이 지역 내 최고 레벨 생물보다 몇 레벨 높을 수 있는지 설정
# AiPlayerbot.EnableNewRpgStrategy가 활성화되어 있으면 효과가 없습니다.
# 기본값: 3 (랜덤봇이 3레벨 넘게 높으면 떠남)
AiPlayerbot.RandomBotTeleHigherLevel = 3

# 봇이 레벨 상승 시 육성을 위해 다른 장소로 자동 순간이동
# 기본값: 1 (활성)
AiPlayerbot.AutoTeleportForLevel = 1

#
#
####################################################################################################

####################################################################################################
# 전장 및 투기장 및 PvP
#

# 무작위 봇의 전장/투기장 활성화
AiPlayerbot.RandomBotJoinBG = 1

# 전장 자동 참가 활성화: 봇이 스스로 전장과 투기장을 시작하게 합니다.
AiPlayerbot.RandomBotAutoJoinBG = 0

# RandomBotAutoJoinBG에 필요한 설정
#
# 알려진 문제: 여러 구간을 여러 인스턴스와 함께 활성화하면 봇이 의도보다 많은 인스턴스를
# 생성할 수 있습니다(과다 대기열 등록).
#
# 이 섹션은 전장 및 투기장의 레벨 구간과 봇의 자동 참가를 제어합니다.
#
# 구간:
# - 봇이 자동 참가할 레벨 범위를 지정합니다 (구간 ID는 전장별로 다르며, 각 전장의 최소 레벨에서 0부터 시작):
#   - Warsong Gulch    (WS): 0=10-19, 1=20-29, 2=30-39, 3=40-49, 4=50-59, 5=60-69, 6=70-79, 7=80    (기본값: 7)
#   - Arathi Basin     (AB): 0=20-29, 1=30-39, 2=40-49, 3=50-59, 4=60-69, 5=70-79, 6=80             (기본값: 6)
#   - Alterac Valley   (AV): 0=51-60, 1=61-70, 2=71-79, 3=80                                        (기본값: 3)
#   - Eye of the Storm (EY): 0=61-69, 1=70-79, 2=80                                                 (기본값: 2)
#   - Isle of Conquest (IC): 0=71-79, 1=80                                                          (기본값: 1)
# - 전장 구간은 쉼표로 구분해 여러 개 지정할 수 있습니다 (예: "0,2,5"). 평점제 투기장에는 해당되지 않습니다.
#   - 평점제 투기장:         0=10-14, 1=15-19, 2=20-24, ..., 13=75-79, 14=80-84                     (기본값: 14)
#
# 개수:
# - 구간마다 자동으로 채울 전투 수를 지정합니다.
# - 전장의 경우 'Count"는 구간당 전투 수입니다. 예:
#   - RandomBotAutoJoinWSBrackets = 6,7
#   - RandomBotAutoJoinBGWSCount = 1
#   - 이 설정은 구간 6과 구간 7에 각각 하나씩, 총 두 개의 전투를 생성합니다.
# - 지정한 개수를 채울 만큼 조건에 맞는 봇이 충분한지 확인하세요.

# 전장별로 지정 가능한 레벨 구간 범위:
# AiPlayerbot.RandomBotAutoJoinWSBrackets = 0,1,2,3,4,5,6,7
# AiPlayerbot.RandomBotAutoJoinABBrackets = 0,1,2,3,4,5,6
# AiPlayerbot.RandomBotAutoJoinAVBrackets = 0,1,2,3
# AiPlayerbot.RandomBotAutoJoinEYBrackets = 0,1,2
# AiPlayerbot.RandomBotAutoJoinICBrackets = 0,1
AiPlayerbot.RandomBotAutoJoinWSBrackets = 7
AiPlayerbot.RandomBotAutoJoinABBrackets = 6
AiPlayerbot.RandomBotAutoJoinAVBrackets = 3
AiPlayerbot.RandomBotAutoJoinEYBrackets = 2
AiPlayerbot.RandomBotAutoJoinICBrackets = 1

# 전장 전투 수 (구간별):
AiPlayerbot.RandomBotAutoJoinBGWSCount = 1
AiPlayerbot.RandomBotAutoJoinBGABCount = 1
AiPlayerbot.RandomBotAutoJoinBGAVCount = 0
AiPlayerbot.RandomBotAutoJoinBGEYCount = 1
AiPlayerbot.RandomBotAutoJoinBGICCount = 0

# 투기장 구간 (단일 구간만):
# 낮은 레벨 투기장 구간이 제대로 작동하려면 별도의 코드 수정이 필요합니다.
AiPlayerbot.RandomBotAutoJoinArenaBracket = 14

# 투기장 전투 수:
AiPlayerbot.RandomBotAutoJoinBGRatedArena2v2Count = 0
AiPlayerbot.RandomBotAutoJoinBGRatedArena3v3Count = 0
AiPlayerbot.RandomBotAutoJoinBGRatedArena5v5Count = 0

# 랜덤봇 투기장 팀 수
# 팀은 서버 재시작 시 봇이 초기화될 때 생성됩니다.
# 먼저 모든 투기장 팀을 삭제한 뒤 봇을 다시 초기화해야 할 수 있습니다.
# 경고: 봇을 다시 초기화하면 완전히 초기화됩니다 (게임 내 명령: .playerbots rndbot init)
# 대기열 문제를 피하기 위해 봇은 투기장 팀 하나에만 가입합니다. 수를 늘릴 때 이 점을 고려하세요.
# 기본값: 2v2: 10 (봇 20), 3v3: 10 (봇 30), 5v5: 5 (봇 25)
AiPlayerbot.RandomBotArenaTeam2v2Count = 10
AiPlayerbot.RandomBotArenaTeam3v3Count = 10
AiPlayerbot.RandomBotArenaTeam5v5Count = 5

# 팀 생성 시 투기장 평점을 무작위로 설정합니다.
# 기본값: 최대: 2000, 최소: 1000
AiPlayerbot.RandomBotArenaTeamMaxRating = 2000
AiPlayerbot.RandomBotArenaTeamMinRating = 1000

# 시작 시 모든 랜덤봇(및 애드클래스 봇) 투기장 팀을 삭제합니다. 활성 상태에서는
# 새 랜덤봇 투기장 팀이 생성되거나 가입되지 않습니다. 정상적인 랜덤봇 투기장 팀 배정을
# 재개하려면 0으로 되돌리고 서버를 재시작하세요.
AiPlayerbot.DeleteRandomBotArenaTeams = 0

# PvP 제한 지역 (봇이 PvP를 먼저 걸지 않으며 공격받아도 방어하지 않음)
AiPlayerbot.PvpProhibitedZoneIds = "2255,656,2361,2362,2363,976,35,2268,3425,392,541,1446,3828,3712,3738,3565,3539,3623,4152,3988,4658,4284,4418,4436,4275,4323,4395,3703,4298,3951"

# PvP 제한 구역 (봇이 PvP를 먼저 걸지 않으며 공격받아도 방어하지 않음)
AiPlayerbot.PvpProhibitedAreaIds = "976,35,392,2268,4161,4010,4317,4312,3649,3887,3958,3724,4080,3938,3754,3786,3973,4085,4086,4087,4088"

# 전장 및 투기장에서 반응 속도 개선 (지연을 유발할 수 있음)
AiPlayerbot.FastReactInBG = 1

#
#
####################################################################################################

####################################################################################################
# 랜덤봇 타이밍 및 행동
#

# 랜덤봇 관리자가 메인 업데이트 루프를 실행하는 주기(초)
# 기본값: 20
AiPlayerbot.RandomBotUpdateInterval = 20

# 관리자가 전체 랜덤봇 수를 다시 평가하고 조정하기까지의 최소/최대 초
# 기본값: 1800 (최소), 7200 (최대)
AiPlayerbot.RandomBotCountChangeMinInterval = 1800
AiPlayerbot.RandomBotCountChangeMaxInterval = 7200

# 랜덤봇이 로그아웃하기 전까지 접속 상태를 유지하는 최소/최대 초
# 기본값: 600 (최소), 28800 (최대)
AiPlayerbot.MinRandomBotInWorldTime = 600
AiPlayerbot.MaxRandomBotInWorldTime = 28800

# 랜덤봇이 접속해 있고 유휴 상태일 때 일부 요소가 주기적으로 무작위화됩니다.
# 가방이 포함되며, EquipAndSpecPersistence가 비활성이면 장비와 특성 전문화도 포함됩니다.
# 이 설정은 그러한 무작위화 사이의 최소/최대 초를 지정합니다.
# 기본값: 7200 (최소 - 2시간), 1209600 (최대 - 14일)
AiPlayerbot.MinRandomBotRandomizeTime = 7200
AiPlayerbot.MaxRandomBotRandomizeTime = 1209600

# 관리자의 갱신 주기마다 처리할 봇 수 (로그인, 로그아웃, 갱신)
# 기본값: 60
AiPlayerbot.RandomBotsPerInterval = 60

# 로그에 랜덤봇 통계를 주기적으로 기록하는 간격(초)
# (접속 수, 레벨/종족/직업 분포, 역할, 상태). 0이면 비활성.
# 기본값: 300
AiPlayerbot.RandomBotPrintStatsInterval = 300

# 봇이 사망한 후 부활하기까지의 최소 및 최대 시간 (초)
# 기본값: 60 (최소), 300 (최대)
AiPlayerbot.MinRandomBotReviveTime = 60
AiPlayerbot.MaxRandomBotReviveTime = 300

# 봇이 새 구역이나 지역으로 순간이동하는 최소 및 최대 간격 (초)
# 기본값: 3600 (최소), 18000 (최대)
AiPlayerbot.MinRandomBotTeleportInterval = 3600
AiPlayerbot.MaxRandomBotTeleportInterval = 18000

# 영구 봇으로 표시된 봇이 세계에 머무는 시간 (초, 31,104,000 ≈ 1년)
# 기본값: 31104000
AiPlayerbot.PermanentlyInWorldTime = 31104000

