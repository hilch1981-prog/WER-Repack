##############################################
# 레벨 초기화
##############################################

# 레벨 초기화 기능을 활성화합니다.
# 기본값: 0 (비활성)
AiPlayerbot.ResetBotLevel.Enabled = 0

# 초기화되기 전에 봇이 도달할 수 있는 최대 레벨.
# 기본값:     80
# 유효 범위: 2-80 (0이면 최대 레벨 초기화 검사를 끔; SkipFromLevel/SkipToLevel은 계속 적용됨)
AiPlayerbot.ResetBotLevel.MaxLevel = 80

# 봇이 초기화될 레벨. 죽음의 기사는 이 값이 영웅 직업 시작 레벨보다 낮으면
# 대신 영웅 직업 시작 레벨로 초기화됩니다.
# 기본값:     1
# 유효 범위: 1-79 및 < MaxLevel
AiPlayerbot.ResetBotLevel.ResetToLevel = 1

# 봇이 정확히 이 레벨에 도달하면 SkipToLevel에 지정된 레벨로 바로 보내집니다.
# 이 설정은 ScaledChance나 RestrictTimePlayed의 영향을 받지 않습니다.
# 기본값:     0 (비활성)
# 유효 범위: 1-80 및 < MaxLevel (0이면 비활성)
AiPlayerbot.ResetBotLevel.SkipFromLevel = 0

# 봇이 SkipFromLevel에 도달했을 때 보내질 레벨. 죽음의 기사는 이 값이 영웅 직업 시작 레벨보다
# 낮으면 대신 영웅 직업 시작 레벨로 초기화됩니다.
# 기본값:     1
# 유효 범위: 1-80 및 <= MaxLevel
AiPlayerbot.ResetBotLevel.SkipToLevel = 1

# 최대 레벨(또는 최대 레벨에서 설정된 플레이 시간)에 도달했을 때 봇의 레벨이 초기화될
# 확률(%).
# 기본값:     100
# 유효 범위: 0-100
AiPlayerbot.ResetBotLevel.ResetChance = 100

# 활성이면 레벨업할 때마다 초기화 확률을 다시 굴리며, 봇 레벨과 MaxLevel의 차이에 따라
# 확률이 조정됩니다. 낮은 레벨에서는 초기화 확률이 작고, MaxLevel에 가까워질수록 증가하여
# MaxLevel에서 ResetChance에 도달합니다.
# 기본값: 0 (비활성)
AiPlayerbot.ResetBotLevel.ScaledChance = 0

# 활성이면 MaxLevel에 도달한 봇은 해당 레벨에서 최소 MinTimePlayed초 이상 플레이한 뒤에만
# 레벨이 초기화됩니다.
# 기본값: 0 (비활성)
AiPlayerbot.ResetBotLevel.RestrictTimePlayed = 0

# RestrictTimePlayed가 활성일 때, MaxLevel에서 초기화가 일어나기 전에 봇이 현재 레벨에서
# 플레이해야 하는 최소 시간(초).
# 기본값: 86400 (3600 = 1시간, 86400 = 1일, 604800 = 1주)
AiPlayerbot.ResetBotLevel.MinTimePlayed = 86400

# RestrictTimePlayed가 활성일 때, MaxLevel 이상인 봇에 대해 플레이 시간 검사를 수행하는
# 주기(초).
# 기본값: 864
# 권장: MinTimePlayed의 1% 또는 300초 중 더 큰 값.
AiPlayerbot.ResetBotLevel.PlayedTimeCheckFrequency = 864

# 활성이면 실제(봇이 아닌) 플레이어가 길드장인 길드에 속한 봇은 레벨 초기화 처리에서 제외됩니다.
# AiPlayerbot.LevelBrackets.IgnoreGuildBotsWithRealPlayers와 같은 공유 PlayerbotGuildMgr 길드 캐시
# (시작 시 검증되고 매시간 갱신)를 사용하며 오프라인 플레이어도 포함합니다. 길드장이 랜덤봇 계정이
# 아니면 실제 길드로 간주합니다.
# 기본값: 0 (비활성)
AiPlayerbot.ResetBotLevel.IgnoreGuildBotsWithRealPlayers = 0

# 레벨 초기화 처리에서 제외할 봇 이름 목록(쉼표로 구분). 이름은 캐릭터 이름과 정확히 일치해야
# 합니다(캐릭터 이름은 첫 글자가 대문자로 저장됨, 예: "Thrall").
# 기본값: "" (비어 있음)
AiPlayerbot.ResetBotLevel.ExcludeNames =

