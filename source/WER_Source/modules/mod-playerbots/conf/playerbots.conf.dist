# 장비
#

# 랜덤봇이 레벨업 시 업그레이드된 장비를 자동으로 받습니다
# 기본값: 1 (활성)
AiPlayerbot.AutoUpgradeEquip = 1

# 로그인 및 주기적 무작위화 중 랜덤봇이 현재 장비와 특성 전문화를 유지할지(지속성) 설정합니다.
# 기본값: 1 (활성)
AiPlayerbot.EquipAndSpecPersistence = 1

# EquipAndSpecPersistence가 활성일 때, 이 레벨 이상의 랜덤봇에 장비와 특성 지속성이
# 적용됩니다.
# 기본값: 1 (1레벨 이상, 즉 모든 레벨의 랜덤봇에 지속성 적용)
AiPlayerbot.EquipAndSpecPersistenceLevel = 1

# 랜덤봇의 장비 품질 제한 (1 = 일반, 2 = 고급, 3 = 희귀, 4 = 영웅, 5 = 전설)
# 랜덤봇과 알트봇에 대해 autogear가 생성할 수 있는 최대 품질도 이 값으로 정해집니다
# 기본값: 3 (희귀)
AiPlayerbot.RandomGearQualityLimit = 3

# 무작위 봇의 장비 아이템 레벨 제한 (장비 점수가 아님, 0 = 제한 없음)
# Classic
# 최대 아이템 레벨 Tier 1 = 66 | Tier 2 = 76 | Tier 2.5 = 88 | Tier 3 = 92
# 최대 아이템 레벨 Phase 1(MC, Ony, ZG) = 78 | Phase 2(BWL) = 83 | Phase 2.5(AQ40) = 88 | Phase 3(Naxx40) = 92
# 불타는 성전(TBC)
# 최대 아이템 레벨 Tier 4 = 120 | Tier 5 = 133 | Tier 6 = 164
# 최대 아이템 레벨 Phase 1(Kara, Gruul, Mag) = 125 | Phase 2(SSC, TK, ZA) = 141 | Phase 3(Hyjal, BT) = 156 | Phase 4(Sunwell) = 164
# WotLK
# 최대 아이템 레벨 Tier 7(10/25) = 200/213 | Tier 8(10/25) = 225/232 | Tier 9(10/25) = 232/245 | Tier 10(10/25/HC) = 251/264/290
# 최대 아이템 레벨 Phase 1(Naxx) = 224 | Phase 2(Ulduar) = 245 | Phase 3(ToC) = 258 | Phase 4(ICC) = 290
# 기본값: 0 (제한 없음)
AiPlayerbot.RandomGearScoreLimit = 0

# 직업에 이상적인 방어구 유형 선호: 직업에 적합한 방어구 점수에 3배 배수를 적용합니다.
# 활성화하면 전사는 판금, 주술사는 사슬 등을 강하게 선호합니다.
# 성능이 월등한 아이템은 여전히 선택될 수 있습니다 (강제 필터링 없음). 다만 같은 품질이면
# 선호 유형의 방어구 점수가 3배가 되어 그 방어구를 대신 장착합니다.
#
# 방어구 유형 선호:
#   판금:   전사, 성기사, 죽음의 기사
#   사슬:   사냥꾼, 주술사
#   가죽:   도적, 드루이드
#   천:     사제, 마법사, 흑마법사
#
# 기본값: 0 (비활성화)
AiPlayerbot.PreferClassArmorType = 0

# 활성이면 autogear 시 봇이 공격 속도와 무기 종류를 기준으로 전문화에 맞는 무기를 선호합니다.
# 예: 무기 전사는 느린 양손 도끼/장창(도끼 전문화)을, 전투 도적은 느린 주장비와 빠른 보조장비를,
# 고양 주술사는 공격 속도가 맞춰진 느린 한손 무기를 선호합니다.
# 기본값: 0 (비활성)
AiPlayerbot.PreferredSpecWeapons = 0

# maintenance로 장비에 마법부여와 보석 장착을 하는 봇의 최소 레벨
# RandomBotMaxlevel보다 크면 봇이 장비에 자동으로 마법부여하거나 보석을 장착하지 않습니다
# 기본값: 60
AiPlayerbot.MinEnchantingBotLevel = 60

# 봇의 마법부여 및 보석에 확장팩 제한 활성화
# 활성화하면 봇은 61레벨 전에는 TBC 마법부여를, 71레벨 전에는 WotLK 마법부여와 보석을 사용하지 않습니다.
# 기본값: 1 (활성)
AiPlayerbot.LimitEnchantExpansion = 1

# 장비의 확장팩 제한 활성화
# 활성화하면 봇은 61레벨 전에는 TBC 장비를, 71레벨 전에는 WotLK 장비를 장착하지 않습니다.
# 기본값: 1 (활성)
AiPlayerbot.LimitGearExpansion = 1

# 랜덤봇의 생성 장비가 최적보다 낮은 성능일 확률
# 0 (0%)과 1 (100%) 사이로 설정
AiPlayerbot.RandomGearLoweringChance = 0

# 획득 불가능하거나 사용할 수 없는 아이템 (쉼표로 구분한 아이템 ID)
# 기본값: Chilton Wand (12468), Frenzyheart Insignia of Fury 테스트/사용 효과 항목 (44869),
#         Oracle Talisman of Ablution 테스트/사용 효과 항목 (44870), Totem of the Earthen Ring (46978)
AiPlayerbot.UnobtainableItems = 12468,44869,44870,46978

# 랜덤봇이 플레이어의 장비 점수를 확인하고 너무 낮으면 파티 초대 거절
# 기본값: 0 (비활성)
AiPlayerbot.GearScoreCheck = 0

# 최적의 공격대 성능을 위해 사냥꾼 야수를 늑대로만 설정 (0 = 비활성, 1 = 최대 레벨 봇만 활성, 2 = 활성)
# 기본값: 0 (비활성)
AiPlayerbot.HunterWolfPet = 0

# 봇이 소환수를 소환할 때의 기본 행동 상태
# 0 = 수동적, 1 = 방어적, 2 = 공격적
# 기본값: 1 (방어적)
AiPlayerbot.DefaultPetStance = 1

# 소환수 명령 디버그 메시지 활성화/비활성화
# 0 = Disabled, 1 = Enabled
# Default = 0 (disabled)
AiPlayerbot.PetChatCommandDebug = 0

# 사냥꾼 봇이 아래 ExcludedHunterPetFamilies에 나열된 계열 ID의 야수를 만들지 못하게 합니다
# 계열 ID별 전체 목록은 creature_family 데이터베이스 테이블을 참고하세요 (참고: 거미의 ID는 3)
AiPlayerbot.ExcludedHunterPetFamilies = ""

#
#
####################################################################################################

####################################################################################################
# 활동
#

# BotActiveAlone
# - 근처에 실제 플레이어가 없을 때 활성 상태로 둘 봇 수를 제어합니다.
# - 대략적인 백분율로 생각하면 됩니다. 10은 봇의 약 10%가 활성 상태라는 뜻입니다.
#   정확한 값은 아니며, 실제 수는 교대 주기마다 약간 달라질 수 있습니다.
# - 활성 봇은 교대합니다. <DurationSeconds>마다 다른 봇 집합이 차례를 맡습니다.
# - 실제 활성 봇 수는 항상 이 값보다 많습니다. 전투 중, 던전, 전장, LFG 대기열,
#   실제 플레이어가 있는 파티 등에 속한 봇은 이 값과 별도로 항상 강제
#   활성화되기 때문입니다(아래 강제 규칙 참고).
# - 100으로 설정(SmartScale 끔) = 모든 봇이 항상 활성. 서버 부하가 최대입니다.
# - 0으로 설정 = 아래 강제 규칙에 해당하는 봇만 활성화됩니다.
#
# BotActiveAloneDurationSeconds
# - 활성 봇 구성이 교대되는 주기(초)입니다. 다른 봇 그룹이 깨어나고
#   이전 그룹은 유휴 상태가 될 수 있습니다.
# - 정확한 값이 아니라 최소값입니다. 교대 시점에 봇이 전투 중이거나 강제 규칙에 해당하면
#   그 조건이 끝날 때까지 활성 상태를 유지합니다. 차례가 끝났다는 이유만으로
#   전투 도중에 멈추지 않습니다.
#
AiPlayerbot.BotActiveAlone = 10
AiPlayerbot.BotActiveAloneDurationSeconds = 30

# 강제 활성화 규칙 (1 = 켜짐, 0 = 꺼짐)
# 이 규칙은 위 백분율보다 우선합니다. 하나라도 해당하면 봇이 활성 상태를 유지합니다.
#
# InRadius  - 실제 플레이어가 이 거리(야드) 이내에 있음(0으로 설정하면 비활성).
# InZone    - 실제 플레이어가 같은 지역에 있음(예: 엘윈 숲).
# InMap     - 실제 플레이어가 같은 대륙에 있음(예: 동부 왕국).
# IsFriend  - 실제 플레이어의 친구 목록에 이 봇이 있음.
# InGuild   - 이 봇이 실제 플레이어가 있는 길드에 속해 있음.
#
# 다음 경우에도 봇은 항상 강제로 활성화됩니다(설정 불가):
#   전투 중, 던전/공격대/전장 안, 전장 또는 LFG 대기열에 있을 때,
#   실제 플레이어와 파티 중이거나 실제 플레이어가 조종할 때.
#
AiPlayerbot.BotActiveAloneForceWhenInRadius = 150
AiPlayerbot.BotActiveAloneForceWhenInZone = 1
AiPlayerbot.BotActiveAloneForceWhenInMap = 0
AiPlayerbot.BotActiveAloneForceWhenIsFriend = 0
AiPlayerbot.BotActiveAloneForceWhenInGuild = 1

# SmartScale: 서버가 부하를 감당하기 어려울 때 활성 봇 수를 자동으로 줄입니다.
# 서버의 갱신 시간 (서버 틱마다 걸리는 시간, 밀리초 단위)을 감시합니다.
# 서버가 느려지면 활성 상태로 유지하는 봇 수를 줄여 부하를 낮춥니다.
#
#   Floor (기본값 50ms)    - 이 값 미만이면 감소 없음. 서버가 정상 동작 중.
#   Ceiling (기본값 200ms) - 이 값 이상이면 강제 활성이 아닌 모든 봇이 일시 정지됨.
#   floor와 ceiling 사이에서는 활동량이 점진적으로 줄어듭니다.
#     예: BotActiveAlone=10, floor=50, ceiling=200
#       서버 50ms  → ~10% 활성 (감소 없음)
#       서버 125ms → ~5% 활성 (절반 감소)
#       서버 200ms → 0% 활성 (강제 활성 봇만 남음)
#
# MinLevel/MaxLevel — 이 레벨 범위 안의 봇만 SmartScale의 영향을 받습니다.
#   범위 밖의 봇은 항상 BotActiveAlone 값을 그대로 사용합니다.
#   강제 규칙은 항상 SmartScale보다 우선합니다.
#
AiPlayerbot.botActiveAloneSmartScale = 1
AiPlayerbot.botActiveAloneSmartScaleDiffLimitfloor = 50
AiPlayerbot.botActiveAloneSmartScaleDiffLimitCeiling = 200
AiPlayerbot.botActiveAloneSmartScaleWhenMinLevel = 1
AiPlayerbot.botActiveAloneSmartScaleWhenMaxLevel = 80

