##################################################
# PLAYERBOTS 설정 파일                  #
##################################################

# Overview
# "Randombot"(랜덤봇): 무작위로 생성되어 플레이어와 별도로 접속하며 월드를 채우는 봇입니다.
# 랜덤봇은 자동으로 사냥, 퀘스트, 레벨업, 장비 업그레이드를 할 수 있으며, 파티에 초대해 명령을 내릴 수 있습니다.
# "AddClass bot"(애드클래스 봇): AddClassAccountPoolSize 계정에 속한 봇입니다. 레벨과 장비를 갖춘
# 원하는 직업의 봇을 파티에 빠르게 추가할 때 사용하며, 파티를 빠르게 꾸릴 때 권장됩니다.
# "Altbot"(알트봇): 플레이어 계정에서 만든 캐릭터로, 플레이어가 접속시킬 수 있고 랜덤봇처럼
# 파티에 초대해 명령을 내릴 수 있습니다. 장기간 진행하는 플레이에 가장 적합합니다.
# 봇을 조종하고 전략을 설정하는 명령어에 대한 정보는 위키에서 확인할 수 있습니다:
# https://github.com/mod-playerbots/mod-playerbots/wiki/Playerbot-Commands.

####################################################################################################
# 섹션 목차
#   일반 설정
#    PLAYERBOTS 설정
#        일반
#        소환 옵션
#        탈것
#        장비
#        전리품 획득
#        타이머
#        거리
#        임계값
#        퀘스트
#        전투
#        치트
#        주문
#        비행 경로
#        전문기술
#    무작위 봇 전용 설정
#        일반
#        레벨
#        랜덤봇 레벨 관리 (레벨 구간 + 레벨 초기화)
#        장비
#        퀘스트
#        활동
#        주문
#        전략
#        RPG 전략
#        순간이동
#        전장 & 투기장 & PvP
#        랜덤봇 타이밍 및 행동
#    사전 설정 특성
#        정보
#        전사
#        성기사
#        사냥꾼
#        도적
#        사제
#        죽음의 기사
#        주술사
#        마법사
#        흑마법사
#        드루이드
#    무작위 봇 기본 특성
#        전사
#        성기사
#        사냥꾼
#        도적
#        사제
#        죽음의 기사
#        주술사
#        마법사
#        흑마법사
#        드루이드
#    공격대
#    PLAYERBOTS 시스템 설정
#        데이터베이스 및 연결
#        디버그
#        채팅 설정
#        로그
#    사용 중단 예정 (임시)
####################################################################################################

###################################
#                                 #
# 일반 설정                #
#                                 #
###################################

####################################################################################################

# Playerbots 모듈 활성화 또는 비활성화
AiPlayerbot.Enabled = 1

# 무작위 봇 시스템 활성화
AiPlayerbot.RandomBotAutologin = 1

# 랜덤봇 수
# 기본 배포값 200 = 일반적인 게임용 하드웨어에서 활기찬 월드. 고성능 머신은 둘 다 500+ 까지
# 올릴 수 있습니다(부하 증가 + playerbot 크래시 빈도 증가; watchdog 런처를 사용하세요).
AiPlayerbot.MinRandomBots = 200
AiPlayerbot.MaxRandomBots = 200

# 랜덤봇 계정
# 0으로 설정하면 MaxRandomBots, EnablePeriodicOnlineOffline 및 그 비율, AddClassAccountPoolSize를 바탕으로
# 필요한 계정 수를 자동 계산합니다. 필요한 것보다 많은 계정을 만들고 싶다면 직접 설정하세요.
# 직접 설정한 값이 필요한 값보다 작으면 시스템이 필요한 값으로 덮어씁니다.
# 기본값: 0 (자동)
AiPlayerbot.RandomBotAccountCount = 0

# 애드클래스 계정
# addclass 명령 전용 봇을 위해 생성하는 계정 수입니다. 랜덤봇과 마찬가지로 계정마다
# 직업별로 하나씩 10개의 봇(WotLK가 비활성이면 9개)이 있습니다.
AiPlayerbot.AddClassAccountPoolSize = 50

# 생성되는 봇 계정(모든 종류)의 접두사입니다.
# 봇 계정이 존재하는 동안에는 이 접두사를 변경하지 마세요.
AiPlayerbot.RandomBotAccountPrefix = "rndbot"

# 모든 랜덤봇 계정 삭제
# 적용하려면 값을 1로 설정하고 Worldserver를 실행하세요. 삭제가 끝난 뒤 랜덤봇을 다시 만들고
# 싶다면 값을 다시 0으로 설정하고 Worldserver를 재실행하세요.
AiPlayerbot.DeleteRandomBotAccounts = 0

# 로그인한 실제 플레이어가 없을 때 랜덤봇 비활성화
# 기본값: 0 (서버 시작 시 랜덤봇 로그인)
# 활성화하면 실제 플레이어가 로그인한 뒤 30초 (기본값)가 지나야 랜덤봇이 로그인하며,
# 모든 실제 플레이어가 로그아웃한 뒤 300초 (기본값)가 지나면 로그아웃합니다.
AiPlayerbot.DisabledWithoutRealPlayer = 0
AiPlayerbot.DisabledWithoutRealPlayerLoginDelay = 30
AiPlayerbot.DisabledWithoutRealPlayerLogoutDelay = 300

####################################################################################################

###################################
#                                 #
# PLAYERBOTS 설정             #
#                                 #
###################################

####################################################################################################

####################################################################################################
# 일반
#

# 플레이어가 동시에 제어할 수 있는 최대 봇 수
AiPlayerbot.MaxAddedBots = 40

# addclass 명령으로 봇 생성 허용 여부 (0 = GM 전용, 1 = 활성)
# 기본값: 1 (활성)
AiPlayerbot.AddClassCommand = 1

# 봇의 파티 초대 수락 권한 수준 (0 = GM 전용, 1 = 레벨에 따라 수락, 2 = 항상 수락)
# 기본값: 1 (레벨에 따라 수락)
AiPlayerbot.GroupInvitationPermission = 1

# 마스터가 떠나도 알트봇을 파티에 유지
# 0 = 비활성 (기본 동작)
# 1 = 활성 (봇이 자동으로 파티를 떠나지 않음)
AiPlayerbot.KeepAltsInGroup = 0

# 플레이어 로그인 시 모든 부캐를 부캐 봇으로 자동 로그인
AiPlayerbot.BotAutologin = 0

# 플레이어 계정의 부캐 봇 초대 허용/금지
AiPlayerbot.AllowAccountBots = 1

# 플레이어 길드의 부캐 봇 초대 허용/금지
AiPlayerbot.AllowGuildBots = 1

# 부캐 봇 제어를 공유하기 위한 계정 연결 허용
AiPlayerbot.AllowTrustedAccountBots = 1

# 랜덤봇이 근처 랜덤봇과 함께 길드를 생성
# 참고: 현재 랜덤봇은 길드 생성 후 추가 봇을 초대하지 않으므로,
# 랜덤봇 길드에는 창단 서명에 필요한 최초 랜덤봇 10명만 있게 됩니다.
# 기본값: 0 (비활성)
AiPlayerbot.RandomBotGuildNearby = 0

# 무작위 봇이 생성하는 길드 수
AiPlayerbot.RandomBotGuildCount = 20

# 무작위 봇 길드의 최대 길드원 수 (최소값은 코드에서 10으로 고정)
AiPlayerbot.RandomBotGuildSizeMax = 15

# 시작 시 모든 랜덤봇(및 애드클래스 봇) 길드를 삭제합니다. 활성 상태에서는
# 새 랜덤봇 길드가 생성되거나 가입되지 않습니다. 정상적인 랜덤봇 길드 배정을 재개하려면
# 0으로 되돌리고 서버를 재시작하세요.
AiPlayerbot.DeleteRandomBotGuilds = 0

# 무작위 봇이 플레이어를 파티/공격대/길드에 초대
AiPlayerbot.RandomBotInvitePlayer = 0

# 봇이 다른 봇을 파티/공격대/길드에 초대할 때 일반 대화/길드 채팅 사용
AiPlayerbot.InviteChat = 0

# 봇이 파티 초대를 수락하면 플레이어에게 자동 소환
AiPlayerbot.SummonWhenGroup = 1

# 플레이어를 봇으로 활성화할 수 있음 (셀프봇)
# 셀프봇 권한 수준 (0 = 비활성, 1 = GM 전용 (기본값), 2 = 모든 플레이어, 3 = 로그인 시 활성화)
AiPlayerbot.SelfBotLevel = 1

# GM이 아닌 플레이어는 자신의 레벨과 장비 점수에 맞춰 봇을 초기화하는 init=auto만 사용할 수 있음
# 기본값: 0 (GM이 아닌 플레이어도 모든 초기화 명령 사용 가능)
AiPlayerbot.AutoInitOnly = 0

# 플레이어가 만든 알트봇(애드클래스 봇이 아닌 봇)에 .bot refresh=raid로
# 인스턴스 귀속 해제를 허용합니다. 0이면 알트봇에 대한 refresh=raid가
# "non-addclass bot" 오류로 거부됩니다. UnbindInstance는 DB 부담이 적어
# 활성화해도 렉 위험이 없습니다.
# 기본값: 0
AiPlayerbot.ResetInstanceIdForAltBots = 0

# init=auto 사용 시 봇 장비 레벨의 상한 비율
# 기본값: 1.0 (플레이어와 동일)
AiPlayerbot.AutoInitEquipLevelLimitRatio = 1.0

# AllowLearnTrainerSpells
# 설명: 돈이 있는 한 봇이 트레이너에게서 주문을 배우도록 허용합니다.
# 기본값: 1 - (활성)
AiPlayerbot.AllowLearnTrainerSpells = 1

#
#
####################################################################################################

####################################################################################################
# 소환 옵션
#

# 주인이 전투 중일 때 봇 소환 활성화/비활성화
# 기본값: 1 (활성)
AiPlayerbot.AllowSummonInCombat = 1

# 주인이 죽었을 때 봇 소환 활성화/비활성화
# 기본값: 1 (활성)
AiPlayerbot.AllowSummonWhenMasterIsDead = 1

# 죽은 봇의 소환 활성화/비활성화 (0 = 봇이 유령 상태일 때만, 1 = 항상)
# 기본값: 1 (항상)
AiPlayerbot.AllowSummonWhenBotIsDead = 1

# 봇 소환 시 부활 활성화/비활성화 (0 = 비활성화, 1 = 전투 중에는 비활성화, 2 = 활성화)
# 기본값: 1 (전투 중에는 비활성화)
AiPlayerbot.ReviveBotWhenSummoned = 1

# 소환된 봇의 장비 수리 활성화/비활성화
# 기본값: 1 (활성)
AiPlayerbot.BotRepairWhenSummon = 1

#
#
####################################################################################################

####################################################################################################
# 탈것
#

# 봇이 60% 지상 탈것을 기본으로 사용하기 시작하는 레벨
# 참고: WotLK에서는 20레벨, TBC에서는 30레벨, 오리지널에서는 40레벨이었습니다
# 기본값: 20
AiPlayerbot.UseGroundMountAtMinLevel = 20

# 봇이 100% 빠른 지상 탈것을 기본으로 사용하기 시작하는 레벨
# 참고: WotLK에서는 40레벨, 오리지널에서는 60레벨이었습니다
# 기본값: 40
AiPlayerbot.UseFastGroundMountAtMinLevel = 40

# 봇이 150% 비행 탈것을 기본으로 사용하기 시작하는 레벨
# 참고: WotLK에서는 60레벨, TBC에서는 70레벨이었습니다
# 기본값: 60
AiPlayerbot.UseFlyMountAtMinLevel = 60

# 봇이 280% 빠른 비행 탈것을 기본으로 사용하기 시작하는 레벨
# 참고: WotLK와 TBC에서는 70레벨이었습니다
# 기본값: 70
AiPlayerbot.UseFastFlyMountAtMinLevel = 70

#
#
####################################################################################################

####################################################################################################
# 장비
#

# 랜덤봇의 투구와 망토 표시 (초기화 필요)
# 0 - 모든 랜덤봇에서 투구와 망토가 보이지 않음
# 1 - 모든 랜덤봇에서 투구와 망토가 보임
# 2 - 랜덤봇이 무작위화될 때 투구와 망토 표시 여부를 무작위로 결정
# 기본값: 1 (모든 랜덤봇에서 투구/망토 표시)
AiPlayerbot.RandomBotShowHelmet = 1
AiPlayerbot.RandomBotShowCloak = 1

# 부캐 봇이 소지품 중 충분한 성능 향상이 있는 아이템을 자동으로 장착할지 설정
# 기본값: 1 (활성)
AiPlayerbot.AutoEquipUpgradeLoot = 1

# 상위 장비 자동 장착 기준값
# 기본값: 1.1 (새 아이템의 장비 점수가 현재 장착한 아이템의 1.1배일 때 장착)
AiPlayerbot.EquipUpgradeThreshold = 1.1

# 더 적합한 장비를 생성하도록 장비 초기화를 두 차례 수행
AiPlayerbot.TwoRoundsGearInit = 0

#
#
####################################################################################################

####################################################################################################
# 전리품 획득
#

# 전리품 분배 방식이 자유 획득일 때도 봇이 계속 전리품 획득
# 기본값: 0 (비활성)
AiPlayerbot.FreeMethodLoot = 0

# 봇에게 필요한 아이템에 사용할 주사위 선택 수준 (0 = 포기, 1 = 차비, 2 = 입찰)
# 기본값: 1 (차비)
AiPlayerbot.LootNeedRollLevel = 1

# 봇의 아이템 차비 선택 활성화 (전체 적용)
# 비활성화하면 봇이 모든 아이템에서 차비 대신 포기를 선택
# 기본값: 0 (비활성 - 봇은 입찰 또는 포기만 선택)
AiPlayerbot.LootGreedRollLevel = 0

# 봇의 제조법 주사위 참여 활성화. 배울 수 있고 아직 모르는 전문 기술 제조법에는 입찰합니다.
# LootRollGreed가 활성화되어 있으면 배울 수 없는 착용 시 귀속 제조법에는 차비를 선택합니다.
# 기본값: 0 (비활성)
AiPlayerbot.LootRollRecipe = 0

# 마법부여를 배운 봇은 마력 추출 가능한 아이템에 차비 대신 마력 추출을 선택
# 비활성화하면 봇은 마력 추출 가능한 아이템에 대신 차비를 선택
# 기본값: 0 (비활성)
AiPlayerbot.LootRollDisenchant = 0

# 봇이 상호작용하지 않을 GameObject GUID 목록입니다.
# 기본 GUID 목록:
# 퀘스트 아이템:
# Blood of Heroes = 176213, Defias Gunpowder = 17155, Waterlogged Envelope = 2656, Baelog's Chest = 123329, Half-Buried Bottle = 2560
# 상자:
# Large Solid Chest = 74448, Box of Assorted Parts = 19020, Food Crate = 3719, Water Barrel = 3658, Barrel of Milk = 3705, Barrel of sweet Nectar = 3706, Tattered Chest = 105579, Large bettered Chest = 75293, Solid Chest = 2857, Battered Foodlocker = 179490, Witch Doctor's Chest = 141596, Relic Coffer = 160836, Dark Coffer = 160845, Fengus's Chest = 179516, Supply Crate = 176224/181085, Malor's Strongbox = 176112
# 기타:
# Shallow Grave (Zul'Farrak) = 128308/128403, Grim Guzzler Boar (Blackrock Depths) = 165739, Dark Iron Ale Mug (Blackrock Depths) = 165738, Father Flame (Blackrock Spire) = 175245, Unforged Runic Breastplate (Blackrock Spire) = 175970, Blacksmithing Plans (Stratholme) = 176325/176327
AiPlayerbot.DisallowedGameObjects = 176213,17155,2656,74448,19020,3719,3658,3705,3706,105579,75293,2857,179490,141596,160836,160845,179516,176224,181085,176112,128308,128403,165739,165738,175245,175970,176325,176327,123329,2560

#
#
####################################################################################################

####################################################################################################
# 타이머
#

# 틱당 최대 AI 반복 횟수
AiPlayerbot.IterationsPerTick = 10

# 짧은 시간 내 연속 주문 시전 사이의 지연
AiPlayerbot.GlobalCooldown = 500

# 이동 시 최대 대기 시간
AiPlayerbot.MaxWaitForMove = 5000

# 봇 이동에 MoveSplinePath 사용 활성화/비활성화
# 비활성화하면 움직임이 더 불규칙해지지만, 봇에게 기절, 감속 및 이동 불가 효과가 적용되려면 필요합니다.
# 기본값: 0 - MoveSplinePath 활성화
#          1 - 전장/투기장에서만 MoveSplinePath 비활성화
#          2 - 모든 곳에서 MoveSplinePath 비활성화
AiPlayerbot.DisableMoveSplinePath = 0

# 이동 경로의 최대 탐색 시간 (값이 클수록 경사면 이동 개선)
# 기본값: 3
AiPlayerbot.MaxMovementSearchTime = 3

# 행동 만료 시간
AiPlayerbot.ExpireActionTime = 5000

# 해제할 오라의 최대 지속 시간
AiPlayerbot.DispelAuraDuration = 700

# 봇의 두 행동 사이 지연
AiPlayerbot.ReactDelay = 100

# 서버 지연을 줄이기 위해 봇의 상태에 따라 반응 지연을 동적으로 조정
AiPlayerbot.DynamicReactDelay = 1

# 비활동 상태의 지연
AiPlayerbot.PassiveDelay = 10000

# 반복 행동 사이의 최소 지연 (채팅 메시지, 감정 표현 등)
AiPlayerbot.RepeatDelay = 2000

# 지연 타이머
AiPlayerbot.ErrorDelay = 100
AiPlayerbot.RpgDelay = 10000
AiPlayerbot.SitDelay = 20000
# ReturnDelay의 최소값은 2000입니다. 더 낮게 설정하면 충돌이 발생합니다!
AiPlayerbot.ReturnDelay = 2000
AiPlayerbot.LootDelay = 1000

