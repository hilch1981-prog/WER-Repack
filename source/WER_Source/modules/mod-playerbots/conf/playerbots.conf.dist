# 봇의 퀘스트 보상 선택
# yes = 가장 유용한 아이템 선택, no = 모든 보상 나열, ask = 유용한 아이템을 고르되 여러 개면 나열
AiPlayerbot.AutoPickReward = yes

# 플레이어와 퀘스트 동기화 (플레이어가 퀘스트를 제출하는 즉시 봇도 완료하며 퀘스트 아이템은 획득하지 않습니다.)
# 기본값: 1 (활성)
AiPlayerbot.SyncQuestWithPlayer = 1

# 봇이 자신의 퀘스트를 제출할 때 플레이어의 퀘스트도 자동 완료
# 기본값: 0 (비활성)
AiPlayerbot.SyncQuestForPlayer = 0

# 봇이 더 이상 필요하지 않은 퀘스트 포기
# 기본값: 1 (활성)
AiPlayerbot.DropObsoleteQuests = 1

#
#
####################################################################################################

####################################################################################################
# 전투
#

# 인스턴스 입장 시 구현된 던전/공격대 전략 자동 추가
AiPlayerbot.ApplyInstanceStrategies = 1

# 광역 효과 자동 회피 전략 활성화
# 기본값: 1 (활성)
AiPlayerbot.AutoAvoidAoe = 1

# 반경이 이 값보다 작은 광역 주문만 회피
AiPlayerbot.MaxAoeAvoidRadius = 15.0

# 회피하지 않아야 하는 광역 주문 ID 허용 목록
AiPlayerbot.AoeAvoidSpellWhitelist = 50759,57491,13810,29946

# 치유 봇의 마나 절약 전략 활성화
# 기본값: 1 (활성)
AiPlayerbot.AutoSaveMana = 1

# 치유 봇의 마나 절약 기준값
# 기본값: 60 (60%)
AiPlayerbot.SaveManaThreshold = 60

# 성기사 봇이 상급 축복을 사용하도록 합니다. 사용할 축복은 공격대/파티 내 성기사 수와
# 대상의 특성 전문화에 따라 정해집니다. 전문화별 우선순위는
# GreaterBlessingActions.h에 하드코딩되어 있습니다.
# 0 = disabled
# 1 = 공격대 파티에서만 활성
# 2 = 모든 파티에서 활성
# 기본값: 1 (공격대에서만)
AiPlayerbot.AutoGreaterBlessings = 1

# 봇이 재료를 쓰는 파티 버프를 사용하도록 합니다: 야생의 선물, 신비한 총명함,
# 인내의 기원, 정신의 기원, 암흑 보호의 기원.
# 0 = disabled
# 1 = 공격대 파티에서만 활성
# 2 = 모든 파티에서 활성
# 기본값: 2 (모든 파티)
AiPlayerbot.AutoPartyBuffs = 2

# 재료가 필요한 상급 축복이나 파티 버프를 시도했지만 재료가 없어 단일 대상 버전으로
# 대체해야 할 때, 봇이 파티에 알립니다.
# 기본값: 1 (활성)
AiPlayerbot.TellWhenMissingBuffReagents = 1

# 버프 재료 부족 메시지의 재사용 대기시간(초).
# 기본값: 300 (5분)
AiPlayerbot.MissingBuffReagentMessageCooldown = 300

# 전투 외 상황에서 전투 준비 확인이 시작되면, 봇은 준비 완료를 보고하기 전에 없거나 곧 끝나는 버프를 갱신합니다.
# 아직 수행할 버프 작업이 남은 봇은 전투 준비 확인이 끝날 때까지 준비 안 됨 상태로 남습니다. 재료가
# 부족한 경우도 포함됩니다(시전을 시도하고 실패). 항상 켜져 있는 "force rebuff" 전략을 사용합니다.
# 이 기능 이전에 전략 세트가 저장된 봇은 저장된 세트를 유지하므로, 전략을 초기화하거나
# "nc +force rebuff"로 적용하세요. "rebuff" 채팅 명령은 전투 준비 확인 없이 같은 버프 과정을
# 시작하며, 이 설정과 관계없이 작동합니다.
# 기본값: 0 (비활성)
AiPlayerbot.ForceRebuffOnReadyCheck = 0

# 강제 재버프 과정(전투 준비 확인 또는 "rebuff" 명령) 중, 버프의 남은 시간이 전체 지속시간보다
# 이 초 수 이상 줄어들면 다시 시전하여, 전투 내내 유지되도록 버프를 최대 지속시간 쪽으로 갱신합니다.
# 실제 여유값은 과정이 이미 진행된 시간보다 작아지지 않으므로 작은 값도 안전합니다.
# 기본값: 60
AiPlayerbot.ForceRebuffMarginSecs = 60

# 봇이 적에게서 도주 가능
AiPlayerbot.FleeingEnabled = 1

#
#
####################################################################################################

####################################################################################################
# 치트
#

# maintenance 명령 사용 여부
# 사용 가능한 모든 주문과 기술 습득, 특성 포인트 배분, 소모품 보충, 수리, 장비 마법부여, 보석 장착 등을 수행합니다.
# 봇 레벨이 AiPlayerbot.MinEnchantingBotLevel보다 높을 때 적용됩니다
# 기본값: 1 (활성)
AiPlayerbot.MaintenanceCommand = 1

# 알트봇에 대한 maintenance 명령의 세부 기능별 사용 여부
# 플레이어가 자신의 알트봇에게 가방, 주문, 기술 레벨 등을 무료로 주지 못하게 하려면 비활성으로 설정하세요
# 아래 모든 키의 업스트림 기본값은 1(활성)입니다.
#
# ############################################################################
# WER 기본값 - 2026-08-01 변경, 변경 이유를 꼭 확인하세요.
# ############################################################################
# 여기서 "알트"는 봇으로 추가한 자신의 캐릭터를 뜻합니다(PlayerbotAI::IsAlt() =
# 실제 플레이어 마스터가 있고 랜덤봇이 아님). GM 권한이 없는 일반 플레이어도 80레벨
# 캐릭터로 접속한 뒤 두 번째 캐릭터에서 봇으로 추가하고 maintenance를 실행할 수 있습니다.
# StretchtGorilla 제보, 2026-08-01.
#
# 분명히 해 두자면, 이 기능은 아무것도 파괴하지 않습니다. Randomize(),
# ClearEverything(), ResetQuests(), ClearInventory(), resetTalents()는 모두
# 이 경로에서 호출되지 않습니다(확인됨). 오직 주기만 합니다.
#
# 바로 그 점이 여러 사람이 함께 쓰는 렐름에서는 문제가 됩니다. 성장 보상을 주거나
# 골드 소모처를 우회하는 기능은 모두 끈 상태(OFF)로 배포하고, 자신의 부캐를 봇으로
# 운용하는 것을 견딜 만하게 해 주는 소모품 보충 기능만 켠 상태(ON)로 둡니다.
#
# 혼자 또는 친구들과 플레이하나요? 그렇다면 모두 1로 되돌리세요. 자신의 렐름에서
# 자신의 부캐에 보석을 박는 것은 편의 기능일 뿐 누구를 속이는 것이 아닙니다.
# 이것을 설정으로 둔 이유가 바로 그것입니다.
#
# worldserver 재시작이 필요합니다.
# ############################################################################

# --- 활성화: 소모품 보충. 상점 잡화 수준으로, 의미 있는 골드 소모를 없애지 않습니다. ------
AiPlayerbot.AltMaintenanceAmmo = 1
AiPlayerbot.AltMaintenanceFood = 1
AiPlayerbot.AltMaintenanceReagents = 1
AiPlayerbot.AltMaintenanceConsumables = 1
AiPlayerbot.AltMaintenancePotions = 1

# 켬(ON): 가방을 지급하지만 빈 칸에만 넣습니다(기존 가방을 교체하거나 파괴하지 않음).
# 가방이 없는 부캐 봇은 아무것도 가져다줄 수 없기 때문입니다.
AiPlayerbot.AltMaintenanceBags = 1

# 활성화: 소환수가 없는 사냥꾼/흑마법사 부캐는 봇으로서 제대로 기능하지 못합니다.
AiPlayerbot.AltMaintenancePet = 1

# --- 비활성화: 무료 성장. 함께 플레이할 때 악용이 되는 기능입니다. ----
AiPlayerbot.AltMaintenanceMounts = 0
AiPlayerbot.AltMaintenanceReputation = 0
AiPlayerbot.AltMaintenanceAttunementQuests = 0
AiPlayerbot.AltMaintenanceKeyring = 0

# 비활성화: 상급자 훈련에 필요한 골드 소모를 건너뜁니다.
AiPlayerbot.AltMaintenanceSkills = 0
# "특수 주문"은 AiPlayerbot.RandomBotSpellIds에 나열된 모든 주문과 죽음의 기사의 죽음의 관문을 뜻합니다.
AiPlayerbot.AltMaintenanceClassSpells = 0
AiPlayerbot.AltMaintenanceAvailableSpells = 0
AiPlayerbot.AltMaintenanceSpecialSpells = 0

# 비활성화: 다른 플레이어의 생계 수단인 마법부여, 보석세공 및 주문각인 제작자를 건너뜁니다.
AiPlayerbot.AltMaintenanceGemsEnchants = 0
AiPlayerbot.AltMaintenanceGlyphs = 0

# 다른 이유로 끔(OFF): 이 기능들은 봇 템플릿에 맞춰 플레이어의 특성 포인트를
# 대신 소비합니다. 악용은 아니지만, 직접 육성하던 실제 캐릭터에게
# 일어나서는 안 되는 일입니다.
AiPlayerbot.AltMaintenanceTalentTree = 0
AiPlayerbot.AltMaintenancePetTalents = 0

# 참고: maintenance의 마지막에 무료 내구도 전체 수리가 실행되며
# (TrainerAction.cpp, 두 분기 이후) 이에 대한 별도 설정 키가 없습니다.
# 여기서는 끌 수 없으며, 코드 수정이 필요합니다.

# 봇의 장비를 자동으로 업그레이드하는 autogear 명령 사용 여부
# 품질은 AutoGearQualityLimit와 AutoGearScoreLimit로 제한됩니다
# 게임 내 사용법 (인자는 설정된 제한 이하로만 요청할 수 있음):
#   autogear            - 설정된 AutoGearQualityLimit / AutoGearScoreLimit에 맞춰 장비 착용
#   autogear green      - 품질을 고급으로 제한 (그 밖에: white/common, blue/rare, purple/epic,
#                         orange/legendary, artifact, heirloom)
#   autogear match      - 명령한 플레이어의 평균 아이템 레벨에 맞춤. 플레이어가 실제로 착용 중인
#                         슬롯만으로 계산하므로 빈 슬롯이 목표치를 낮추지 않음
#   autogear 200        - 특정 아이템 레벨을 목표로 함 (AutoGearScoreLimit가 0이 아니면 그 값으로 제한).
#                         양의 정수만 허용되며, 음수나 잘못된 값은 거부됨
#   autogear reset      - 착용한 장비를 모두 지우고 처음부터 다시 착용 (조합 가능: autogear reset green,
#                         autogear reset 200, autogear reset match)
#   autogear bis        - 별도의 BiS 명령, 아래 AutoGearBisCommand 참고
# 기본값: 1 (활성)
AiPlayerbot.AutoGearCommand = 1

# 알트봇에 대한 autogear 명령 사용 여부
# 기본값: 1 (활성)
AiPlayerbot.AutoGearCommandAltBots = 1

# 1(활성)이면 채팅 명령 autogear bis로 playerbots_bis_gear 테이블에서 BiS 장비를 줍니다.
# 아이템 레벨 하한이 AutoGearScoreLimit와 일치하는 것을 사용합니다 (예: 290 = ICC, 245 = ToC,
# 125 = Kara, 78 = MC). 전체 목록은 아래 AutoGearScoreLimit 설명을 참고하세요.
# 채팅 명령 autogear bis x (x는 양의 정수)는 x 값에 따라 아이템을 줍니다.
# x가 AutoGearScoreLimit보다 크면 BiS를 주지 않고, 작으면 x에 맞춰 아이템을 줍니다.
# 일치하는 티어가 없거나 봇의 직업/전문화에 대한 테이블이 비어 있으면 autogear로 대체됩니다.
# AutoGearQualityLimit = 4 및 AutoGearCommand = 1이 필요합니다.
# AutoGearCommandAltBots = 1이면 알트봇에서도 사용할 수 있습니다.
# 기본값: 0 (비활성)
AiPlayerbot.AutoGearBisCommand = 0

# autogear 명령의 장비 품질 제한 (1 = 일반, 2 = 고급, 3 = 희귀, 4 = 영웅, 5 = 전설)
# 기본값: 3 (희귀)
AiPlayerbot.AutoGearQualityLimit = 3

# autogear 명령의 장비 아이템 레벨(장비 점수 아님) 제한 (0 = 제한 없음)
# Classic
# 최대 아이템 레벨 Tier 1 = 66 | Tier 2 = 76 | Tier 2.5 = 88 | Tier 3 = 92
# 최대 아이템 레벨 Phase 1(MC, Ony, ZG) = 78 | Phase 2(BWL) = 83 | Phase 2.5(AQ40) = 88 | Phase 3(Naxx40) = 92
# 불타는 성전(TBC)
# 최대 아이템 레벨 Tier 4 = 120 | Tier 5 = 133 | Tier 6 = 164
# 최대 아이템 레벨 Phase 1(Kara, Gruul, Mag) = 125 | Phase 2(SSC, TK, ZA) = 141 | Phase 3(Hyjal, BT) = 156 | Phase 4(Sunwell) = 164
# WotLK
# 최대 아이템 레벨 Tier 7(10/25) = 200/213 | Tier 8(10/25) = 225/232 | Tier 9(10/25) = 232/245 | Tier 10(10/25/HC) = 251/264/290
# 최대 아이템 레벨 Phase 1(Naxx) = 224 | Phase 2(Ulduar) = 245 | Phase 3(ToC) = 258 | Phase 4(ICC) = 290
# 기본값: 0 (제한 없음)
AiPlayerbot.AutoGearScoreLimit = 0

# 봇 치트 사용 설정
# "food" (봇이 가방의 음식이나 음료를 소모하지 않고 먹고 마심)
# "gold" (봇의 골드가 무한)
# "health" (봇이 잃은 생명력을 즉시 회복)
# "mana" (봇의 마나가 무한)
# "power" (봇의 기력, 분노, 룬 마력이 무한)
# "taxi" (봇이 실제로 배우지 않고도 모든 비행 경로를 이용 가능)
# "raid" (봇이 공격대 전략에 구현된 일부 치트를 사용)
# 여러 치트를 사용하려면 아래에 쉼표로 구분해 입력하세요 (예: 모두 활성화하려면 "gold,health,mana,power,raid,taxi")
# 기본값: food, taxi, raid 활성
AiPlayerbot.BotCheats = "food,taxi,raid"

# 모든 봇에 대해 자동으로 완료 처리되는 입장 조건 퀘스트 목록 (쉼표로 구분한 퀘스트 ID).
# mod-playerbots는 삭제된 입장 조건을 복원하지 않지만, mod-individual-progression 같은 다른 모듈은 복원할 수 있습니다.
# 이 설정은 봇을 그러한 조건에서 제외하기 위한 것입니다.
#
# 기본값:
# Caverns of Time - Part 1
# - 10279, To The Master's Lair
# - 10277, The Caverns of Time
# 시간의 동굴 - 2부 (Escape from Durnholde Keep)
# - 10282, Old Hillsbrad
# - 10283, Taretha's Diversion
# - 10284, Escape from Durnholde
# - 10285, Return to Andormu
# 시간의 동굴 - 2부 (The Black Morass)
# - 10296, The Black Morass
# - 10297, The Opening of the Dark Portal
# - 10298, Hero of the Brood
