[worldserver]

########################################
# mod-ollama-chat 설정
########################################

# --------------------------------------------
# 핵심 모듈 스위치 및 디버깅
# --------------------------------------------

# OllamaChat.Enable
#     설명: 모듈을 활성화하거나 비활성화합니다.
#     기본값: 1 (참)
OllamaChat.Enable = 1

# OllamaChat.DebugEnabled
#     설명: 디버깅용 추가 로그를 활성화합니다.
#           1 (참)로 설정하면 모듈이 자세한 디버그 정보를 기록합니다.
#           0 (거짓)으로 설정하면 표준 로그만 사용합니다.
#     기본값: 0 (거짓)
OllamaChat.DebugEnabled = 0

# OllamaChat.DebugShowFullPrompt

#     설명: 활성(1)이면 RAG 정보를 포함해 Ollama API로 보내는 전체 프롬프트를 로그에 기록합니다.
#           RAG 시스템이 봇에게 어떤 정보를 제공하는지 디버깅할 때 유용합니다.
#           OllamaChat.DebugEnabled도 활성일 때만 동작합니다.
#           비활성(0)이면 표준 로그만 사용합니다.
#     기본값: 0 (거짓)
OllamaChat.DebugShowFullPrompt = 0

# --------------------------------------------
# Ollama LLM 연결 및 추론
# --------------------------------------------

# OllamaChat.Url
#     설명: Ollama API 요청에 사용하는 URL입니다.
#     기본값: http://localhost:11434/api/generate
OllamaChat.Url = http://localhost:11434/api/generate

# OllamaChat.Model
#     설명: Ollama API 요청에 사용할 모델 식별자입니다.
#     기본값: llama3.2:1b
OllamaChat.Model = llama3.2:1b

# OllamaChat.NumPredict
#     설명: Ollama 응답에서 생성할 최대 토큰 수입니다.
#     0 = 무제한. 확실한 상한이 필요할 때만 설정하세요.
#     기본값: 100
#
#     중요: 이 상한은 추론(reasoning)과 답변을 모두 포함합니다. 추론 모델
#     (gpt-oss, deepseek-r1, qwen3 thinking 빌드)은 추론을 먼저 출력하므로,
#     상한이 낮으면 답변이 시작되기 전에 모두 소진되어 봇이 아무것도 반환하지 않습니다.
#     이런 모델은 think 모드를 꺼도 추론합니다. "think": false 는 요청일 뿐
#     보장이 아닙니다. OllamaChat.ReasoningTokenReserve 항목을 참고하세요.
#
#     | NumPredict | 대략 단어 수  | 용도                             |
#     |:----------:|:-------------:|:---------------------------------|
#     |     20     |   ~13–15      | 아주 짧은 답/감정 표현/잡담      |
#     |     30     |     ~20       | 짧은 답변                        |
#     |     40     |   ~27–30      | 일반적인 WoW 답변 (권장)         |
#     |     50     |   ~35–38      | 조금 긴 답변                     |
#     |     75     |   ~50–60      | 긴 퀘스트/배경 이야기 텍스트     |
#     |    100+    |   70–80+      | 여러 문단 (일반적이지 않음)      |
OllamaChat.NumPredict = 100

# OllamaChat.ReasoningTokenReserve
#     설명: 추론 토큰이 예상될 때 num_predict에 추가로 더하는 여유분입니다.
#           think 모드가 켜져 있거나, think 모드를 끈 상태에서도 모델이
#           추론하는 것이 관찰된 경우에 적용됩니다.
#
#           두 번째 경우는 모듈이 스스로 감지합니다. HTTP 200 응답에 추론은 있는데
#           답변이 비어 있으면 예산을 생각하는 데 다 썼다는 뜻입니다. 그러면 해당 요청을
#           여유분을 더해 다시 시도하고, 이후 그 모델의 모든 요청에 적용하므로
#           이를 파악하는 동안 답변 하나만 잃게 됩니다.
#
#           NumPredict = 0 (이미 무제한)일 때는 효과가 없습니다.
#           0으로 설정하면 여유분과 재시도를 비활성화합니다.
#     기본값: 512
OllamaChat.ReasoningTokenReserve = 512

# OllamaChat.Temperature
#     설명: 모델 출력의 "창의성", 즉 무작위성을 조절합니다.
#           낮은 값(예: 0.2) = 더 집중적이고 반복적이며 예측 가능합니다.
#           높은 값(예: 1.0) = 더 무작위적이고 창의적이거나 의외의 결과가 나옵니다.
#           0.8이 Ollama 기본값입니다.
#     예:     OllamaChat.Temperature = 0.6
#     기본값: 0.8
OllamaChat.Temperature = 0.8

# OllamaChat.TopP
#     설명: 무작위성을 조절하는 또 다른 방식인 nucleus 샘플링을 제어합니다.
#           낮은 값(예: 0.5) = 더 보수적입니다.
#           높은 값(최대 1.0) = 더 개방적입니다.
#           0.95가 Ollama 기본값입니다.
#     예:     OllamaChat.TopP = 0.9
#     기본값: 0.95
OllamaChat.TopP = 0.95

# OllamaChat.RepeatPenalty
#     설명: 모델 출력에서 반복을 억제합니다.
#                  1.0 = 불이익 없음. 높을수록(e.g. 1.2) 반복이 줄어듭니다.
#           1.1이 Ollama 기본값입니다.
#     예:     OllamaChat.RepeatPenalty = 1.2
#     기본값: 1.1
OllamaChat.RepeatPenalty = 1.1

# OllamaChat.NumCtx
#     설명: 모델에 보내는 최대 컨텍스트 길이(토큰 단위)입니다.
#                  0 = 모델 기본값. 컨텍스트를 제한하거나 늘리고 싶을 때만 값을 지정하세요.
#           예: Llama-3 8B는 8192, 70B는 8192/32768.
#     예:     OllamaChat.NumCtx = 4096
#     기본값: 0
OllamaChat.NumCtx = 0

# OllamaChat.NumThreads
#     설명: 모델이 요청을 계산할 때 사용할 최대 스레드 수입니다.
#                  0 = 모델 기본값. 자동 설정을 제한하거나 바꾸고 싶을 때만 값을 지정하세요.
#                  
#     예:     OllamaChat.NumThreads = 2
#     기본값: 0
OllamaChat.NumThreads = 0

# OllamaChat.Stop
#     설명: 선택 사항입니다. 쉼표로 구분한 "정지 시퀀스(stop sequence)" 문자열 목록입니다.
#           모델이 이 문자열 중 하나를 출력하면 즉시 생성을 멈추고 그 지점까지의 응답을 반환합니다.
#           채팅 애플리케이션에서 다른 사용자의 대화 차례처럼 원치 않는 부분으로
#           모델이 이어서 출력하는 것을 막을 때 사용하세요.
#           예: "User:,Bot:" 로 설정하면 응답에 "User:" 또는 "Bot:" 이 나타날 때 출력이 멈춥니다.
#           비워 두면 비활성화됩니다.
#     예:     OllamaChat.Stop = User:,Bot:
#     기본값: (비어 있음)
OllamaChat.Stop =

# OllamaChat.SystemPrompt
#     설명: 선택 사항입니다. Ollama에 보내는 "system" 필드의 내용입니다.
#           모델의 동작을 전역적으로 유도하거나 "사전 설정"하는 데 사용할 수 있습니다.
#           시스템 프롬프트를 쓰지 않으려면 비워 두고, 원하면 직접 입력하세요.
#     예:     OllamaChat.SystemPrompt = "Always answer as if you are a WoW quest giver."
#     기본값: (비어 있음)
OllamaChat.SystemPrompt =

# OllamaChat.Seed
#     설명: 선택 사항입니다. 결정적 생성을 위한 랜덤 시드입니다. 반복 가능한 결과를 원하면
#           숫자를 설정하고, 일반적인 무작위 출력을 원하면 비워 두세요.
#     예:     OllamaChat.Seed = 42
#     기본값: (비어 있음)
OllamaChat.Seed =

# OllamaChat.MaxConcurrentQueries
#     설명: 허용되는 최대 동시 API 요청 수입니다. 0이면 제한이 없습니다.
#     기본값: 0
OllamaChat.MaxConcurrentQueries = 0

# --------------------------------------------
# Think 모드 지원
# --------------------------------------------

# OllamaChat.ThinkModeEnableForModule
#     설명: 지원되는 LLM 모델에서 Think 모드를 활성화합니다. 활성화하면 API 요청에 "think" 플래그가 포함되고,
#           봇 답변에서 모든 <think> 태그와 그 내용을 제거한 본문 응답만 반환합니다.
#           Think 모드를 사용할 때는 반드시 OllamaChat.NumPredict = 0 (무제한)으로 설정하세요.
#           Think 모드가 필요한 일부 모델은 이 옵션을 켜야 제대로 동작합니다.
#     기본값: 0 (거짓)
# (이동됨: 이 파일 끝의 THINK MODE 섹션을 참고하세요)

# --------------------------------------------
# 일반 대화 / 응답 로직
# --------------------------------------------

# OllamaChat.PlayerReplyChance.Say
#     설명: 조건을 만족하는 봇이 일반 대화/외치기(Say/Yell) 채널에서 플레이어에게 답할 확률(0-100, %)입니다.
#     기본값: 90
OllamaChat.PlayerReplyChance.Say = 90

# OllamaChat.BotReplyChance.Say
#     설명: 조건을 만족하는 봇이 일반 대화/외치기(Say/Yell) 채널에서 다른 봇에게 답할 확률(0-100, %)입니다.
#     기본값: 10
OllamaChat.BotReplyChance.Say = 10

# OllamaChat.PlayerReplyChance.Channel
#     설명: 조건을 만족하는 봇이 사용자 지정 채널(General, Trade 등)에서 플레이어에게 답할 확률(0-100, %)입니다.
#     기본값: 60
OllamaChat.PlayerReplyChance.Channel = 60

# OllamaChat.BotReplyChance.Channel
#     설명: 조건을 만족하는 봇이 사용자 지정 채널(General, Trade 등)에서 다른 봇에게 답할 확률(0-100, %)입니다.
#     기본값: 3
OllamaChat.BotReplyChance.Channel = 3

# OllamaChat.PlayerReplyChance.Party
#     설명: 조건을 만족하는 봇이 파티/공격대(Party/Raid) 채팅에서 플레이어에게 답할 확률(0-100, %)입니다.
#     기본값: 90
OllamaChat.PlayerReplyChance.Party = 90

# OllamaChat.BotReplyChance.Party
#     설명: 조건을 만족하는 봇이 파티/공격대(Party/Raid) 채팅에서 다른 봇에게 답할 확률(0-100, %)입니다.
#     기본값: 25
OllamaChat.BotReplyChance.Party = 25

# OllamaChat.PlayerReplyChance.Guild
#     설명: 조건을 만족하는 봇이 길드/길드관리자(Guild/Officer) 채팅에서 플레이어에게 답할 확률(0-100, %)입니다.
#     기본값: 70
OllamaChat.PlayerReplyChance.Guild = 70

# OllamaChat.BotReplyChance.Guild
#     설명: 조건을 만족하는 봇이 길드/길드관리자(Guild/Officer) 채팅에서 다른 봇에게 답할 확률(0-100, %)입니다.
#     기본값: 5
OllamaChat.BotReplyChance.Guild = 5

# OllamaChat.EnableWhisperReplies
#     설명: 귓속말에 대한 봇 응답을 활성화하거나 비활성화합니다.
#           0 (거짓)으로 설정하면 봇은 어떤 귓속말에도 답하지 않습니다.
#           1 (참)로 설정하면 봇은 일반 응답 확률에 따라 귓속말에 답합니다.
#     기본값: 0 (거짓)
#
#        귓속말은 직접 건네는 말이므로, 이 옵션이 켜져 있으면 봇은 항상 답합니다.
#        PlayerReplyChance.* 의 영향을 받지 않으며(예전에는 PlayerReplyChance.Say 를
#        빌려 썼기 때문에 이 값을 낮추면 귓속말이 무작위로 무시되고, 0으로 설정하면
#        완전히 막혔습니다), BotCooldownSeconds, ScopeCooldownSeconds, ScopeMessagesPerMinute
#        나 반복 필터에도 제한받지 않습니다. 이들은 주변 잡담의 속도를 조절하는 설정이라
#        직접 받은 질문에 대한 답을 막아서는 안 되기 때문입니다.
#
#        GlobalMessagesPerMinute 는 여전히 적용됩니다. 이 설정은 봇의 속도 조절이 아니라
#        LLM 백엔드를 보호하기 위한 것입니다.
OllamaChat.EnableWhisperReplies = 0

# OllamaChat.MaxBotsToPick
#     설명: 봇 이름이 명시적으로 언급되지 않았을 때 무작위로 선택되어 답할 수 있는 최대 봇 수입니다.
#     기본값: 2
OllamaChat.MaxBotsToPick = 2

# OllamaChat.BlacklistCommands
#     설명: AI 봇이 무시해야 할 명령어 접두사를 쉼표로 구분한 목록입니다.
#           메시지가 이 접두사 중 하나로 시작하면 봇은 응답하지 않습니다.
#     기본값: 
OllamaChat.BlacklistCommands = autogear,talents,reset botAI,summon,release,revive,leave,attack,follow,flee,stay,runaway,grind,disperse,give leader,spells,cast ,quests,accept,drop,talk,reset,ss ,trainer,rti,rtsc,do ,ll ,e ,ue ,nc ,open,destroy,s ,b ,bank,gb ,u ,co ,ELVUI_VERSIONCHK,Asked,DPSMate_,LibGroupTalents,BLT,oRA3,Skada,HealBot,hbComms,questie,pfQuest,DBMv4-Ver,BWVQ3,add,remove,reset ai,report,state,help,log,stats,tank,offtank,healer,cc ,damage,boost,passive,defensive,aggressive,stay,guard,free,follow,assist,pet,stance,formation,rpg,emote,cheer,applaud,drink,eat,dance,attackers,reset instances,home,zone,who ,pos ,tele,grind,loot,quest,trainer,travel,teleport,homebind,unfollow,invite,uninvite,join,leave,leader,ready,release,save,update,reset talents,gear,trade,mail,ah ,ahscan,ahbid,ahbuy,ahsell,ahcancel,bag,repair,vendor,train,spells,reset spells,learn,unlearn,cast,uncast,use ,move,go ,look,stop,turn,face,wait,party,followleader,stayleader,moveleader,info,distance,debug,reset path,reset state,reset all,reset dungeon,reset raid,zone info,LHC40,RECOUNT,GTFO_v,Altoholic,DS_,DataStore

# OllamaChat.SayDistance
#     설명: 일반 대화(Say) 메시지에 답하기 위해 봇이 있어야 하는 최대 거리(게임 단위)입니다.
#     기본값: 30.0
OllamaChat.SayDistance = 30.0

# OllamaChat.YellDistance
#     설명: 외치기(Yell) 메시지에 답하기 위해 봇이 있어야 하는 최대 거리(게임 단위)입니다.
#     기본값: 100.0
OllamaChat.YellDistance = 100.0

# OllamaChat.DisableForCustomChannels
#     설명: 활성(1)이면 사용자 지정 채널(General, Trade, LookingForGroup 등)에서
#           Ollama 봇의 답변, 무작위 잡담, 이벤트를 비활성화합니다.
#           다른 채팅 유형의 봇 상호작용은 유지하면서 공개 채널의 도배를 줄일 수 있습니다.
#     기본값: 0 (거짓)
OllamaChat.DisableForCustomChannels = 0

# OllamaChat.DisableForSayYell
#     설명: 활성(1)이면 일반 대화 및 외치기(Say/Yell) 채널에서 Ollama 봇의 답변, 무작위 잡담, 이벤트를 비활성화합니다.
#           근거리 기반 채팅에서 봇을 조용히 두고 싶을 때 유용합니다.
#     기본값: 0 (거짓)
OllamaChat.DisableForSayYell = 0

# OllamaChat.DisableForGuild
#     설명: 활성(1)이면 길드 및 길드관리자(Guild/Officer) 채널에서 Ollama 봇의 답변, 무작위 잡담, 이벤트를 비활성화합니다.
#           봇 잡담 없이 길드 채팅을 집중된 상태로 유지할 때 유용합니다.
#     기본값: 0 (거짓)
OllamaChat.DisableForGuild = 0

# OllamaChat.DisableForParty
#     설명: 활성(1)이면 파티 및 공격대(Party/Raid) 채널에서 Ollama 봇의 답변, 무작위 잡담, 이벤트를 비활성화합니다.
#           파티 채팅에 봇이 끼지 않게 하고 싶을 때 유용합니다.
#     기본값: 0 (거짓)
OllamaChat.DisableForParty = 0

# --------------------------------------------
# 무작위 잡담 시스템
# --------------------------------------------

# OllamaChat.EnableRandomChatter
#     설명: 실제 플레이어가 근처에 있을 때 AI 봇의 무작위 잡담을 활성화하거나 비활성화합니다.
#     기본값: 1 (참)
OllamaChat.EnableRandomChatter = 1

# OllamaChat.DisableRepliesInCombat
#     설명: 참이면 봇이 전투 중에는 답하거나 무작위 잡담을 하지 않습니다.
#     기본값: 1
OllamaChat.DisableRepliesInCombat = 1

# OllamaChat.MinRandomInterval
#     설명: AI 봇의 무작위 대사 사이 최소 시간(초)입니다.
#     기본값: 45
OllamaChat.MinRandomInterval = 45

# OllamaChat.MaxRandomInterval
#     설명: AI 봇의 무작위 대사 사이 최대 시간(초)입니다.
#     기본값: 180
OllamaChat.MaxRandomInterval = 180

# OllamaChat.RandomChatterRealPlayerDistance
#     설명: 봇의 무작위 잡담이 발생하려면 실제 플레이어가 있어야 하는 최대 거리(게임 단위)입니다.
#     기본값: 200.0
OllamaChat.RandomChatterRealPlayerDistance = 200.0

# OllamaChat.RandomChatterBotCommentChance
#     설명: 무작위 잡담이 발생했을 때 AI 봇이 한마디 덧붙일 확률(0-100, %)입니다.
#     기본값: 5
OllamaChat.RandomChatterBotCommentChance = 5

# OllamaChat.RandomChatterMaxBotsPerPlayer
#     설명: 실제 플레이어가 근처에 있을 때 무작위 잡담 갱신 한 번에 발동할 수 있는 최대 AI 봇 수입니다.
#           도배를 막기 위해 한 번에 응답할 수 있는 봇 수를 제한합니다.
#            각 봇은 틱당 한 번만 처리되며, 실제 플레이어 여러 명이 가까이 있어도 중복되지 않습니다.
#     기본값: 2
OllamaChat.RandomChatterMaxBotsPerPlayer = 2

# OllamaChat.RandomChatterPromptTemplate
#   설명: 봇의 무작위 잡담 프롬프트에 쓰는 템플릿 문자열입니다.
#   치환자(이름 지정): {bot_name} {bot_level} {bot_class} {bot_race} {bot_gender} {bot_role} {bot_faction} {bot_area} {bot_zone} {bot_map} {bot_personality} {bot_personality_name} {environment_info}
#   참고: {bot_personality_name} 에는 성격의 이름/키(예: "grumpy", "helpful")가 들어가고,
#         {bot_personality} 에는 성격 설명 전체 텍스트가 들어갑니다.
OllamaChat.RandomChatterPromptTemplate = "You are a World of Warcraft player. Name: {bot_name}, Level: {bot_level} {bot_class}, {bot_race} {bot_gender}, Spec: {bot_role}, Faction: {bot_faction}. Location: {bot_area}, Zone: {bot_zone}, Map: {bot_map}. MAKE SURE YOU RESPOND USING YOUR PERSONALITY, WHICH IS: {bot_personality_name}: {bot_personality}. {environment_info} Reply casually in under 15 words. No quotes, markdown, symbols, or emojis. Use real WoW slang. Avoid uncommon jargon or formatting."

# OllamaChat.RandomChatterPromptVariations
#   설명: 무작위로 선택되어 RandomChatterPromptTemplate 뒤에 붙는 추가 프롬프트 지시문 목록으로, 파이프(|)로 구분합니다.
#         봇의 무작위 잡담 관점이나 초점을 바꿔 응답에 다양성을 더합니다.
#         봇이 무작위 잡담을 생성할 때마다 변형 하나가 무작위로 선택됩니다.
#         비워 두면 변형 없이 기본 템플릿만 사용합니다.
#   예:     "Talk about the weather or environment.|Comment on your current task or goal.|Make an observation about nearby creatures or players."
#   기본값: (아래의 리치 왕의 분노 시대에 맞춘 변형 참고)
OllamaChat.RandomChatterPromptVariations = "Complain about something typical WoW players complain about.|Make a casual observation about leveling or grinding.|Share your opinion on Horde vs Alliance.|Comment on how tough or easy the zone feels.|Make a joke or sarcastic remark about WoW.|Mention something about the Lich King expansion.|Talk about wanting better gear or loot.|Comment on flying mounts or Northrend travel.|Complain about repair costs or gold.|Make an observation about your class in general.|Comment on dungeon finder or group content.|Talk about daily quests or reputation grinds.|Mention Death Knights being OP or annoying.|Share your thoughts on arena or battlegrounds.|Complain about nerfed abilities or changes.|Talk about needing to farm materials or gold.|Comment on the cold weather in Northrend.|Mention wanting to raid or do heroics.|Talk about achievements being too grindy.|Make a casual remark about quest objectives."

# OllamaChat.RandomChatterQuestionVariations
#   설명: 다른 봇이나 플레이어의 응답을 끌어낼 질문을 LLM이 생성하도록 지시하는 프롬프트 목록으로, 파이프(|)로 구분합니다.
#         봇이 이 변형 중 하나를 사용하면 LLM이 해당 지시문을 바탕으로 질문을 생성합니다.
#         이 질문은 다른 봇(BotReplyChance 를 통해)과 실제 플레이어가 대화에 참여하도록 유도하기 위한 것입니다.
#         봇이 무작위 잡담을 생성할 때는 진술하기(RandomChatterPromptVariations)와
#         질문하기(RandomChatterQuestionVariations) 중 하나를 무작위로 고릅니다.
#         비워 두면 질문 변형을 비활성화하고 진술 변형만 사용합니다.
#   예:     "Ask about dungeon preferences.|Ask if anyone wants to PvP.|Ask about raid progression."
#   기본값: (봇끼리, 플레이어와 봇 사이의 대화를 유도하도록 만든 리치 왕의 분노 시대 질문 프롬프트는 아래 참고)
OllamaChat.RandomChatterQuestionVariations = "Ask if others think this zone is difficult.|Ask about favorite dungeons.|Ask about Icecrown Citadel progression.|Ask about daily quest frustrations.|Ask about Naxxramas difficulty compared to original.|Ask what spec people are running.|Ask about Death Knight popularity.|Ask about upcoming Death Knight nerfs.|Ask about gold-making strategies in WoW.|Ask if anyone is farming badges.|Ask about excitement for Ulduar.|Ask if dual spec was worth the cost.|Ask about opinions on the old talent trees.|Ask about favorite raid bosses.|Ask if flying mounts ruined world PvP.|Ask who's doing arena this season.|Ask about arena ratings.|Ask about Wintergrasp balance.|Ask about Oculus dungeon opinions.|Ask which professions make the most gold.|Ask about old-world flying possibilities.|Ask about reputation mount farming.|Ask which heroic dungeon is hardest.|Ask if emblems are too easy to get."

# --------------------------------------------
# 이벤트 잡담 시스템
# --------------------------------------------

# OllamaChat.EnableEventChatter
#     설명: 이벤트 기반 잡담 시스템(예: 플레이어 사망, 지역 진입)을 활성화하거나 비활성화합니다.
#           활성(1)이면 봇이 미리 정의된 게임 이벤트에 반응합니다.
#     기본값: 1 (참)
OllamaChat.EnableEventChatter = 1

# OllamaChat.EventChatterRealPlayerDistance
#     설명: 이벤트 기반 봇 잡담이 발생하려면 실제 플레이어가 있어야 하는 최대 거리(게임 단위)입니다.
#     기본값: 40.0
OllamaChat.EventChatterRealPlayerDistance = 40.0

# OllamaChat.EventChatterBotCommentChance
#     설명: 다른 플레이어가 일으킨 게임 이벤트에 AI 봇이 반응할 확률(0–100, %)입니다.
#     기본값: 25
OllamaChat.EventChatterBotCommentChance = 25

# OllamaChat.EventChatterBotSelfCommentChance
#     설명: 봇 자신이 일으킨 게임 이벤트에 AI 봇이 반응할 확률(0–100, %)입니다.
#     기본값: 5
OllamaChat.EventChatterBotSelfCommentChance = 5

# OllamaChat.EventChatterMaxBotsPerPlayer
#     설명: 한 플레이어의 이벤트에 반응할 수 있는 최대 봇 수입니다.
#     기본값: 2
OllamaChat.EventChatterMaxBotsPerPlayer = 2

# OllamaChat.EventChatterPromptTemplate
#     설명: 월드 이벤트에 반응할 때 봇 프롬프트를 생성하는 데 쓰는 템플릿입니다.

#     치환자(이름 지정): {bot_name} {bot_level} {bot_class} {bot_race} {bot_gender} {bot_role} {bot_faction} {bot_area} {bot_zone} {bot_map} {bot_personality} {bot_personality_name} {event_type} {event_detail} {actor_name} {sentiment_info}
#     참고: {bot_personality_name} 에는 성격의 이름/키(예: "grumpy", "helpful")가 들어가고,
#           {bot_personality} 에는 성격 설명 전체 텍스트가 들어갑니다.
OllamaChat.EventChatterPromptTemplate = "You are {bot_name}, a level {bot_level} {bot_class} ({bot_race} {bot_gender}) specializing as a {bot_role} from the {bot_faction} faction. You are currently in {bot_area}, Zone: {bot_zone}, Map: {bot_map}. Personality: {bot_personality_name}: {bot_personality}. {sentiment_info} Event: {actor_name} {event_type} {event_detail}. Respond to this specific Event that just happened in character, casually, in under 15 words. Avoid emojis, markdown, or narration."

# --------------------------------------------
# 타이핑 시뮬레이션
# --------------------------------------------

# OllamaChat.EnableTypingSimulation
#     설명: 활성(1)이면 실제 타이핑처럼 보이도록 봇이 메시지 길이에 비례해 응답을 지연합니다.
#           지연 시간은 다음과 같이 계산합니다.
#           BaseDelay + (MessageLength * DelayPerChar) 밀리초
#           예: 기본값으로 100자 메시지 = 1000ms + (100 * 250ms) = 26초
#     기본값: 0 (거짓)
OllamaChat.EnableTypingSimulation = 0

# OllamaChat.TypingSimulationBaseDelay
#     설명: 봇이 응답을 "입력"하기 시작하기 전의 기본 지연 시간(밀리초)입니다.
#           메시지를 읽고 입력을 시작하는 데 걸리는 시간을 흉내 냅니다.
#     기본값: 1000
OllamaChat.TypingSimulationBaseDelay = 1000

# OllamaChat.TypingSimulationDelayPerChar
#     설명: 봇 응답의 글자당 추가 지연 시간(밀리초)입니다.
#           현실적인 타이핑 속도:
#           - 글자당 400ms = 초당 2.5자 (느림/여유롭게)
#           - 글자당 250ms = 초당 4자 (보통 사람)
#           - 글자당 150ms = 초당 6.7자 (능숙함)
#           - 글자당 100ms = 초당 10자 (전문가)
#     기본값: 250
OllamaChat.TypingSimulationDelayPerChar = 250

# --------------------------------------------
# RP 성격 시스템
# --------------------------------------------

# OllamaChat.EnableRPPersonalities
#     설명: AI 봇에 정의된 롤플레이 성격을 사용할지 활성화하거나 비활성화합니다.
#           활성(1)이면 봇이 할당된 유형에 따라 뚜렷한 성격으로 응답합니다.
#           비활성(0)이면 봇이 중립적인 기본 응답 스타일을 사용합니다.
#     기본값: 0 (거짓)
OllamaChat.EnableRPPersonalities = 0

# OllamaChat.DefaultPersonalityPrompt
#     설명: 봇에 특정 롤플레이 유형이 할당되지 않았을 때 사용하는 대체 성격 설명입니다.
#     기본값: Talk like a standard WoW player.
OllamaChat.DefaultPersonalityPrompt = "Speak like a real WoW player. Stay in character and use casual in-game tone."

# --------------------------------------------
# 대화 기록 및 스냅샷 시스템
# --------------------------------------------

# OllamaChat.EnableChatHistory
#     설명: 채팅 기록 사용을 활성화하거나 비활성화합니다.
#     기본값: 1 (참)
OllamaChat.EnableChatHistory = 1

# OllamaChat.MaxConversationHistory
#     설명: 봇/플레이어 조합마다 추적할 최근 메시지 쌍(플레이어 메시지 + 봇 답변)의 최대 개수입니다.
#           이 기록은 메모리에 저장되며, 같은 플레이어가 다시 봇에게 말을 걸 때 LLM 프롬프트에 포함됩니다.
#     기본값: 5
OllamaChat.MaxConversationHistory = 5

# OllamaChat.ConversationHistorySaveInterval
#     설명: 메모리의 대화 기록을 데이터베이스에 주기적으로 저장하는 간격(분)입니다.
#           0으로 설정하면 자동 저장을 비활성화합니다.
#
#           마지막 저장 이후 추가된 대화만 기록되며, 새 대화가 추가된 봇/플레이어 쌍만
#           MaxConversationHistory 에 맞게 잘라냅니다. 조용한 서버에서는 아무것도 기록하지 않으므로,
#           이 값을 낮춰도 간격이 짧아지는 것에 비해 부담은 훨씬 적습니다.
#     기본값: 10
OllamaChat.ConversationHistorySaveInterval = 10

# OllamaChat.EnableChatBotSnapshotTemplate
#     설명: 각 봇의 추가 상황 인식 컨텍스트를 활성화하거나 비활성화합니다.
#           활성(1)이면 봇이 현재 상태와 주변 환경의 스냅샷을 채팅 프롬프트에 포함합니다.
#           여기에는 전투 상태, 파티 정보, 알고 있는 주문, 진행 중인 퀘스트, 시야 내 오브젝트, 근처 플레이어가 포함됩니다.
#           비활성(0)이면 이 컨텍스트를 채팅 프롬프트에 포함하지 않습니다.
#           주변 환경과 현재 상태를 인식해야 하는 봇에 유용합니다.
#           활성화하면 API 호출의 응답 시간과 토큰 사용량이 늘어날 수 있습니다.
#     기본값: 0 (거짓)
OllamaChat.EnableChatBotSnapshotTemplate = 0

# OllamaChat.ChatHistoryHeaderTemplate
#   설명: 대화 기록 컨텍스트의 머리글 형식입니다.
#   치환자(이름 지정): {player_name}
OllamaChat.ChatHistoryHeaderTemplate = "Recent chats with {player_name}. Use only for context. Reply to the new message."

# OllamaChat.ChatHistoryLineTemplate
#   설명: 대화 기록 컨텍스트의 각 줄 형식입니다.
#   치환자(이름 지정): {player_name} {player_message} {bot_reply}
OllamaChat.ChatHistoryLineTemplate = "{player_name} said: {player_message}\nYou said: {bot_reply}\n"

# OllamaChat.ChatHistoryFooterTemplate
#   설명: 대화 기록 컨텍스트의 바닥글 형식입니다.
#   치환자(이름 지정): {player_name} {player_message}
OllamaChat.ChatHistoryFooterTemplate = "NEW MESSAGE from {player_name}: {player_message}"

# OllamaChat.ChatBotSnapshotTemplate
#   설명: 봇의 주변 환경과 상태에 대한 컨텍스트 스냅샷 템플릿 문자열입니다.
#   치환자(이름 지정): {combat} {group} {spells} {quests} {los} {players}
OllamaChat.ChatBotSnapshotTemplate = "CURRENT CONTEXT:\n{combat}\n{group}\nSpells:\n{spells}\nQuests:\n{quests}\nVisible Objects:\n{los}\nNearby Players:\n{players}"

# ----------------------------------------------
# 호감도(감정) 추적 시스템
# ----------------------------------------------

# 봇과 플레이어 사이의 호감도 추적을 활성화하거나 비활성화합니다.
# LLM 호출이 추가로 필요하므로 기본적으로 비활성입니다.
# 기본값: 0 (비활성)
OllamaChat.EnableSentimentTracking = 0

# 새로운 봇-플레이어 관계의 기본 호감도 값
# 범위: 0.0 (적대적) ~ 1.0 (우호적), 0.5 = 중립
# 기본값: 0.5
OllamaChat.SentimentDefaultValue = 0.5

# 긍정/부정 메시지 하나당 호감도를 조정하는 양
# 범위: 0.01 ~ 0.5 (작을수록 더 점진적으로 변화)
# 기본값: 0.05
OllamaChat.SentimentAdjustmentStrength = 0.05

# 호감도 데이터를 데이터베이스에 저장하는 주기(분)
# 0으로 설정하면 주기적 저장을 비활성화합니다.
# 호감도가 실제로 변한 봇/플레이어 쌍만 기록합니다.
# 기본값: 10
OllamaChat.SentimentSaveInterval = 10

# 호감도(감정) 분석용 프롬프트 템플릿
# 분석할 메시지 자리에 {message} 치환자를 사용하세요.
# 기본값: "Analyze the sentiment of this message: \"{message}\". Respond only with: POSITIVE, NEGATIVE, or NEUTRAL."
OllamaChat.SentimentAnalysisPrompt = "Analyze the sentiment of this message: \"{message}\". Respond only with: POSITIVE, NEGATIVE, or NEUTRAL."

# 봇 프롬프트에 호감도 정보를 넣을 때 쓰는 템플릿
# {player_name} 와 {sentiment_value} 치환자를 사용하세요.
# 기본값: "Your relationship sentiment with {player_name} is {sentiment_value} (0.0=hostile, 0.5=neutral, 1.0=friendly). Use this to guide your tone and response."
OllamaChat.SentimentPromptTemplate = "Your relationship sentiment with {player_name} is {sentiment_value} (0.0=hostile, 0.5=neutral, 1.0=friendly). Use this to guide your tone and response."

# --------------------------------------------
# 채팅/프롬프트 템플릿
# --------------------------------------------

# OllamaChat.ChatPromptTemplate
#   설명: LLM에 보내는 봇 채팅 프롬프트의 기본 템플릿입니다.
#   치환자(이름 지정): {bot_name} {bot_level} {bot_class} {bot_personality} {bot_personality_name} {player_level} {player_class} {player_name} {player_message} {extra_info} {sentiment_info}
#   참고: {bot_personality_name} 에는 성격의 이름/키(예: "grumpy", "helpful")가 들어가고,
#         {bot_personality} 에는 성격 설명 전체 텍스트가 들어갑니다.
OllamaChat.ChatPromptTemplate = "You're a WoW player familiar with 3.3.5 version of the game and before. Name: {bot_name}, Level: {bot_level} {bot_class}, MAKE SURE YOU RESPOND USING YOUR PERSONALITY, WHICH IS: {bot_personality_name}: {bot_personality}. {sentiment_info} {chat_history} A level {player_level} {player_class} named {player_name} said: '{player_message}'. {extra_info} Reply naturally in under 15 words. Use authentic WoW tone. Be blunt if provoked. Be precise if giving directions. Never contradict your class, race, or location. Never act like a narrator—just respond like a player."

# OllamaChat.ChatExtraInfoTemplate
#   설명: 봇과 플레이어에 대한 컨텍스트/세부 정보 문자열로, 채팅 프롬프트의 마지막 매개변수로 삽입됩니다.
#   치환자(이름 지정): {bot_race} {bot_gender} {bot_role} {bot_faction} {bot_guild} {bot_group_status} {bot_gold} {player_race} {player_gender} {player_role} {player_faction} {player_guild} {player_group_status} {player_gold} {player_distance} {bot_area} {bot_zone} {bot_map}
OllamaChat.ChatExtraInfoTemplate = "Your Info: {bot_race} {bot_gender}, Spec: {bot_role}, Faction: {bot_faction}, Guild: {bot_guild}, Group: {bot_group_status}, Gold: {bot_gold}. Player Info: {player_race} {player_gender}, Spec: {player_role}, Faction: {player_faction}, Guild: {player_guild}, Group: {player_group_status}, Gold: {player_gold}, Distance: {player_distance} yards. Location: {bot_area}, Zone: {bot_zone}, Map: {bot_map}. Only respond to the new message. No commentary, no meta-talk, no prefix—just the reply."

# --------------------------------------------
# 환경/상황 템플릿
# --------------------------------------------

# OllamaChat.EnvCommentCreature
#   설명: 근처에서 생물이 발견되었을 때 쓰는 파이프(|)로 구분한 템플릿 메시지 목록입니다.
#   치환자(이름 지정): {creature_name}
OllamaChat.EnvCommentCreature = You spot a creature named '{creature_name}' and react cautiously.|You spot a creature named '{creature_name}' and assess its threat.|You spot a creature named '{creature_name}' and comment on its behavior.|You spot a creature named '{creature_name}' and consider whether to engage.|You spot a creature named '{creature_name}' and recall what you know about it.|You spot a creature named '{creature_name}' and comment on its appearance.|You spot a creature named '{creature_name}' and decide if it should be avoided.|You spot a creature named '{creature_name}' and speculate on its intentions.

# OllamaChat.EnvCommentGameObject
#   설명: 근처에 게임 오브젝트가 있을 때 쓰는 파이프(|)로 구분한 템플릿 메시지 목록입니다.
#   치환자(이름 지정): {object_name}
OllamaChat.EnvCommentGameObject = You see {object_name} nearby and comment on its purpose.|You see {object_name} nearby and decide whether to interact.|You see {object_name} nearby and recall why it is useful.|You see {object_name} nearby and judge its condition.|You see {object_name} nearby and consider if it is valuable.|You see {object_name} nearby and explain what it might be used for.|You see {object_name} nearby and react with curiosity.|You see {object_name} nearby and decide whether to investigate.

# OllamaChat.EnvCommentEquippedItem
#   설명: 무작위로 고른 착용 중인 아이템을 언급하는 파이프(|)로 구분한 템플릿 메시지 목록입니다.
#   치환자(이름 지정): {item_name}
OllamaChat.EnvCommentEquippedItem = Talk about your equipped item {item_name} and why you chose it.|Talk about your equipped item {item_name} and how it helps you.|Talk about your equipped item {item_name} and its strengths.|Talk about your equipped item {item_name} and any weaknesses.|Talk about your equipped item {item_name} and how it feels to use.|Talk about your equipped item {item_name} and when it is most effective.|Talk about your equipped item {item_name} and compare it to alternatives.|Talk about your equipped item {item_name} and your confidence in it.

# OllamaChat.EnvCommentBagItem
#   설명: 봇의 가방에 있는 아이템에 대한 파이프(|)로 구분한 템플릿 메시지 목록입니다.
#   치환자(이름 지정): {item_name}
OllamaChat.EnvCommentBagItem = You notice a {item_name} in your bag and consider using it.|You notice a {item_name} in your bag and explain why you keep it.|You notice a {item_name} in your bag and decide if it is still useful.|You notice a {item_name} in your bag and recall where you got it.|You notice a {item_name} in your bag and judge its value.|You notice a {item_name} in your bag and think about trading it.|You notice a {item_name} in your bag and plan when to use it.|You notice a {item_name} in your bag and comment on its condition.

# OllamaChat.EnvCommentBagItemSell
#   설명: 봇이 팔려고 할 만한 아이템에 대한 파이프(|)로 구분한 템플릿 메시지 목록입니다.
#   치환자(이름 지정): {item_count} {item_name}
OllamaChat.EnvCommentBagItemSell = You are trying persuasively to sell {item_count} of this item {item_name} by highlighting its benefits.|You are trying persuasively to sell {item_count} of this item {item_name} by stressing its rarity.|You are trying persuasively to sell {item_count} of this item {item_name} by appealing to need.|You are trying persuasively to sell {item_count} of this item {item_name} by offering a deal.|You are trying persuasively to sell {item_count} of this item {item_name} by explaining its uses.|You are trying persuasively to sell {item_count} of this item {item_name} by comparing it to others.|You are trying persuasively to sell {item_count} of this item {item_name} by creating urgency.|You are trying persuasively to sell {item_count} of this item {item_name} by praising its quality.

# OllamaChat.EnvCommentSpell
#   설명: 무작위로 고른 알고 있는 주문에 대한 파이프(|)로 구분한 템플릿 메시지 목록입니다.
#   치환자(이름 지정): {spell_name} {spell_effect} {spell_cost}
OllamaChat.EnvCommentSpell = Discuss possible uses or strategies for '{spell_name}' in the current situation.|Discuss possible uses or strategies for '{spell_name}' against different enemies.|Discuss possible uses or strategies for '{spell_name}' when resources are low.|Discuss possible uses or strategies for '{spell_name}' and its risks.|Discuss possible uses or strategies for '{spell_name}' compared to other spells.|Discuss possible uses or strategies for '{spell_name}' in group combat.|Discuss possible uses or strategies for '{spell_name}' outside of combat.|Discuss possible uses or strategies for '{spell_name}' given its cost of {spell_cost}.

# OllamaChat.EnvCommentQuestArea
#   설명: 퀘스트할 지역을 추천하는 파이프(|)로 구분한 템플릿 메시지 목록입니다.
#   치환자(이름 지정): {quest_area}
OllamaChat.EnvCommentQuestArea = Suggest you could go questing around {quest_area} and explain why.|Suggest you could go questing around {quest_area} based on your level.|Suggest you could go questing around {quest_area} for rewards.|Suggest you could go questing around {quest_area} due to recent rumors.|Suggest you could go questing around {quest_area} to gain experience.|Suggest you could go questing around {quest_area} and note the dangers.|Suggest you could go questing around {quest_area} if prepared.|Suggest you could go questing around {quest_area} and set a goal.

# OllamaChat.EnvCommentVendor
#   설명: 근처에 상인 NPC가 있을 때 쓰는 파이프(|)로 구분한 템플릿 메시지 목록입니다.
#   치환자(이름 지정): {vendor_name}
OllamaChat.EnvCommentVendor = You spot {vendor_name} selling wares nearby and consider browsing.|You spot {vendor_name} selling wares nearby and recall past deals.|You spot {vendor_name} selling wares nearby and check your coin.|You spot {vendor_name} selling wares nearby and judge their stock.|You spot {vendor_name} selling wares nearby and decide whether to trade.|You spot {vendor_name} selling wares nearby and comment on their reputation.|You spot {vendor_name} selling wares nearby and look for upgrades.|You spot {vendor_name} selling wares nearby and compare prices.

# OllamaChat.EnvCommentQuestgiver
#   설명: 근처에 퀘스트 제공 NPC가 있을 때 쓰는 파이프(|)로 구분한 템플릿 메시지 목록입니다.
#   치환자(이름 지정): {questgiver_name} {quest_count}
OllamaChat.EnvCommentQuestgiver = {questgiver_name} looks like they have {quest_count} quests and you evaluate which to take.|{questgiver_name} looks like they have {quest_count} quests and you judge the risk.|{questgiver_name} looks like they have {quest_count} quests and you consider rewards.|{questgiver_name} looks like they have {quest_count} quests and you recall past work.|{questgiver_name} looks like they have {quest_count} quests and you assess urgency.|{questgiver_name} looks like they have {quest_count} quests and you choose carefully.|{questgiver_name} looks like they have {quest_count} quests and you plan next steps.|{questgiver_name} looks like they have {quest_count} quests and you comment on their tone.

# OllamaChat.EnvCommentBagSlots
#   설명: 남은 가방 칸에 대한 파이프(|)로 구분한 템플릿 메시지 목록입니다.
#   치환자(이름 지정): {bag_slots}
OllamaChat.EnvCommentBagSlots = You have {bag_slots} free bag slots left and decide how cautious to be.|You have {bag_slots} free bag slots left and plan your looting.|You have {bag_slots} free bag slots left and consider selling items.|You have {bag_slots} free bag slots left and comment on inventory pressure.|You have {bag_slots} free bag slots left and adjust priorities.|You have {bag_slots} free bag slots left and plan ahead.|You have {bag_slots} free bag slots left and evaluate risk.|You have {bag_slots} free bag slots left and think about storage.

# OllamaChat.EnvCommentDungeon
#   설명: 봇이 던전에 있을 때 쓰는 파이프(|)로 구분한 템플릿 메시지 목록입니다.
#   치환자(이름 지정): {dungeon_name}
OllamaChat.EnvCommentDungeon = You're in a Dungeon instance named '{dungeon_name}' and comment on the atmosphere.|You're in a Dungeon instance named '{dungeon_name}' and recall known bosses.|You're in a Dungeon instance named '{dungeon_name}' and plan your approach.|You're in a Dungeon instance named '{dungeon_name}' and assess danger.|You're in a Dungeon instance named '{dungeon_name}' and prepare mentally.|You're in a Dungeon instance named '{dungeon_name}' and comment on layout.|You're in a Dungeon instance named '{dungeon_name}' and recall past runs.|You're in a Dungeon instance named '{dungeon_name}' and set expectations.

# OllamaChat.EnvCommentUnfinishedQuest
#   설명: 봇의 퀘스트 목록에서 무작위로 고른 미완료 퀘스트에 대한 파이프(|)로 구분한 템플릿 메시지 목록입니다.
#   치환자(이름 지정): {quest_name}
OllamaChat.EnvCommentUnfinishedQuest = Say the name of and talk about your un-finished quest '{quest_name}' and what remains.|Say the name of and talk about your un-finished quest '{quest_name}' and its difficulty.|Say the name of and talk about your un-finished quest '{quest_name}' and why it stalled.|Say the name of and talk about your un-finished quest '{quest_name}' and your next step.|Say the name of and talk about your un-finished quest '{quest_name}' and its rewards.|Say the name of and talk about your un-finished quest '{quest_name}' and the risks.|Say the name of and talk about your un-finished quest '{quest_name}' and your motivation.|Say the name of and talk about your un-finished quest '{quest_name}' and its urgency.

# --------------------------------------------
# 이벤트 템플릿
# --------------------------------------------

# OllamaChat.EventTypeDefeated
#     설명: 플레이어나 봇이 생물을 처치했을 때의 이벤트 유형 문자열입니다.
#     사용처: 이벤트 기반 채팅 프롬프트. 예: "Kurim defeated Hogger."
#     기본값: defeated
OllamaChat.EventTypeDefeated = defeated
OllamaChat.EventTypeDefeated_Chance = 1

# OllamaChat.EventTypeDefeatedPlayer
#     설명: 플레이어가 다른 플레이어를 처치했을 때(PvP 처치)의 이벤트 유형 문자열입니다.
#     사용처: PvP 처치에 대한 이벤트 기반 채팅 프롬프트.
#     기본값: defeated player
OllamaChat.EventTypeDefeatedPlayer = defeated player
OllamaChat.EventTypeDefeatedPlayer_Chance = 10

# OllamaChat.EventTypePetDefeated
#     설명: 플레이어의 소환수가 생물을 처치했을 때의 이벤트 유형 문자열입니다.
#     사용처: 이벤트 기반 채팅 프롬프트.
#     기본값: pet defeated
OllamaChat.EventTypePetDefeated = pet defeated
OllamaChat.EventTypePetDefeated_Chance = 2

# OllamaChat.EventTypeGotItem
#     설명: 플레이어가 희귀 등급 이상의 아이템을 얻었을 때의 이벤트 유형 문자열입니다.
#     사용처: 플레이어가 주목할 만한 아이템을 얻었을 때의 이벤트 기반 채팅.
#     기본값: got item
OllamaChat.EventTypeGotItem = got item
OllamaChat.EventTypeGotItem_Chance = 65

# OllamaChat.EventTypeDied
#     설명: 플레이어가 죽었을 때의 이벤트 유형 문자열입니다.
#     사용처: 플레이어 사망 시 이벤트 기반 채팅.
#     기본값: died
OllamaChat.EventTypeDied = died
OllamaChat.EventTypeDied_Chance = 18

# OllamaChat.EventTypeCompletedQuest
#     설명: 플레이어가 퀘스트를 완료했을 때의 이벤트 유형 문자열입니다.
#     사용처: 퀘스트 완료 시 이벤트 기반 채팅.
#     기본값: completed quest
OllamaChat.EventTypeCompletedQuest = completed quest
OllamaChat.EventTypeCompletedQuest_Chance = 35

# OllamaChat.EventTypeLearnedSpell
#     설명: 플레이어가 새 주문을 배웠을 때의 이벤트 유형 문자열입니다.
#     사용처: 주문 습득에 대한 이벤트 기반 채팅.
#     기본값: learned spell
OllamaChat.EventTypeLearnedSpell = learned spell
OllamaChat.EventTypeLearnedSpell_Chance = 2

# OllamaChat.EventTypeRequestedDuel
#     설명: 플레이어가 결투를 신청했을 때의 이벤트 유형 문자열입니다.
#     사용처: 결투 신청 시 이벤트 기반 채팅.
#     기본값: requested to duel
OllamaChat.EventTypeRequestedDuel = requested to duel
OllamaChat.EventTypeRequestedDuel_Chance = 28

# OllamaChat.EventTypeStartedDueling
#     설명: 플레이어 간 결투가 시작되었을 때의 이벤트 유형 문자열입니다.
#     사용처: 결투 시작 시 이벤트 기반 채팅.
#     기본값: started dueling
OllamaChat.EventTypeStartedDueling = started dueling
OllamaChat.EventTypeStartedDueling_Chance = 10

# OllamaChat.EventTypeWonDuel
#     설명: 플레이어가 결투에서 이겼을 때의 이벤트 유형 문자열입니다.
#     사용처: 결투 승리에 대한 이벤트 기반 채팅.
#     기본값: won duel against
OllamaChat.EventTypeWonDuel = won duel against
OllamaChat.EventTypeWonDuel_Chance = 85

# OllamaChat.EventTypeLeveledUp
#     설명: 플레이어가 레벨업했을 때의 이벤트 유형 문자열입니다.
#     사용처: 레벨업 시 이벤트 기반 채팅.
#     기본값: leveled up
OllamaChat.EventTypeLeveledUp = leveled up
OllamaChat.EventTypeLeveledUp_Chance = 75

# OllamaChat.EventTypeAchievement
#     설명: 플레이어가 업적을 달성했을 때의 이벤트 유형 문자열입니다.
#     사용처: 업적에 대한 이벤트 기반 채팅.
#     기본값: earned achievement
OllamaChat.EventTypeAchievement = earned achievement
OllamaChat.EventTypeAchievement_Chance = 75

# OllamaChat.EventTypeUsedObject
#     설명: 플레이어가 게임 오브젝트를 사용했을 때의 이벤트 유형 문자열입니다.
#     사용처: 월드의 오브젝트를 사용할 때의 이벤트 기반 채팅.
#     기본값: used object
OllamaChat.EventTypeUsedObject = used object
OllamaChat.EventTypeUsedObject_Chance = 10

# OllamaChat.EventCooldownTime
#     설명: 봇이 이벤트에 반응하는 재사용 대기시간(초)입니다.
#     기본값: 10
OllamaChat.EventCooldownTime = 10

# --------------------------------------------
# 길드 전용 무작위 잡담
# --------------------------------------------

# OllamaChat.EnableGuildRandomAmbientChatter
#     설명: 실제 플레이어가 접속 중인 길드에 속한 봇의 무작위 길드 잡담을 활성화하거나 비활성화합니다.
#     기본값: 1 (참)
OllamaChat.EnableGuildRandomAmbientChatter = 1

# OllamaChat.GuildRandomChatterChance
#     설명: 조건을 만족할 때 봇이 무작위 길드 채팅 메시지를 보낼 확률(0-100, %)입니다.
#     기본값: 10
OllamaChat.GuildRandomChatterChance = 85

# OllamaChat.EnableGuildEventChatter
#     설명: 실제 플레이어가 있는 길드에 속한 봇의 길드 전용 무작위 잡담을 활성화합니다.
#           활성화하면 봇이 길드 관련 이야기를 하고 길드 채팅을 사용합니다.
#           봇과 같은 길드에 실제 플레이어가 접속해 있을 때만 동작합니다.
#     기본값: 1 (참)
OllamaChat.EnableGuildEventChatter = 1

# OllamaChat.GuildChatterBotCommentChance
#     설명: 길드 봇이 길드 이벤트에 한마디 할 확률(0-100, %)입니다.
#           레벨업, 장비 획득, 던전 완료 같은 이벤트에 적용됩니다.
#           값이 낮을수록 길드 이벤트에 덜 자주 반응합니다.
#     기본값: 65
OllamaChat.GuildChatterBotCommentChance = 65

# OllamaChat.GuildChatterMaxBotsPerEvent
#     설명: 하나의 길드 이벤트에 반응할 수 있는 최대 길드 봇 수입니다.
#           여러 길드 봇이 같은 이벤트에 한마디씩 하려 할 때 도배를 막습니다.
#           예: 2로 설정하면 길드원이 레벨업했을 때 최대 2명의 봇만 반응합니다.
#     기본값: 2
OllamaChat.GuildChatterMaxBotsPerEvent = 2

# --------------------------------------------
# 길드 환경 언급 템플릿
# --------------------------------------------

# OllamaChat.GuildEnvCommentGuildMember
#     설명: 길드원에 대해 언급할 때 쓰는 템플릿입니다. 파이프(|)로 구분한 목록입니다.
#     치환자: {member_name}
#     예: "I wonder what {member_name} is up to today."
#     기본값: (비어 있음 - 길드원 언급 없음)
OllamaChat.GuildEnvCommentGuildMember = I wonder what {member_name} is up to today.|{member_name} is a solid guild member.|Haven't seen {member_name} around much lately.

# OllamaChat.GuildEnvCommentGuildRank
#     설명: 길드 등급에 대해 언급할 때 쓰는 템플릿입니다. 파이프(|)로 구분한 목록입니다.
#     치환자: {guild_rank}
#     예: "Being a {guild_rank} has its perks."
#     기본값: (비어 있음 - 길드 등급 언급 없음)
OllamaChat.GuildEnvCommentGuildRank = Being a {guild_rank} has its perks.|The {guild_rank} rank comes with responsibilities.|I'm proud to be a {guild_rank} in this guild.

# OllamaChat.GuildEnvCommentGuildBank
#     설명: 길드 은행 상태에 대해 언급할 때 쓰는 템플릿입니다. 파이프(|)로 구분한 목록입니다.
#     치환자: {bank_gold}
#     예: "Guild bank has {bank_gold} gold saved up."
#     기본값: (비어 있음 - 길드 은행 언급 없음)
OllamaChat.GuildEnvCommentGuildBank = Guild bank has {bank_gold} gold saved up.|We should check what's in the guild bank.|{bank_gold} gold in the guild bank, not bad.|The guild bank could use some donations.

# OllamaChat.GuildEnvCommentGuildMOTD
#     설명: 길드 오늘의 메시지(MOTD)에 대해 언급할 때 쓰는 템플릿입니다. 파이프(|)로 구분한 목록입니다.
#     치환자: {guild_motd}
#     예: "Guild MOTD says: {guild_motd}"
#     기본값: (비어 있음 - 길드 MOTD 언급 없음)
OllamaChat.GuildEnvCommentGuildMOTD = Guild MOTD says: {guild_motd}|Did everyone see the guild message? {guild_motd}|The officers updated the MOTD: {guild_motd}

# OllamaChat.GuildEnvCommentGuildInfo
#     설명: 길드 정보에 대해 언급할 때 쓰는 템플릿입니다. 파이프(|)로 구분한 목록입니다.
#     치환자: {guild_info}
#     예: "Our guild info reads: {guild_info}"
#     기본값: (비어 있음 - 길드 정보 언급 없음)
OllamaChat.GuildEnvCommentGuildInfo = Our guild info reads: {guild_info}|Check out the guild info if you haven't: {guild_info}|The guild description says it all: {guild_info}

# OllamaChat.GuildEnvCommentGuildOnlineMembers
#     설명: 접속 중인 길드원에 대해 언급할 때 쓰는 템플릿입니다. 파이프(|)로 구분한 목록입니다.
#     치환자: {online_count}, {total_count}
#     예: "We have {online_count} out of {total_count} guild members online."
#     기본값: (비어 있음 - 접속 길드원 언급 없음)
OllamaChat.GuildEnvCommentGuildOnlineMembers = We have {online_count} out of {total_count} guild members online.|{online_count} guildies are online right now.|Nice to see {online_count} guild members active today.|Only {online_count} of us online from the guild.

