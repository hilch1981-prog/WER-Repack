# OllamaChat.GuildEventTypeEpicGear
#     설명: 길드원의 영웅 장비 획득 알림에 쓰는 이벤트 유형입니다.
#           희귀한 전리품에 대한 기대감과 축하 분위기를 만듭니다.
#     예:     "Grats on the epic loot!"
#     기본값: guild member got epic gear
OllamaChat.GuildEventTypeEpicGear = guild member got epic gear
OllamaChat.GuildEventTypeEpicGear_Chance = 95

# OllamaChat.GuildEventTypeRareGear
#     설명: 길드원의 희귀 장비 획득 알림에 쓰는 이벤트 유형입니다.
#           길드원이 희귀(파란색) 등급 무기나 방어구를 얻었을 때 발생합니다.
#           장비만 알리며 소비용품이나 거래 물품은 알리지 않습니다.
#     예:     "Nice blue gear upgrade!"
#     기본값: guild member got rare gear
OllamaChat.GuildEventTypeRareGear = guild member got rare gear
OllamaChat.GuildEventTypeRareGear_Chance = 65

# OllamaChat.GuildEventTypeGuildJoin
#     설명: 길드원 가입 알림에 쓰는 이벤트 유형입니다.
#           새 플레이어가 길드에 가입했을 때 발생합니다.
#           새 길드원을 길드 공동체에 환영합니다.
#     예:     "Welcome to the guild!"
#     기본값: member joined guild
OllamaChat.GuildEventTypeGuildJoin = member joined guild
OllamaChat.GuildEventTypeGuildJoin_Chance = 12

# OllamaChat.GuildEventTypeGuildLogin
#     설명: 길드원 접속 알림에 쓰는 이벤트 유형입니다.
#           봇이 아닌 길드원이 접속했을 때 발생합니다.
#           돌아온 길드원을 환영합니다.
#     예:     "{actor_name} has logged in to the guild!"
#     기본값: member logged in
OllamaChat.GuildEventTypeGuildLogin = member logged in
OllamaChat.GuildEventTypeGuildLogin_Chance = 85

# OllamaChat.GuildEventTypeGuildLeave
#     설명: 길드원 탈퇴 알림에 쓰는 이벤트 유형입니다.
#           플레이어가 길드를 떠났을 때 발생합니다.
#           떠나는 길드원을 언급합니다.
#     예:     "Sad to see them go."
#     기본값: member left guild
OllamaChat.GuildEventTypeGuildLeave = member left guild
OllamaChat.GuildEventTypeGuildLeave_Chance = 85

# OllamaChat.GuildEventTypeGuildPromotion
#     설명: 길드원 승급 알림에 쓰는 이벤트 유형입니다.
#           길드원이 더 높은 등급으로 승급했을 때 발생합니다.
#           길드 내 등급 상승을 축하합니다.
#     예:     "Congrats on the promotion!"
#     기본값: member got promoted
OllamaChat.GuildEventTypeGuildPromotion = member got promoted
OllamaChat.GuildEventTypeGuildPromotion_Chance = 25

# OllamaChat.GuildEventTypeGuildDemotion
#     설명: 길드원 강등 알림에 쓰는 이벤트 유형입니다.
#           길드원이 더 낮은 등급으로 강등되었을 때 발생합니다.
#           등급 변경을 조심스럽게 다룹니다.
#     예:     "Rank changes happen."
#     기본값: member got demoted
OllamaChat.GuildEventTypeGuildDemotion = member got demoted
OllamaChat.GuildEventTypeGuildDemotion_Chance = 5

# OllamaChat.GuildEventTypeGuildAchievement
#     설명: 길드원 업적 달성 알림에 쓰는 이벤트 유형입니다.
#           실제(봇이 아닌) 길드원이 업적을 달성했을 때 발생합니다.
#           길드 내 플레이어의 성취를 축하합니다.
#     예:     "{actor_name} just earned an achievement!"
#     기본값: member earned achievement
OllamaChat.GuildEventTypeGuildAchievement = member earned achievement
OllamaChat.GuildEventTypeGuildAchievement_Chance = 85

# OllamaChat.GuildEventTypeLevelUp
#     설명: 길드원 레벨업 알림에 쓰는 이벤트 유형입니다.
#           길드원이 레벨업했을 때 발생합니다.
#           길드 내 플레이어의 성장을 축하합니다.
#     예:     "Grats on the level up!"
#     기본값: member leveled up
OllamaChat.GuildEventTypeLevelUp = member leveled up
OllamaChat.GuildEventTypeLevelUp_Chance = 95

# OllamaChat.GuildEventTypeDungeonComplete
#     설명: 길드 던전 완료 알림에 쓰는 이벤트 유형입니다.
#           길드 파티가 던전을 완료했을 때 발생합니다.
#           PvE 콘텐츠에서의 파티 성과를 인정합니다.
#     예:     "Dungeon run complete!"
#     기본값: guild group completed a dungeon
OllamaChat.GuildEventTypeDungeonComplete = guild group completed a dungeon
OllamaChat.GuildEventTypeDungeonComplete_Chance = 85

# --------------------------------------------
# RAG(검색 증강 생성, Retrieval-Augmented Generation) 시스템
# --------------------------------------------

# OllamaChat.EnableRAG
#     설명: RAG(검색 증강 생성) 기능을 활성화하거나 비활성화합니다.
#           활성화하면 봇이 플레이어 메시지를 분석하고 JSON 지식 베이스 파일에서 관련 정보를 찾아
#           더 정확하고 자세한 응답을 제공합니다.
#     기본값: 0 (거짓)
OllamaChat.EnableRAG = 0



# OllamaChat.RAGDataPath
#     설명: RAG JSON 데이터 파일이 들어 있는 디렉터리 경로입니다.
#           서버 작업 디렉터리 기준의 상대 경로여야 합니다.
#           AzerothCore 설치 환경에서는 보통 ../../../modules/mod-ollama-chat/data/rag/ 입니다.
#           이 디렉터리의 모든 .json 파일을 불러옵니다.
#     기본값: ../../../modules/mod-ollama-chat/data/rag/
OllamaChat.RAGDataPath = ../../../modules/mod-ollama-chat/data/rag/



# OllamaChat.RAGMaxRetrievedItems
#     설명: 찾아서 프롬프트에 포함할 관련 정보 항목의 최대 개수입니다.
#           값이 높을수록 컨텍스트가 많아지지만 토큰 한도를 넘을 수 있습니다.
#     기본값: 3
OllamaChat.RAGMaxRetrievedItems = 3



# OllamaChat.RAGSimilarityThreshold
#     설명: 정보가 관련 있다고 판단되기 위한 최소 유사도 점수(0.0-1.0)입니다.
#           값이 낮으면 더 많은 정보가 포함되지만 정확도가 떨어질 수 있습니다.
#           값이 높으면 더 정밀하지만 관련 정보를 놓칠 수 있습니다.
#           권장 범위: 관련성과 범위의 균형을 위해 0.2-0.4.
#     기본값: 0.3
OllamaChat.RAGSimilarityThreshold = 0.3



# OllamaChat.RAGPromptTemplate
#     설명: 봇 프롬프트에 RAG 정보를 넣을 때 쓰는 템플릿입니다.
#     치환자(이름 지정): {rag_info}
OllamaChat.RAGPromptTemplate = "RELEVANT INFORMATION:\n{rag_info}\nUse this information to provide accurate and detailed responses when applicable."
###############################################################################
#
#   OLLAMA CHAT - Think 모드
#
###############################################################################

#    OllamaChat.ThinkMode
#        값: auto / on / off.
#
#        auto(기본값)는 모델 기능과 작업 종류를 모두 따져서 동작합니다. 시작 시 모듈이
#        Ollama에 설정된 모델이 무엇을 할 수 있는지 묻습니다(POST /api/show, 구버전 Ollama에서는
#        토큰 하나짜리 실제 요청으로 확인). 해당 기능이 있다고 보고한 모델에만 "think"를 보내므로,
#        생각할 수 없는 모델에는 절대 요청하지 않습니다. 예전에는 이런 요청이 HTTP 400으로
#        돌아와 로그에 쓸 만한 정보도 없이 서버의 모든 봇을 침묵시켰습니다.
#
#        auto에서는 답변이 달라지는 경우에만 추론을 사용합니다.
#            채팅 답변 / 무작위 잡담 / 이벤트 잡담 -> off
#              (짧고 지연 시간에 민감하며 추론할 내용이 없음)
#            호감도(감정) 분석                     -> on
#              (판단이 필요하며 플레이어에게 보이지 않음)
#            Strictness 2 에서의 롤플레이 답변     -> on
#
#        on  = 모델이 지원하면 항상 생각(think)합니다.
#        off = never think.
#
#        아래 내용은 모두 실행 중에 감지되어 즉시 적용됩니다. 모델을 바꾼 뒤
#        재시작하거나 설정을 다시 할 필요가 없습니다.
#
#          * think를 요청해서 거부된 요청 -> 해당 모델의 think를 끄고, 한 번 로그에 기록한 뒤
#            think 없이 요청을 다시 시도합니다.
#
#          * "think": false 는 요청일 뿐 보장이 아닙니다. gpt-oss 및 기타
#            harmony 형식 빌드는 상관없이 추론하며, Ollama는 그 토큰을 num_predict 에
#            포함합니다. 따라서 상한이 낮으면 추론에 다 쓰여 답변이 비어서 돌아옵니다.
#            모듈은 이 형태(HTTP 200, 추론 있음, 답변 비어 있음)를 인식하고 이후로는
#                - 이 모델에 false 대신 "think": "low" 를 보냅니다. 이런 모델이
#                  제공하는 설정 중 off에 가장 가깝습니다.
#                - num_predict 에 ReasoningTokenReserve 를 더합니다.
#            감지를 일으킨 요청은 다시 시도되므로, 모듈이 이를 파악하는 동안
#            잃는 답변은 최대 하나입니다.
#
#          * Ollama가 문자열 단계 값을 거부하면, 모듈은 해당 모델에 대해 영구적으로
#            불리언 형식으로 전환하고 한 번 로그에 기록합니다.
#
#        ".ollama status" 로 지금까지 감지된 내용을 확인할 수 있습니다.
#        기본값: auto
OllamaChat.ThinkMode = "auto"

#    OllamaChat.ThinkModeEnableForModule
#        더 이상 권장하지 않음(DEPRECATED). 이전 설정이 계속 동작하도록 남겨 두었습니다.
#        이 값이 1이고 ThinkMode 가 "auto"로 되어 있으면 think 모드가 강제로 켜집니다.
#        OllamaChat.ThinkMode 사용을 권장합니다.
#        기본값: 0
OllamaChat.ThinkModeEnableForModule = 0

#    OllamaChat.ThinkMaxLatencyMs
#        auto 모드의 지연 시간 보호 장치입니다. think를 사용한 요청의 평균 시간이
#        이 값보다 느리면, 세션이 끝날 때까지 think를 끄고 그 이유를 로그에 기록합니다.
#        서버가 느린 모델로 바뀌어도 채팅 채널이 먹통이 되는 대신 빠른 답변으로 전환됩니다.
#        0이면 보호 장치를 비활성화합니다.
#        기본값: 12000
OllamaChat.ThinkMaxLatencyMs = 12000

#    OllamaChat.CapabilityProbeTimeoutSeconds
#        시작 시 기능 확인(probe)에만 쓰는 타임아웃입니다. Ollama가 없을 때 모듈이
#        2분 동안 판단을 못 내리고 기다리지 않도록 짧게 잡아 두었습니다.
#        기본값: 10
OllamaChat.CapabilityProbeTimeoutSeconds = 10

###############################################################################
#
#   OLLAMA CHAT - 디스패처 및 HTTP
#
###############################################################################

#    OllamaChat.WorkerThreads
#        LLM 호출을 처리하는 작업자 풀의 크기입니다. 예전에는 메시지마다 봇별로
#        분리된(detached) 스레드를 하나씩 띄웠고 그 수에 제한이 없었는데, 이 방식을 대체합니다.
#        작업자는 HTTP와 문자열 처리만 하며, 모든 답변은 월드 스레드에서 전달됩니다.
#        MaxConcurrentQueries가 설정되어 있으면 그 값을, 아니면 4를 기본값으로 씁니다.
OllamaChat.WorkerThreads = 4

#    OllamaChat.MaxQueueDepth
#        작업자를 기다리는 요청 수입니다. 이 값을 넘으면 새 요청은 대기열에 넣지 않고
#        버립니다. 그래서 Ollama가 느려도 오래된 답변이 끝없이 쌓이지 않고 부하를 덜어냅니다.
#        0 = 무제한(권장하지 않음).
#        기본값: 64
OllamaChat.MaxQueueDepth = 64

#    OllamaChat.HttpTimeoutSeconds
#        LLM 호출의 연결/읽기/쓰기 타임아웃입니다.
#        기본값: 120
OllamaChat.HttpTimeoutSeconds = 120

#    OllamaChat.TypingSimulationMaxDelay
#        타이핑하는 척 지연하는 시간의 상한(밀리초)입니다. 상한이 없으면
#        긴 답변이 아주 오랫동안 전송되지 않을 수 있습니다.
#        기본값: 8000
OllamaChat.TypingSimulationMaxDelay = 8000

###############################################################################
#
#   OLLAMA CHAT - 답변 정리
#
###############################################################################

#    OllamaChat.MaxReplyLength
#        답변의 최대 길이(바이트)입니다. WoW 채팅은 255로 제한됩니다. 답변은 가까운 곳에
#        문장 끝이 있으면 마지막 문장 끝에서, 없으면 단어 경계에서 자릅니다.
#        단어 중간이나 UTF-8 문자 중간에서 자르는 일은 없습니다.
#        기본값: 240
OllamaChat.MaxReplyLength = 240

#    OllamaChat.StripMarkdown
#        답변에서 마크다운 강조, 글머리 기호, 제목, 코드 블록 표시를 제거합니다.
#        프롬프트에서 뭐라고 요청하든 모델은 이런 서식을 넣기 때문입니다.
#        기본값: 1
OllamaChat.StripMarkdown = 1

#    OllamaChat.StripDecorativeUnicode
#        둥근 따옴표와 대시를 ASCII 문자로 바꾼 뒤, 3.3.5 클라이언트에서 네모 상자로
#        보이는 이모지와 기호를 제거합니다. 악센트가 붙은 라틴 문자는 유지합니다.
#        기본값: 1
OllamaChat.StripDecorativeUnicode = 1

###############################################################################
#
#   OLLAMA CHAT - 대화 조절기
#
#   봇 채팅이 폭주하는 경로가 네 가지이므로, 서로 독립적인 제동 장치도 네 가지입니다.
#   봇끼리 끝없이 대화한다면 이 설정들을 조정하세요. 특히 대부분의 역할을 하는
#   RequireRecentHuman을 먼저 보세요.
#
###############################################################################

#    OllamaChat.BotConversation.MaxChainDepth
#        봇이 봇에게 답하는 단계가 대화 하나에서 몇 번까지 이어질 수 있는지 정합니다.
#        이를 넘으면 대화가 끊깁니다. 실제 플레이어의 메시지는 깊이 0입니다.
#        기본값: 3
OllamaChat.BotConversation.MaxChainDepth = 3

#    OllamaChat.BotConversation.ChanceDecayPct
#        단계마다 답변 확률에 곱하는 배율(퍼센트)입니다. 50이면 기본 확률 20%가
#        깊이 1에서 10%, 깊이 2에서 5%가 되므로, 대화 사슬은 하드 상한에 닿기
#        훨씬 전에 저절로 잦아듭니다.
#        기본값: 50
OllamaChat.BotConversation.ChanceDecayPct = 50

#    OllamaChat.BotConversation.RequireRecentHuman
#        같은 채널에서 최근에 실제 플레이어가 말한 경우에만 봇이 다른 봇에게 답할 수
#        있습니다. 새벽 4시에 길드에 봇 둘만 있으면 조용해지고, 같은 두 봇이라도
#        플레이어 곁에서라면 계속 대화합니다.
#        기본값: 1
OllamaChat.BotConversation.RequireRecentHuman = 1

#    OllamaChat.BotConversation.HumanWindowSeconds
#        실제 플레이어의 메시지 하나가 봇끼리의 대화를 얼마 동안 유지시키는지 정합니다.
#        기본값: 120
OllamaChat.BotConversation.HumanWindowSeconds = 120

#    OllamaChat.Cooldown.PerBotSeconds
#        같은 봇이 두 줄을 말하는 사이의 최소 간격입니다. 주변 잡담의 속도를 조절하며,
#        봇에게 직접 건 말에는 일부러 적용하지 않습니다. 아래의
#        OllamaChat.Cooldown.DirectAddressGroupSize를 참고하세요.
#        기본값: 45
OllamaChat.Cooldown.PerBotSeconds = 45

#    OllamaChat.Cooldown.PerScopeSeconds
#        같은 채널에서 봇이 말하는 줄 사이의 최소 간격(어느 봇이든)입니다.
#        기본값: 15
OllamaChat.Cooldown.PerScopeSeconds = 15

#    OllamaChat.Cooldown.DirectAddressGroupSize
#        파티원 수가 이 값 이하이면, 실제 플레이어가 파티 및 공격대 채팅에서 한 말을
#        "직접 건 말"로 간주하여 위의 두 속도 조절 쿨다운에서 답변을 제외합니다.
#
#        이 쿨다운은 주변 잡담이 과열되지 않게 하려고 있습니다. 그런데 파티에서는
#        역효과가 났습니다. 봇이 처음 들은 말에만 답하고 그 뒤 45초 동안의 대화를
#        무시해서, 속도 제한이 제대로 작동하는 게 아니라 봇이 고장 난 것처럼 보였습니다.
#        5인 파티는 대화이고 25인 공격대는 군중이므로, 이 크기를 넘으면
#        속도 조절이 다시 적용됩니다.
#
#        귓속말과 봇의 이름을 부른 메시지는 이 값과 상관없이 항상 직접 건 말입니다.
#        0으로 설정하면 파티 조건을 끄고, 파티 채팅도 다른 채널과 똑같이 속도를 조절합니다.
#
#        전체 상한인 RateLimit.GlobalPerMinute는 직접 건 말에도 여전히 적용됩니다.
#        이 상한은 속도 조절이 아니라 LLM 백엔드를 보호하기 위한 것입니다.
#        기본값: 5
OllamaChat.Cooldown.DirectAddressGroupSize = 5

#    OllamaChat.Cooldown.ConversationWindowSeconds
#        봇이 누군가에게 답한 뒤 채널별로 그 사람과 "대화 중" 상태를 유지하는 시간입니다.
#        이 시간 동안 그 사람이 해당 채널에서 하는 모든 말은 그 봇에게 직접 건 말로
#        간주되어, 속도 조절 쿨다운을 건너뛰고 DirectAddressReplyChance 확률로 답합니다.
#
#        이것이 대화를 이어지게 해 줍니다. 이 기능이 없으면 봇은 첫 줄에만 답하고,
#        보통 봇 이름을 다시 부르지 않는 후속 말은 주변 잡담 속도 조절로 돌아가
#        봇이 다시 조용해집니다.
#
#        실제 플레이어를 상대로만 열리며 봇끼리는 절대 열리지 않습니다. 봇끼리 열리면
#        두 봇이 서로 대화하며 조절기의 모든 제동 장치를 우회할 수 있기 때문입니다.
#        0으로 설정하면 매 줄마다 이름을 불러야 답합니다.
#        기본값: 180
OllamaChat.Cooldown.ConversationWindowSeconds = 180

#    OllamaChat.DirectAddressReplyChance
#        귓속말, 이름 부르기, 대화 도중, 소규모 파티 등 말이 이 봇을 향한 경우에
#        채널별 PlayerReplyChance 대신 사용하는 답변 확률입니다.
#        계속 이야기를 나누던 상대라면 다음 말에 반응할지를 반반 확률로 정하지 않으니까요.
#
#        이미 더 높은 채널 확률을 낮추지는 않습니다. 0으로 설정하면 이 상향을 끄고
#        어디서나 채널별 주변 잡담 확률을 씁니다. 참고로 0이면, 확률이 0%인 채널에서
#        이름으로 불린 봇이 무시하던 예전 동작도 되돌아옵니다.
#        기본값: 95
OllamaChat.DirectAddressReplyChance = 95

#    OllamaChat.RateLimit.ScopePerMinute
#        채널별 분당 봇 메시지 수의 상한입니다. 0 = 무제한.
#        기본값: 8
OllamaChat.RateLimit.ScopePerMinute = 8

#    OllamaChat.RateLimit.GlobalPerMinute
#        서버 전체의 분당 봇 메시지 수 상한입니다. LLM 사용 비용의 상한 역할도 합니다.
#        0 = 무제한.
#        기본값: 40
OllamaChat.RateLimit.GlobalPerMinute = 40

#    OllamaChat.Repetition.BotHistorySize
#        각 봇이 비교용으로 기억하는 최근 자기 대사 줄 수입니다.
#        기본값: 12
OllamaChat.Repetition.BotHistorySize = 12

#    OllamaChat.Repetition.ScopeHistorySize
#        각 채널이 기억하는 최근 줄 수입니다. 서로 다른 두 봇이 같은 말을 하지 않게 합니다.
#        기본값: 30
OllamaChat.Repetition.ScopeHistorySize = 30

#    OllamaChat.Repetition.SimilarityThreshold
#        0.0 - 1.0. 후보 답변이 최근 기록과 비교해 이 값 이상의 점수를 받으면 버립니다.
#        점수는 내용어 Jaccard 유사도와 문자 trigram 코사인 유사도 중 높은 값입니다.
#        낮을수록 엄격합니다.
#        기본값: 0.72
OllamaChat.Repetition.SimilarityThreshold = 0.72

#    OllamaChat.Repetition.WindowSeconds
#        기억한 줄이 비교 대상으로 유지되는 시간입니다.
#        기본값: 1800
OllamaChat.Repetition.WindowSeconds = 1800

#    OllamaChat.Repetition.OpenerHistorySize
#        채널별로 막는 최근 첫머리 문구(처음 세 단어)의 수입니다. 줄 전체 유사도 점수로는
#        잡지 못하는 "모든 봇이 Aye,로 말을 시작하는" 문제를 잡아냅니다.
#        기본값: 8
OllamaChat.Repetition.OpenerHistorySize = 8

###############################################################################
#
#   OLLAMA CHAT - 화제 엔진
#
#   봇이 무엇에 대해 말할지 정합니다. 예전 화제 풀은 13가지 화제가 균등했는데, 그중
#   7가지가 봇 자신의 소지품과 주문책이었고 옆에 서 있는 사람에 관한 화제는
#   하나도 없었습니다. 그래서 봇들이 캐릭터 정보창을 소리 내어 읽는 것처럼 들렸습니다.
#
#   가중치는 퍼센트가 아니라 상대값입니다.
#
###############################################################################

#    OllamaChat.Topic.WeightPeople
#        근처 플레이어의 이름과 하고 있는 일, 파티원, 접속 중인 길드원,
#        그리고 봇이 방금 목격한 일.
#        기본값: 30
OllamaChat.Topic.WeightPeople = 30

#    OllamaChat.Topic.WeightWorld
#        가장 가까운 "흥미로운" 생물(정예, 희귀, 또는 레벨상 실제 위협이 되는 대상이며
#        동물(critter)은 제외), 역할별 이름 있는 NPC, 지형지물, 시체, 시간대,
#        봇이 있는 인스턴스.
#        기본값: 30
OllamaChat.Topic.WeightWorld = 30

#    OllamaChat.Topic.WeightActivity
#        현재 퀘스트 목표, 위험 평가, 파티에 필요한 것
#        (생명력이 낮은 사람, 마나가 떨어진 사람).
#        기본값: 25
OllamaChat.Topic.WeightActivity = 25

#    OllamaChat.Topic.WeightSelf
#        원래 있던 자기 자신에 관한 화제: 주문, 착용 아이템, 가방 공간.
#        유지하되 비중을 낮췄습니다. 예전 느낌으로 되돌리려면 100 쪽으로 올리세요.
#        기본값: 15
OllamaChat.Topic.WeightSelf = 15

#    OllamaChat.Topic.WeightGuild
#        길드 관련 화제로, 봇이 길드에 속해 있고 실제 플레이어가 접속 중일 때만 사용합니다.
#        기본값: 20
OllamaChat.Topic.WeightGuild = 20

#    OllamaChat.Topic.MemoryCount
#        봇별로 최근 사용한 화제를 몇 개까지 제외할지 정합니다. 봇이 같은 화제를
#        연달아 두 번 말하지 않게 합니다.
#        기본값: 4
OllamaChat.Topic.MemoryCount = 4

#    OllamaChat.Topic.EventMemorySize
#        각 봇이 기억하는 목격한 사건의 수입니다("Kaelan killed a Fjord Hawk",
#        "Sereth was killed" 같은 것). 이 기능 덕분에 봇이 자기 자신에 관한 사실을 늘어놓는
#        대신 방금 함께 치른 전투에 대해 이야기할 수 있습니다.
#        0이면 목격한 사건 기억을 끕니다.
#        기본값: 6
OllamaChat.Topic.EventMemorySize = 6

#    OllamaChat.Topic.EventMemorySeconds
#        목격한 사건이 언급할 가치가 있는 기간입니다.
#        기본값: 300
OllamaChat.Topic.EventMemorySeconds = 300

#    OllamaChat.Topic.PlayerRadius
#        봇이 이야깃거리로 삼을 근처 플레이어를 고를 때 살피는 거리입니다.
#        기본값: 40
OllamaChat.Topic.PlayerRadius = 40

#    OllamaChat.RandomChatterQuestionChance
#        주변 잡담 중 서술문이 아닌 질문 형태로 말하는 줄의 비율(퍼센트)입니다.
#        예전 코드는 50/50으로 고정되어 있었습니다.
#        기본값: 35
OllamaChat.RandomChatterQuestionChance = 35

###############################################################################
#
#   OLLAMA CHAT - 게임 상태 스냅숏 제한
#
###############################################################################

#    OllamaChat.Snapshot.IncludeSpells
#        봇이 사용할 수 있는 주문을 프롬프트에 나열할지 정합니다.
#
#        이제 기본값은 끔입니다. 예전 코드는 봇이 아는 모든 비지속 효과(non-passive)이며
#        재사용 대기시간이 아닌 주문을 프롬프트에 붙여 넣었습니다. 수십 줄에 달하는,
#        프롬프트에서 가장 구체적이고 인용하기 좋은 텍스트였고, 이것이 봇들이 계속
#        주문책 이야기를 한 직접적인 원인이었습니다.
#        기본값: 0
OllamaChat.Snapshot.IncludeSpells = 0

#    OllamaChat.Snapshot.MaxSpells
#        주문을 포함할 경우 몇 개를 나열할지 정합니다(무작위로 골라서 항상 알파벳
#        순으로 앞선 주문만 나오지는 않습니다).
#        기본값: 6
OllamaChat.Snapshot.MaxSpells = 6

#    OllamaChat.Snapshot.MaxCreatures
#        스냅숏에 나열할 근처 생물 수이며, 가까운 순서입니다. 스냅숏은 이제 그리드 검색을
#        사용합니다. 예전에는 프롬프트를 만들 때마다 맵 전체의 모든 생물 스폰을 훑었습니다.
#        기본값: 8
OllamaChat.Snapshot.MaxCreatures = 8

#    OllamaChat.Snapshot.MaxObjects
#        스냅숏에 나열할 근처 게임 오브젝트 수이며, 가까운 순서입니다.
#        기본값: 8
OllamaChat.Snapshot.MaxObjects = 8

#    OllamaChat.Snapshot.MaxPlayers
#        스냅숏에 나열할 근처 플레이어 수이며, 가까운 순서입니다. 접속 중인 모든
#        캐릭터를 훑는 대신 그리드 검색으로 찾습니다.
#        기본값: 8
OllamaChat.Snapshot.MaxPlayers = 8

###############################################################################
#
#   OLLAMA CHAT - 롤플레이 모드
#
#   종족과 직업을 능력치 목록이 아니라 "목소리"로 표현합니다. 기본값은 끔입니다.
#
###############################################################################

#    OllamaChat.Roleplay.Enable
#        롤플레이 모드 전체 스위치입니다.
#        기본값: 0
OllamaChat.Roleplay.Enable = 0

#    OllamaChat.Roleplay.Strictness
#        0 = 분위기만 적용. 종족과 직업 말투가 프롬프트에 입혀지며, 그 밖의
#            다른 것은 바뀌지 않습니다. 그대로 교체해 쓸 수 있는 업그레이드입니다.
#        1 = 캐릭터 유지. 세계관 밖 어휘가 답변에서 걸러지고
#            진영 태도가 적용됩니다.
#        2 = 엄격한 캐릭터 유지. 롤플레이 잡담 목록이 기본 제공되는
#            캐릭터 밖(out-of-character) 프롬프트 대신 쓰이고, 부상과 거리는 수치로
#            말하지 않고 묘사하며, 지원되는 경우 think 모드를 사용합니다.
#        기본값: 1
OllamaChat.Roleplay.Strictness = 1

#    OllamaChat.Roleplay.UseRaceVoice
#        종족마다 말투와 문화적 상징을 부여합니다. 타우렌은 대지모신과 균형을 이야기하고,
#        포세이큰은 건조하게 말하며 산 자들을 "breathers"라고 부르고,
#        노움은 빠르고 기술적으로 말합니다.
#        기본값: 1
OllamaChat.Roleplay.UseRaceVoice = 1

#    OllamaChat.Roleplay.UseClassVoice
#        직업마다 세계관, 즉 그 캐릭터가 "눈여겨보는 것"을 부여합니다. 사제는 상처를 보고,
#        사냥꾼은 흔적과 지형을 읽고, 도적은 출구를 셉니다.
#        기본값: 1
OllamaChat.Roleplay.UseClassVoice = 1

#    OllamaChat.Roleplay.FactionAttitude
#        봇이 자기 진영에 충성하고 상대 진영을 경계하는 태도로 말합니다.
#        기본값: 1
OllamaChat.Roleplay.FactionAttitude = 1

#    OllamaChat.Roleplay.BlockMetaTerms
#        Strictness >= 1일 때, 게임 세계 밖의 어휘가 들어간 답변을 거부합니다.
#        답변을 고쳐 쓰지 않고 버리므로, 봇은 캐릭터에서 벗어나는 대신 침묵합니다.
#        기본값: 1
OllamaChat.Roleplay.BlockMetaTerms = 1

#    OllamaChat.Roleplay.MetaTermList
#        파이프(|)로 구분하며, 대소문자를 구분하지 않고 온전한 단어 단위로 비교합니다.
OllamaChat.Roleplay.MetaTermList = "dps|nerf|proc|patch|server|realm|respec|mmo|npc|toon|irl|lfg|afk|noob|meta|aggro|dot|hot|aoe|wipe|hitbox|hotfix|expansion"

#    OllamaChat.Roleplay.CrossFactionGibberish
#        진영이 다른 상대에게는 일반 대화/외치기 답변을 생성하지 않습니다. 어차피 클라이언트는
#        오크어와 공용어를 알아볼 수 없는 말로 표시하므로, 다른 진영에 유창하게 답하는 것은
#        이 모듈이 할 수 있는 가장 몰입을 깨는 행동입니다.
#        게다가 건너뛰면 LLM 왕복 호출도 절약됩니다.
#        기본값: 1
OllamaChat.Roleplay.CrossFactionGibberish = 1

#    OllamaChat.Roleplay.PromptVariations
#    OllamaChat.Roleplay.QuestionVariations
#        RandomChatterPromptVariations와 RandomChatterQuestionVariations를 대신하는
#        캐릭터 내(in-character) 목록으로, Strictness 2에서 사용합니다. 기본 제공 목록은
#        반대 방향("Complain about nerfed abilities", "Ask if dual spec was worth the cost")으로
#        이끄는데, 이는 게임 세계 안의 대화가 아니라 플레이어 포럼식 대화입니다.
#        파이프(|)로 구분합니다. 설정하지 않으면 이미 게임 세계 안의 내용으로 된
#        내장 기본값을 사용합니다.
# OllamaChat.Roleplay.PromptVariations = ""
# OllamaChat.Roleplay.QuestionVariations = ""

###############################################################################
#
#   OLLAMA CHAT - 몸짓 표현(바라보기, 제스처, 감정 표현 반응)
#
#   답변이 로그 한 줄이 아니라 대화처럼 느껴지게 합니다.
#
###############################################################################

#    OllamaChat.EnableBotFacing
#        대사가 전송되기 직전에 봇이 답하는 상대를 바라보도록 돌아섭니다. 봇이 이동 중,
#        시전 중, 전투 중, 비행 탈것 탑승 중, 운송 수단 위, 순간이동 중일 때는 건너뜁니다.
#        기본값: 1
OllamaChat.EnableBotFacing = 1

#    OllamaChat.Facing.MaxDistance
#        이 거리보다 멀리 있는 대상 쪽으로는 돌아서지 않습니다. 0 = 제한 없음.
#        기본값: 40
OllamaChat.Facing.MaxDistance = 40

#    OllamaChat.EnableBotEmotes
#        모델이 제스처 태그를 넣어 주면 봇이 답변과 함께 실제 감정 표현을 하게 합니다.
#        프롬프트는 "[emote:wave]"를 요청하지만, 모델이 시키지 않아도 "*waves*"나
#        그냥 "/wave"를 쓰기 때문에 파서는 이것들도 받아들입니다.
#        인식하지 못한 태그는 말로 내보내지 않고 제거합니다.
#
#        감정 표현은 클라이언트가 쓰는 것과 같은 코드 경로로 실행되므로, 근처 플레이어는
#        동작 애니메이션과 "Bot waves at You." 소셜 문구를 모두 보게 되며,
#        종족별·성별에 맞는 감정 표현 변형이 적용됩니다.
#        기본값: 1
OllamaChat.EnableBotEmotes = 1

#    OllamaChat.GestureChance
#        대사 하나의 프롬프트가 제스처를 권할 확률(0-100 퍼센트)입니다.
#
#        제스처는 답변, 무작위 잡담, 이벤트 잡담 모두에 제안됩니다. 매 줄마다 권했더니
#        봇이 거의 쉬지 않고 제스처를 해서 살아 있는 느낌보다 산만해 보였고,
#        대부분의 줄에 필요 없는 문장에 프롬프트 분량을 낭비했습니다. 제안을 받아도
#        제스처가 어울리는지는 모델이 판단하므로, 실제 비율은 이 숫자보다 낮습니다.
#
#        0 = 제스처를 제안하지 않음. 모델이 요청하지 않아도 "*waves*"를
#        그래도 쓰는 경우가 있으며, 그런 태그도 여전히 해석합니다.
#        기본값: 40
OllamaChat.GestureChance = 40

#    OllamaChat.StateEmoteDurationMs
#        봇이 자세나 반복 감정 표현을 유지하는 시간(밀리초)입니다.
#
#        감정 표현 두 가지가 계속 남는데, 이유는 서로 다릅니다.
#
#          /dance          UNIT_NPC_EMOTESTATE를 설정합니다. 실제 플레이어에게서 이를
#                          해제하는 유일한 방법은 클라이언트가 보낸 이동 패킷의 처리기인데,
#                          봇은 MotionMaster를 통해 서버 측에서 이동하므로 이 패킷을
#                          보내지 않습니다. 이 설정이 없으면 따라 한 /dance가 끝없이
#                          계속되었고, 필드가 밑에 여전히 설정되어 있어서 전투나 일회성
#                          감정 표현 뒤에도 다시 춤을 추었습니다.
#
#          /sit /sleep     코어의 텍스트 감정 표현 처리기가 이것들의 소셜 문구만 알리고
#          /kneel          아무것도 하지 않아서, 봇이 선 채로 앉는다고 말하곤 했습니다.
#                          코어가 빠뜨린 자세를 모듈이 적용하므로, 그 자세를 다시
#                          풀어 주는 일도 모듈이 맡아야 합니다.
#
#        봇이 감정 표현으로 취한 바로 그 자세를 아직 유지하고 있을 때만 다시 일으켜 세우므로,
#        먹기, 마시기, 또는 그 뒤에 봇 AI가 스스로 선택한 앉기를 방해하지 않습니다.
#
#        0이면 자세 변경과 해제를 모두 끕니다.
#        기본값: 15000
OllamaChat.StateEmoteDurationMs = 15000

#    OllamaChat.EmoteFallback
#        모델이 실제 WoW 감정 표현이 아닌 이름을 넣었을 때 대신 실행할 제스처입니다.
#        프롬프트는 흔한 감정 표현 이름이면 무엇이든 된다고 알려 주는데, 모델은 게임에 없는
#        이름("grunt")을 쓰곤 해서, 그런 답변은 로그에 아무 기록도 없이 제스처가 사라졌습니다.
#
#        감정 표현 테이블에 있는 이름으로 설정하거나, 대체 동작이 필요 없으면 비워 두세요.
#        DebugEnable이 켜져 있으면 해석하지 못한 이름이 로그에 남으므로, 사용하는 모델이
#        어떤 이름을 즐겨 쓰는지 보고 신경 쓸지 판단할 수 있습니다.
#        기본값: talk
OllamaChat.EmoteFallback = "talk"

#    OllamaChat.BotExpressionDelayMs
#        돌아서기와 제스처가 실행되기 전의 지연 시간(밀리초)입니다. 약간 지연을 두면
#        즉각적이고 기계적으로 보이지 않습니다.
#        기본값: 400
OllamaChat.BotExpressionDelayMs = 400

#    OllamaChat.EnableEmoteReactions
#        실제 플레이어가 봇에게 감정 표현을 하면 봇이 반응합니다.
#        기본값: 1
OllamaChat.EnableEmoteReactions = 1

#    OllamaChat.EmoteReplyChance
#        자신을 향한 감정 표현에 봇이 반응할 확률(퍼센트)입니다.
#        기본값: 60
OllamaChat.EmoteReplyChance = 60

#    OllamaChat.EmoteReply.MirrorWeight
#    OllamaChat.EmoteReply.CounterWeight
#    OllamaChat.EmoteReply.SpeakWeight
#        세 가지 반응 방식의 상대 가중치:
#            Mirror  - 손 흔들기에는 손 흔들기, 절하기에는 절하기로 답합니다. LLM 호출 없이 무료입니다.
#            Counter - 근육 자랑에는 웃음, 무례한 행동에는 노려보기로 답합니다. 역시 무료입니다.
#            Speak   - LLM을 통해 말로 답합니다.
#        기본값: 55 / 30 / 15
OllamaChat.EmoteReply.MirrorWeight = 55
OllamaChat.EmoteReply.CounterWeight = 30
OllamaChat.EmoteReply.SpeakWeight = 15

#    OllamaChat.EmoteReply.CooldownSeconds
#        (플레이어, 봇) 쌍별 중복 방지 간격으로, /spam으로 대기열을 넘치게 할 수 없게 합니다.
#        기본값: 20
OllamaChat.EmoteReply.CooldownSeconds = 20

#    OllamaChat.EmoteReactionPromptTemplate
#        봇이 감정 표현에 말로 답할 때 사용하는 프롬프트입니다.
#        치환자: {bot_name} {bot_level} {bot_class} {bot_race}
#                {bot_personality} {bot_personality_name}
#                {player_name} {player_class} {player_race} {emote_name}
#        설정하지 않으면 내장 기본값을 사용합니다.
# OllamaChat.EmoteReactionPromptTemplate = ""

###############################################################################
#
#   OLLAMA CHAT - 화제별 대사 풀
#
#   기존 EnvComment* 설정과 똑같이 파이프(|)로 구분합니다. 모두 내장 기본값이
#   있으므로 설정하지 않아도 괜찮습니다.
#
###############################################################################

#    근처 플레이어. 치환자: {player_name} {player_class} {player_race}
#    {player_level} {player_state} {level_gap}
#    {player_state}는 다음 중 하나입니다: lying dead, fighting, mounted up, flying
#    overhead, standing idle, sitting down, badly hurt, passing by.
# OllamaChat.EnvCommentNearbyPlayer = ""

#    파티원. 치환자: {member_name} {member_class} {member_state}
#    {member_level}
# OllamaChat.EnvCommentGroupMember = ""

#    접속 중인 길드원. 치환자: {member_name} {member_class} {member_level}
# OllamaChat.EnvCommentGuildMemberOnline = ""

#    봇이 방금 목격한 일. 치환자: {event_text}
# OllamaChat.EnvCommentRecentEvent = ""

#    역할별 이름 있는 NPC. 치환자: {npc_name} {npc_role}
#    {npc_role}은 다음 중 하나입니다: innkeeper, merchant, quest giver, trainer.
# OllamaChat.EnvCommentNamedNpc = ""

#    현재 위치. 치환자: {area_name} {zone_name}
# OllamaChat.EnvCommentZoneLandmark = ""

#    시간대. 치환자: {time_of_day}
# OllamaChat.EnvCommentTimeOfDay = ""

#    근처의 시체. 치환자: {creature_name} {creature_level} {level_delta}
# OllamaChat.EnvCommentCorpse = ""

#    위험한 생물. 치환자: {creature_name} {level_delta}
# OllamaChat.EnvCommentDanger = ""

#    현재 퀘스트 목표. 치환자: {quest_name} {objective}
# OllamaChat.EnvCommentQuestObjective = ""

#    파티원에게 필요한 것이 있음. 치환자: {member_name} {need}
# OllamaChat.EnvCommentGroupNeed = ""

###############################################################################
#
#   OLLAMA CHAT - 선택적 샘플링 제어
#
#   답변 다양성과 반복을 조절하는 추가 설정입니다. 모두 기본적으로 설정되지 않은 상태입니다.
#   설정하지 않으면 해당 필드를 아예 보내지 않으므로 모델 자체의 기본값이 적용되며,
#   직접 켜지 않는 한 동작은 달라지지 않습니다.
#
#   이 설정들은 한 번의 생성 안에서만 작동합니다. CONVERSATION GOVERNOR 아래의 반복 제어를
#   대체하지 않습니다. 그 제어는 후보 답변을 앞서 실제로 한 말과 비교하는데,
#   모델은 그 내용을 볼 수 없습니다.
#
###############################################################################

#    OllamaChat.TopK
#        가장 가능성 높은 K개의 토큰에서만 샘플링합니다. 낮을수록 더 집중되고,
#        높을수록 = 더 다양함. 일반적인 범위는 20-100.
#        -1 = unset (default)
OllamaChat.TopK = -1

#    OllamaChat.MinP
#        최상위 토큰 확률에 대한 비율이 이 값보다 낮은 토큰을 제외합니다. TopK보다
#        나은 다양성 제어인 경우가 많습니다. 일반적인 범위 0.02-0.10.
#        -1 = unset (default)
OllamaChat.MinP = -1

#    OllamaChat.PresencePenalty
#        한 번이라도 나온 토큰에 불이익을 주어 새로운 주제 쪽으로 유도합니다.
#        일반적인 범위 0.0-1.0.
#        기본적으로 설정되지 않습니다.
# OllamaChat.PresencePenalty = 0.4

#    OllamaChat.FrequencyPenalty
#        토큰이 나온 횟수에 비례해 불이익을 주어, 답변 안에서 같은 문구를 그대로
#        반복하는 것을 억제합니다. 일반적인 범위 0.0-1.0.
#        기본적으로 설정되지 않습니다.
# OllamaChat.FrequencyPenalty = 0.4

###############################################################################
#
#   OLLAMA CHAT - 주변 잡담 채널 선택
#
#   주변(무작위) 잡담을 할 수 있는 번호 채널을 정합니다. 답변은 항상 플레이어가
#   사용한 채널을 따르며, 다음의 영향을 받지 않습니다:
#   these.
#
#   채널은 이름이 아니라 채널 ID와 지역으로 판별합니다. "Trade - Stormwind City"나
#   "GuildRecruitment - Stormwind City" 같은 도시 채널도 이제 제대로 판별되며,
#   현지화된 렐름에서도 마찬가지입니다.
#
#   Trade와 GuildRecruitment 채널은 도시에만 있으므로, 켜 두어도 봇이 도시 밖에
#   있는 동안에는 아무 효과가 없습니다.
#
###############################################################################

#    OllamaChat.Chatter.UseGeneralChannel
#        기본값: 1
OllamaChat.Chatter.UseGeneralChannel = 1

#    OllamaChat.Chatter.UseTradeChannel
#        기본값: 1
OllamaChat.Chatter.UseTradeChannel = 1

#    OllamaChat.Chatter.UseLookingForGroupChannel
#        렐름 전체 채널이라 여기서 하는 봇 잡담은 모두에게 보입니다.
#        채널이 도배되지 않도록 기본값은 끔입니다.
#        기본값: 0
OllamaChat.Chatter.UseLookingForGroupChannel = 0

#    OllamaChat.Chatter.UseGuildRecruitmentChannel
#        기본값: 0
OllamaChat.Chatter.UseGuildRecruitmentChannel = 0

###############################################################################
#
#   OLLAMA CHAT - 장기 기억과 관계
#
#   대화 기록은 슬라이딩 윈도우 방식입니다. 어떤 줄이 윈도우 밖으로 밀려나면 봇은
#   그런 일이 있었는지 전혀 모릅니다. 그래서 이 기능이 없으면 아무리 많이 이야기했어도
#   봇이 매 세션마다 처음 만나는 사람처럼 느껴집니다.
#
#   두 가지 방식으로 이를 해결하며, 둘 다 제한이 있어서 캐릭터가 아무리 오래
#   존재했더라도 프롬프트가 무한정 커지지 않습니다:
#
#     MEMORY         기록이 토큰 예산을 넘을 때까지 쌓이면, 모델이 이를 중요도 점수가
#                    붙은 짧은 서술자 시점 메모 몇 개로 요약하고 원래 기록은 지웁니다.
#                    그 뒤 가장 중요한 메모들을 더 작은 예산 안에서 골라
#                    각 프롬프트에 넣습니다.
#
#     RELATIONSHIPS  봇의 기록에 어떤 이름이 충분히 자주 나오면, 모델이 그 봇이 그 사람을
#                    어떻게 느끼는지 한 문장으로 쓰거나 고쳐 씁니다. 이 문장이 이후
#                    프롬프트에 들어가므로, 봇의 태도가 초기화되지 않고 유지되며 변해 갑니다.
#
#   둘 다 일반 모드와 롤플레이 모드에서 작동합니다. 기존의 수치형 호감도 점수는
#   그대로 유지되며, 이 기능은 이를 보완하는 질적인 부분입니다.
#
#   다음 파일의 테이블이 필요합니다:
#   data/sql/characters/base/2026_08_29_memory_relationships.sql
#
###############################################################################

#    OllamaChat.Memory.Enable
#        장기 기억 전체 스위치입니다.
#        기본값: 1
OllamaChat.Memory.Enable = 1

#    OllamaChat.Memory.HistoryTokenLimit
#        봇에 쌓인 기록이 대략 이 토큰 수를 넘으면 요약합니다. 낮을수록 기억이 더 빨리
#        만들어지지만 더 적은 자료로 만들어집니다.
#        0이면 요약을 끕니다(기록은 예전처럼 밀려나 사라집니다).
#        기본값: 1500
OllamaChat.Memory.HistoryTokenLimit = 1500

#    OllamaChat.Memory.PromptTokenBudget
#        각 프롬프트에서 기억 메모가 차지할 수 있는 분량입니다. 프롬프트 증가를 막는
#        확실한 상한입니다.
#        기본값: 400
OllamaChat.Memory.PromptTokenBudget = 400

#    OllamaChat.Memory.MaxPerBot
#        캐릭터당 보관하는 메모 수입니다. 이를 넘으면 가장 덜 중요한 메모가
#        dropped.
#        기본값: 40
OllamaChat.Memory.MaxPerBot = 40

#    OllamaChat.Memory.SaveInterval
#        기억과 관계를 데이터베이스에 저장하는 간격(분)입니다.
#        기본값: 10
OllamaChat.Memory.SaveInterval = 10

#    OllamaChat.Memory.CondensePrompt
#        기록을 기억으로 요약할 때 쓰는 프롬프트입니다.
#        치환자: {bot_name} {history}
#        모델에게 한 줄에 메모 하나씩, 앞에 "N | "를 붙여 달라고 요청합니다. N은 1에서 10까지의
#        중요도입니다. 설정하지 않으면 내장 기본값을 사용합니다.
# OllamaChat.Memory.CondensePrompt = ""

#    OllamaChat.Memory.PromptTemplate
#        프롬프트에서 기억 메모를 소개하는 문구입니다.
#        치환자: {memories}
# OllamaChat.Memory.PromptTemplate = " Things you remember:\n{memories}"

#    OllamaChat.Relationship.Enable
#        기본값: 1
OllamaChat.Relationship.Enable = 1

#    OllamaChat.Relationship.MentionThreshold
#        어떤 이름이 몇 번 나와야 그 사람에 대한 캐릭터의 생각을 쓰거나 고칠지 정합니다.
#        낮을수록 관계가 더 빨리 형성되지만 LLM 호출이 더 많이 듭니다.
#        기본값: 8
OllamaChat.Relationship.MentionThreshold = 8

#    OllamaChat.Relationship.MaxPerPrompt
#        프롬프트에 넣을 관계 수입니다. 봇이 지금 이야기하는 상대는 항상 맨 앞에
#        나열되므로, 그 사람과의 관계가 밀려나는 일은 없습니다.
#        기본값: 3
OllamaChat.Relationship.MaxPerPrompt = 3

#    OllamaChat.Relationship.MaxLength
#        모델이 쓴 설명에서 유지할 최대 글자 수입니다.
#        기본값: 220
OllamaChat.Relationship.MaxLength = 220

#    OllamaChat.Relationship.UpdatePrompt
#        치환자: {bot_name} {other_name} {existing} {history}
# OllamaChat.Relationship.UpdatePrompt = ""

#    OllamaChat.Relationship.PromptTemplate
#        치환자: {relationships}
# OllamaChat.Relationship.PromptTemplate = " How you feel about people you know:\n{relationships}"

# --------------------------------------------
# 환경/상황 템플릿 (계속)
# --------------------------------------------
#
# 이 설정들은 제대로 작동하는 내장 기본값이 있지만, 코어가 찾지 못한 키마다
# "Missing property" 경고를 로그에 남기므로 여기에 명시적으로 적어 두었습니다.
# 아래 값은 모듈 자체의 기본값입니다.

# OllamaChat.EnvCommentNearbyPlayer
#   설명: 다른 플레이어가 근처에 보일 때 사용할 메시지 템플릿 목록이며, 파이프(|)로 구분합니다.
#   치환자(이름 지정): {player_name} {player_race} {player_class} {player_level} {player_state}
OllamaChat.EnvCommentNearbyPlayer = You notice {player_name}, a {player_race} {player_class}, {player_state} nearby. Say something to or about them.|{player_name} the {player_class} is {player_state} close by. React to seeing them.|A level {player_level} {player_class} called {player_name} is nearby. Comment on them.|You size up {player_name}, a {player_race} {player_class}. Say what you make of them.|{player_name} is {player_state} within earshot. Greet or remark on them.|You spot {player_name} and note they are {player_state}. Say something fitting.

# OllamaChat.EnvCommentGroupMember
#   설명: 파티원이나 공격대원에 대해 한마디 할 만할 때 사용할 메시지 템플릿 목록이며, 파이프(|)로 구분합니다.
#   치환자(이름 지정): {member_name} {member_class} {member_state}
OllamaChat.EnvCommentGroupMember = Your companion {member_name} the {member_class} is {member_state}. Say something to them.|{member_name} is {member_state}. Comment on how your group is doing.|You glance at {member_name}, your {member_class}, and remark on the group's state.|Talk to {member_name} about what the group should do next.

# OllamaChat.EnvCommentGuildMemberOnline
#   설명: 길드원이 접속 중일 때 사용할 메시지 템플릿 목록이며, 파이프(|)로 구분합니다.
#   치환자(이름 지정): {member_name} {member_class} {member_level}
OllamaChat.EnvCommentGuildMemberOnline = Your guildmate {member_name} the {member_class} is online. Say something to the guild about them.|Greet {member_name} in guild chat, or ask what they are up to.|Mention {member_name}, level {member_level}, to the guild.

# OllamaChat.EnvCommentRecentEvent
#   설명: 봇이 방금 목격한 일을 떠올릴 때 사용할 메시지 템플릿 목록이며, 파이프(|)로 구분합니다.
#   치환자(이름 지정): {event_text}
OllamaChat.EnvCommentRecentEvent = You just saw this happen: {event_text}. React to it.|Something you witnessed: {event_text}. Comment on it naturally.|Bring up what just happened: {event_text}.|You are still thinking about this: {event_text}. Say something about it.

# OllamaChat.EnvCommentNamedNpc
#   설명: 이름 있는 NPC가 근처에 서 있을 때 사용할 메시지 템플릿 목록이며, 파이프(|)로 구분합니다.
#   치환자(이름 지정): {npc_name} {npc_role}
OllamaChat.EnvCommentNamedNpc = {npc_name} the {npc_role} is standing nearby. Say something about them.|You see {npc_name}, a {npc_role}. Remark on what they offer.|Mention {npc_name} the {npc_role} and whether they are worth visiting.

# OllamaChat.EnvCommentZoneLandmark
#   설명: 봇이 현재 위치에 대해 한마디 할 때 사용할 메시지 템플릿 목록이며, 파이프(|)로 구분합니다.
#   치환자(이름 지정): {area_name} {zone_name}
OllamaChat.EnvCommentZoneLandmark = You are in {area_name}, part of {zone_name}. Say something about this place.|Remark on the look or feel of {area_name}.|Comment on what {zone_name} is known for.|Say whether {area_name} is worth lingering in.

# OllamaChat.EnvCommentTimeOfDay
#   설명: 봇이 시간대에 대해 한마디 할 때 사용할 메시지 템플릿 목록이며, 파이프(|)로 구분합니다.
#   치환자(이름 지정): {time_of_day}
OllamaChat.EnvCommentTimeOfDay = It is {time_of_day}. Remark on the hour.|Comment on it being {time_of_day} and what that means for travelling.|Mention that it is {time_of_day} and how you feel about it.

# OllamaChat.EnvCommentCorpse
#   설명: 근처 땅바닥에 시체가 있을 때 사용할 메시지 템플릿 목록이며, 파이프(|)로 구분합니다.
#   치환자(이름 지정): {creature_name}
OllamaChat.EnvCommentCorpse = There is a dead {creature_name} on the ground here. React to it.|You see the corpse of a {creature_name}. Say something about the fight that happened.|Remark on the slain {creature_name} nearby.

# OllamaChat.EnvCommentDanger
#   설명: 근처 생물의 레벨이 봇보다 높을 때 사용할 메시지 템플릿 목록이며, 파이프(|)로 구분합니다.
#   치환자(이름 지정): {creature_name} {level_delta}
OllamaChat.EnvCommentDanger = A {creature_name} is nearby and it is {level_delta} levels above you. Warn or brag.|The {creature_name} here looks dangerous. Say whether you would take it on.|Comment on the threat the {creature_name} poses.

# OllamaChat.EnvCommentQuestObjective
#   설명: 봇이 퀘스트를 진행하는 도중일 때 사용할 메시지 템플릿 목록이며, 파이프(|)로 구분합니다.
#   치환자(이름 지정): {quest_name} {objective}
OllamaChat.EnvCommentQuestObjective = You are partway through '{quest_name}' and still need to {objective}. Mention it.|Talk about your task '{quest_name}' and what is left: {objective}.|Bring up '{quest_name}' and ask for help or advice with it.|Complain or enthuse about '{quest_name}'.

# OllamaChat.EnvCommentGroupNeed
#   설명: 파티원에게 필요한 것이 있을 때 사용할 메시지 템플릿 목록이며, 파이프(|)로 구분합니다.
#   치환자(이름 지정): {member_name} {need}
OllamaChat.EnvCommentGroupNeed = {member_name} is {need}. Say something useful about it.|Point out that {member_name} is {need}.|React to {member_name} being {need}.

# OllamaChat.Roleplay.PromptVariations
#   설명: 롤플레이 모드의 서술형 프롬프트로 사용할 메시지 템플릿 목록이며, 파이프(|)로 구분합니다.
#   Roleplay.Strictness 2에서 기본 제공 무작위 잡담 목록을 대체합니다.
#   치환자(이름 지정): 없음
OllamaChat.Roleplay.PromptVariations = Remark on the weather or the road ahead.|Mention a rumour you heard in the last town.|Say something about the war and what it has cost.|Complain about the price of supplies.|Speak of someone you have lost.|Mention where you are headed and why.|Say something about your faith or what you believe in.|Comment on the state of the land here.|Talk about a beast or enemy you have fought recently.|Mention hunger, thirst, or how long since you last slept.|Say something about your homeland.|Remark on how far you are from anywhere safe.|Speak of an old debt or grudge.|Mention a piece of your gear and where it came from.|Say something about the people passing through here.

# OllamaChat.Roleplay.QuestionVariations
#   설명: 롤플레이 모드의 질문형 프롬프트로 사용할 메시지 템플릿 목록이며, 파이프(|)로 구분합니다.
#   사용 방식은 위와 같습니다.
#   치환자(이름 지정): 없음
OllamaChat.Roleplay.QuestionVariations = Ask whether the road ahead is safe.|Ask if anyone has news from the front.|Ask where a person might find work here.|Ask what happened in this place.|Ask whether anyone has seen a particular kind of beast nearby.|Ask where the nearest inn or camp is.|Ask someone where they hail from.|Ask whether the local lord or chieftain is worth trusting.|Ask if anyone needs a hand with something.|Ask what the strangest thing seen around here has been.|Ask whether the water or food here can be trusted.|Ask how long the fighting has been going on.

# --------------------------------------------
# 선택적 프롬프트 재정의
# --------------------------------------------
#
# 모듈의 내장 프롬프트를 쓰려면 비워 두세요. 거의 모든 경우 그것이 원하는 설정입니다.
# 코어가 키가 없다고 경고하지 않도록 나열해 두었을 뿐입니다.
# 값을 설정하면 해당 프롬프트를 완전히 대체합니다.

# OllamaChat.EmoteReactionPromptTemplate
#   설명: 플레이어가 봇에게 감정 표현을 했을 때 사용하는 프롬프트입니다.
#   빈 값 = 내장 기본값 사용.
OllamaChat.EmoteReactionPromptTemplate = ""

# OllamaChat.Memory.CondensePrompt
#   설명: 봇의 대화 기록을 장기 기억으로 요약하는 프롬프트입니다.
#   빈 값 = 내장 기본값 사용.
OllamaChat.Memory.CondensePrompt = ""

# OllamaChat.Memory.PromptTemplate
#   설명: 프롬프트에 넣는 기억 목록을 감싸는 문구입니다.
#   빈 값 = 내장 기본값 사용.
OllamaChat.Memory.PromptTemplate = ""

# OllamaChat.Relationship.PromptTemplate
#   설명: 프롬프트에 넣는 관계 목록을 감싸는 문구입니다.
#   빈 값 = 내장 기본값 사용.
OllamaChat.Relationship.PromptTemplate = ""

# OllamaChat.Relationship.UpdatePrompt
#   설명: 봇이 누군가를 어떻게 느끼는지 새로 쓰는 프롬프트입니다.
#   빈 값 = 내장 기본값 사용.
OllamaChat.Relationship.UpdatePrompt = ""

# --------------------------------------------
# 선택적 샘플링 페널티
# --------------------------------------------
#
# -1000은 "이 매개변수를 아예 보내지 않음"을 뜻하는 특수 값으로, 모델 자체의 기본값이
# 적용됩니다. 원하는 것이 확실할 때만 실제 값(보통 0.0에서 2.0)을 설정하세요.

# OllamaChat.PresencePenalty
#   설명: 이미 나온 토큰을 억제합니다. -1000 = 매개변수를 보내지 않음.
#   기본값: -1000
OllamaChat.PresencePenalty = -1000

# OllamaChat.FrequencyPenalty
#   설명: 토큰이 나온 횟수에 따라 억제합니다. -1000 = 매개변수를 보내지 않음.
#   기본값: -1000
OllamaChat.FrequencyPenalty = -1000

