[worldserver]
########################################################################
# WER — 모듈 설정
########################################################################
#
#    WER.Hardcore.RealmWide
#        1 = 렐름 전체가 하드코어 (모든 캐릭터에 강제 적용).
#        0 = 끔. 플레이어가 캐릭터별로 선택 참여할 수 있습니다 (AllowOptIn 참고).
#        기본값: 0
#
#    WER.Hardcore.AllowOptIn
#        1 = 플레이어가 ".hardcore on"으로 캐릭터에 하드코어를 켤 수 있습니다
#            (레벨 1에서만, 영구 적용). RealmWide = 1이면 무시됩니다.
#        기본값: 1
#
#    WER.Hardcore.AnnounceDeaths
#        1 = 플레이어가 선택 참여할 때와 쓰러질 때 서버 전체에 메시지를 보냅니다.
#        기본값: 1
#
#    WER.Hardcore.Makgora
#        1 = ".makgora" 활성화 — 서로 동의한 죽음의 결투로, 두
#            하드코어 플레이어끼리 겨룹니다(패자는 쓰러진 영웅이 됩니다).
#        기본값: 1
#
########################################################################

########################################################################

########################################################################
# 봇 AI 채팅 — 실제 플레이어가 봇에게 귓속말하면 봇이 답합니다(파티/
# 길드/주변 대화도 지원, 아래 참고). HTTP 호출은 별도 스레드에서 실행되며,
# 답장은 월드 틱에서 전달됩니다.
#
# 외부 LLM은 본인 공급자의 주소·모델·API 키를 설정해야 합니다:
#   1. https://WER.eu (계정 대시보드)에서 API 키를 발급받으세요.
#   2. 아래 AiChat.ApiKey를 입력하고 Provider/ApiUrl/Model이 공급자와 일치하는지 확인하세요.
#
# 직접 운영하는 백엔드를 쓰고 싶으신가요? 두 방식 모두 완전히 지원합니다:
#   * 본인 클라우드 키(DeepSeek/OpenAI/Moonshot...): Provider/ApiUrl/
#     ApiKey/Model을 설정하세요 — 아래 PROVIDER 섹션 참고.
#   * 완전 로컬, 무료, 키 불필요(Ollama): Provider = "ollama"로 두고
#     OllamaHost/Port와 Model을 내려받은 모델로 설정하세요. 아래 참고.
#
# 연결 가능한 백엔드가 없으면 봇은 그냥 말을 하지 않습니다(오류나 크래시 없음).
#    AiChat.Enabled        1 = 켬(기본값 켬). 0으로 두면 모든 AI 채팅이 비활성화됩니다.
#    AiChat.OllamaHost/Port  Ollama가 대기하는 주소 — Provider = "ollama"일 때만 사용
#    AiChat.Model          호스팅 제공자 엔드포인트에서는 비워 두세요(모델을 자동으로
#                          선택합니다). ollama나 본인 클라우드 엔드포인트에서는 필수입니다
#                          (예: 내려받은 Ollama 모델 또는 제공자의 모델 이름).
#    AiChat.CooldownSeconds 봇별 답장 쿨다운(토큰/스팸 방지)
#    AiChat.System         시스템 프롬프트 / 페르소나 규칙
########################################################################
WowLegends.AiChat.Enabled = 1
WowLegends.AiChat.OllamaHost = "127.0.0.1"
WowLegends.AiChat.OllamaPort = "11434"
WowLegends.AiChat.Model = "nvidia/nemotron-3-ultra-550b-a55b"
#    AiChat.ModelFast  고급, 선택 사항: 양이 많은 주변 잡담(주변/파티 끼어들기)에 쓸 두 번째
#        (더 저렴한) 모델. 설정하지 않으면 모든 곳에 같은 모델을 씁니다.
#        본인 Ollama 예: Model = 귓속말 응답용 큰 모델, ModelFast = 작은 모델로 두면
#        큰 모델의 재치를 꼭 필요한 곳에만 쓰게 됩니다.
# WER.AiChat.ModelFast = ""
WowLegends.AiChat.CooldownSeconds = 5
#    AiChat.RudeActions     1 = 화난 봇이 행동할 수 있음(예: 화내며 파티를 탈퇴)
#    AiChat.LeavePartyAnger 파티 중인 봇이 박차고 나가는 분노 수치(모욕 1회당 2씩 증가)
WowLegends.AiChat.RudeActions = 1
WowLegends.AiChat.LeavePartyAnger = 4
#    AiChat.RoarAnger  파티에 없는 봇이 당신에게 분노하며 포효하는 분노 수치(모욕 1회당 2씩 증가)
WowLegends.AiChat.RoarAnger = 6
#    AiChat.MemoryTurns  봇이 플레이어별로 기억하는 최근 대화 수(플레이어 말 + 봇 답장).
#                        대화 맥락이 쌓이게 해 줍니다. 이 기억은 이제 characters DB
#                        (playerbot_ai_chat_memory 테이블, 시작 시 자동 생성)에 (봇, 플레이어)
#                        단위로 영구 저장되며 분노 수치도 포함됩니다. 그래서 봇은 재시작이나
#                        날짜가 바뀌어도 당신을 좋은 일, 나쁜 일 모두 기억합니다.
#                        안전 상한 200까지 적용되며, 높게 설정해도 됩니다(예: 100).
#                        주의: 기억된 대화는 모두 프롬프트에 들어가므로 값이 매우 높으면
#                        요청당 프롬프트 토큰이 늘어납니다. 기본값으로는 12가 적당합니다.
WowLegends.AiChat.MemoryTurns = 12
#    AiChat.Dedupe  1 = 봇의 답장이 같은 플레이어에게 보낸 자신의 최근 두 줄과 거의 같으면
#                   버립니다(작은 로컬 모델은 반복하기 쉽습니다). 0 = 모두 전달.
WowLegends.AiChat.Dedupe = 1
#    AiChat.Workers  AI 요청을 처리하는 작업 스레드 수(1-4). 많을수록 느린 호출 하나 뒤에
#                    줄 서지 않고 여러 봇이 동시에 답할 수 있습니다. 재시작이 필요합니다.
#                    GM/RA 원격 측정: .aichat stats (대기열, 누락, 실제 토큰 사용량).
WowLegends.AiChat.Workers = 4
#    AiCommand.Enabled  대화와 명령을 함께: 파티 중인 내 봇에게 평범한 말로 귓속말하면
#                       그대로 따릅니다("follow me", "stay here", "wait here a sec" 등
#                       어떤 표현, 어떤 언어든). 단순한 문구는 즉시 무료로 처리되고, 그 외는
#                       답장을 쓰는 같은 호출에서 AI가 이해합니다 - 명령 하나는 채팅 답장
#                       하나와 비용이 같습니다(호스팅 크레딧 1개, 또는 본인 Ollama).
#                       봇의 주인만 명령할 수 있습니다. "$"로 시작하는 명시적 명령은
#                       항상 동작합니다.
#                       자유로운 표현의 이해도는 AI 모델에 따라 다릅니다. 호스팅/대형 모델은
#                       거의 완벽하지만, 아주 작은 로컬 모델은 따르지 않고 채팅으로만 답할
#                       때가 있습니다(의도된 안전 설계). 단순 문구와 "$" 명령은 항상 동작합니다.
#                       동사: follow, stay, attack, tank, pull, flee, grind, summon,
#                       revive, release, home, drink, reset, heal. attack/tank/pull은
#                       내 현재 대상에게 작용합니다(먼저 적을 대상으로 지정) - 또는 적의
#                       이름을 말하세요: "attack the young nightsaber"라고 하면 근처에서
#                       스스로 찾아냅니다(AI를 전혀 설정하지 않아도 동작). 참고: 적의 이름을
#                       말하면 서버 쪽 내 대상이 그 적으로 설정됩니다(대상 창에는 표시되지
#                       않음). 다음에 직접 클릭할 때까지 유지되므로, 이어서 그냥
#                       "attack"/"tank"/"pull"만 말해도 마지막으로 지목한 적에게 작용합니다.
#                       AiChat.Enabled = 1이 필요합니다.
WowLegends.AiCommand.Enabled = 0

#    AiCommand.PartyOrders.Enabled
#                       파티/공격대 채팅에서 파티 전체를 부르면 내 봇 모두에게 한 번에
#                       명령할 수 있습니다: "everyone follow me", "all of you
#                       stay", "bots attack the harpy". 내가 소유한 파티 봇이 모두
#                       따르고, 봇 하나가 파티를 대표해 대답합니다. 일반 파티 잡담은 명령으로
#                       취급되지 않으며(파티 전체를 부르는 표현만 해당), 파티 채팅의
#                       "<BotName> follow me"는 그 봇에게만 명령합니다. 파티 전체 "home"과
#                       "grind"는 분대 전체에 한꺼번에 영향을 주므로, 봇이 따르기 전에
#                       한 번 더 말해 달라고 요청합니다. AiCommand.Enabled = 1이 필요합니다.
WowLegends.AiCommand.PartyOrders.Enabled = 1

#    AiCommand.MaxTargetsInPrompt
#                       명령이 가능한 메시지와 함께 AI에 넘기는 주변 적 이름의 수로,
#                       "attack the X"를 이해할 수 있게 해 줍니다
#                       (이름이 많을수록 호출당 토큰이 조금 늘어납니다). 1-24.
WowLegends.AiCommand.MaxTargetsInPrompt = 12
#    AiChat.PartyChat   1 = 봇이 파티/공격대 채팅에 답할 수 있음(이름이 불린 봇은 직접 답하고,
#                       아니면 파티 봇 하나가 무작위로 끼어들 수 있음, PartyAmbientChance 참고).
#    AiChat.GuildChat   1 = 봇이 길드 채팅에 답할 수 있지만, 이름이 불렸을 때만(길드는 크니까요).
#    AiChat.PartyAmbientChance  특정 봇을 부르지 않은 파티 채팅에 파티 봇 하나가 답할 확률(%)
#                       (0 = 봇 이름이 불렸을 때만 답함). 봇별 쿨다운은 그대로 적용됩니다.
WowLegends.AiChat.PartyChat = 1
WowLegends.AiChat.GuildChat = 1
WowLegends.AiChat.PartyAmbientChance = 80
#    AiChat.ProximityChat   1 = 실제 플레이어가 소리 내어 말하기/외치기를 하면 근처 봇이
#                           소리 내어 답할 수 있음(도시/월드 분위기). 저렴한 ModelFast 등급을 사용.
#    AiChat.ProximityRange  근처 봇을 찾는 범위(야드) (WoW 말하기 범위는 약 20).
#    AiChat.ProximityChance 특정 봇을 부르지 않은 말하기에 근처 봇 하나가 답할 확률(%) (이름이 불린
#                           봇은 항상 고품질 등급으로 답함). 봇별 쿨다운은 그대로 적용됩니다.
WowLegends.AiChat.ProximityChat = 1
WowLegends.AiChat.ProximityRange = 20
WowLegends.AiChat.ProximityChance = 80
WowLegends.AiChat.PublicChannelChat = 1
WowLegends.AiChat.PublicPlayerReplyChance = 100
WowLegends.AiChat.PublicBotReplyChance = 1
WowLegends.AiChat.GuildPlayerReplyChance = 80
#    AiChat.System  기본 시스템 프롬프트 / 공통 규칙. 종족별, 진영별 성격은 이제 봇마다 자동으로
#                   주입되므로(아래 AiChat.Race.* / AiChat.Faction.* 참고), 예전의 일반적인
#                   "Orcs are blunt, Forsaken sardonic" 문장은 여기서 제거되었습니다.
#    AiChat.NoTrailingQuestions  1(기본값): 봇의 채팅에서 서술문이 남는 경우 끝의 질문을 잘라냅니다
#        예: 답변 끝의 불필요한 질문을 제거하고 앞의 설명만 남깁니다.
#        작은 로컬 모델은 비서처럼 훈련되어 거의 모든 줄을 질문이나 도움 제안으로
#        끝내는데, 이는 오크가 아니라 챗봇처럼 보입니다. 시스템 프롬프트 규칙으로는 이를
#        안정적으로 막을 수 없습니다(실측: 3B 모델에 "end with a period"라고 지시하자 모든 줄
#        끝에 "Period."라는 단어를 썼습니다). 질문 하나로만 된 답장은 그대로 두므로 봇이 가끔은
#        여전히 질문을 합니다. 0 = 모델이 쓴 답장을 그대로 둡니다.
WowLegends.AiChat.NoTrailingQuestions = 1

WowLegends.AiChat.System = "당신은 월드 오브 워크래프트를 함께 플레이하는 한국인 유저입니다. 반드시 한국어로만 답하세요. 영어, 중국어, 일본어 등 다른 언어를 사용하지 마세요. 필요한 게임 고유명사만 원문으로 쓰고 설명과 문장은 모두 한국어로 작성하세요. 실제 플레이어처럼 짧고 자연스럽게 한두 문장으로 답하고 영웅이나 NPC를 연기하지 마세요. 파티와 공격대에서는 현재 전투, 역할, 퀘스트와 질문을 우선하세요. 이름을 부르지 않은 질문에도 답하되 이미 대화가 많으면 침묵하세요. 농담은 전체 응답의 10퍼센트 이하로 제한하고 전투 중에는 농담하지 마세요. 전달받지 않은 공략, 쿨다운, 파티 준비 상태, 아이템과 기억을 지어내지 마세요. 실제로 실행할 수 없는 행동을 했다고 말하지 마세요. 이모지, 장식 기호, 마크다운 없이 평문으로 답하세요."

#    AiChat.Race.<Name> / AiChat.Faction.<Side>  봇별 성격 주입. 호출할 때마다 봇 자신의
#        종족 줄과 자신의 진영 줄만 페르소나에 덧붙이므로 토큰이 적게 듭니다(프롬프트당
#        종족 한 줄 + 진영 한 줄, 큰 덩어리가 아님). 모두 코드에 기본값이 내장되어 있어
#        바꾸고 싶은 것만 설정하면 됩니다. 종족 키를 ""로 두면 그 종족은 주입하지 않습니다.
#        종족: Human Orc Dwarf NightElf Undead Tauren Gnome Troll BloodElf Draenei.
WowLegends.AiChat.Race.Human = "인간 캐릭터를 플레이하는 유저입니다. 종족 특유의 연극 말투나 역사 인물 역할극 없이 평범한 게임 유저처럼 말하세요."
WowLegends.AiChat.Race.Orc = "오크 캐릭터를 플레이하는 유저입니다. 종족 특유의 연극 말투나 역사 인물 역할극 없이 평범한 게임 유저처럼 말하세요."
WowLegends.AiChat.Race.Dwarf = "드워프 캐릭터를 플레이하는 유저입니다. 종족 특유의 연극 말투나 역사 인물 역할극 없이 평범한 게임 유저처럼 말하세요."
WowLegends.AiChat.Race.NightElf = "나이트 엘프 캐릭터를 플레이하는 유저입니다. 종족 특유의 연극 말투나 역사 인물 역할극 없이 평범한 게임 유저처럼 말하세요."
WowLegends.AiChat.Race.Undead = "언데드 캐릭터를 플레이하는 유저입니다. 종족 특유의 연극 말투나 역사 인물 역할극 없이 평범한 게임 유저처럼 말하세요."
WowLegends.AiChat.Race.Tauren = "타우렌 캐릭터를 플레이하는 유저입니다. 종족 특유의 연극 말투나 역사 인물 역할극 없이 평범한 게임 유저처럼 말하세요."
WowLegends.AiChat.Race.Gnome = "노움 캐릭터를 플레이하는 유저입니다. 종족 특유의 연극 말투나 역사 인물 역할극 없이 평범한 게임 유저처럼 말하세요."
WowLegends.AiChat.Race.Troll = "트롤 캐릭터를 플레이하는 유저입니다. 종족 특유의 연극 말투나 역사 인물 역할극 없이 평범한 게임 유저처럼 말하세요."
WowLegends.AiChat.Race.BloodElf = "블러드 엘프 캐릭터를 플레이하는 유저입니다. 종족 특유의 연극 말투나 역사 인물 역할극 없이 평범한 게임 유저처럼 말하세요."
WowLegends.AiChat.Race.Draenei = "드레나이 캐릭터를 플레이하는 유저입니다. 종족 특유의 연극 말투나 역사 인물 역할극 없이 평범한 게임 유저처럼 말하세요."
WowLegends.AiChat.Faction.Alliance = "얼라이언스 진영 캐릭터입니다. 진영 전쟁 연설보다 현재 게임 플레이와 협동에 집중하세요."
WowLegends.AiChat.Faction.Horde = "호드 진영 캐릭터입니다. 진영 전쟁 연설보다 현재 게임 플레이와 협동에 집중하세요."

#    AiChat.Provider   호출할 백엔드:
#        openai    = HTTPS를 통한 OpenAI 호환 /chat/completions 엔드포인트 (기본값 —
#                    호스팅 제공자 AI가 이 방식을 쓰며, 본인 키를 쓰는 OpenAI, DeepSeek,
#                    Moonshot/Kimi도 마찬가지입니다).
#        ollama    = 로컬 Ollama HTTP (무료, 키 불필요, 내 컴퓨터에서 실행).
#                    OllamaHost/Port + Model을 사용합니다(Model은 내려받은 모델로 설정하세요!).
#        anthropic = HTTPS를 통한 Anthropic /v1/messages. ApiKey + Model 필요 (ApiUrl은 선택).
WowLegends.AiChat.Provider = "openai"
#    AiChat.ApiUrl   엔드포인트 URL. 기본값 = 호스팅 제공자 AI(아래에 키만 넣으면
#                    끝입니다). ollama에서는 무시됩니다.
#        본인 키 사용 예:
#                          https://api.deepseek.com/chat/completions
#                          https://api.openai.com/v1/chat/completions
#                          https://api.moonshot.ai/v1/chat/completions
#        anthropic       : https://api.anthropic.com/v1/messages   (비워 두면 기본값)
WowLegends.AiChat.ApiUrl = "https://integrate.api.nvidia.com/v1/chat/completions"
#    AiChat.ApiKey   API 키. 호스팅 엔드포인트용 키는 https://WER.eu 의 계정에서
#                    복사하세요(wlk_로 시작). ollama는 비워 둡니다. 외부에 공개하지 마세요.
WowLegends.AiChat.ApiKey = ""
#    AiChat.MaxTokens   응답 길이 상한. OpenAI 호환 공급자에서 0이면 max_tokens를 보내지 않아 공급자/모델 한도만 적용합니다.
#        호스팅 엔드포인트는 어차피 서버 쪽에서 제한합니다. 본인 키로 DeepSeek을 쓸 때 참고:
#        추론 모델은 먼저 생각하는 데 예산을 쓰므로 2000으로 설정하세요. 아니면 빈 답장이 옵니다.
WowLegends.AiChat.MaxTokens = 0
#    AiChat.Temperature   openai 호환 + ollama용 샘플링 온도(anthropic adaptive는 무시).
WowLegends.AiChat.Temperature = 0.4
#    AiChat.TimeoutMs   요청별 네트워크 타임아웃. 클라우드 왕복은 로컬보다 느립니다.
WowLegends.AiChat.TimeoutMs = 12000
#    AiChat.VerifyTLS   1 = OS 루트 인증서로 서버 인증서를 검증(강화). 0 = verify_none(기본값,
#        호스트에 CA 번들이 없어도 동작). 서버에서 API로의 호출이며, v1에서는 0도 괜찮습니다.
WowLegends.AiChat.VerifyTLS = 0

########################################################################
# 살아 있는 대화(LIVING CHATTER) - AI가 만드는 오픈 월드 봇 대화. 가끔씩 실제 플레이어
# 근처의 봇이 자신의 실제 상태와 위치(지역, 레벨, 직업, 전투 상태)에 맞는 AI 생성 대사를
# 말하고, 봇 둘이 짧은 AI 대화극을 펼칩니다. 알아보고 건네는 인사
# (Bot Social Memory)도 정해진 대사 대신 AI 대사로 바뀝니다.
# 목격 시에만: 실제 플레이어가 읽을 수 있을 만큼 가까이 있지 않으면 아무것도 생성하지
# 않습니다 - 빈 렐름에서는 비용이 전혀 들지 않습니다.
# ⚠ 비용: 생성되는 대사/장면/인사 하나가 요청 1회 = 호스팅 크레딧 1개입니다
# (로컬 Ollama면 호출 1회, 무료). MaxRequestsPerDay는 Living Chatter 전체에 대한
# 일일 절대 상한이며, 플레이어 귓속말은 여기에 포함되지 않습니다. 사용량 실시간 확인: .aichat stats
# 활성화 전에 시험해 보세요: .aichat test ambient / .aichat test scene
# (GM, 게임 내)은 Enabled = 0이어도 동작합니다.
#    LivingChatter.Enabled            전체 스위치(기본값 0 - 비용이 듭니다)
#    LivingChatter.AmbientIntervalSec 주변 대사 사이 목표 간격
#    LivingChatter.SceneIntervalSec   두 봇 장면 사이 목표 간격
#    LivingChatter.WitnessRange       실제 플레이어가 있어야 하는 거리(야드)
#    LivingChatter.MaxRequestsPerDay  일일 절대 상한(Living Chatter 전체)
#    LivingChatter.AiGreetings        1 = 알아보고 건네는 인사에 AI 사용
########################################################################
WowLegends.LivingChatter.Enabled = 0
WowLegends.LivingChatter.AmbientIntervalSec = 600
WowLegends.LivingChatter.SceneIntervalSec = 420
WowLegends.LivingChatter.WitnessRange = 30
WowLegends.LivingChatter.MaxRequestsPerDay = 600
WowLegends.LivingChatter.AiGreetings = 1

########################################################################
# 봇 사회적 기억(BOT SOCIAL MEMORY) - 모든 봇은 만난 실제 플레이어를 기억합니다:
# 언제 어디서 마주쳤는지, 얼마나 자주 만났는지, 파티/결투/PvP 기록과 친밀도 점수
# (원한 <-> 친구). 봇이 다시 만난 플레이어를 알아보면 손을 흔들거나(또는 노려보거나),
# 마주 손을 흔들거나 대상으로 지정하면 함께한 기록을 언급하는 인사를 귓속말합니다
# ("Last I saw you was in Westfall..."). 이 기억은 AI 채팅에도 반영되어, 당신을 아는
# 봇은 그렇게 말합니다. 영구 저장됨(characters.WER_bot_acquaintance).
#    BotSocial.Enabled           전체 스위치(분위기용 기능, 기본값 켬)
#    BotSocial.SightRange        봇이 플레이어를 "알아차리는" 거리(야드)
#    BotSocial.MinAwayMinutes    재회로 인정되기까지 떨어져 있어야 하는 분(알아보고
#                                건네는 인사가 발생할 수 있음).
#                                720 = 12시간. 테스트할 때는 낮게(e.g. 10) 설정하세요
#                                또는 더 수다스러운 렐름
#    BotSocial.GreetChance       알아봤을 때 인사를 건넬 확률(%)
#    BotSocial.MaxGreetsPerPlayerPerDay  도시에서 인사 공세를 받지 않도록 하는 상한
#    BotSocial.StrongTieMeetings 봇이 손 흔들기 단계를 건너뛰고 바로 귓속말하게
#                                되는 만남 횟수
#    BotSocial.PvpGrudge.Enabled 봇이 자신을 죽인 플레이어를 기억하고 World PvP 중에
#                                그 플레이어를 추격함(WorldPvP가 활성이어야
#                                의미가 있음)
########################################################################
WowLegends.BotSocial.Enabled = 1
WowLegends.BotSocial.SightRange = 25
WowLegends.BotSocial.MinAwayMinutes = 720
WowLegends.BotSocial.GreetChance = 10
WowLegends.BotSocial.MaxGreetsPerPlayerPerDay = 3
WowLegends.BotSocial.StrongTieMeetings = 5
WowLegends.BotSocial.PvpGrudge.Enabled = 1

#    WER.EasterEgg.Enabled
#        가시덤불 골짜기 어딘가에 숨겨진 작은 헌정물입니다. 어렵게 찾아내는 것이
#        핵심입니다. 1 = 작동(기본값), 0 = 현지인들이 물러납니다.
#        (궁금한 운영자는 db/wl-custom에서 자세한 내용을 확인하세요. 스포일러는 없습니다.)
WowLegends.EasterEgg.Enabled = 1

########################################################################
# 전설의 길(PATHS OF LEGENDS) - 선택 참여형, 캐릭터별 플레이 도전 과제로, 쓰러진 자들의
# 전령(모든 시작 지역에 있는 하드코어 NPC)에게 맹세합니다.
# 길은 맹세한 캐릭터에게만 적용되며 월드나 다른 플레이어에게는 영향을 주지 않습니다.
# 맹세한 길을 포기하면 영구적입니다.
# v1 길: 머나먼 길(THE LONG ROAD) - 라그나로스, 오닉시아, 네파리안, 쑨을 쓰러뜨릴 때까지
# XP가 60에서 잠기고(공격대의 봇도 인정), 그 뒤 일리단을 쓰러뜨릴 때까지 70에서
# 잠깁니다 - 그제서야 노스렌드와 80이 당신의 것이 됩니다. 잠금 중에는 퀘스트와
# 처치 XP가 전부 흡수되며(골드로 전환되지 않음), 휴식 XP는 관문이 열릴 때까지 기다립니다.
#    Paths.Enabled          전체 스위치(순수 선택 참여이므로 켜 두어도 안전;
#                           0 = 관문이 열리고 보스 처치 인정도 중단됨)
#    Paths.MaxLevelToSwear  길에 맹세할 수 있는 최고 레벨.
#                           머나먼 길은 이 값과 관계없이 첫 관문(60)을 넘으면
#                           맹세를 거부합니다 - 4보다 높게는 테스트할 때만 올리세요.
#    Paths.Announce         맹세와 달성을 렐름 전체에 알림
#    Paths.AllowAbandon     1 = 길을 저버릴 수 있음(영원히 FORSAKEN으로 표시);
#                           0 = 맹세는 맹세
########################################################################
# 길 목록(각각 개별 토글이 있음. 레벨 80에 도달하면 머나먼 길을 제외한 모든 길이
# 달성되며, 머나먼 길은 일리단이 쓰러질 때 끝납니다).
# 길별로 0을 설정하면 새 맹세가 막히고, 이미 맹세한 캐릭터에게 걸린 그 길의 관문이
# 모두 해제됩니다 - 기록은 유지되며(진행도와 포기 여부는 전령에게서 계속 확인 가능)
# 다시 활성화하면 재적용됩니다. 삭제가 아니라 일시 중지입니다.
#    LongRoad     옛 공격대 뒤에서 XP가 60/70에서 잠김(위 참고).
#    IronOath     레벨 1에서 시작 복장, 빈 지갑, 빈 은행으로 맹세. 경매장, 거래,
#                 우편 금지(우편함이 닫힘 - 시스템 우편 포함, 그것이 바로 맹세입니다),
#                 길드 은행 금지, 길드 비용 수리 금지.
#    PilgrimsWay  탈것, 비행 경로, 귀환석/Astral Recall 금지,
#                 자신의 이동 마법(마법사 순간이동, 죽음의 관문) 금지. 도보,
#                 배, 비행선만 허용. 드루이드 변신은 허용되며(탈것이 아닌 직업의
#                 특색), 다른 사람이 쓰는 마법(차원문, 소환)은 제한하지 않습니다 - 감옥이
#                 아니라 맹세이니까요.
#    SlowBurn     모든 XP가 영원히 절반, 어떤 배율과도 중첩 - 설정으로
#                 맹세를 무를 수 없습니다.
#    Paths.Trophies.Enabled     길을 달성하면 귀속 기념품 아이템을 지급
#                               (읽을 수 있음 - 안에 맹세의 신조가 적혀
#                               있음). 기록당 정확히 한 번 지급되며, 놓친 지급은 로그인 시 보충.
#    Paths.HeraldHonors.Enabled 전령이 달성한 방문자에게 절하며 이름과 업적을
#                               소리 내어 말함(캐릭터당 1분에 한 번으로 제한).
WowLegends.Paths.Enabled = 1
WowLegends.Paths.MaxLevelToSwear = 4
WowLegends.Paths.Announce = 1
WowLegends.Paths.AllowAbandon = 1
WowLegends.Paths.LongRoad.Enabled = 1
WowLegends.Paths.IronOath.Enabled = 1
WowLegends.Paths.PilgrimsWay.Enabled = 1
WowLegends.Paths.SlowBurn.Enabled = 1
WowLegends.Paths.Trophies.Enabled = 1
WowLegends.Paths.HeraldHonors.Enabled = 1

WowLegends.Hardcore.RealmWide = 0
WowLegends.Hardcore.AllowOptIn = 1
WowLegends.Hardcore.AnnounceDeaths = 1
WowLegends.Hardcore.Makgora = 1

#    WER.Hardcore.AuraSpell
#        살아 있는 하드코어 캐릭터에게 적용되는 지속 시각 효과(오라)로, 자신과 다른
#        사람이 알아볼 수 있게 합니다. 시각 효과가 지속되는 주문 ID면 무엇이든 가능합니다.
#        0 = 오라 없음. id를 바꾸고 다시 접속하면 다른 모습을 미리 볼 수 있습니다.
#        시험해 볼 만한 예: 168 = 서리 갑옷(얼음), 28189 = 지옥 갑옷(어두움),
#        11426 = 얼음 방패(보호막), 1463 = 마나 보호막.
#        기본값: 0 (꺼짐)
WowLegends.Hardcore.AuraSpell = 0

#    WER.WorldPvP.Enabled
#        모든 지역 오픈 월드 PvP. 켜면 GM이 아닌 모든 플레이어가 어디서나 PvP 상태로
#        유지되어, 적대 진영 플레이어와 AI 플레이어봇 모두 월드에서 공격할 수 있게
#        됩니다(혼자 플레이해도 살아 있고 위험한 세계). 같은 진영은 안전하며, 수도와
#        안식처도 안전합니다(오픈 월드에만 적용). 플레이어 본인의 /pvp 토글은
#        건드리지 않으며, 이 설정을 끄면 PvP가 정상적으로 해제됩니다.
#        worldserver 재시작 또는 `.reload config` 시 적용됩니다.
#        기본값: 0 (끔)
WowLegends.WorldPvP.Enabled = 0

#    WER.WorldPvP.Mode
#        World PvP 일정 방식(Enabled = 1일 때만 의미가 있음):
#          always - PvP가 계속 켜져 있음(기존 방식).
#          timed  - IntervalMinutes마다 PvP 시간대가 열려 DurationMinutes 동안
#                   유지되며, 열리고 닫힐 때 서버 공지가 나갑니다.
#                   GM이 필요할 때 직접 열거나 닫을 수도 있습니다:
#                     .worldpvp start [minutes]   .worldpvp stop   .worldpvp status
#        기본값: always
WowLegends.WorldPvP.Mode = "always"

#    WER.WorldPvP.Timed.IntervalMinutes
#        (timed 모드) 한 시간대의 시작부터 다음 시간대 시작까지의 분.
#        1..10080으로 제한. 기본값: 120 (2시간마다)
WowLegends.WorldPvP.Timed.IntervalMinutes = 120

#    WER.WorldPvP.Timed.DurationMinutes
#        (timed 모드) 각 PvP 시간대가 열려 있는 시간. 1..1440으로 제한.
#        기본값: 30
WowLegends.WorldPvP.Timed.DurationMinutes = 30

#    WER.WorldPvP.Timed.Announce
#        (timed 모드) 시간대가 열리고 닫힐 때의 서버 전체 메시지.
#        기본값: 1 (켬)
WowLegends.WorldPvP.Timed.Announce = 1

#    WER.BotTaunts.Enabled
#        진영 인식 전투 도발: 켜면 AI 플레이어봇이 적 플레이어와 교전할 때 모욕을
#        외칩니다(world PvP나 적 플레이어와의 모든 전투와 잘 어울립니다). 도발은 대상이
#        읽을 수 있는 언어로 나오므로 조롱이 제대로 전달되며, 봇마다 가끔 한 줄씩만
#        나오도록 제한되어 스팸이 되지 않습니다. playerbots DB에 도발 문구 행이
#        필요합니다(리팩에 포함).
#        기본값: 0 (끔)
WowLegends.BotTaunts.Enabled = 0

#    WER.BotNarration.Enabled
#        파티 중인 봇이 자기 퀘스트 진행 상황을 파티 채팅에서 짧고 사람답게 말합니다:
#        예: 목표 몬스터가 두 마리 더 필요하다는 말이나 퀘스트 재료를 다 모았다는 말처럼
#        자신의 진행 상황을 알려 줍니다. 실제 목표 수치를 기반으로 하므로 항상
#        사실만 말합니다. 봇별로 제한되어(약 25-45초에 한 줄) 수다스럽지 않고 매력적으로
#        유지되며, 봇에게 "silent"라고 귓속말하면 완전히 음소거됩니다. 대사는 playerbots
#        DB에서 수정할 수 있습니다(ai_playerbot_texts, wl_narrate_* 키 - 키마다 여러 행을
#        두면 다양해짐, 기본 세트 포함). 비용 없음: AI 호출 없이 정해진 대사만 사용합니다.
#        기본값: 1 (켬)
WowLegends.BotNarration.Enabled = 1

#    WER.BotPitchIn.Enabled
#        봇이 당신의 퀘스트를 거듭니다: 오픈 월드에서 실제 플레이어와 파티 중일 때,
#        할 일 없는 봇이 자기 퀘스트 목록에 아직 필요한 근처 몹(처치 인정 또는 퀘스트
#        아이템 드랍)을 골라 스스로 공격합니다. 뒤에 서 있기만 하는 대신 진짜 파티원처럼
#        행동합니다. 봇은 당신 곁을 벗어나지 않고(Radius 참고), 던전/공격대/전장에서는
#        절대 동작하지 않으며, "stay"를 따르고, 같은 몹을 겹쳐 잡기 전에 여러 몹으로
#        흩어집니다. 퀘스트 공유/자동 수락, BotNarration과 함께 쓰면 완전한 "살아 있는
#        파티" 느낌을 줍니다. 특정 봇만 끄려면 "nc -pitch in"이라고 귓속말하세요
#        (그 봇의 전략이 초기화될 때까지 유지: 재접속, 파티 초대, 전장, 특성 변경).
#        기본값: 1 (켬)
WowLegends.BotPitchIn.Enabled = 1

#    WER.BotPitchIn.Radius
#        봇이 퀘스트를 거들 때 퀘스트 몹을 고를 수 있는 당신(주인) 주변 거리(야드).
#        작으면 봇이 바로 곁에서 싸우고, 크면 사냥터 전체를 누빕니다. 10-100으로 제한.
#        기본값: 40
WowLegends.BotPitchIn.Radius = 40

#    WER.BotIdleLife.Enabled
#        한가한 일상: 당신이 자리를 잡으면(가만히 서 있고, 탈것에서 내리고, 비전투 상태),
#        파티 봇들이 차렷 자세를 멈추고 주변을 짧게 산책하며, 당신이 앉으면 둘러앉고
#        (모닥불이 피워져 있으면 그 주위에 - 한번 해 보세요), 가끔 감정 표현을 합니다.
#        당신이 움직이거나, 탈것에 타거나, 싸우거나, 명령을 내리는 순간 바로 평소대로
#        돌아옵니다. 오픈 월드에서만 동작. 봇별로 끄기: "$nc -idle life"라고
#        귓속말하세요(그 봇의 전략이 초기화될 때까지).
#        기본값: 1 (켬)
WowLegends.BotIdleLife.Enabled = 1

#    WER.AiChat.Sage.Enabled
#        현자(The Sage): 봇에게 게임에 대해 물으면 - 아이템(링크하거나 이름을 말함),
#        퀘스트, NPC, "who sells X", "where is Y" - AI의 답이 이 서버의 실제 데이터를
#        근거로 합니다(아이템/퀘스트/NPC 저장소 읽기 전용 조회; 가격, 레벨, 퀘스트
#        제공자, 가장 가까운 생성 위치). 본인 Ollama를 포함한 모든 AI 제공자와 동작합니다.
#        추가 비용 없음: 정보는 같은 AI 호출 한 번에 함께 실립니다.
#        기본값: 1 (켬)
WowLegends.AiChat.Sage.Enabled = 1

#    WER.BotGuide.Enabled
#        안내자(The Guide): 파티 봇에게 어딘가로 안내해 달라고 하면 앞장서서 길을 걷고,
#        당신이 뒤처지면 외치며 기다리고, 도착을 알립니다. "take me to the crossroads",
#        예: 여관주인, 직업 상급자, 퀘스트 장소까지 길을 안내해 달라는 요청입니다.
#        던전 이름, 모든 .tele 위치를 인식합니다. 같은 대륙 안에서만 걸어갑니다(안내자는
#        순간이동하지 않음). 바다를 건너는 요청에는 솔직하게 답합니다.
#        AiCommand.Enabled = 1이 필요하며, 목적지 문구는 AI를 설정하지 않아도 동작합니다.
#        기본값: 1 (켬)
WowLegends.BotGuide.Enabled = 1

#    WER.BotPathways.Enabled
#        "Legend Roads": 대륙마다 미리 계산해 둔, 경사가 제한된 경로망입니다.
#        긴 봇 이동(안내자 호위와 돌아다니는 봇)은 이 경로망으로 계획되므로, 봇이
#        기술적으로 걸을 수 있는 비탈을 염소처럼 오르는 대신 플레이어처럼 산을 돌아갑니다.
#        <DataDir>/pathways/ 에 경로 데이터 파일이 필요합니다 - 리팩에 포함되어 있으며,
#        .wlpaths build <mapId> 명령으로 직접 다시 만들 수도 있습니다(월드가 1-2분 정도
#        멈추며, 이후 재시작 필요). 데이터 파일이 없으면 봇은 예전처럼 실시간 경로 탐색을
#        사용합니다.
#        기본값: 1 (켬)
WowLegends.BotPathways.Enabled = 1

#    WER.BotPathways.AllBots
#        안내자 호위뿐 아니라 모든 장거리 봇 지상 이동(돌아다니는 월드 봇, 퀘스트 봇)을
#        경로망으로 처리합니다.
#        기본값: 1 (켬)
WowLegends.BotPathways.AllBots = 1

#    WER.BotPathways.MaxSlopeDegrees
#        경로 계산의 "편안한" 경사도(절대 벽이 아님). 이보다 가파른 지형은 비용이
#        점점 커지므로 경로가 골짜기와 길을 따라갑니다. 더 가파른 지형도 유일한 통로라면
#        건넙니다. 여기를 절대 벽으로 두면 대륙이 섬처럼 쪼개지므로(구불구불한 고갯길도
#        직선으로 보면 절벽이 됨) 부드러운 기준점으로 둡니다. 빌드된 데이터에 반영됩니다.
#        범위 5-45. 기본값: 20
WowLegends.BotPathways.MaxSlopeDegrees = 16

#    WER.BotPathways.ClimbWeight
#        경로가 가파른 지형을 얼마나 강하게 피할지. 0 = 최단 경로(봇이 산을 가로지름);
#        높을수록 더 평탄하고 언덕을 크게 돌아가는 긴 우회로. ~10이면 대륙 횡단 경로가
#        내내 편안한 경사도 이하를 유지하며, 이동 거리는 약 25% 늘어납니다.
#        빌드된 데이터에 반영됩니다.
#        범위 0-100. 기본값: 10
WowLegends.BotPathways.ClimbWeight = 22

#    WER.BotPathways.WaterCostFactor
#        경로 계획기가 수영을 얼마나 꺼릴지. 물은 건널 수 있지만 실제 거리의 이 배수로
#        가중되므로, 봇은 육지 우회로가 훨씬 길 때만 강과 호수를 건너며 - 그것도 가장
#        좁은 곳으로 건넙니다. 조회 시점에 적용됩니다(실행 중 조정 가능).
#        범위 1-50. 기본값: 5
WowLegends.BotPathways.WaterCostFactor = 12

#    WER.TriageHealer.Enabled
#        더 똑똑한 치유 봇. 두 가지 변경이 있으며, 둘 다 끄면 => 원본(upstream)과 정확히 같은 동작:
#        (1) 원본에 연결은 되어 있지만 꺼진 채 배포된 아군 구조 시스템을 활성화합니다 -
#        사제/성기사/전사 봇이 곧 죽을 파티원에게 방어용 외부 기술(고통 억제(Pain Suppression),
#        보호의 손길/희생의 손길(Hand of Protection/Sacrifice), 가로막기(Intervene))을 쓰며,
#        봇이 따르는 사람인 당신을 가장 먼저 챙깁니다.
#        (2) 치유 대상 우선순위: 생명력이 비슷하면 탱커와 당신을 같은 생명력의 DPS 봇보다
#        먼저 채웁니다(정말로 생명력이 낮은 DPS는 여전히 우선). 파티 치유사가 진짜처럼 느껴집니다.
#        기본값: 1 (켬)
WowLegends.TriageHealer.Enabled = 1

#    WER.VoiceCards.Enabled
#        모든 봇에게 캐릭터 GUID에서 결정적으로 도출한 고유한 성격(기질 + 말버릇 +
#        수다스러움)을 부여합니다. 그래서 두 오크도 서로 다른 사람처럼 들리고, 알게 된 봇은
#        영원히 같은 목소리를 유지합니다(상태 없음, 저장하는 것 없음). AI 채팅 + 주변 대사에
#        개성을 더하고, 주변 잡담에서 봇이 끼어드는 빈도를 바꿉니다(LLM이 꺼져 있어도
#        확인 가능). 직접 보낸 귓속말에 대한 답은 절대 막지 않습니다. 끄면 = 기본
#        종족/진영 목소리만 사용.
#        기본값: 1 (켬)
WowLegends.VoiceCards.Enabled = 1

#    WER.SpeechGovernor.Enabled
#        모든 봇 잡담(AI 끼어들기, 알아보고 건네는 인사, 주변 한마디, 두 봇 장면)이 거치는
#        하나의 공통 관문입니다. 모두가 한꺼번에 말할 때 봇이 한 지역을 글 폭탄으로 덮지
#        않고 차례로 말하게 합니다. 좁은 지역에서 짧은 시간 동안 들리는 봇 대사 수를
#        제한하며, 가치가 낮은 주변 잡담부터 버리고 가치가 높은 대사는 통과시킵니다.
#        플레이어에게 직접 보내는 답장/귓속말은 절대 보류하지 않습니다. 덤으로: 주변 대사는
#        LLM을 호출하기 전에 이 관문에 먼저 묻기 때문에, 보류된 대사는 토큰이 전혀 들지
#        않습니다(Ollama / 종량제 AI에서 절약).
#        기본값: 1 (켬)
WowLegends.SpeechGovernor.Enabled = 1

#    WER.SmartPvpTargeting.Enabled
#        더 똑똑한 봇 PvP 대상 선택: 봇이 공격할 수 있는 적 플레이어 중 먼저 찾은 대상을
#        잡는 대신 적 치유사를 우선하고, 그다음 생명력이 가장 낮은 대상을 고릅니다.
#        봇 대 플레이어 전투가 의도적으로 느껴집니다. 끄면 = 원래의 먼저 찾은 대상 방식.
#        기본값: 1 (켬)
WowLegends.SmartPvpTargeting.Enabled = 1

#    WER.Companion.Memory.Enabled
#        장기 동료(Companion) 기억: 개인 동료(.companion)가 파티 중에 당신과 함께 겪은
#        주요 순간 - 레벨 업, 보스 처치, 전투 중 쓰러짐 - 을 기억하고, 귓속말하면 AI
#        채팅에서 다시 이야기합니다(AiChat.Enabled + 백엔드 필요).
#        기본값: 1 (켬)
WowLegends.Companion.Memory.Enabled = 1

#    WER.Companion.Memory.MaxEvents
#        동료가 보관하고 답장에 녹여 쓸 수 있는 최근 공유 기억의 수
#        (AiChat.MemoryTurns처럼 프롬프트 토큰 비용을 제한).
#        기본값: 8
WowLegends.Companion.Memory.MaxEvents = 8

###############################################################################
# 월드 이벤트 - 진영 BATTLEFRONT
#
#    엄선된 오픈 월드 지역(동부 왕국 / 칼림도어)에서 무작위 타이머나 GM 명령으로
#    쟁탈 거점이 나타나고, 두 진영이 이를 두고 싸웁니다. 깃발 위에 서서 줄다리기 막대를
#    내 쪽으로 끌어오고, 점령을 유지하면 승리합니다. AI 플레이어봇도 난전에 참여하지만,
#    실제 플레이어의 가중치가 훨씬 높아(기본값 3:1) 승패는 실제 플레이어가 결정합니다.
#    승자는 골드 + 명예(+ 선택적 버프)를, 패자는 약간의 위로 명예를 받습니다.
#
#    GM 명령(콘솔/RA에서도 사용 가능):
#        .wlevent start [zone|index]   지금 시작(생략하면 무작위 지역)
#        .wlevent stop                 진행 중인 전선 종료
#        .wlevent status               점령도 %와 기여자 표시
#        .wlevent zones                엄선된 지역 + 인덱스 목록
###############################################################################

#    WER.WorldEvents.Enabled
#        World Events 전체 스위치(무작위 스케줄러와 GM 명령 모두).
#        끄면 = 자동 생성이 없고 명령으로도 시작할 수 없습니다.
#        worldserver 재시작 또는 `.reload config` 시 적용됩니다.
#        기본값: 0 (끔)
WowLegends.WorldEvents.Enabled = 0

#    WER.WorldEvents.IntervalMinMinutes / IntervalMaxMinutes
#        자동 생성되는 전선 사이의 무작위 간격(각 이벤트가 끝날 때마다 이 범위에서
#        새로 무작위 값을 정합니다). 한 번에 하나만 진행됩니다.
#        기본값: 45 / 90
WowLegends.WorldEvents.IntervalMinMinutes = 45
WowLegends.WorldEvents.IntervalMaxMinutes = 90

#    WER.WorldEvents.Battlefront.Radius
#        점령도에 반영되는 깃발 주변 점령 반경(야드).
#        기본값: 50
WowLegends.WorldEvents.Battlefront.Radius = 50

#    WER.WorldEvents.Battlefront.RealPlayerWeight / BotWeight
#        실제 플레이어와 AI 플레이어봇이 점령도에 기여하는 비중. 기본값 3:1이면
#        실제 플레이어 두어 명이 봇끼리의 교착 상태를 깰 수 있습니다.
#        기본값: 3 / 1
WowLegends.WorldEvents.Battlefront.RealPlayerWeight = 3
WowLegends.WorldEvents.Battlefront.BotWeight = 1

#    WER.WorldEvents.Battlefront.CaptureStep
#        한 진영이 경쟁 없이 거점을 유지할 때 약 3초 틱마다 얻는 점령 점수(100점 만점).
#        경쟁 중이면 이 값의 절반만큼 밀어냅니다. 높을수록 점령이 빨라집니다.
#        기본값: 4
WowLegends.WorldEvents.Battlefront.CaptureStep = 4

#    WER.WorldEvents.Battlefront.HoldToWinSeconds
#        승리하려면 한 진영이 최대 점령도를 (인원이 있는 상태로) 유지해야 하는 초.
#        기본값: 8
WowLegends.WorldEvents.Battlefront.HoldToWinSeconds = 8

#    WER.WorldEvents.Battlefront.TimeoutMinutes
#        절대 제한 시간. 그때까지 아무도 점령하지 못하면 전선은 승자 없이 사라집니다.
#        0으로 두면 제한 시간 없음(한 진영이 이길 때까지 진행) - 참고: 실제 플레이어 없이
#        봇끼리 균형이 맞아 교착되면 아주 오래 진행될 수 있습니다.
#        기본값: 20
WowLegends.WorldEvents.Battlefront.TimeoutMinutes = 20

#    WER.WorldEvents.Battlefront.BannerEntry
#        시각적 점령 표식으로 소환되는 GameObject 엔트리.
#        기본값: 182259 (Battle Standard of the Mag'har)
WowLegends.WorldEvents.Battlefront.BannerEntry = 182259

#    WER.WorldEvents.Battlefront.GuardEntry / GuardCount / GuardRingRadius
#        깃발 주위에 원형으로 소환되는 중립 경비병(모두와 싸우므로 위험을 더하고 근처
#        봇을 난전으로 끌어들입니다). GuardCount = 0이면 비활성화됩니다. 참고: 기본값
#        23562는 레벨 80 faction-14 정예입니다 - 저레벨 지역에서는 수를 줄이거나 더 약한
#        생물을 고르세요.
#        기본값: 23562 / 2 / 10
WowLegends.WorldEvents.Battlefront.GuardEntry = 23562
WowLegends.WorldEvents.Battlefront.GuardCount = 2
WowLegends.WorldEvents.Battlefront.GuardRingRadius = 10

#    WER.WorldEvents.Battlefront.SpawnBotsPerFaction
#        각 이벤트 시작 시 같은 대륙에서 진영별로 최대 이 수만큼의 무작위 AI 플레이어봇을
#        (10 = 10대10 난전) 깃발로 순간이동시켜, 거점에서 싸울 인원이 항상 있게 합니다.
#        이 봇들은 따로 추적되지 않으며, 싸운 뒤 원래 일과로 돌아갑니다. 0이면 비활성화.
#        기본값: 10
WowLegends.WorldEvents.Battlefront.SpawnBotsPerFaction = 10

#    WER.WorldEvents.Reward.Gold
#        승리한 실제 참가자 각자에게 주는 골드 보상, 코퍼 단위(50000 = 5g).
#        기본값: 50000
WowLegends.WorldEvents.Reward.Gold = 50000

#    WER.WorldEvents.Reward.Honor
#        승리한 실제 참가자 각자에게 주는 명예 점수.
#        기본값: 250
WowLegends.WorldEvents.Reward.Honor = 250

#    WER.WorldEvents.Reward.ConsolationHonor
#        패배한 실제 참가자 각자에게 주는 명예 점수(0 = 없음).
#        기본값: 50
WowLegends.WorldEvents.Reward.ConsolationHonor = 50

#    WER.WorldEvents.Reward.BuffSpell
#        승리한 실제 참가자 각자에게 시전되는 주문(월드 버프). 0 = 없음.
#        기본값: 22888 (Rallying Cry of the Dragonslayer)
WowLegends.WorldEvents.Reward.BuffSpell = 22888

###############################################################################
# AUTO-SUMMON PARTY 봇 으로 INSTANCES
#
#    플레이어(파티장)가 던전이나 공격대에 입장하면, 몇 초 뒤 파티의 봇이 자동으로
#    소환됩니다 - 파티 채팅에 `summon` 명령을 입력하는 것과 같지만 자동입니다.
#    던전 찾기가 봇을 인스턴스 밖에 세워 두는 playerbots의 문제를 해결합니다.
#    들어가면서 죽은 봇도 부활시킵니다. 파티장만 이 기능을 발동합니다.
###############################################################################

#    WER.AutoSummonBots.Enabled
#        던전/공격대에 들어가면 파티의 봇을 자동 소환합니다.
#        기본값: 1 (켬)
WowLegends.AutoSummonBots.Enabled = 1

#    WER.AutoSummonBots.DelayMs
#        입장 후 소환까지의 시간(ms). 지연을 두면 파티 전체가 자리를 잡아
#        1-2개가 아니라 모든 봇이 옵니다.
#        기본값: 4000
WowLegends.AutoSummonBots.DelayMs = 4000

###############################################################################
# 아니요 HEARTHSTONE COOLDOWN
#
#    귀환석(그리고 "There's No Place Like Home"을 시전하는 귀환석 대용 아이템)의
#    30분 대기 시간을 없애, 집으로 귀환해 가방을 정리하고 곧바로 다시 돌아갈 수 있게
#    합니다. 편의 기능일 뿐이며 전투, 전리품, 월드에는 변화가 없으므로 어떤 렐름에서도
#    안전하지만, 정식 서버의 진행 속도와는 다르므로 기본으로 꺼져 있고 직접 켜야 합니다.
#
#    동료 봇에게도 적용됩니다: 집으로 가라고 한 봇이 더 이상
#    "my hearthstone is still cooling down"이라고 답하지 않습니다.
#
#    영향 없음: 순례자의 길(The Pilgrim's Way)은 여전히 귀환석을 완전히 금지합니다
#    (그 길은 쿨다운이 아니라 아이템 자체를 막음) - 맹세하면 여전히 모든 거리를
#    자기 두 발로 걸어야 합니다.
###############################################################################

#    WER.NoHearthstoneCooldown.Enabled
#        플레이어와 봇의 귀환석 쿨다운을 없앱니다.
#        기본값: 0 (끔 - 정식 서버의 30분 쿨다운 유지)
WowLegends.NoHearthstoneCooldown.Enabled = 0

###############################################################################
# 죽음 KNIGHT 봇 - 던전 FINDER FIX
#
#    이 설정이 없으면 파티에 죽음의 기사 봇이 하나만 있어도 파티 전체가
#    던전 찾기 대기열에 들어갈 수 없습니다.
#
#    이유: 게임은 모든 죽음의 기사가 아케루스의 시작 퀘스트 연계를 마칠 때까지 던전 찾기를
#    잠급니다(정식 서버와 같은 올바른 동작). 실제 죽음의 기사는 떠나는 과정에서 이를
#    해제합니다. 봇은 레벨 55+로 바로 생성되어 연계 퀘스트를 하지 않으므로 조건을 절대
#    만족할 수 없고, 던전 찾기는 파티에서 가장 조건이 나쁜 구성원 기준으로 잠그기 때문에
#    파티의 사람 플레이어까지 막힙니다.
#
#    이 설정을 켜면 죽음의 기사 봇이 접속할 때 그 시작 퀘스트를 완료한 것으로
#    처리됩니다. 던전 찾기가 실제로 확인하는 것은 이것뿐입니다.
#    그 외에는 아무것도 주지 않습니다 - 장비, 주문, 경험치 모두 없음.
#
#    실제 플레이어는 절대 건드리지 않습니다: 본인의 죽음의 기사는 여전히
#    정상적인 방법으로 아케루스를 떠나야 합니다.
#
#    기존 봇은 다음 접속 시 스스로 고쳐지므로, 업데이트 후 직접 실행할 것이
#    없습니다.
###############################################################################

#    WER.DkDungeonFinderFix.Enabled
#        죽음의 기사 봇이 던전 찾기를 사용할 수 있게 합니다.
#        기본값: 1 (켬 - 봇이 대기열에 들어갈 수 없는 렐름이 고장 난 상태입니다)
WowLegends.DkDungeonFinderFix.Enabled = 1

###############################################################################
# 즉시 공격(INSTANT SWING) (v1.5.0 - Boethiah 제안)
#
#    3.3.5에서는 몇몇 근접 기술이 "다음 공격 시" 발동합니다: 영웅의 일격을 눌러도
#    바로 아무것도 때리지 않고, 다음 자동 공격이 더 세게 맞도록 준비할 뿐입니다.
#    이런 방식에 익숙하지 않은 사람에게는 단축키가 먹통인 것처럼 느껴집니다.
#
#    이 설정을 켜면 다섯 가지 기술이 다른 모든 즉시 시전 기술처럼
#    바로 발동합니다:
#
#        영웅의 일격 · 회전베기  (전사)
#        랩터의 일격             (사냥꾼)
#        룬의 일격               (죽음의 기사)
#
#    모든 등급이 포함됩니다. 렐름의 다른 것은 건드리지 않으며 - 같은 방식을 쓰는
#    생물 기술은 의도적으로 그대로 둡니다.
#
#    후려치기(Maul)는 의도적으로 제외했습니다. 드루이드 특성 청명의 전조(Omen of Clarity)는
#    바로 이 플래그로 근접 기술의 발동 여부를 판단하므로, 후려치기를 즉시로 만들면
#    야성 드루이드의 청명의 전조가 조용히 작동을 멈춥니다. 편의 설정이 특성을 몰래
#    꺼 버리는 것은 저희가 대신 선택할 수 있는 거래가 아니므로, 곰은 공격 타이머를 유지합니다.
#
#    기본값이 꺼짐인 이유는 두 가지입니다. 렐름의 모든 플레이어에게 해당 기술의 작동 방식이
#    바뀌고, 모든 봇의 근접 순환도 바뀝니다 - 공격 사이에 영웅의 일격을 예약해 두지
#    않게 된 전사 봇은 분노를 다르게 씁니다. 라이브 렐름에 앞서 테스트 렐름에서 먼저 시험해 보세요.
#
#    ⚠️ 시작 시에만 적용. 주문 속성은 월드를 불러올 때 한 번만 읽으므로
#    `.reload config`로는 이 변경이 적용되지 않습니다 - worldserver를 재시작하세요.
#    켜져 있으면 시작 로그에 변환된 기술 등급 수가 표시됩니다.
###############################################################################

#    WER.InstantSwing.Enabled
#        다음 공격 시 발동하는 기술을 즉시 발동하게 합니다.
#        기본값: 0 (끔 - 월드를 바꾸는 기능이므로 운영자가 직접 켜야 함)
WowLegends.InstantSwing.Enabled = 0

###############################################################################
# 전투단 야영지(WARBAND CAMP) (v1.5.0 - AeonFlux 제안)
#
#    캐릭터 하나가 아니라 계정에 속하는 땅입니다. 내가 가진 모든 캐릭터가
#    같은 야영지를 공유하며, 다른 플레이어도 누구나 들어올 수 있습니다 - 비공개가
#    아닌 월드 속의 장소입니다
#    별도의 인스턴스 공간이 아닙니다.
#
#        .camp           내 야영지 위치
#        .camp claim     지금 서 있는 땅을 차지
#        .camp go        그곳으로 이동(5분 쿨다운)
#        .camp props     설치할 수 있는 물건 목록
#        .camp place X   서 있는 곳에 하나 설치
#        .camp remove    가장 가까운 물건 치우기
#        .camp leave     땅 반납(확인을 요청함)
#
#    위치는 직접 고릅니다. 오픈 월드에서 마음에 드는 곳 어디에서든 서서 차지하세요.
#    인스턴스, 전장, 투기장, 수도, 안식처, 실내, 물속, 공중, 그리고 다른 사람의
#    야영지로부터 150야드 이내에서는 야영지를 만들 수 없습니다.
#
#    다른 사람에게 방해가 되지 않는 방법. 야영지마다 고유한 위상을 가지므로 천막과
#    화로는 일반 월드에서 보이지 않습니다 - 40야드 안으로 들어오면 주변에 야영지가
#    나타나고, 벗어나면 사라집니다. 그동안에도 일반 월드는 계속 보이며, 누구의
#    야영지에 서 있든 플레이어끼리는 항상 서로를 볼 수 있습니다.
#
#    소품은 평범한 WotLK 배경 오브젝트(천막, 모닥불, 마차, 상자, 깃발...)이며
#    야영지당 30개로 제한됩니다. CHARACTERS 데이터베이스에 저장되므로 월드 덤프를
#    다시 가져와도 누구의 야영지도 삭제되지 않습니다.
#
#    기본값 꺼짐 - 월드를 바꾸는 기능이므로, 업데이트했다고 렐름에 생기는 것이 아니라
#    직접 켜야 합니다.
###############################################################################

#    WER.WarbandCamp.Enabled
#        .camp 명령과 전투단 야영지를 활성화합니다.
#        기본값: 0 (끔)
WowLegends.WarbandCamp.Enabled = 1

#    WER.WarbandCamp.MaxProps
#        야영지 하나에 둘 수 있는 소품 수. 0 = 무제한. 설치할 때마다 맵별 영구
#        오브젝트 GUID를 사용하므로, "무제한"은 무엇을 하는지 아는 운영자를 위한 것입니다.
#        기본값: 200
WowLegends.WarbandCamp.MaxProps = 200

#    WER.WarbandCamp.ViewDistance
#        야영지가 보이기 시작하는 거리(야드). 0 = 거리 제한 없음 - 클라이언트가 그릴 수
#        있게 되는 즉시 모든 야영지가 나타나므로, 지역을 이동하며 모든 전투단을 보게 됩니다.
#        20-250으로 제한.
#        기본값: 40
WowLegends.WarbandCamp.ViewDistance = 40

#    WER.WarbandCamp.AltsSameFactionOnly
#        1 = 현재 플레이 중인 진영의 부캐만 모이는
#        캠프. 0 = 계정 전체가 양 진영 함께 모입니다.
#        기본값: 1
WowLegends.WarbandCamp.AltsSameFactionOnly = 1

#    WER.WarbandCamp.AutoAlts
#        캠프를 소유한 플레이어가 로그인하면, 그 플레이어의 다른 캐릭터들이 봇으로 깨어나 명령 없이도
#        스스로 모닥불 곁에 모입니다. 파티에 속하지 않고 따라가기도 해제된 상태로 도착해 캠프 주변을
#        조용히 거닙니다. 한 명에게 "follow"라고 귓속말하면 곁으로 부를 수 있고, 그 캐릭터로 로그인하면
#        그대로 자신이 됩니다. 직접 모으려면 `.camp alts`를 계속 사용할 수 있습니다.
#        WarbandCamp가 활성일 때만 의미가 있습니다.
#        기본값: 1 (켜짐)
WowLegends.WarbandCamp.AutoAlts = 1

###############################################################################
# 봇 CHATTER
#
#    동료 봇은 자기 행동을 스스로 알립니다. 퀘스트를 수락, 완료, 포기하거나 실패할 때마다 귓속말이 옵니다.
#    동료가 하나면 개성 있게 느껴지지만, 다섯이면 정말 읽고 싶었던 내용이 묻혀 버리며, 이는 동료 봇에 대한
#    가장 흔한 불만입니다.
#
#    이 스위치는 봇이 말하는 두 종류의 내용을 구분합니다:
#
#      내가 한 말에 대한 답변               - 항상 전송, 제한 없음
#      봇이 알려 주기로 스스로 정한 내용    - 이 설정으로 제한
#
#    따라서 꺼도 봇이 말을 못 하게 되는 것은 아닙니다. 질문하거나 명령을 내리면 이전과 똑같이 답합니다.
#    요청하지 않은 실황 중계만 멈출 뿐입니다.
#
#    ⚠️ 이 설정은 플레이어별이 아니라 렐름 전체에 적용됩니다. 플레이어별 "그만 말하기"는 별도 작업이며
#    아직 구현되지 않았습니다.
###############################################################################

#    WER.BotChatter.Unsolicited
#        1 = 봇이 먼저 퀘스트 보고와 상태 잡담을 합니다 (원본 기본값)
#        0 = 봇은 말을 걸었을 때만 말합니다
#        기본값: 1 (켜짐)
WowLegends.BotChatter.Unsolicited = 1

# 한글 운영 프로필 추가 설정
WowLegends.Chat.AutoJoinWorld = 0

# 한글 운영 프로필 추가 설정
WowLegends.AiChat.PlayerStyle = 1

# 한글 운영 프로필 추가 설정
WowLegends.AiChat.JokeChance = 10
