###################################################################################################
# 도시 생활 모듈
###################################################################################################

[worldserver]

# 모듈 사용 여부.
CityLife.Enable = 1

# 인원 배치와 이동에 관한 상세 로그를 기록합니다.
CityLife.Debug = 0

# 랜덤봇 접속을 기다린 뒤 도시 상주 봇을 배정합니다.
CityLife.StartupDelaySeconds = 90

# 인원·행동 관리 주기. 짧을수록 반응은 빠르지만 CPU 사용량이 늘어납니다.
CityLife.TickSeconds = 10

###################################################################################################
# 봇 선택 및 안전 설정
###################################################################################################

# mod-playerbots에서 랜덤봇 계정 접두사와 접속 지연 설정을 읽습니다.
CityLife.Bots.UsePlayerbotConfig = 1

# auto는 AiPlayerbot.RandomBotAccountPrefix 값을 사용합니다.
CityLife.Bots.AccountPrefix = "auto"

# 선택적으로 계정 ID 범위를 제한합니다. 두 값이 모두 0이면 제한하지 않습니다.
CityLife.Bots.AccountMin = 0
CityLife.Bots.AccountMax = 0

CityLife.Bots.QueryLimit = 500

CityLife.Bots.SkipGrouped = 1

# 일반 랜덤봇 환경에서는 꺼 두세요. 켜면 BotActiveAlone 조건 때문에 대부분의 봇이 제외될 수 있습니다.
CityLife.Bots.RespectPlayerbotActivity = 0

# 도시 상주 배정이 끝난 봇을 원래 위치로 돌려보냅니다.
CityLife.Bots.ReturnWhenReleased = 1

###################################################################################################
# 인원 배치 관리
###################################################################################################

# 거점별 설정과 시간대 배율 적용 후의 전체 인원 안전 상한입니다.
# 상한에 도달하면 city_life_hub에서 우선순위가 높은 거점을 먼저 채웁니다.
CityLife.Population.MaxTotal = 300

# 봇을 조금씩 배치·해제해 대규모 순간이동과 순간 부하를 줄입니다.
CityLife.Population.MaxChangesPerTick = 3

###################################################################################################
# 시간대별 인원 배율(월드서버 PC의 현지 시각 기준)
###################################################################################################

CityLife.Time.Enable = 1

# 아침 06:00~11:59, 낮 12:00~17:59, 저녁 18:00~23:59, 밤 00:00~05:59.
# 100이면 해당 거점에 설정한 인원을 모두 배치합니다.
CityLife.Time.MorningMultiplierPct = 60
CityLife.Time.DayMultiplierPct = 80
CityLife.Time.EveningMultiplierPct = 100
CityLife.Time.NightMultiplierPct = 25

###################################################################################################
# 도시 내 행동
###################################################################################################

# 상주 봇이 가끔 경매장·은행·우편함·비행장·광장 사이를 이동합니다.
CityLife.Behaviour.Relocate = 1
CityLife.Behaviour.RelocateMinSeconds = 180
CityLife.Behaviour.RelocateMaxSeconds = 600

# 다른 AI 동작으로 이 거리보다 멀어진 비전투 상주 봇을 배정 위치로 돌려보냅니다.
# 이 위치 유지 기능은 전투를 중단시키지 않습니다.
CityLife.Behaviour.LeashRadius = 35

CityLife.Behaviour.Emotes = 1
CityLife.Behaviour.EmoteChancePct = 35
CityLife.Behaviour.EmoteMinSeconds = 120
CityLife.Behaviour.EmoteMaxSeconds = 360

# 지정된 거점의 경매장·은행에 다른 지점보다 더 많은 봇을 배치합니다.
# 250이면 DB 기본 가중치의 2.5배입니다.
CityLife.Behaviour.ServiceSpotWeightMultiplierPct = 250

# 해당 서비스 지점에 처음 배정된 봇 중 자리를 유지할 비율입니다.
# 자리를 유지해도 감정 표현이나 공격에 대한 방어는 할 수 있습니다.
CityLife.Behaviour.StaticServiceChancePct = 80
CityLife.Behaviour.StaticServiceHubs = "Stormwind,Orgrimmar"
CityLife.Behaviour.StaticServiceCategories = "auction,bank"

# 도시 봇은 공격받으면 방어하지만 스스로 사냥·여행하거나 멀리 떠나지 않습니다.
CityLife.Strategies.NonCombat = "+stay,-follow,-passive,-grind,-rpg,-travel,-duel,-pvp"

###################################################################################################
# 기본 거점별 인원
###################################################################################################

# DB의 각 거점은 다음 개별 설정도 지원합니다:
#   CityLife.Hub.<HubName>.Enable
#   CityLife.Hub.<HubName>.Population
#   CityLife.Hub.<HubName>.TimeScaling
#   CityLife.Hub.<HubName>.ResidenceSeconds: 상주 시간(초). 0이면 교체 없이 계속 유지합니다.
# 사용자 추가 거점은 대응 설정 키가 없으면 DB 기본값을 사용합니다.

CityLife.Hub.Stormwind.Enable = 1
CityLife.Hub.Stormwind.Population = 25

CityLife.Hub.Orgrimmar.Enable = 1
CityLife.Hub.Orgrimmar.Population = 25

CityLife.Hub.Ironforge.Enable = 1
CityLife.Hub.Ironforge.Population = 18

CityLife.Hub.Undercity.Enable = 1
CityLife.Hub.Undercity.Population = 18

CityLife.Hub.Darnassus.Enable = 1
CityLife.Hub.Darnassus.Population = 10

CityLife.Hub.ThunderBluff.Enable = 1
CityLife.Hub.ThunderBluff.Population = 10

CityLife.Hub.Exodar.Enable = 1
CityLife.Hub.Exodar.Population = 5

CityLife.Hub.Silvermoon.Enable = 1
CityLife.Hub.Silvermoon.Population = 8

CityLife.Hub.Shattrath.Enable = 1
CityLife.Hub.Shattrath.Population = 20

CityLife.Hub.Dalaran.Enable = 1
CityLife.Hub.Dalaran.Population = 25

# 겨울손아귀의 진영별 시작 야영지에 각각 봇 40명을 유지합니다.
# 이 인원은 시간대 배율을 무시하며 3시간마다 교체됩니다.
CityLife.Hub.WintergraspAlliance.Enable = 1
CityLife.Hub.WintergraspAlliance.Population = 40
CityLife.Hub.WintergraspAlliance.TimeScaling = 0
CityLife.Hub.WintergraspAlliance.ResidenceSeconds = 10800

CityLife.Hub.WintergraspHorde.Enable = 1
CityLife.Hub.WintergraspHorde.Population = 40
CityLife.Hub.WintergraspHorde.TimeScaling = 0
CityLife.Hub.WintergraspHorde.ResidenceSeconds = 10800

CityLife.Hub.Gadgetzan.Enable = 1
CityLife.Hub.Gadgetzan.Population = 8

CityLife.Hub.Goldshire.Enable = 1
CityLife.Hub.Goldshire.Population = 8

CityLife.Hub.HonorHold.Enable = 1
CityLife.Hub.HonorHold.Population = 6

CityLife.Hub.Thrallmar.Enable = 1
CityLife.Hub.Thrallmar.Population = 6
